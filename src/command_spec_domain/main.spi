:< model

:= main () : i32 =
    := _ = model.command_code "status"
    := _ = model.command_effect_code "status"
    := _ = model.command_subcommand_effect_code "patch:check"
    := _ = model.command_descriptor_by_index "0"
    := _ = model.command_descriptor_json_by_index "0"
    := _ = model.command_count ()
    := _ = model.command_catalog_witness ()
    := _ = model.command_schema_witness ()
    := _ = model.diagnostic_catalog_witness ()
    := _ = model.toolchain_action_code "cargo-check"
    := _ = model.proxy_usage "fs-read"
    := _ = model.proxy_route_code "plan-ir-check"
    := _ = model.proxy_route_witness ()
    := _ = model.help_flag_code "--schema"
    := _ = model.help_flag_witness ()
    := _ = model.help_request_text ()
    !!!!Export("kit_command_code", ((\ value => command_code value) : string -> u64))
    !!!!Export("kit_command_effect_code", ((\ value => command_effect_code value) : string -> u64))
    !!!!Export(
        "kit_command_subcommand_effect_code",
        ((\ value => command_subcommand_effect_code value) : string -> u64)
    )
    !!!!Export(
        "kit_command_descriptor",
        ((\ value => command_descriptor_by_index value) : string -> string * string * string * string * string)
    )
    !!!!Export(
        "kit_command_descriptor_named",
        ((\ value => command_descriptor_named value) : string -> string * string * string * string * string)
    )
    !!!!Export(
        "kit_command_descriptor_json",
        ((\ value => command_descriptor_json_by_index value) : string -> string)
    )
    !!!!Export("kit_command_count", ((\ () => command_count ()) : () -> i32))
    !!!!Export("kit_command_schema_witness", ((\ () => command_schema_witness ()) : () -> i32))
    !!!!Export("kit_toolchain_action_name_code", ((\ value => toolchain_action_code value) : string -> u64))
    !!!!Export("kit_command_proxy_usage", ((\ value => proxy_usage value) : string -> string))
    !!!!Export("kit_proxy_route_code", ((\ value => proxy_route_code value) : string -> u64))
    !!!!Export("kit_proxy_route_witness", ((\ () => proxy_route_witness ()) : () -> i32))
    !!!!Export("kit_help_flag_code", ((\ value => help_flag_code value) : string -> u64))
    !!!!Export("kit_help_flag_witness", ((\ () => help_flag_witness ()) : () -> i32))
    !!!!Export("kit_help_request_text", ((\ () => help_request_text ()) : () -> string))
    !!!!Export("kit_direct_verb_usage", ((\ value => direct_verb_usage value) : string -> string))
    0i32
