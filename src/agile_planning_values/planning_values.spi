:< workspace_primitives.outcome
:< workspace_primitives.numbers
:< agile_planning_model.model

:~ planned_value_token (field : planning_field) (~value : string) : validation_result string =
    ?= field ?|
    | FieldEstimate =>
        ?= parse_planned_estimate value ?|
        | Valid estimate => Valid (estimate_state_token estimate)
        | Invalid => Invalid
    | FieldLoad =>
        ?= parse_planned_load value ?|
        | Valid load => Valid (load_state_token load)
        | Invalid => Invalid
    | FieldAssignee =>
        ?= parse_planned_assignee value ?|
        | Valid assignee => Valid (assignee_state_token assignee)
        | Invalid => Invalid

:~ field_value_token (field : planning_field) (~value : string) : i32 * string =
    ?= planned_value_token field value ?|
    | Valid token => 0i32, token
    | Invalid => 1i32, planning_field_rule field

:~ planning_value_token (~field_name : string) (~value : string) : i32 * string =
    ?= parse_planning_field field_name ?|
    | Valid field => field_value_token field value
    | Invalid => 1i32, "field must be estimate, load or assignee"

:| legacy_agent =
    | LegacyYes
    | LegacyPair
    | LegacyNo

:= legacy_word (flag : legacy_agent) : string =
    ?= flag ?|
    | LegacyYes => "yes"
    | LegacyPair => "pair"
    | LegacyNo => "no"

:= legacy_assignee (flag : legacy_agent) : string =
    ?= flag ?|
    | LegacyYes => "agent"
    | LegacyPair => "pair"
    | LegacyNo => "user"

:~ legacy_agent_value (~value : string) : string =
    union_reflection.cases.union_case_where
        \ (flag : legacy_agent) => value = legacy_word flag
        \ flag => legacy_assignee flag
        ""

:= main () : i32 =
    !!!!Export(
        "kit_agile_planning_value_token",
        ((\ (field_name, value) => planning_value_token field_name value) : string * string -> i32 * string)
    )
    !!!!Export("kit_agile_planning_legacy_agent_value", ((\ value => legacy_agent_value value) : string -> string))
    := _ = planning_value_token "load" "heavy"
    := _ = legacy_agent_value "yes"
    0i32
