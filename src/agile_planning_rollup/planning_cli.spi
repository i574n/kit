///- --package ../eoie_cli_harness --timeout 900000
open cli

union agile_call =
    | RootThen : string * string
    | ModeThenRoot : string * string

inl tab () : string = $'std::rc::Rc::<str>::from(char::from(9u8).to_string())' : string
inl tabbed (~left : string) (~right : string) : string = cat (cat left (tab ())) right
inl count_of (~text : string) (~part : string) : i32 = $'!text.matches(&*!part).count() as i32' : i32
inl offset_of (~text : string) (~part : string) : i32 = $'!text.find(&*!part).map_or(-1, |offset| offset as i32)' : i32
inl id_symbol (~id : string) : string = $'std::rc::Rc::<str>::from(!id.to_lowercase().replace(char::from(45u8), "_"))' : string

let rec tab_split (~text : string) : cli_args =
    if text = "" then NoArgs
    else
        inl head = $'std::rc::Rc::<str>::from((!text).split(char::from(9u8)).next().unwrap_or(""))' : string
        inl rest = $'std::rc::Rc::<str>::from((!text).split_once(char::from(9u8)).map(|(_, rest)| rest).unwrap_or(""))' : string
        Arg (head, tab_split rest)

inl task_header () : string =
    """
        union task_kind =
            | Epic :: task_kind
            | TaskKind :: task_kind

        union agile_item =
            | Task :: string * string * task_kind * u32 -> agile_item

        """

inl task_row (id : string) (kind : string) (status : string) (deps : string) (tags : string) : string =
    inl head = cat (cat (cat "inl task_" (id_symbol id)) " () = Task (\"") id
    inl title = cat (cat (cat (cat head "\", \"Title of ") id) "\", ") kind
    inl planning = cat (cat title ", P1, D3, 0u32, ") status
    cat (cat (cat (cat (cat planning ", \"") deps) "\", \"") tags) "\", \"current\", \"current\")\n"

inl state_read (root : fixture_root) : string = fixture_read root "state/agile.spi"

inl fixture (label : string) (rows : string) : fixture_root =
    inl root = fixture_root_create label
    fixture_write root "state/agile.spi" (cat (cat (task_header ()) rows) "inl main () : i32 = 0i32\n")
    root

inl agile (root : fixture_root) (call : agile_call) : cli_run =
    inl path = fixture_text_of root
    inl args =
        match call with
        | RootThen (verb, rest) => Arg ("agile", Arg (verb, Arg (path, tab_split rest)))
        | ModeThenRoot (verb, mode) => Arg ("agile", Arg (verb, Arg (mode, Arg (path, NoArgs))))
    eoie_run (temp_directory ()) NoArgs NoArgs args

inl epic_deps_line_counts_two (~text : string) : bool = $'!text.lines().any(|line| line.starts_with("epic+deps") && line.contains("ID-A") && line.split_whitespace().nth(2) == Some("2"))' : bool

inl accepted (run : cli_run) (~part : string) : () = shows (succeeded run) part

///> rust
test planning_edit_validates_and_renders_typed_fields =
    inl root = fixture "edit" (task_row "ID-A" "TaskKind" "Planned" "" "eoie,agile")
    inl before = state_read root
    failed_with (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "estimate") "abc"))) "estimate must be"
    failed_with (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "estimate") "20000h"))) "at most 999999 minutes"
    failed_with (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "estimate") "-5"))) "estimate must be"
    failed_with (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "load") "huge"))) "load must be"
    failed_with (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "assignee") "bot"))) "assignee must be"
    failed_with (agile root (RootThen ("edit", tabbed (tabbed "NO-SUCH" "load") "heavy"))) "no task with this id"
    same (state_read root) before
    accepted (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "estimate") "6h"))) "estimate=360m load=- assignee=-"
    accepted (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "load") "Heavy"))) "load=heavy"
    accepted (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "assignee") "pair"))) "estimate=360m load=heavy assignee=pair"
    inl state = state_read root
    expect (count_of state "union task_planning =" = 1) state
    shows state "inl planning_of_id_a () = Planning (\"ID-A\", Minutes 360u32, Load Heavy, Assigned Pair)"
    expect (offset_of state "-> agile_item" < offset_of state "union task_load") state
    accepted (agile root (RootThen ("show", "ID-A"))) "planning: estimate=360m load=heavy assignee=pair"
    accepted (agile root (RootThen ("show", tabbed "ID-A" "--json"))) "\"estimate_minutes\":360,\"load\":\"heavy\",\"assignee\":\"pair\",\"notes\":[],\"elapsed_ms\""
    accepted (agile root (RootThen ("edit", tabbed (tabbed "ID-A" "load") "none"))) "load=-"
    shows (state_read root) "Planning (\"ID-A\", Minutes 360u32, LoadUnset, Assigned Pair)"
    fixture_root_remove root

///> rust
test tag_migration_is_previewed_applied_once_and_keeps_rejected_tags =
    inl a = task_row "ID-A" "Epic" "Active" "" "eoie,est:300m,load:heavy,agent:yes"
    inl b = task_row "ID-B" "TaskKind" "Planned" "ID-A" "est:abc,load:light,agent:no,web"
    inl c = task_row "ID-C" "TaskKind" "Done" "" "plain"
    inl root = fixture "migrate" (cat (cat a b) c)
    inl before = state_read root
    inl preview = agile root (ModeThenRoot ("migrate-tags", "preview"))
    accepted preview "ID-A moved=3 estimate=300m load=heavy assignee=agent tags=eoie"
    accepted preview "ID-B moved=2 estimate=- load=light assignee=user tags=est:abc,web rejected=est:abc"
    accepted preview "eoie agile migrate-tags preview tasks=2 tags_moved=5 rejected=1"
    same (state_read root) before
    accepted (agile root (ModeThenRoot ("migrate-tags", "apply"))) "eoie agile migrate-tags ok tasks=2"
    inl migrated = state_read root
    shows migrated "\"eoie\", \"current\""
    shows migrated "\"est:abc,web\""
    shows migrated "Planning (\"ID-B\", Unestimated, Load Light, Assigned User)"
    accepted (agile root (ModeThenRoot ("migrate-tags", "apply"))) "ok unchanged tasks=0 tags_moved=0 rejected=1"
    same (state_read root) migrated
    inl heavy = agile root (RootThen ("list", tabbed "--load" "heavy"))
    accepted heavy "shown=1 filter=all load=heavy assignee=all"
    shows heavy.stdout "ID-A"
    hides heavy.stdout "ID-B"
    inl users = agile root (RootThen ("list", tabbed (tabbed (tabbed "Planned" "--assignee") "user") "--json"))
    accepted users "\"id\":\"ID-B\""
    accepted users "\"estimate_minutes\":null,\"load\":\"light\",\"assignee\":\"user\"}"
    inl table = agile root (RootThen ("list", ""))
    accepted table "EST    LOAD   WHO"
    accepted table "300m   heavy  agent"
    failed_with (agile root (RootThen ("list", tabbed "--load" "huge"))) "invalid planning filter"
    inl plan = agile root (RootThen ("plan", ""))
    accepted plan "eoie agile plan ok tasks=3 open=2 estimated=1 minutes=300 open_minutes=300"
    expect (epic_deps_line_counts_two plan.stdout) plan.stdout
    accepted (agile root (RootThen ("plan", "--json"))) "{\"group\":\"load\",\"value\":\"heavy\",\"tasks\":1,\"open_tasks\":1,\"estimated\":1,\"minutes\":300,\"open_minutes\":300}"
    fixture_root_remove root
