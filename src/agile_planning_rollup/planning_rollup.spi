:< rust_std_fs.model
:< sm'_operators
:< agile_task_text.model
:< workspace_primitives.outcome
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< workspace_primitives.clock
:< workspace_primitives.console
:< workspace_primitives.files

:= argument_owned index : string = rust_std_env.model.argument_owned index
:~ argument_count () : i32 =
    := user = env.command_line_argument_count ()
    ? user > 0i32 ?> user - 1i32 |: 0i32

:== planning_tally =
    {
        tasks : i32
        open_tasks : i32
        estimated : i32
        minutes : i32
        open_minutes : i32
    }

:| rollup_format =
    | RollupText
    | RollupJson

:== rollup_group =
    {
        name : string
        label : string
    }

:= tally_record (tasks, open_tasks, estimated, minutes, open_minutes) : planning_tally =
    { tasks = tasks; open_tasks = open_tasks; estimated = estimated; minutes = minutes; open_minutes = open_minutes }

:~ tally_of (~text : string) (~group : string) (~value : string) : planning_tally =
    tally_record (
        $'agile_planning_tally::kit_agile_planning_tally(&*!text, &*!group, &*!value)' : i32 * i32 * i32 * i32 * i32
    )

:= padded (~text : string) (width : i32) : string =
    $'{ let text = !text; let filler = (!width as usize).saturating_sub(text.chars().count()); \
        std::rc::Rc::<str>::from(text.to_string() + &" ".repeat(filler)) }' : string
:= right_aligned (value : i32) (width : i32) : string =
    $'{ let text = (!value).to_string(); let filler = (!width as usize).saturating_sub(text.chars().count()); \
        std::rc::Rc::<str>::from(" ".repeat(filler) + &text) }' : string

:= json_number (~name : string) (value : i32) : string = ",\"" ++# name ++# "\":" ++# (i32_text value)

:~ tally_json (tally : planning_tally) : string =
    := counts =
        (json_number "tasks" tally.tasks)
        ++# (json_number "open_tasks" tally.open_tasks)
        ++# (json_number "estimated" tally.estimated)
    counts ++# (json_number "minutes" tally.minutes) ++# (json_number "open_minutes" tally.open_minutes)

:~ tally_columns (tally : planning_tally) : string =
    := counts =
        right_aligned tally.tasks 5i32
        ++# right_aligned tally.open_tasks 7i32
        ++# right_aligned tally.estimated 11i32
    counts ++# (right_aligned tally.minutes 9i32) ++# (right_aligned tally.open_minutes 14i32)

:~ rollup_line
    (format : rollup_format) (group : rollup_group) (~value : string) (tally : planning_tally) (first : bool)
    : string
    =
    ?= format ?|
    | RollupText => (padded group.label 11i32) ++# (padded value 28i32) ++# (tally_columns tally)
    | RollupJson =>
        := separator = ? first ?> "" |: ","
        := head = separator ++# "{\"group\":\"" ++# group.label ++# "\",\"value\":\"" ++# value
        head ++# "\"" ++# (tally_json tally) ++# "}"

:= status_group () : rollup_group = { name = "status"; label = "status" }
:= load_group () : rollup_group = { name = "load"; label = "load" }
:= assignee_group () : rollup_group = { name = "assignee"; label = "assignee" }
:= epic_group () : rollup_group = { name = "epic"; label = "epic+deps" }

:~ ^ print_group_rows
    (~text : string) (format : rollup_format) (group : rollup_group) (~values : string) (offset : i32) (first : bool)
    : i32
    =
    ? byte_len values <= offset ?> 0i32
    |:
        := comma = byte_find_from values "," offset
        := stop = ? comma < 0i32 ?> byte_len values |: comma
        := value = byte_slice values offset stop
        := _ = stdout_line (rollup_line format group value (tally_of text group.name value) first)
        print_group_rows text format group values (stop + 1i32) !-

:= unquoted (~token : string) : string = byte_slice token 1i32 (byte_len token - 1i32)

:= joined (~list : string) (~item : string) : string =
    ? (list = "") ?> item |: list ++# "," ++# item

:~ ^ epic_ids_from (text : string) (offset : i32) (length : i32) (~epics : string) : string =
    := found = byte_find_from text (task_marker ()) offset
    ? found < 0i32 ?> epics
    |:
        := arguments = (found + (task_arguments_offset ()))
        := field = tuple_field text arguments length
        ? declared_task text found ?>
            ? ((field 2i32) = "Epic") ?> epic_ids_from text arguments length (joined epics (unquoted (field 0i32)))
            |: epic_ids_from text arguments length epics
        |: epic_ids_from text arguments length epics

:~ planning_epic_ids (~text : string) : string = epic_ids_from text 0i32 (byte_len text) ""

:= rollup_header () : string =
    (padded "GROUP" 11i32) ++# (padded "VALUE" 28i32) ++# "TASKS   OPEN  ESTIMATED  MINUTES  OPEN_MINUTES"

:= rollup_opening (format : rollup_format) : string =
    ?= format ?|
    | RollupText => rollup_header ()
    | RollupJson => "{\"groups\":["

:= rollup_receipt (tally : planning_tally) (started : u64) : string =
    := head =
        "kit agile plan ok tasks="
        ++# i32_text tally.tasks
        ++# " open="
        ++# i32_text tally.open_tasks
        ++# " estimated="
    := middle =
        i32_text tally.estimated
        ++# " minutes="
        ++# i32_text tally.minutes
        ++# " open_minutes="
        ++# i32_text tally.open_minutes
    head ++# middle ++# " elapsed_ms=" ++# (u64_text (ms_since started))

:= rollup_closing (format : rollup_format) (tally : planning_tally) (started : u64) : string =
    ?= format ?|
    | RollupText => rollup_receipt tally started
    | RollupJson => "]" ++# (tally_json tally) ++# ",\"elapsed_ms\":" ++# (u64_text (ms_since started)) ++# "}"

:~ print_rollup (~text : string) (format : rollup_format) (started : u64) : i32 =
    := _ = stdout_line (rollup_opening format)
    := _ = print_group_rows text format (status_group ()) "Planned,Active,Blocked,Paused,Done" 0i32 !+
    := _ = print_group_rows text format (load_group ()) "light,medium,heavy,none" 0i32 !-
    := _ = print_group_rows text format (assignee_group ()) "agent,pair,user,none" 0i32 !-
    := _ = print_group_rows text format (epic_group ()) (planning_epic_ids text) 0i32 !-
    stdout_line (rollup_closing format (tally_of text "all" "") started)

:= planning_rollup_failure (~reason : string) : i32 = stderr_failure ("agile plan rejected: " ++# reason)

:~ planning_rollup (~root : string) (format : rollup_format) : i32 =
    := started = unix_ms ()
    ?= probe (unchecked (backlog_state_path root)) ?|
    | FileMissing _ => planning_rollup_failure "state/agile.spi is missing"
    | FileReadable file => print_rollup (records_text (loaded_string (read_text file))) format started

:= rollup_format_of (~flag : string) : validation_result rollup_format =
    ? (flag = "--json") ?> Valid RollupJson |: Invalid

:~ planning_rollup_entry () : i32 =
    := count = argument_count ()
    ? count = 2i32 ?> planning_rollup (argument_owned 1i32) RollupText
    |? count = 3i32 ?>
        ?= rollup_format_of (argument_owned 2i32) ?|
        | Valid format => planning_rollup (argument_owned 1i32) format
        | Invalid => planning_rollup_failure "plan expects <root> [--json]"
    |: planning_rollup_failure "plan expects <root> [--json]"

:= main () : i32 =
    !!!!Export("kit_agile_planning_rollup_run", ((\ () => planning_rollup_entry ()) : () -> i32))
    := _ = planning_rollup_entry ()
    0i32
