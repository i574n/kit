:< sm'_operators
:< kit_table_query.query
:< kit_table_query.cells
:< kit_table_query.stats
:< kit_table_query.wheres
:< kit_table_query.lines

:~ ^ all_columns (width : i32) (index : i32) : list i32 =
    ? index >= width ?> [] |: index :: all_columns width (index + 1i32)

:~ ^ named_columns (cells : table_cells) (cols : string) (missing : string) : list i32 * string =
    ? cols = ""
    ?> [], missing
    |:
        := index = column_of cells (head_of cols ",")
        := rest, missing =
            named_columns cells (tail_of cols ",") (? index < 0i32 ?> listed missing (head_of cols ",") |: missing)
        ? index < 0i32 ?> rest, missing |: index :: rest, missing

:= projection (cells : table_cells) (cols : string) (missing : string) : list i32 * string =
    ? cols = "" ?> all_columns (row_width cells 0i32) 0i32, missing |: named_columns cells cols missing

:== plain_count = { total : i32; matched : i32; shown : i32 }

:~ ^ listed_rows
    (cells : table_cells) (list : filters) (indexes : list i32) (limit : u64) (row : i32) (n : plain_count)
    =
    ? row > row_total cells
    ?> n
    |? row_passes list cells row = !-
    ?> listed_rows cells list indexes limit (row + 1i32) { n ?| total = n.total + 1i32 }
    |:
        := shown = below_limit n.shown limit
        ? shown ?> stdout_line (row_text cells row indexes)
        := n = { n ?| total = n.total + 1i32; matched = n.matched + 1i32; shown = n.shown + (? shown ?> 1i32 |: 0i32) }
        listed_rows cells list indexes limit (row + 1i32) n

:= ranked_before (counts : key_rows) (a : string) (b : string) : bool =
    := ca, cb = key_row counts a, key_row counts b
    ca > cb || (ca = cb && xml.text_order a b < 0i32)

:~ ^ ranked (counts : key_rows) (value : string) (sorted : list string) : list string =
    ?= sorted ?|
    | [] => [ value ]
    | head :: rest => ? ranked_before counts value head ?> value :: sorted |: head :: ranked counts value rest

:= counted (counts : key_rows) (value : string) (seen : list string) : list string =
    := before = key_row counts value
    key_row_set counts value (? before < 0i32 ?> 1i32 |: before + 1i32)
    ? before < 0i32 ?> value :: seen |: seen

:~ ^ grouped_rows
    (cells : table_cells) (list : filters) (group : i32) (counts : key_rows) (row : i32) (seen : list string)
    =
    ? row > row_total cells
    ?> seen
    |? row_passes list cells row
    ?> grouped_rows cells list group counts (row + 1i32) (counted counts (cell_at cells row group) seen)
    |: grouped_rows cells list group counts (row + 1i32) seen

:~ ^ printed_groups (counts : key_rows) (sorted : list string) (limit : u64) (shown : i32) : i32 =
    ?= sorted ?|
    | value :: rest =>
        ? below_limit shown limit = !- ?> shown
        |:
            stdout_line (group_line (key_row counts value) value)
            printed_groups counts rest limit (shown + 1i32)
    | [] => shown

:= query_ok (total : i32) (matched : i32) : string =
    "kit table query ok total=" ++# i32_text total ++# " matched=" ++# i32_text matched

:= plain_summary (n : plain_count) : string = query_ok n.total n.matched ++# " shown=" ++# i32_text n.shown

:= matched_of (counts : key_rows) (seen : list string) : i32 =
    listm.fold (\ acc value => acc + key_row counts value) 0i32 seen

:= grouped_summary (cells : table_cells) (counts : key_rows) (seen : list string) (shown : i32) : string =
    := groups = " groups=" ++# i32_text (listm.length seen) ++# " shown=" ++# i32_text shown
    query_ok (row_total cells) (matched_of counts seen) ++# groups

:= plain_grouped (cells : table_cells) (list : filters) (group : i32) (request : table_request) : i32 =
    := counts = key_rows_new ()
    := seen = grouped_rows cells list group counts 1i32 []
    := sorted = listm.fold (\ acc value => ranked counts value acc) [] seen
    stdout_line (group_header request.group)
    := shown = printed_groups counts sorted request.limit 0i32
    ? request.quiet = !- ?> stdout_line (grouped_summary cells counts seen shown)
    0i32

:= plain_listed (cells : table_cells) (list : filters) (indexes : list i32) (request : table_request) : i32 =
    stdout_line (row_text cells 0i32 indexes)
    := n = listed_rows cells list indexes request.limit 1i32 { total = 0i32; matched = 0i32; shown = 0i32 }
    ? request.quiet = !- ?> stdout_line (plain_summary n)
    0i32

:= unknown_columns (cells : table_cells) (missing : string) : i32 =
    rejected ("unknown columns: " ++# missing ++# " (header: " ++# header_joined cells "," ++# ")")

:= group_column (cells : table_cells) (group : string) : i32 = ? group = "" ?> -1i32 |: column_of cells group

:= plain_loaded (cells : table_cells) (request : table_request) : i32 =
    := list, missing = filters_from cells request.wheres
    := indexes, missing = projection cells request.cols missing
    := group = group_column cells request.group
    := missing = ? request.group <> "" && group < 0i32 ?> listed missing request.group |: missing
    ? missing <> "" ?> unknown_columns cells missing
    |? group >= 0i32 ?> plain_grouped cells list group request
    |: plain_listed cells list indexes request

:~ plain_query (~file : string) (request : table_request) : i32 =
    ?= table_read file ?|
    | TableUnreadable problem => rejected problem
    | TableLoaded cells => plain_loaded cells request

:~ plain_entry
    (~file : string) (~wheres : string) (~cols : string) (~group : string) (limit : u64) (quiet : bool)
    : i32
    =
    := base = no_request ()
    plain_query file { base ?| wheres = wheres; cols = cols; group = group; limit = limit; quiet = quiet }

:= main () : i32 =
    !!!!Export(
        "kit_table_plain",
        (
            \ (file, wheres, cols, group, limit, quiet) => plain_entry file wheres cols group limit quiet
            : string * string * string * string * u64 * bool -> i32
        )
    )
    0i32
