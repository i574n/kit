///- --package .
:# host_model static =
    :< sm'_operators

:< sm'_operators

:| host_step =
    | KeepServing
    | HostIdleExit
    | HostDraining

:| host_home =
    | HomePresent
    | HomeGone

:| host_claim =
    | HostOwns
    | OtherHostServes : u64

:| host_state =
    | HostMissing
    | HostRunning : u64

:| supervisor_wait =
    | SupervisorUp : u64
    | SupervisorHeld : string
    | SupervisorLate

:= idle_limit_ms () : u64 = 600000u64

:= owner_ended_detail () : string = "its owner session ended before the job started"

:= request_suffix () : string = ".start"

:| idle_policy =
    | ExitAfter : u64
    | NeverExit

:= idle_policy_of (~text : string) : idle_policy =
    ?= convert.try_convert (sm'.trim text) ?|
    | Some seconds => ? seconds = 0u64 ?> NeverExit |: ExitAfter (seconds * 1000u64)
    | None => ExitAfter (idle_limit_ms ())

:= idle_reached (policy : idle_policy) (quiet_ms : u64) : bool =
    ?= policy ?|
    | ExitAfter limit => quiet_ms >= limit
    | NeverExit => !-

:~ host_step_of
    (policy : idle_policy) (live : u64) (idle_since : u64) (now : u64) (home : host_home) (owner_present : bool)
    : host_step
    =
    ? owner_present = !- ?> (? live > 0u64 ?> HostDraining |: HostIdleExit)
    |? live > 0u64 ?> KeepServing
    |? home = HomeGone ?> HostIdleExit
    |? idle_reached policy (now - idle_since) ?> HostIdleExit
    |: KeepServing

:~ host_claim_of (recorded : u64) (own : u64) (recorded_alive : bool) : host_claim =
    ? recorded <> 0u64 && recorded <> own && recorded_alive ?> OtherHostServes recorded |: HostOwns

:~ host_state_of (recorded : u64) (recorded_alive : bool) : host_state =
    ? recorded <> 0u64 && recorded_alive ?> HostRunning recorded |: HostMissing

:| slot_cap =
    | Unlimited
    | AtMost : u64

:= slot_cap_of (~text : string) : slot_cap =
    ?= convert.try_convert (sm'.trim text) ?|
    | Some n => ? n > 0u64 ?> AtMost n |: Unlimited
    | None => Unlimited

:= cap_text_of (~env_text : string) (~file_text : string) : string =
    ? sm'.trim env_text <> "" ?> env_text |: file_text

:= may_take (cap : slot_cap) (live : u64) : bool =
    ?= cap ?|
    | Unlimited => !+
    | AtMost n => live < n

:| queue_verdict =
    | StartNow
    | HoldBack
    | DropRequest

:= queue_verdict_of (code : i32) : queue_verdict = ? code = 0i32 ?> StartNow |? code = 1i32 ?> HoldBack |: DropRequest

:= admitted (cap : slot_cap) (live : u64) (verdict : queue_verdict) : queue_verdict =
    ? verdict = StartNow && may_take cap live = !- ?> HoldBack |: verdict

:== host_terms =
    {
        home : string
        owner_pid : u64
        owner_start : u64
        policy : idle_policy
        cap : slot_cap
    }

:~ request_name (~id : string) : string = id ++# request_suffix ()

:~ request_id (~name : string) : string = sm'.trim_end_suffix (request_suffix ()) name

:~ supervisor_wait_of (pid : u64) (now : u64) (deadline : u64) : option supervisor_wait =
    ? pid <> 0u64 ?> Some (SupervisorUp pid)
    |? now >= deadline ?> Some SupervisorLate
    |: None

:= unset () : idle_policy = idle_policy_of ""

///> rust
:# a_host_idle_policy_reads_seconds_and_zero_means_never =
    testing.expect (unset () = ExitAfter 600000u64) "unset keeps the ten-minute idle exit"
    testing.expect (idle_policy_of "0" = NeverExit && idle_policy_of " 30 " = ExitAfter 30000u64) "0 never exits"
    testing.expect (host_step_of NeverExit 0u64 0u64 3600000u64 HomePresent !+ = KeepServing) "a pod host stays up"
    testing.expect (host_step_of NeverExit 0u64 0u64 1000u64 HomePresent !- = HostIdleExit) "its owner still ends it"

///> rust
:# an_idle_host_exits_only_after_ten_quiet_minutes_without_children =
    testing.expect
        (host_step_of (unset ()) 1u64 0u64 900000u64 HomePresent !+ = KeepServing)
        "a live supervisor keeps the host"
    testing.expect
        (host_step_of (unset ()) 0u64 1000u64 300000u64 HomePresent !+ = KeepServing)
        "five quiet minutes are not enough"
    testing.expect
        (host_step_of (unset ()) 0u64 1000u64 601000u64 HomePresent !+ = HostIdleExit)
        "ten quiet minutes end the host"

///> rust
:# a_slot_cap_holds_new_requests_while_the_machine_is_full =
    testing.expect (slot_cap_of "" = Unlimited && slot_cap_of "0" = Unlimited) "unset or 0 means no cap"
    testing.expect (slot_cap_of " 1 " = AtMost 1u64 && slot_cap_of "two" = Unlimited) "a whole number caps"
    testing.expect (cap_text_of "2" "6\n" = "2") "the env beats the file"
    testing.expect (slot_cap_of (cap_text_of " " "6\n") = AtMost 6u64) "the file fills a blank env"
    testing.expect (may_take (AtMost 1u64) 0u64 && may_take (AtMost 1u64) 1u64 = !-) "one slot: the second waits"
    testing.expect (may_take Unlimited 50u64) "no cap takes every request"
    testing.expect (admitted (AtMost 1u64) 1u64 StartNow = HoldBack) "a full machine holds a ready job"
    testing.expect (admitted (AtMost 2u64) 1u64 StartNow = StartNow) "a free slot starts it"
    testing.expect (admitted (AtMost 1u64) 1u64 DropRequest = DropRequest) "the cap never revives a dropped job"

///> rust
:# a_host_whose_jobs_home_was_removed_exits_once_its_children_end =
    testing.expect
        (host_step_of (unset ()) 0u64 1000u64 2000u64 HomeGone !+ = HostIdleExit)
        "a removed home ends an idle host at once"
    testing.expect
        (host_step_of (unset ()) 1u64 1000u64 2000u64 HomeGone !+ = KeepServing)
        "a running supervisor still keeps it"

///> rust
:# a_host_drains_when_its_owner_ends =
    testing.expect
        (host_step_of (unset ()) 2u64 0u64 1000u64 HomePresent !- = HostDraining)
        "running children finish first"
    testing.expect
        (host_step_of (unset ()) 0u64 0u64 1000u64 HomePresent !- = HostIdleExit)
        "with no children left it exits"

///> rust
:# one_host_serves_an_owner =
    testing.expect (host_claim_of 0u64 7u64 !- = HostOwns) "no recorded host"
    testing.expect (host_claim_of 7u64 7u64 !+ = HostOwns) "the recorded host is this one"
    testing.expect (host_claim_of 9u64 7u64 !- = HostOwns) "a dead recorded host is replaced"
    testing.expect (host_claim_of 9u64 7u64 !+ = OtherHostServes 9u64) "a live other host keeps its owner's home"

///> rust
:# a_missing_host_pid_file_starts_a_host =
    testing.expect
        (host_state_of 0u64 !+ = HostMissing)
        "no host.pid reads as pid 0, which process_alive reports alive; it must still start a host"
    testing.expect (host_state_of 41u64 !- = HostMissing) "a dead recorded host is restarted"
    testing.expect (host_state_of 41u64 !+ = HostRunning 41u64) "a live recorded host takes the request"

///> rust
:# requests_name_their_job =
    testing.expect (request_name "job-1-build" = "job-1-build.start") "request file name"
    testing.expect (request_id "job-1-build.start" = "job-1-build") "job id from the request"
