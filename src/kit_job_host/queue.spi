///- --package .
:# queue static =
    :< sm'_operators
    :< kit_jobs.host
    :< kit_jobs.jobs
    :< kit_jobs.model

:< sm'_operators
:< kit_jobs.host
:< kit_jobs.jobs
:< kit_jobs.model

:| after_mode =
    | AfterAny
    | AfterOk

:| predecessor_state =
    | PredecessorLive
    | PredecessorSettled : string * i32

:| queued_wait =
    | NoChain
    | Chained : string * after_mode * predecessor_state

:== queued_job =
    {
        id : string
        stop_requested : bool
        wait : queued_wait
    }

:| queue_step =
    | KeepWaiting
    | StartSupervisor
    | SettleStopped : string
    | SettleSkipped : string

:= waited_for (wait : queued_wait) : string =
    ?= wait ?|
    | NoChain => ""
    | Chained (predecessor, _, _) => predecessor

:= step_of (job : queued_job) : queue_step =
    ? job.stop_requested ?> SettleStopped ("stopped on request while waiting for " ++# waited_for job.wait)
    |:
        ?= job.wait ?|
        | NoChain => StartSupervisor
        | Chained (_, _, PredecessorLive) => KeepWaiting
        | Chained (_, AfterAny, _) => StartSupervisor
        | Chained (predecessor, AfterOk, PredecessorSettled (word, code)) =>
            ? code = 0i32 ?> StartSupervisor
            |: SettleSkipped ("--after-ok: " ++# predecessor ++# " ended " ++# word ++# " exit " ++# sm'.format code)

:= after_part (~text : string) (index : i32) : string =
    := fields = sm'.split "\t" text |> array
    ? index < am'.length fields ?> sm'.trim (am'.index index fields) |: ""

:= predecessor_state_of (state : job_state) : predecessor_state =
    ? state_settled state ?> PredecessorSettled (state_word state, state_exit state) |: PredecessorLive

:~ queued_of (~id : string) : queued_job =
    := after_text = text_or_empty (job_file id "after")
    := stop_requested = file_exists (job_file id "stop")
    ? after_text = ""
    ?> { id = id; stop_requested = stop_requested; wait = NoChain }
    |:
        := predecessor = after_part after_text 0i32
        := mode = ? after_part after_text 1i32 = "ok" ?> AfterOk |: AfterAny
        {
            id = id
            stop_requested = stop_requested
            wait = Chained (predecessor, mode, predecessor_state_of (shared_state predecessor))
        }

:~ held_directory () : string = joined (jobs_root ()) "held"

:~ held_file (~id : string) : string = joined (held_directory ()) id

:~ held_names () : array string =
    ? file_system.directory_exists (held_directory ())
    ?>
        file_system.read_dir_names (held_directory ())
        |> resultm.unwrap'
        |> am'.from_vec_base
        |> am'.map_base sm'.from_std_string
        |> array
        |> am'.sort_by id
    |: ;[]

:~ held_beat (~id : string) : () =
    := _ = text_written (job_file id "heartbeat_ms") (decimal_text (now_ms ()))
    ()

:~ held_recorded (~id : string) (~executable : string) : () =
    := _ = directory_created (held_directory ())
    := _ = text_written (held_file id) executable
    held_beat id

:~ held_released (~id : string) : () =
    := path = held_file id
    $'{ let _ = std::fs::remove_file(&*!path); }' : ()

:~ settled_in_queue (~id : string) (step : queue_step) : () =
    ?= step ?|
    | SettleStopped detail =>
        := _ = text_written (job_file id "exit") (exit_line 143i32 (now_ms ()) JobStopped detail)
        ()
    | SettleSkipped detail =>
        := _ = text_written (job_file id "exit") (exit_line 125i32 (now_ms ()) (JobSkipped "") detail)
        ()
    | _ => ()


:= chained (~predecessor : string) (mode : after_mode) (state : predecessor_state) : queued_job =
    { id = "job-2-next"; stop_requested = !-; wait = Chained (predecessor, mode, state) }

///> rust
:# a_queued_job_starts_its_supervisor_only_when_its_chain_clears =
    testing.expect
        (step_of (chained "job-1-a" AfterAny PredecessorLive) = KeepWaiting)
        "a live predecessor holds the job without a process"
    testing.expect
        (step_of (chained "job-1-a" AfterAny (PredecessorSettled ("finished", 3i32))) = StartSupervisor)
        "--after runs after any end"
    testing.expect
        (step_of (chained "job-1-a" AfterOk (PredecessorSettled ("finished", 0i32))) = StartSupervisor)
        "--after-ok runs after success"
    testing.expect
        (step_of { id = "job-3-plain"; stop_requested = !-; wait = NoChain } = StartSupervisor)
        "an unchained job starts at once"

///> rust
:# held_jobs_settle_with_the_after_waiters_exit_details =
    testing.expect
        (
            step_of (chained "job-1-a" AfterOk (PredecessorSettled ("finished", 3i32)))
            = SettleSkipped "--after-ok: job-1-a ended finished exit 3"
        )
        "same detail as kit_job_after's skip"
    testing.expect
        (
            step_of (chained "job-1-a" AfterOk (PredecessorSettled ("lost", 125i32)))
            = SettleSkipped "--after-ok: job-1-a ended lost exit 125"
        )
        "a missing predecessor reads as lost, as in kit_job_after"
    testing.expect
        (
            step_of { (chained "job-1-a" AfterAny PredecessorLive) ?| stop_requested = !+ }
            = SettleStopped "stopped on request while waiting for job-1-a"
        )
        "same detail as kit_job_after's stop"

///> rust
:# a_serial_chain_behind_a_running_job_holds_no_process =
    := serial =
        [
            chained "job-review" AfterAny PredecessorLive
            chained "job-5f" AfterOk PredecessorLive
            chained "job-gate" AfterAny PredecessorLive
        ]
    := spawned =
        serial
        |> listm.fold (\ count (job : queued_job) => ? step_of job = StartSupervisor ?> count + 1i32 |: count) 0i32
    testing.expect (spawned = 0i32) "nothing spawns until the chain head settles"

///> rust
:# after_files_read_as_predecessor_and_mode =
    testing.expect
        (after_part "job-1-a\tok" 0i32 = "job-1-a" && after_part "job-1-a\tok" 1i32 = "ok")
        "the after file is predecessor TAB mode"
    testing.expect (after_part "job-1-a" 1i32 = "") "a plain --after has no mode field"
