///- --package .
:# release static =
    :< sm'_operators
    :< agile_claim_model.claim

:< sm'_operators
:< agile_claim_model.claim

:~ declined_row (~item : string) (~lane : string) (until : u64) (claims : list claim) (now_ms : u64) (~detail : string)
    : string * string * string * u64 * i32 * i32 * string * string
    =
    := wip = live_count (released claims item) now_ms
    outcome_word OutcomeDropped, item, "~" ++# lane, until, 0i32, wip, detail, change_word ChangeUpsert

:= claim_dropped (~item : string) (~lane : string) (ttl_min : i32) (claims : list claim) (now_ms : u64)
    : string * string * string * u64 * i32 * i32 * string * string
    =
    := until = now_ms + (conv ttl_min : u64) * 60000u64
    := declined = \ (~detail : string) => declined_row item lane until claims now_ms detail
    ?= state_of claims item now_ms ?|
    | LeasedTo c =>
        ? c.owner = lane ?> declined "yes"
        |:
            := wip, reason = live_count claims now_ms, refusal_reason (LeasedBy c)
            outcome_word OutcomeReleaseRefused, item, c.owner, c.expires_ms, 0i32, wip, reason, change_word ChangeNone
    | Unclaimed => declined "none"
    | _ => declined "yes"

:~ lease_released (~item : string) (~lane : string) (ttl_min : i32) (~rows : string) (now_ms : u64)
    : string * string * string * u64 * i32 * i32 * string * string
    =
    claim_dropped item lane ttl_min (claims_of_text rows) now_ms

:= release_lease_of (~item : string) (~owner : string) (expires_ms : u64) : claim =
    { item = item; owner = owner; expires_ms = expires_ms; paths = [] }

///> rust
:# only_the_owner_releases_a_live_lease =
    := held = claims_text [ release_lease_of "GATE" "a" 9000u64 ]
    := kind, _, owner, _, _, _, reason, _ = lease_released "GATE" "b" 90i32 held 1000u64
    testing.expect (kind = "releaserefused" && owner = "a" && reason = "leased-by:a:9000") reason
    := kind, _, owner, until, _, wip, detail, change = lease_released "GATE" "a" 90i32 held 1000u64
    testing.expect (kind = "dropped" && owner = "~a" && until = 5401000u64 && wip = 0i32) detail
    testing.expect (detail = "yes" && change = "upsert") detail
    := kind, _, owner, _, _, _, detail, change = lease_released "KIT-SIDE" "a" 90i32 held 1000u64
    testing.expect (kind = "dropped" && owner = "~a" && detail = "none" && change = "upsert") detail
    := declined = claims_text [ release_lease_of "GATE" "~a" 9000u64 ]
    := _, _, _, _, _, _, again, _ = lease_released "GATE" "a" 90i32 declined 1000u64
    testing.expect (again = "none") "a second release by the decliner is a no-op"
///> _
:= main () : i32 =
    export "kit_claim_release" (
        (\ (item, lane, ttl, rows, now) => lease_released item lane ttl rows now)
        : string * string * i32 * string * u64 -> string * string * string * u64 * i32 * i32 * string * string
    )
    0i32
