:~ ^ projection_find_digit_loop (text : string) (at : i32) (text_len : i32) : i32 =
    ? (=.) at text_len ?> text_len
    |:
        := digit = codec_decimal_digit_value (sm.index text at)
        ? (<) digit 10u64 ?> at
        |: projection_find_digit_loop text ((+.) at 1i32) text_len

:= projection_line (source : string) (marker : string) : string =
    := source_len = sm.length source : i32
    := marker_at = find_text source 0i32 marker
    ? (=.) marker_at source_len ?> codec_empty ()
    |:
        := line_near_to = find_char source marker_at (char_newline ())
        slice_exclusive source marker_at line_near_to

:= projection_u32 (source : string) (marker : string) : string =
    := line = projection_line source marker
    := line_len = sm.length line : i32
    ? (=.) line_len 0i32 ?> codec_empty ()
    |:
        := equals_at = find_char line 0i32 '='
        ? (=.) equals_at line_len ?> codec_empty ()
        |:
            := digit_from = projection_find_digit_loop line ((+.) equals_at 1i32) line_len
            ? (=.) digit_from line_len ?> codec_empty ()
            |:
                := digit_near_to = find_text line digit_from "u32"
                ? (=.) digit_near_to line_len ?> codec_empty ()
                |: codec_u64_decimal_normalize (slice_exclusive line digit_from digit_near_to)

:~ handoff_ratings_projection (source : string) : string =
    := active = projection_u32 source "inl active_codebase_readiness"
    := ceiling = projection_u32 source "inl subjective_phase_ceiling"
    := coverage = projection_u32 source "inl active_coverage_attainment"
    := runtime_drift = projection_u32 source "inl phase_runtime_drift"
    := parallel = projection_u32 source "inl phase_parallel_readiness"
    := plan_ir = projection_u32 source "inl phase_plan_ir"
    := migration = projection_u32 source "inl migration ()"
    ? (=.) active "" ?> codec_empty ()
    |? (=.) ceiling "" ?> codec_empty ()
    |? (=.) coverage "" ?> codec_empty ()
    |? (=.) runtime_drift "" ?> codec_empty ()
    |? (=.) parallel "" ?> codec_empty ()
    |? (=.) plan_ir "" ?> codec_empty ()
    |? (=.) migration "" ?> codec_empty ()
    |:
        := out0 = sm.concat "active_readiness=" active
        := out1 = sm.concat out0 "/1000 subjective_ceiling="
        := out2 = sm.concat out1 ceiling
        := out3 = sm.concat out2 "/1000 coverage="
        := out4 = sm.concat out3 coverage
        := out5 = sm.concat out4 "/1000 runtime_drift="
        := out6 = sm.concat out5 runtime_drift
        := out7 = sm.concat out6 "/1000 parallel_readiness="
        := out8 = sm.concat out7 parallel
        := out9 = sm.concat out8 "/1000 canonical_plan_ir="
        := out10 = sm.concat out9 plan_ir
        := out11 = sm.concat out10 "/1000 migration_historical="
        := out12 = sm.concat out11 migration
        sm.concat out12 "/1000"

:~ ^ projection_census_loop (line : string) (at : i32) (line_len : i32) (index : i32) (out : string) : string =
    := digit_from = projection_find_digit_loop line at line_len
    ? (=.) digit_from line_len ?> ? (=.) index 10i32 ?> out |: codec_empty ()
    |? (>=) index 10i32 ?> codec_empty ()
    |:
        := digit_near_to = find_text line digit_from "u32"
        ? (=.) digit_near_to line_len ?> codec_empty ()
        |:
            := value = codec_u64_decimal_normalize (slice_exclusive line digit_from digit_near_to)
            ? (=.) value "" ?> codec_empty ()
            |:
                := prefix =
                    ? (=.) index 0i32 ?> "spiral_files="
                    |? (=.) index 1i32 ?> " generated_rust_files="
                    |? (=.) index 2i32 ?> " rust_global_sites="
                    |? (=.) index 3i32 ?> " spiral_loc="
                    |? (=.) index 4i32 ?> " generated_rust_loc="
                    |? (=.) index 5i32 ?> " cargo_crates="
                    |? (=.) index 6i32 ?> " spiral_packages="
                    |? (=.) index 7i32 ?> " package_only="
                    |? (=.) index 8i32 ?> " max_crate_loc="
                    |: " max_rust_file_loc="
                := item = sm.concat prefix value
                projection_census_loop line ((+.) digit_near_to 3i32) line_len ((+.) index 1i32) (sm.concat out item)

:~ handoff_census_projection (source : string) : string =
    := line = projection_line source "AuthorityCensus ("
    := line_len = sm.length line : i32
    ? (=.) line_len 0i32 ?> codec_empty ()
    |: projection_census_loop line 0i32 line_len 0i32 ""

:= fixture_ratings () : string =
    """
        inl active_coverage_attainment () : u32 = 804u32
        inl active_codebase_readiness () : u32 = 477u32
        inl subjective_phase_ceiling () : u32 = 620u32
        inl phase_runtime_drift () : phase_dimension = PhaseDimension ("runtime-drift-burndown", 510u32, 12u32)
        inl phase_parallel_readiness () : phase_dimension = PhaseDimension ("parallel-readiness", 550u32, 8u32)
        inl phase_plan_ir () : phase_dimension = PhaseDimension ("canonical-plan-ir", 750u32, 10u32)
        inl migration () = Rating (MigrationCompleteness, 987u32, 0i32)

        """

:= fixture_census () : string =
    "inl census () : authority_census = AuthorityCensus (446u32, 90u32, 2141u32, 19236u32, 27530u32, 81u32, "
    ^^ "239u32, 158u32, 996u32, 957u32)\n"
