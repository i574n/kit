:< model

:= missing_stage_probe () : bool =
    := pending = staged "/tmp/kit-rust-std-fs-negative-stage.txt"
    discard pending && staged_missing pending

:= missing_path_probe () : bool =
    ?= probe (unchecked "/tmp/kit-rust-std-fs-negative-missing.txt") ?|
    | FileMissing path => missing_path_nonempty path
    | FileReadable _ => !-

:= main () : i32 =
    ? missing_stage_probe () && missing_path_probe () ?> 0i32 |: 1i32
