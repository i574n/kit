:< rooted_domain

:= copy_allowed () : bool =
    policy_accepted (transition_allowed (CopyRegular : rooted_transition (regular_path * absent_path) regular_path))

:= remove_file_allowed () : bool =
    policy_accepted (transition_allowed (RemoveRegular : rooted_transition regular_path absent_path))

:= remove_tree_allowed () : bool =
    policy_accepted (transition_allowed (RemoveDirectory : rooted_transition directory_path absent_path))

:= main () : i32 =
    ? copy_allowed () && remove_file_allowed () && remove_tree_allowed () ?> 0i32 |: 1i32
