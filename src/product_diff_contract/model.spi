:! product_diff_raw = ()
:! product_diff_rooted = ()
:! product_diff_manifested = ()
:! product_diff_compared = ()
:! product_diff_reported = ()

:| product_diff_policy =
    | RejectInvalidRoots
    | RejectSymlinks
    | ReuseDeterministicManifest
    | CompareByRelativeIdentity
    | HashRegularFiles
    | ClassifyAddedRemovedChangedUnchanged
    | ReportDeterministically

:| product_diff_op from to =
    | ValidateProductRoots :: product_diff_op product_diff_raw product_diff_rooted
    | ManifestProductTrees :: product_diff_op product_diff_rooted product_diff_manifested
    | CompareProductEntries :: product_diff_op product_diff_manifested product_diff_compared
    | ReportProductDiff :: product_diff_op product_diff_compared product_diff_reported

:| ^ product_diff_plan from to =
    | ProductDiffStep :: \* from to. product_diff_op from to -> product_diff_plan from to
    | ProductDiffThen :: \* from to.
        (\? middle. product_diff_plan from middle * product_diff_plan middle to) ->
        product_diff_plan from to

:= product_diff_public_plan () : product_diff_plan product_diff_raw product_diff_reported =
    ProductDiffThen (\? (
        ProductDiffStep ValidateProductRoots,
        ProductDiffThen (\? (
            ProductDiffStep ManifestProductTrees,
            ProductDiffThen (\? (
                ProductDiffStep CompareProductEntries,
                ProductDiffStep ReportProductDiff
            ))
        ))
    ))

:~ product_diff_request_binding (left_valid : i32) (right_valid : i32) : i32 =
    ? left_valid = 1i32 ?>
        ? right_valid = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:~ product_diff_summary_binding (changed_entries : i32) (total_entries : i32) : i32 =
    ? changed_entries < 0i32 ?> 0i32
    |? total_entries < 0i32 ?> 0i32
    |? total_entries < changed_entries ?> 0i32
    |: 1i32
