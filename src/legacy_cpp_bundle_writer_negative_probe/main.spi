:< legacy_cpp_bundle_writer_contract.model

:= zero_is (value : i32) : bool =
    ? value < 0i32 ?> !-
    |? 0i32 < value ?> !-
    |: !+

:= main () : i32 =
    := _ = negative_plan ()
    := missing_source = source_comparison_binding 1i32 0i32
    := wrong_order = ordering_binding 1i32 0i32
    := wrong_count = count_binding 1i32 0i32
    := wrong_nested_mode =
        nested_policy_binding (nested_zip_policy_code LegacyExcludeNested) (nested_zip_policy_code LegacyExcludeNested)
    := wrong_epoch = epoch_binding 1i32 0i32
    := nondeterministic = determinism_binding 1i32 0i32
    ? zero_is missing_source ?>
        ? zero_is wrong_order ?>
            ? zero_is wrong_count ?>
                ? zero_is wrong_nested_mode ?>
                    ? zero_is wrong_epoch ?>
                        ? zero_is nondeterministic ?> 0i32 |: 6i32
                    |: 5i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
