:! exact_replace_policy_owner = string
:! exact_replace_negative_owner = string
:! replace_pending owner = owner
:! replace_inspected owner = owner
:! replace_unique owner = owner
:! replace_committed owner = owner
:! replace_verified owner = owner

:| exact_replace_transition from to =
    | InspectReplaceTarget :: \* owner. exact_replace_transition (replace_pending owner) (replace_inspected owner)
    | RequireUniqueMatch :: \* owner. exact_replace_transition (replace_inspected owner) (replace_unique owner)
    | CommitExactReplace :: \* owner. exact_replace_transition (replace_unique owner) (replace_committed owner)
    | VerifyExactReplace :: \* owner. exact_replace_transition (replace_committed owner) (replace_verified owner)

:| ^ exact_replace_plan from to =
    | ExactReplaceStep :: \* from to. exact_replace_transition from to -> exact_replace_plan from to
    | ExactReplaceThen :: \* from to.
        (\? middle. exact_replace_plan from middle * exact_replace_plan middle to) ->
        exact_replace_plan from to

:~ bool_pair_binding (left : i32) (right : i32) : i32 =
    ? left < 1i32 ?> 0i32
    |? 1i32 < left ?> 0i32
    |? right < 1i32 ?> 0i32
    |? 1i32 < right ?> 0i32
    |: 1i32

:~ preflight_binding (regular_file : i32) (old_nonempty : i32) (distinct_payloads : i32) : i32 =
    := first = bool_pair_binding regular_file old_nonempty
    bool_pair_binding first distinct_payloads

:~ unique_match_binding (match_count : i32) : i32 =
    ? match_count < 1i32 ?> 0i32
    |? 1i32 < match_count ?> 0i32
    |: 1i32

:~ mode_binding (known_mode : i32) (side_effect_policy_valid : i32) : i32 =
    bool_pair_binding known_mode side_effect_policy_valid

:~ zero_binding (value : i32) : i32 =
    ? value < 0i32 ?> 0i32
    |? 0i32 < value ?> 0i32
    |: 1i32

:~ verification_binding (candidate_exact : i32) (old_remaining : i32) (rollback_available : i32) : i32 =
    := exact_and_rollback = bool_pair_binding candidate_exact rollback_available
    bool_pair_binding exact_and_rollback (zero_binding old_remaining)

:= full_plan \* owner. () : exact_replace_plan (replace_pending owner) (replace_verified owner) =
    ExactReplaceThen (\? (
        ExactReplaceStep InspectReplaceTarget,
        ExactReplaceThen (\? (
            ExactReplaceStep RequireUniqueMatch,
            ExactReplaceThen (\? (
                ExactReplaceStep CommitExactReplace,
                ExactReplaceStep VerifyExactReplace
            ))
        ))
    ))

:= policy_plan
    ()
    : exact_replace_plan (replace_pending exact_replace_policy_owner) (replace_verified exact_replace_policy_owner)
    =
    full_plan ()
:= negative_plan
    ()
    : exact_replace_plan (replace_pending exact_replace_negative_owner) (replace_verified exact_replace_negative_owner)
    =
    full_plan ()
