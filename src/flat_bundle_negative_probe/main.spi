:< flat_bundle_contract.model

:= zero_is (value : i32) : bool =
    ? value < 0i32 ?> !-
    |? 0i32 < value ?> !-
    |: !+

:= main () : i32 =
    := _ = negative_plan ()
    ? zero_is (preflight_binding 1i32 0i32) ?>
        ? zero_is (manifest_binding 0i32 1i32) ?>
            ? zero_is (manifest_binding 1i32 0i32) ?>
                ? zero_is (compression_binding 1i32 0i32) ?>
                    ? zero_is (compression_binding 0i32 1i32) ?>
                        ? zero_is (size_binding 1i32 0i32) ?> 0i32 |: 6i32
                    |: 5i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
