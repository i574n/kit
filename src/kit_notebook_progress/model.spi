///- --package .
:# model static =
    :< sm'_operators

:< sm'_operators

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail


:| notebook_seen =
    | SeenWritten : u64
    | SeenPending
    | SeenShared

:== batch_progress =
    {
        written : i32
        pending : i32
        shared : i32
        last_name : string
        last_ms : u64
    }

:~ file_name_of (path : string) : string =
    := slashed = sm'.replace "\\" "/" (sm'.replace "\"" "" path)
    := at = sm'.last_index_of "/" slashed
    ? at < 0i32 ?> slashed |: sm'.substring (at + 1i32) ((sm'.length slashed : i32) - at - 1i32) slashed

:~ report_name_of (path : string) : string = file_name_of path ++# ".ipynb"

:~ flag_value_until_next_flag (chunk : string) : string =
    := cut = (sm'.index_of " --" chunk : i32)
    sm'.trim (sm'.replace "\"" "" (? cut < 0i32 ?> chunk |: sm'.substring 0i32 cut chunk))

:~ batch_paths (command : string) : array string = sm'.split " --path " command |> array

:~ batch_output_directory (command : string) : string =
    := at = (sm'.index_of " --output-dir " command : i32)
    ? at < 0i32 ?> ""
    |:
        := start = at + 14i32
        flag_value_until_next_flag (sm'.substring start ((sm'.length command : i32) - start) command)


:== batch_scan =
    {
        chunks : array string
        written_of : string -> u64
        started_ms : u64
    }

:~ chunk_name (scan : batch_scan) (at : i32) : string =
    report_name_of (flag_value_until_next_flag (am'.index at scan.chunks))

:~ ^ names_matching (scan : batch_scan) (name : string) (at : i32) (found : i32) : i32 =
    ? am'.length scan.chunks <= at ?> found
    |: names_matching scan name (at + 1i32) (? chunk_name scan at = name ?> found + 1i32 |: found)


:~ notebook_seen_of (scan : batch_scan) (name : string) : notebook_seen =
    ? names_matching scan name 1i32 0i32 > 1i32 ?> SeenShared
    |:
        := written = scan.written_of name
        ? written > 0u64 && scan.started_ms <= written ?> SeenWritten written |: SeenPending

:~ progress_counted (progress : batch_progress) (name : string) (seen : notebook_seen) : batch_progress =
    ?= seen ?|
    | SeenWritten ms =>
        := counted = { progress ?| written = progress.written + 1i32 }
        ? progress.last_ms <= ms ?> { counted ?| last_name = name; last_ms = ms } |: counted
    | SeenPending => { progress ?| pending = progress.pending + 1i32 }
    | SeenShared => { progress ?| shared = progress.shared + 1i32 }

:~ ^ progress_from (scan : batch_scan) (at : i32) (progress : batch_progress) : batch_progress =
    ? am'.length scan.chunks <= at ?> progress
    |:
        := name = chunk_name scan at
        progress_from scan (at + 1i32) (progress_counted progress name (notebook_seen_of scan name))

:~ batch_progress_of (command : string) (written_of : string -> u64) (started_ms : u64) : batch_progress =
    := scan = { chunks = batch_paths command; written_of = written_of; started_ms = started_ms }
    progress_from scan 1i32 { written = 0i32; pending = 0i32; shared = 0i32; last_name = ""; last_ms = 0u64 }

:~ minutes_text (ms : u64) : string = sm'.format (ms / 60000u64)

:~ shared_text (progress : batch_progress) : string =
    ? progress.shared > 0i32 ?> " (" ++# sm'.format progress.shared ++# " share a report name, not counted)" |: ""

:~ pace_text (progress : batch_progress) (started_ms : u64) : string =
    sm'.format ((progress.last_ms - started_ms) / convert.u64 progress.written / 1000u64) ++# " s per notebook"

:~ batch_progress_text (progress : batch_progress) (started_ms : u64) (now_ms : u64) : string =
    := total = progress.written + progress.pending + progress.shared
    := counted = "notebook batch: " ++# sm'.format progress.written ++# " of " ++# sm'.format total ++# " written"
    := head = counted ++# shared_text progress
    ? progress.written = 0i32 ?> head ++# ", none yet after " ++# minutes_text (now_ms - started_ms) ++# " min"
    |:
        := ago = minutes_text (now_ms - progress.last_ms)
        head ++# ", last " ++# progress.last_name ++# " " ++# ago ++# " min ago, ~" ++# pace_text progress started_ms
:| train_verdict =
    | TrainPending
    | TrainPassed
    | TrainTimedOut
    | TrainFailed

:== train_progress =
    {
        total : i32
        passed : i32
        timed_out : i32
        failed : i32
    }

:~ train_name_of (command : string) : string =
    := at = (sm'.index_of " -Name " command : i32)
    ? not (sm'.contains "release-train.ps1" command) || at < 0i32 ?> ""
    |:
        := rest = sm'.trim (sm'.substring (at + 7i32) ((sm'.length command : i32) - at - 7i32) command)
        := cut = (sm'.index_of " " rest : i32)
        sm'.replace "\"" "" (? cut < 0i32 ?> rest |: sm'.substring 0i32 cut rest)

:~ train_root_of (command : string) : string =
    := slashed = sm'.replace "\\" "/" (sm'.replace "\"" "" command)
    := at = (sm'.index_of "/scripts/release-train.ps1" slashed : i32)
    ? at < 0i32 ?> ""
    |:
        := head = sm'.substring 0i32 at slashed
        := space = sm'.last_index_of " " head
        sm'.substring (space + 1i32) ((sm'.length head : i32) - space - 1i32) head

:~ log_name_of (notebook : string) : string = sm'.replace "/" "_" (sm'.replace "\\" "_" notebook) ++# ".log"

:~ train_verdict_of (log : string) : train_verdict =
    ? sm'.contains "Spiral cell timed out" log ?> TrainTimedOut
    |? sm'.contains "spiral-tests total" log
    ?> (? sm'.contains "\"failed\":0," log ?> TrainPassed |: TrainFailed)
    |? sm'.contains "** (Mix)" log ?> TrainFailed
    |: TrainPending

:~ train_counted (progress : train_progress) (verdict : train_verdict) : train_progress =
    := progress = { progress ?| total = progress.total + 1i32 }
    ?= verdict ?|
    | TrainPending => progress
    | TrainPassed => { progress ?| passed = progress.passed + 1i32 }
    | TrainTimedOut => { progress ?| timed_out = progress.timed_out + 1i32 }
    | TrainFailed => { progress ?| failed = progress.failed + 1i32 }

:~ train_progress_of (logs : list string) : train_progress =
    := empty = { total = 0i32; passed = 0i32; timed_out = 0i32; failed = 0i32 }
    listm.fold (\ progress (log : string) => train_counted progress (train_verdict_of log)) empty logs

:~ train_progress_text (name : string) (progress : train_progress) : string =
    := done = progress.passed + progress.timed_out + progress.failed
    "release train "
    ++# name
    ++# ": "
    ++# sm'.format done
    ++# " of "
    ++# sm'.format progress.total
    ++# " notebooks done, "
    ++# sm'.format progress.passed
    ++# " pass, "
    ++# sm'.format progress.timed_out
    ++# " timed out (a starved run, retried), "
    ++# sm'.format progress.failed
    ++# " failed"

///> rust
:# a_release_train_command_names_its_train_and_root =
    := command =
        "\"C:\\Users\\me\\pwsh.exe\" -NoProfile -File C:\\work\\kit\\scripts\\release-train.ps1 -Name train5e-20261031 -Snapshot"
    expect (train_name_of command = "train5e-20261031") "the name stops at the next flag"
    expect (train_root_of command = "C:/work/kit") "the root is the script's repo"
    expect (train_name_of "pwsh -File run.ps1 -Name x" = "") "only release-train.ps1 counts"
    expect (log_name_of "src/kit_jobs/model.spi" = "src_kit_jobs_model.spi.log") "log names flatten the path"

///> rust
:# train_logs_sort_into_verdicts =
    := passed = "spiral-tests total {\"accepted\":0,\"built\":0,\"discovered\":5,\"executed\":5,\"failed\":0,\"files\":1}"
    := failed = "spiral-tests total {\"accepted\":0,\"built\":0,\"discovered\":5,\"executed\":5,\"failed\":2,\"files\":1}"
    := starved = failed ++# "\n** (Mix) x.spi: Spiral cell timed out after 300s; the process tree was killed."
    := broken = "** (Mix) x.spi: type error somewhere"
    := progress = train_progress_of [ passed; failed; starved; broken; ""; passed ]
    expect (progress.total = 6i32 && progress.passed = 2i32) "two passes of six"
    expect (progress.timed_out = 1i32 && progress.failed = 2i32) "a timeout is not a failure"
    expect
        (
            train_progress_text "t1" progress
            = "release train t1: 5 of 6 notebooks done, 2 pass, 1 timed out (a starved run, retried), 2 failed"
        )
        "receipt"

///> rust
:# report_names_come_from_the_path_file_name =
    expect (report_name_of "C:\\work\\repo\\src\\pkg\\grep_cli.spi" = "grep_cli.spi.ipynb") "windows path"
    expect (report_name_of "/work/repo/src/pkg/model.spi" = "model.spi.ipynb") "unix path"
    expect (report_name_of "\"C:\\work\\a b\\x.spi\"" = "x.spi.ipynb") "quoted path"

///> rust
:# a_batch_command_yields_its_paths_and_output_dir =
    := command =
        "pwsh -NoProfile -File C:\\c\\run_notebook.ps1 --path C:\\r\\src\\a\\one.spi --path C:\\r\\src\\b\\two.spi "
        ^^ "--output-dir C:\\r\\src\\target\\spiral-tests --no-html --gate"
    expect (am'.length (batch_paths command) = 3i32) "a head chunk plus two paths"
    expect (batch_output_directory command = "C:\\r\\src\\target\\spiral-tests") "output dir stops at the next flag"
    expect (batch_output_directory "pwsh run.ps1 --path x.spi" = "") "no output dir"

///> rust
:# progress_counts_reports_written_since_the_batch_started =
    := command =
        "pwsh run.ps1 --path C:\\r\\a\\one.spi --path C:\\r\\b\\two.spi --path C:\\r\\c\\model.spi --path "
        ^^ "C:\\r\\d\\model.spi --path C:\\r\\e\\three.spi --output-dir C:\\out --gate"
    := written_of name =
        ? name = "one.spi.ipynb" ?> 1060000u64
        |? name = "two.spi.ipynb" ?> 1180000u64
        |? name = "three.spi.ipynb" ?> 900000u64
        |? name = "model.spi.ipynb" ?> 1100000u64
        |: 0u64
    := progress = batch_progress_of command written_of 1000000u64
    expect
        (progress.written = 2i32 && progress.pending = 1i32 && progress.shared = 2i32)
        "a stale report is pending and a shared name is not counted"
    expect
        (progress.last_name = "two.spi.ipynb" && progress.last_ms = 1180000u64)
        "the newest written report is the last"
    expect
        (
            batch_progress_text progress 1000000u64 1300000u64
            = (
                "notebook batch: 2 of 5 written (2 share a report name, not counted), last two.spi.ipynb 2 min "
                ^^ "ago, ~90 s per notebook"
            )
        )
        "receipt"
    expect
        (
            batch_progress_text (batch_progress_of command (\ _ => 0u64) 1000000u64) 1000000u64 1180000u64
            = "notebook batch: 0 of 5 written (2 share a report name, not counted), none yet after 3 min"
        )
        "nothing written yet"
