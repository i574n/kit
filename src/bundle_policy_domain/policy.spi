:| bundle_profile_request =
    | AutoProfileRequest
    | GenericProfileRequest
    | KitProfileRequest

:| bundle_signature_requirement =
    | BundleBinarySignature
    | StatePackageSignature
    | StateCoreSignature
    | StateAgileSignature
    | SourceCargoSignature

:| bundle_root_entry =
    | BundleBinaryRoot
    | EvidenceRoot
    | SourceRoot
    | StateRoot

:| bundle_source_root_file =
    | SourceCargoToml
    | SourceCargoLock
    | SourcePackageProject
    | SourceRustfmtToml

:| bundle_source_required_file =
    | SourceRequiredCargoToml
    | SourceRequiredPackageProject

:! bundle_manifest_unobserved = ()
:! bundle_manifest_observed = ()
:! bundle_manifest_authoritative = ()

:| bundle_manifest_mapping_step from to =
    | ObserveWorkspaceMembers :: bundle_manifest_mapping_step bundle_manifest_unobserved bundle_manifest_observed
    | VerifyWorkspaceBijection :: bundle_manifest_mapping_step bundle_manifest_observed bundle_manifest_authoritative

:| ^ bundle_manifest_mapping_plan from to =
    | ManifestMappingStep :: \* from to. bundle_manifest_mapping_step from to -> bundle_manifest_mapping_plan from to
    | ManifestMappingThen :: \* from to.
        (\? middle. bundle_manifest_mapping_plan from middle * bundle_manifest_mapping_plan middle to) ->
        bundle_manifest_mapping_plan from to

:= bundle_manifest_authority_plan
    ()
    : bundle_manifest_mapping_plan bundle_manifest_unobserved bundle_manifest_authoritative
    =
    ManifestMappingThen (\? (ManifestMappingStep ObserveWorkspaceMembers, ManifestMappingStep VerifyWorkspaceBijection))

:~ bundle_manifest_mapping_binding (manifest_parsed : i32) (members_bijective : i32) : i32 =
    ? manifest_parsed = 1i32 && members_bijective = 1i32 ?> 1i32 |: 0i32

:| bundle_state_required_file =
    | StateRequiredPackageProject
    | StateRequiredCoreSource
    | StateRequiredAgileSource

:| bundle_source_special_directory =
    | SourceCargoConfigDirectory
    | SourceVendorDirectory

:| bundle_source_special_file =
    | SourceCargoConfigFile
    | SourceVendorChecksumFile

:| bundle_crate_allowed_file =
    | CrateCargoToml
    | CratePackageProject

:| bundle_crate_forbidden_file =
    | CrateLibRsForbidden

:| bundle_source_extension =
    | RustSourceExtension
    | SpiralSourceExtension

:| bundle_evidence_path =
    | CoverageDirectoryPath
    | CoverageCurrentFilePath

:| bundle_state_witness_file =
    | StateCoverageWitnessFile
    | StateConsolidationFixturesFile
    | StateDogfoodExitFile

:| bundle_runtime_limit =
    | BundleArchiveByteLimit
    | BundleExtractByteLimit
    | BundleCrateLineLimit
    | BundlePublicBinaryCount

:= bundle_profile_label = \|
    | AutoProfileRequest => "auto"
    | GenericProfileRequest => "generic"
    | KitProfileRequest => "kit"

:= bundle_profile_code_text = \|
    | AutoProfileRequest => "0"
    | GenericProfileRequest => "1"
    | KitProfileRequest => "2"

:= bundle_signature_label = \|
    | BundleBinarySignature => "kit"
    | StatePackageSignature => "state/package.spiproj"
    | StateCoreSignature => "state/core.spi"
    | StateAgileSignature => "state/agile.spi"
    | SourceCargoSignature => "src/Cargo.toml"

:= bundle_root_entry_label = \|
    | BundleBinaryRoot => "kit"
    | EvidenceRoot => "evidence"
    | SourceRoot => "src"
    | StateRoot => "state"

:= bundle_source_root_file_label = \|
    | SourceCargoToml => "Cargo.toml"
    | SourceCargoLock => "Cargo.lock"
    | SourcePackageProject => "package.spiproj"
    | SourceRustfmtToml => "rustfmt.toml"

:= bundle_source_required_file_label = \|
    | SourceRequiredCargoToml => "Cargo.toml"
    | SourceRequiredPackageProject => "package.spiproj"

:= bundle_state_required_file_label = \|
    | StateRequiredPackageProject => "package.spiproj"
    | StateRequiredCoreSource => "core.spi"
    | StateRequiredAgileSource => "agile.spi"

:= bundle_source_special_directory_label = \|
    | SourceCargoConfigDirectory => ".cargo"
    | SourceVendorDirectory => "vendor"

:= bundle_source_special_file_label = \|
    | SourceCargoConfigFile => "config.toml"
    | SourceVendorChecksumFile => ".cargo-checksum.json"

:= bundle_crate_allowed_file_label = \|
    | CrateCargoToml => "Cargo.toml"
    | CratePackageProject => "package.spiproj"

:= bundle_crate_forbidden_file_label = \|
    | CrateLibRsForbidden => "lib.rs"

:= bundle_source_extension_label = \|
    | RustSourceExtension => "rs"
    | SpiralSourceExtension => "spi"

:= bundle_evidence_path_label = \|
    | CoverageDirectoryPath => "coverage"
    | CoverageCurrentFilePath => "current.lcov"

:= bundle_state_witness_file_label = \|
    | StateCoverageWitnessFile => "coverage.spi"
    | StateConsolidationFixturesFile => "consolidation_fixtures.spi"
    | StateDogfoodExitFile => "dogfood_exit.spi"

:= bundle_runtime_limit_rust = \|
    | BundleArchiveByteLimit => "30_000_000"
    | BundleExtractByteLimit => "268_435_456"
    | BundleCrateLineLimit => "1000"
    | BundlePublicBinaryCount => "1"

:= rust_quote value =
    sm.concat "\"" (sm.concat value "\"")

:= rust_array2 a b =
    := x0 = sm.concat "[" (rust_quote a)
    := x1 = sm.concat x0 ", "
    := x2 = sm.concat x1 (rust_quote b)
    sm.concat x2 "]"

:= rust_array3 a b c =
    := x0 = sm.concat "[" (rust_quote a)
    := x1 = sm.concat x0 ", "
    := x2 = sm.concat x1 (rust_quote b)
    := x3 = sm.concat x2 ", "
    := x4 = sm.concat x3 (rust_quote c)
    sm.concat x4 "]"

:= rust_array4 a b c d =
    := x0 = sm.concat "[" (rust_quote a)
    := x1 = sm.concat x0 ", "
    := x2 = sm.concat x1 (rust_quote b)
    := x3 = sm.concat x2 ", "
    := x4 = sm.concat x3 (rust_quote c)
    := x5 = sm.concat x4 ", "
    := x6 = sm.concat x5 (rust_quote d)
    sm.concat x6 "]"

:= rust_array5 a b c d e =
    := x0 = sm.concat "[" (rust_quote a)
    := x1 = sm.concat x0 ", "
    := x2 = sm.concat x1 (rust_quote b)
    := x3 = sm.concat x2 ", "
    := x4 = sm.concat x3 (rust_quote c)
    := x5 = sm.concat x4 ", "
    := x6 = sm.concat x5 (rust_quote d)
    := x7 = sm.concat x6 ", "
    := x8 = sm.concat x7 (rust_quote e)
    sm.concat x8 "]"

:= profile_match_arm profile =
    := x0 = sm.concat "        " (rust_quote (bundle_profile_label profile))
    := x1 = sm.concat x0 " => "
    := x2 = sm.concat x1 (bundle_profile_code_text profile)
    sm.concat x2 ",\n"

:= bundle_profile_match_arms_rust () =
    := p0 = profile_match_arm AutoProfileRequest
    := p1 = profile_match_arm GenericProfileRequest
    := p2 = profile_match_arm KitProfileRequest
    sm.concat p0 (sm.concat p1 p2)

:= bundle_signature_array_rust () =
    rust_array4
        (bundle_signature_label BundleBinarySignature)
        (bundle_signature_label StatePackageSignature)
        (bundle_signature_label StateCoreSignature)
        (bundle_signature_label SourceCargoSignature)

:= bundle_rehydrate_agile_path_rust () =
    rust_quote (bundle_signature_label StateAgileSignature)

:= bundle_root_entries_array_rust () =
    rust_array4
        (bundle_root_entry_label BundleBinaryRoot)
        (bundle_root_entry_label EvidenceRoot)
        (bundle_root_entry_label SourceRoot)
        (bundle_root_entry_label StateRoot)

:= bundle_archive_directory_roots_array_rust () =
    rust_array3
        (sm.concat (bundle_root_entry_label EvidenceRoot) "/")
        (sm.concat (bundle_root_entry_label SourceRoot) "/")
        (sm.concat (bundle_root_entry_label StateRoot) "/")

:= bundle_source_root_files_array_rust () =
    rust_array4
        (bundle_source_root_file_label SourceCargoToml)
        (bundle_source_root_file_label SourceCargoLock)
        (bundle_source_root_file_label SourcePackageProject)
        (bundle_source_root_file_label SourceRustfmtToml)

:= bundle_source_required_files_array_rust () =
    rust_array2
        (bundle_source_required_file_label SourceRequiredCargoToml)
        (bundle_source_required_file_label SourceRequiredPackageProject)

:= bundle_state_required_files_array_rust () =
    rust_array3
        (bundle_state_required_file_label StateRequiredPackageProject)
        (bundle_state_required_file_label StateRequiredCoreSource)
        (bundle_state_required_file_label StateRequiredAgileSource)

:= bundle_source_special_directories_array_rust () =
    rust_array2
        (bundle_source_special_directory_label SourceCargoConfigDirectory)
        (bundle_source_special_directory_label SourceVendorDirectory)

:= bundle_crate_allowed_files_array_rust () =
    rust_array2
        (bundle_crate_allowed_file_label CrateCargoToml)
        (bundle_crate_allowed_file_label CratePackageProject)

:= bundle_source_extensions_array_rust () =
    rust_array2
        (bundle_source_extension_label RustSourceExtension)
        (bundle_source_extension_label SpiralSourceExtension)

:= bundle_evidence_paths_array_rust () =
    rust_array2
        (bundle_evidence_path_label CoverageDirectoryPath)
        (bundle_evidence_path_label CoverageCurrentFilePath)

:= bundle_state_witness_files_array_rust () =
    rust_array3
        (bundle_state_witness_file_label StateCoverageWitnessFile)
        (bundle_state_witness_file_label StateConsolidationFixturesFile)
        (bundle_state_witness_file_label StateDogfoodExitFile)

:= bundle_layout_runtime_rust () =
    := crate_allowed = bundle_crate_allowed_files_array_rust ()
    := crate_forbidden = rust_quote (bundle_crate_forbidden_file_label CrateLibRsForbidden)
    := source_extensions = bundle_source_extensions_array_rust ()
    := source_root_files = bundle_source_root_files_array_rust ()
    := source_required_files = bundle_source_required_files_array_rust ()
    := state_required_files = bundle_state_required_files_array_rust ()
    := source_special_directories = bundle_source_special_directories_array_rust ()
    := evidence_paths = bundle_evidence_paths_array_rust ()
    := state_witness_files = bundle_state_witness_files_array_rust ()
    := cargo_config_file = rust_quote (bundle_source_special_file_label SourceCargoConfigFile)
    := vendor_checksum_file = rust_quote (bundle_source_special_file_label SourceVendorChecksumFile)
    := archive_directory_roots = bundle_archive_directory_roots_array_rust ()
    := archive_limit = bundle_runtime_limit_rust BundleArchiveByteLimit
    := extract_limit = bundle_runtime_limit_rust BundleExtractByteLimit
    := crate_line_limit = bundle_runtime_limit_rust BundleCrateLineLimit
    := public_binary_count = bundle_runtime_limit_rust BundlePublicBinaryCount
    := x0 =
        sm.concat
            "const BUNDLE_CRATE_ALLOWED_FILES: [&str; 2] = "
            (sm.concat crate_allowed ";\nconst BUNDLE_CRATE_FORBIDDEN_FILE: &str = ")
    := x0a = sm.concat x0 (sm.concat crate_forbidden ";\nconst BUNDLE_SOURCE_EXTENSIONS: [&str; 2] = ")
    := x1 = sm.concat x0a (sm.concat source_extensions ";\nconst BUNDLE_SOURCE_ROOT_FILES: [&str; 4] = ")
    := x2 = sm.concat x1 (sm.concat source_root_files ";\nconst BUNDLE_SOURCE_REQUIRED_FILES: [&str; 2] = ")
    := x3 = sm.concat x2 (sm.concat source_required_files ";\nconst BUNDLE_STATE_REQUIRED_FILES: [&str; 3] = ")
    := x4 = sm.concat x3 (sm.concat state_required_files ";\nconst BUNDLE_SOURCE_SPECIAL_DIRECTORIES: [&str; 2] = ")
    := x5 = sm.concat x4 (sm.concat source_special_directories ";\nconst BUNDLE_EVIDENCE_PATHS: [&str; 2] = ")
    := x6 = sm.concat x5 (sm.concat evidence_paths ";\nconst BUNDLE_STATE_WITNESS_FILES: [&str; 3] = ")
    := x7 = sm.concat x6 (sm.concat state_witness_files ";\nconst BUNDLE_CARGO_CONFIG_FILE: &str = ")
    := x8 = sm.concat x7 (sm.concat cargo_config_file ";\nconst BUNDLE_VENDOR_CHECKSUM_FILE: &str = ")
    := x9 = sm.concat x8 (sm.concat vendor_checksum_file ";\nconst BUNDLE_ARCHIVE_DIRECTORY_ROOTS: [&str; 3] = ")
    := x10 = sm.concat x9 (sm.concat archive_directory_roots ";\nconst BUNDLE_ARCHIVE_MAX_BYTES: u64 = ")
    := x11 = sm.concat x10 (sm.concat archive_limit ";\nconst BUNDLE_EXTRACT_MAX_BYTES: u64 = ")
    := x12 = sm.concat x11 (sm.concat extract_limit ";\nconst BUNDLE_CRATE_LINE_LIMIT: usize = ")
    := x13 = sm.concat x12 (sm.concat crate_line_limit ";\nconst BUNDLE_PUBLIC_BINARY_COUNT: usize = ")
    sm.concat x13 (sm.concat public_binary_count """
        ;


        """)

:= bundle_profile_runtime_rust () =
    := profile_arms = bundle_profile_match_arms_rust ()
    := signature = bundle_signature_array_rust ()
    := agile_path = bundle_rehydrate_agile_path_rust ()
    := roots = bundle_root_entries_array_rust ()
    := x0a =
        sm.concat "const BUNDLE_ROOT_ENTRIES: [&str; 4] = " (sm.concat roots ";\nconst BUNDLE_KIT_AGILE_PATH: &str = ")
    := x0 = sm.concat x0a (sm.concat agile_path ";\nconst BUNDLE_PROFILE_SIGNATURE: [&str; 4] = ")
    inl x1 = sm.concat x0 (sm.concat signature """
        ;
        const BUNDLE_BINARY_NAMES: [&str; 2] = ["kit", "kit.exe"];

        fn bundle_profile_signature(root: &Path) -> i32 {
            let bootstrap_mask = i32::from(BUNDLE_BINARY_NAMES.iter().any(|name| rooted_open_regular_read(&root.join(name)).is_ok())) | (i32::from(rooted_open_regular_read(&root.join(BUNDLE_PROFILE_SIGNATURE[1])).is_ok()) << 1);
            let model_mask = i32::from(rooted_open_regular_read(&root.join(BUNDLE_PROFILE_SIGNATURE[2])).is_ok()) | (i32::from(rooted_open_regular_read(&root.join(BUNDLE_PROFILE_SIGNATURE[3])).is_ok()) << 1);
            kit_bundle_profile_signature_binding(bootstrap_mask, model_mask)
        }

        fn resolve_bundle_profile_code(requested: Option<&str>, signature: i32) -> Result<i32, String> {
            let requested_code = match requested.unwrap_or("auto") {

        """)
    := x2 = x1
    := x3 = sm.concat x2 profile_arms
    inl x4 = sm.concat x3 """
                other => return Err(format!("unknown bundle profile: {other}; expected auto, generic or kit")),
            };
            let resolved = kit_bundle_profile_resolve_binding(requested_code, signature);
            if resolved == 1 || resolved == 2 { Ok(resolved) } else { Err("typed bundle profile resolution rejected".to_owned()) }
        }

        fn resolve_bundle_profile(requested: Option<&str>, root: &Path) -> Result<i32, String> { resolve_bundle_profile_code(requested, bundle_profile_signature(root)) }

        fn resolve_bundle_archive_profile(requested: Option<&str>, archive: &Path) -> Result<i32, String> {
            let entries = zip_entries(archive)?;
            let bootstrap_mask = i32::from(entries.iter().any(|entry| BUNDLE_BINARY_NAMES.contains(&entry.as_str()))) | (i32::from(entries.iter().any(|entry| entry == BUNDLE_PROFILE_SIGNATURE[1])) << 1);
            let model_mask = i32::from(entries.iter().any(|entry| entry == BUNDLE_PROFILE_SIGNATURE[2])) | (i32::from(entries.iter().any(|entry| entry == BUNDLE_PROFILE_SIGNATURE[3])) << 1);

        """
    inl profile_runtime = sm.concat x4 """
            resolve_bundle_profile_code(requested, kit_bundle_profile_signature_binding(bootstrap_mask, model_mask))
        }


        """
    sm.concat profile_runtime (bundle_layout_runtime_rust ())
