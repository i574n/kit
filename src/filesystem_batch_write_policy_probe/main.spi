:< filesystem_batch_write_contract.model
:< filesystem_batch_write_contract.bindings

:= main () : i32 =
    := _ = public_plan ()
    ?= batch_write_shape_binding 2i32 0i32 ?|
    | 1 =>
        ?= batch_write_freshness_binding 0i32 1i32 ?|
        | 1 =>
            ?= batch_write_freshness_binding 1i32 1i32 ?|
            | 1 =>
                ?= batch_write_stage_binding 2i32 2i32 ?|
                | 1 =>
                    ?= batch_write_verify_binding 2i32 2i32 ?|
                    | 1 =>
                        ?= batch_write_rollback_binding 2i32 2i32 ?|
                        | 1 => 0i32
                        | _ => 1i32
                    | _ => 1i32
                | _ => 1i32
            | _ => 1i32
        | _ => 1i32
    | _ => 1i32
