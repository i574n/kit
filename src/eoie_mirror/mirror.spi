///- --package .
test mirror static =
    open sm'_operators

open sm'_operators

union file_side =
    | Missing
    | Present : string * u64

type mirrored_file =
    {
        path : string
        left : file_side
        right : file_side
    }

union file_drift =
    | SameOnBoth
    | LeftOnly
    | RightOnly
    | LeftNewer
    | RightNewer

union mirror_state =
    | InStep
    | LeftAhead : string
    | RightAhead : string
    | Diverged : string

let drift_of (file : mirrored_file) : file_drift =
    match file.left, file.right with
    | Missing, Missing => SameOnBoth
    | Present _, Missing => LeftOnly
    | Missing, Present _ => RightOnly
    | Present (left, left_ms), Present (right, right_ms) =>
        if left = right then SameOnBoth elif left_ms > right_ms then LeftNewer else RightNewer

inl drift_word (drift : file_drift) : string =
    match drift with
    | SameOnBoth => "same"
    | LeftOnly => "left-only"
    | RightOnly => "right-only"
    | LeftNewer => "left-newer"
    | RightNewer => "right-newer"

inl left_moved (drift : file_drift) : bool =
    match drift with
    | LeftOnly => true
    | LeftNewer => true
    | _ => false

inl joined_path (~list : string) (~path : string) : string = if list = "" then path else list ++# ", " ++# path

let rec mirror_state_of (files : list mirrored_file) (~left : string) (~right : string) : mirror_state =
    match files with
    | Nil =>
        if left = "" && right = "" then InStep
        elif right = "" then LeftAhead left
        elif left = "" then RightAhead right
        else Diverged (left ++# " | " ++# right)
    | Cons (file, rest) =>
        match drift_of file with
        | SameOnBoth => mirror_state_of rest left right
        | drift => if left_moved drift then mirror_state_of rest (joined_path left file.path) right else mirror_state_of rest left (joined_path right file.path)

inl state_word (state : mirror_state) : string =
    match state with
    | InStep => "in-step"
    | LeftAhead _ => "left-ahead"
    | RightAhead _ => "right-ahead"
    | Diverged _ => "diverged"

inl refuses_commit (state : mirror_state) : bool =
    match state with
    | InStep => false
    | _ => true

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

inl file_at (~path : string) (left : file_side) (right : file_side) : mirrored_file = { path = path; left = left; right = right }

///> rust
test a_change_on_one_side_alone_is_reported_and_refused =
    inl same = file_at "ci.yml" (Present ("x", 5u64)) (Present ("x", 9u64))
    expect (mirror_state_of (Cons (same, Nil)) "" "" = InStep) "identical content in step whatever the times"
    inl left_change = file_at "scripts/build.ps1" (Present ("new", 20u64)) (Present ("old", 10u64))
    expect (mirror_state_of (Cons (left_change, Cons (same, Nil))) "" "" = LeftAhead "scripts/build.ps1") "changed only on the left"
    expect (mirror_state_of (Cons (file_at "a" (Present ("old", 10u64)) (Present ("new", 20u64)), Nil)) "" "" = RightAhead "a") "changed only on the right"
    expect (mirror_state_of (Cons (left_change, Cons (file_at "b" (Missing) (Present ("", 3u64)), Nil))) "" "" = Diverged "scripts/build.ps1 | b") "both sides moved"
    expect (refuses_commit (LeftAhead "x") && refuses_commit InStep = false) "only an in-step mirror commits"

///> rust
test an_empty_file_is_present_not_missing =
    expect (drift_of (file_at "e" (Present ("", 1u64)) Missing) = LeftOnly) "an empty file on the left only"
    expect (drift_of (file_at "e" (Present ("", 1u64)) (Present ("", 2u64))) = SameOnBoth) "two empty files agree"
    expect (drift_word (drift_of (file_at "e" Missing Missing)) = "same") "absent on both sides"
