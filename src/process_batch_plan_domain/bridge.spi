:< model

:~ batch_plan_accept_binding (checkpoint_value : i32) (event_value : i32) : i32 =
    ? valid_checkpoint_code checkpoint_value ?>
        ? valid_event_code event_value ?>
            ? checkpoint_value = 0i32 ?> ? event_value = 0i32 ?> 1i32 |: 0i32
            |? checkpoint_value = 1i32 ?> ? event_value = 1i32 ?> 1i32 |: 0i32
            |? checkpoint_value = 2i32 ?>
                ? event_value = 2i32 ?> 1i32
                |? event_value = 3i32 ?> 1i32
                |: 0i32
            |? checkpoint_value = 3i32 ?> ? event_value = 4i32 ?> 1i32 |: 0i32
            |? checkpoint_value = 4i32 ?> ? event_value = 4i32 ?> 1i32 |: 0i32
            |: 0i32
        |: -1i32
    |: -1i32

:~ batch_plan_advance_binding (checkpoint_value : i32) (event_value : i32) : i32 =
    := accepted = batch_plan_accept_binding checkpoint_value event_value
    ? accepted = 1i32 ?>
        ? checkpoint_value = 0i32 ?> 1i32
        |? checkpoint_value = 1i32 ?> 2i32
        |? checkpoint_value = 2i32 ?> ? event_value = 3i32 ?> 4i32 |: 3i32
        |: 5i32
    |: -1i32

:= batch_plan_next_policy (checkpoint_value : i32) (timeout_requested : i32) : i32 =
    ? valid_checkpoint_code checkpoint_value ?>
        ? checkpoint_value = 0i32 ?> 0i32
        |? checkpoint_value = 1i32 ?> 1i32
        |? checkpoint_value = 2i32 ?> ? timeout_requested = 0i32 ?> 2i32 |: 3i32
        |? checkpoint_value = 3i32 ?> 4i32
        |? checkpoint_value = 4i32 ?> 4i32
        |: -1i32
    |: -1i32
