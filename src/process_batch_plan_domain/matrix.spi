:~ matrix_row_policy_binding (required_code : i32) (policy_code : i32) : i32 =
    ? (required_code = 0i32 || required_code = 1i32) && (policy_code = 0i32 || policy_code = 1i32) ?> 1i32 |: -1i32

:~ matrix_dependency_binding (has_dependency : i32) (dependency_passed : i32) : i32 =
    ? has_dependency = 0i32 ?> 1i32
    |? has_dependency = 1i32 ?> ? dependency_passed = 1i32 ?> 1i32 |: 0i32
    |: -1i32

:~ matrix_observed_accept_binding (required_code : i32) (exit_code : i32) : i32 =
    ? required_code = 0i32 ?> ? exit_code = 0i32 ?> 1i32 |: 0i32
    |? required_code = 1i32 ?> ? exit_code = 0i32 ?> 0i32 |: 1i32
    |: -1i32

:~ matrix_resume_action_binding (accepted : i32) (policy_code : i32) : i32 =
    ? policy_code = 0i32 ?> ? accepted = 1i32 ?> 0i32 |: 2i32
    |? policy_code = 1i32 ?> ? accepted = 1i32 ?> 0i32 |: 1i32
    |: -1i32

:= matrix_auto_chain_budget_policy (work_remaining_ms : i32) (timeout_ms : i32) : i32 =
    ? work_remaining_ms < 30000i32 ?> 0i32
    |? timeout_ms < 1i32 ?> -1i32
    |? timeout_ms < 5001i32 ?> 12i32
    |? timeout_ms < 10001i32 ?> 8i32
    |? timeout_ms < 15001i32 ?> 6i32
    |: 1i32

:~ matrix_auto_chain_budget_binding (work_remaining_ms : i32) (timeout_ms : i32) : i32 =
    matrix_auto_chain_budget_policy work_remaining_ms timeout_ms

:| matrix_auto_chain_action =
    | AutoChainStop
    | AutoChainReinvoke

:= matrix_auto_chain_action_policy (work_budget : i32) : matrix_auto_chain_action =
    ? 0i32 < work_budget ?> AutoChainReinvoke |: AutoChainStop

:| matrix_auto_checkpoint_action =
    | AutoCheckpointSkip
    | AutoCheckpointCreate

:= matrix_auto_checkpoint_action_code = \|
    | AutoCheckpointSkip => 0i32
    | AutoCheckpointCreate => 1i32

:~ matrix_auto_checkpoint_binding (mode : i32) (evidence : i32) : i32 =
    ? mode = 0i32 ?>
        ? evidence < 0i32 ?> -1i32 |? 0i32 < evidence ?> 1i32 |: 0i32
    |? mode = 1i32 ?>
        ? evidence < 0i32 || 3i32 < evidence ?> -1i32
        |? evidence = 1i32 ?> 1i32
        |: 0i32
    |: -1i32

:= matrix_auto_budget_status () : i32 =
    := wrap = matrix_auto_chain_budget_policy 29999i32 14000i32
    := fast = matrix_auto_chain_budget_policy 60000i32 5000i32
    := mid = matrix_auto_chain_budget_policy 60000i32 10000i32
    := bounded = matrix_auto_chain_budget_policy 60000i32 14000i32
    := slow = matrix_auto_chain_budget_policy 60000i32 16000i32
    ? wrap = 0i32 ?>
        ? fast = 12i32 ?>
            ? mid = 8i32 ?>
                ? bounded = 6i32 ?>
                    ? slow = 1i32 ?> 1i32 |: 0i32
                |: 0i32
            |: 0i32
        |: 0i32
    |: 0i32

:= matrix_authority_status () : i32 = matrix_auto_budget_status ()


:| command_workspace_policy =
    | RequestedWorkingDirectory
    | NestedCargoWorkspace

:= command_workspace_policy_code = \|
    | RequestedWorkingDirectory => 0i32
    | NestedCargoWorkspace => 1i32

:~ matrix_workspace_policy_binding (program_requested_code : i32) (nested_manifest : i32) : i32 =
    ? program_requested_code < 0i32 ?> -1i32
    |? 3i32 < program_requested_code ?> -1i32
    |? program_requested_code = 2i32 ?>
        ? nested_manifest = 1i32 ?> command_workspace_policy_code NestedCargoWorkspace
        |? nested_manifest = 0i32 ?> command_workspace_policy_code RequestedWorkingDirectory
        |: -1i32
    |: command_workspace_policy_code RequestedWorkingDirectory
:~ matrix_complete_binding (coverage : i32) (accepted : i32) : i32 =
    ? coverage = 3i32 ?>
        ? accepted = 1i32 ?> 1i32 |: 0i32
    |: 0i32
