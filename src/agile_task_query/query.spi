///- --package .
:# query static =
    :< sm'_operators

:< sm'_operators

:= team_word_valid (~word : string) : bool =
    word <> "" && sm'.to_lower word = word && sm'.index_of " " word < 0 && sm'.index_of "," word < 0

:~ tag_listed (~tags : string) (~tag : string) : bool =
    sm'.index_of ("," ++# tag ++# ",") ("," ++# (sm'.replace " " "" tags) ++# ",") >= 0

:= team_id_prefix (~word : string) : string = (sm'.to_upper word) ++# "-"

:~ on_team (~word : string) (~id : string) (~tags : string) : bool =
    tag_listed tags word || sm'.starts_with (team_id_prefix word) id

:= open_status (~status : string) : bool = status = "Planned" || status = "Active"

:= spaced (~text : string) : string =
    sm'.to_lower text
    |> sm'.replace "," " "
    |> sm'.replace "." " "
    |> sm'.replace ":" " "
    |> sm'.replace ";" " "
    |> sm'.replace "(" " "
    |> sm'.replace ")" " "
    |> sm'.replace "'" " "

:~ has_word (~text : string) (~word : string) : bool = sm'.split " " (spaced text) |> am'.any (\ token => token = word)

:~ words_hit (~words : string) (~title : string) (~tags : string) : bool =
    (
        sm'.split "," (sm'.to_lower words)
        |> am'.any \ word => word <> "" && has_word title word = !- && has_word tags word = !-
    )
    = !-

:| query_filter =
    | OnTeam : string
    | WithTag : string
    | WithPrefix : string
    | WithWords : string
    | OnlyOpen
    | OnlyReady
    | OnlyBlocked

:| ^ query_filters =
    | NoFilters
    | FilterThen : query_filter * query_filters

:~ filter_passes
    (filter : query_filter) (~id : string) (~title : string) (~tags : string) (~status : string) (settled : bool)
    : bool
    =
    ?= filter ?|
    | OnTeam word => on_team word id tags
    | WithTag tag => tag_listed tags tag
    | WithPrefix prefix => sm'.starts_with prefix id
    | WithWords words => words_hit words title tags
    | OnlyOpen => open_status status
    | OnlyReady => open_status status && settled
    | OnlyBlocked => status = "Blocked" || (open_status status && settled = !-)

:~ ^ filters_pass
    (filters : query_filters) (~id : string) (~title : string) (~tags : string) (~status : string) (settled : bool)
    : bool
    =
    ?= filters ?|
    | NoFilters => !+
    | FilterThen (filter, rest) =>
        ? filter_passes filter id title tags status settled ?> filters_pass rest id title tags status settled |: !-

:= filter_reads_deps (filter : query_filter) : bool =
    ?= filter ?|
    | OnlyReady => !+
    | OnlyBlocked => !+
    | _ => !-

:~ ^ filters_read_deps (filters : query_filters) : bool =
    ?= filters ?|
    | NoFilters => !-
    | FilterThen (filter, rest) => ? filter_reads_deps filter ?> !+ |: filters_read_deps rest

:= query_filter_text (filter : query_filter) : string =
    ?= filter ?|
    | OnTeam word => "team=" ++# word
    | WithTag tag => "tag=" ++# tag
    | WithPrefix prefix => "prefix=" ++# prefix
    | WithWords words => "words=" ++# words
    | OnlyOpen => "open"
    | OnlyReady => "ready"
    | OnlyBlocked => "blocked"

:~ ^ filters_text (filters : query_filters) (~acc : string) : string =
    ?= filters ?|
    | NoFilters => acc
    | FilterThen (filter, rest) => filters_text rest (" " ++# (query_filter_text filter) ++# acc)

:| query_flag value =
    | FlagTeam :: query_flag string
    | FlagTag :: query_flag string
    | FlagPrefix :: query_flag string
    | FlagWords :: query_flag string
    | FlagOpen :: query_flag ()
    | FlagReady :: query_flag ()
    | FlagBlocked :: query_flag ()

:! any_flag = \? value. query_flag value

:= each_flag \* state. (step : state -> any_flag -> state) (initial : state) : state =
    := s = step initial (any_flag (\? FlagTeam))
    := s = step s (any_flag (\? FlagTag))
    := s = step s (any_flag (\? FlagPrefix))
    := s = step s (any_flag (\? FlagWords))
    := s = step s (any_flag (\? FlagOpen))
    := s = step s (any_flag (\? FlagReady))
    step s (any_flag (\? FlagBlocked))

:= flag_word \* value. (flag : query_flag value) : string =
    ?= flag ?|
    | FlagTeam => "--team"
    | FlagTag => "--tag"
    | FlagPrefix => "--prefix"
    | FlagWords => "--words"
    | FlagOpen => "--open"
    | FlagReady => "--ready"
    | FlagBlocked => "--blocked"

:= flag_usage \* value. (flag : query_flag value) : string =
    ?= flag ?|
    | FlagTeam => "--team <team>"
    | FlagTag => "--tag <tag>"
    | FlagPrefix => "--prefix <ID prefix>"
    | FlagWords => "--words <w1,w2>"
    | FlagOpen => "--open"
    | FlagReady => "--ready"
    | FlagBlocked => "--blocked"

:= any_usage (any_flag f : any_flag) : string =
    := \? value. flag = f
    flag_usage flag

:= query_usage () : string = each_flag (\ acc f => ? acc = "" ?> any_usage f |: acc ++# ", " ++# (any_usage f)) ""

:| value_read value =
    | ValueRead : value
    | ValueRefused : string

:= value_of \* value. (flag : query_flag value) (~raw : string) : value_read value =
    ?= flag ?|
    | FlagTeam =>
        ? team_word_valid raw ?> ValueRead raw |: ValueRefused ("--team expects a lower-case team word, got " ++# raw)
    | FlagTag => ? raw = "" ?> ValueRefused "--tag expects a tag" |: ValueRead raw
    | FlagPrefix => ? raw = "" ?> ValueRefused "--prefix expects an ID prefix" |: ValueRead raw
    | FlagWords => ? raw = "" ?> ValueRefused "--words expects comma-separated words" |: ValueRead raw
    | FlagOpen => ValueRead ()
    | FlagReady => ValueRead ()
    | FlagBlocked => ValueRead ()

:= filter_of \* value. (flag : query_flag value) (given : value) : query_filter =
    ?= flag ?|
    | FlagTeam => OnTeam given
    | FlagTag => WithTag given
    | FlagPrefix => WithPrefix given
    | FlagWords => WithWords given
    | FlagOpen => OnlyOpen
    | FlagReady => OnlyReady
    | FlagBlocked => OnlyBlocked

:= width_of \* value. (flag : query_flag value) : i32 =
    ?= flag ?|
    | FlagOpen => 1i32
    | FlagReady => 1i32
    | FlagBlocked => 1i32
    | _ => 2i32

:| flag_read =
    | FilterRead : query_filter * i32
    | FlagRefused : string
    | NotQueryFlag

:= flag_filter \* value. (flag : query_flag value) (~raw : string) : flag_read =
    ?= value_of flag raw ?|
    | ValueRead given => FilterRead (filter_of flag given, width_of flag)
    | ValueRefused reason => FlagRefused reason

:= flag_step (found : flag_read) (any_flag f : any_flag) (~argument : string) (~raw : string) : flag_read =
    := \? value. flag = f
    ?= found ?|
    | NotQueryFlag => ? argument = flag_word flag ?> flag_filter flag raw |: found
    | _ => found

:~ flag_read_of (~argument : string) (~value : string) : flag_read =
    each_flag (\ found f => flag_step found f argument value) NotQueryFlag

:~ query_token (~query : string) (index : i32) : string =
    $'std::rc::Rc::<str>::from((!query).split_whitespace().nth(!index as usize).unwrap_or(""))' : string

:~ ^ filters_of_query (~query : string) (index : i32) (acc : query_filters) : query_filters =
    := argument = query_token query index
    ? argument = "" ?> acc
    |:
        ?= flag_read_of argument (query_token query (index + 1i32)) ?|
        | FilterRead (filter, used) => filters_of_query query (index + used) (FilterThen (filter, acc))
        | _ => filters_of_query query (index + 1i32) acc

:~ query_passes
    (~query : string) (~id : string) (~title : string) (~tags : string) (~status : string) (settled : bool)
    : bool
    =
    filters_pass (filters_of_query query 0i32 NoFilters) id title tags status settled

:~ query_reads_deps (~query : string) : bool = filters_read_deps (filters_of_query query 0i32 NoFilters)

:~ flag_width (~argument : string) (~value : string) : i32 =
    ?= flag_read_of argument value ?|
    | FilterRead (_, used) => used
    | FlagRefused _ => -1i32
    | NotQueryFlag => 0i32

:~ flag_refusal (~argument : string) (~value : string) : string =
    ?= flag_read_of argument value ?|
    | FlagRefused reason => reason
    | _ => ""

:~ query_shown_of (~query : string) : string = filters_text (filters_of_query query 0i32 NoFilters) ""


:= flag_read_shown (read : flag_read) : string =
    ?= read ?|
    | FilterRead (filter, used) =>
        (query_filter_text filter) ++# " used=" ++# ($'std::rc::Rc::<str>::from((!used).to_string().as_str())' : string)
    | FlagRefused reason => reason
    | NotQueryFlag => "-"

///> rust
:# teams_are_tags_or_upper_case_id_prefixes =
    testing.expect (on_team "ops" "CI-A" "ops,deploy") "a tag names the team"
    testing.expect (on_team "ops" "OPS-A" "") "an upper-case ID prefix names the team"
    testing.expect (on_team "ops" "OPSX-A" "" = !-) "the prefix ends at its dash"
    testing.expect (on_team "ops" "CI-A" "devops" = !-) "a tag is a whole item, not a substring"
    testing.expect (on_team "web" "OPS-A" "web" && on_team "ops" "OPS-A" "web") "an item can sit on several teams"
    testing.expect
        (team_word_valid "ops" && team_word_valid "team-2" && team_word_valid "Ops" = !- && team_word_valid "" = !-)
        "team words are lower-case"

///> rust
:# query_flags_read_into_typed_filters =
    testing.expect (flag_read_shown (flag_read_of "--team" "ops") = "team=ops used=2") "team"
    testing.expect (flag_read_shown (flag_read_of "--open" "P1") = "open used=1") "open takes no value"
    testing.expect
        (flag_read_shown (flag_read_of "--team" "Ops") = "--team expects a lower-case team word, got Ops")
        "malformed team"
    testing.expect (flag_read_shown (flag_read_of "Active" "") = "-") "not a query flag"
    testing.expect
        (
            query_usage ()
            = "--team <team>, --tag <tag>, --prefix <ID prefix>, --words <w1,w2>, --open, --ready, --blocked"
        )
        "usage comes from the flag union"
    := filters = FilterThen (OnlyOpen, FilterThen (WithPrefix "OPS-", NoFilters))
    testing.expect (filters_pass filters "OPS-A" "" "" "Active" !+) "open ops item passes"
    testing.expect (filters_pass filters "OPS-A" "" "" "Done" !+ = !-) "done item fails open"
    testing.expect (filters_text filters "" = " prefix=OPS- open") (filters_text filters "")
    testing.expect (query_passes "--team ops --open" "OPS-A" "" "" "Active" !+) "a query text reads back into the same filters"
    testing.expect (query_passes "--team ops --open" "CI-A" "" "" "Active" !+ = !-) "the team filter holds after the round trip"
    testing.expect
        (flag_width "--team" "Ops" = -1i32 && flag_width "--tag" "x" = 2i32 && flag_width "Done" "" = 0i32)
        "flag widths"

///> rust
:# ready_and_blocked_read_settled_dependencies =
    testing.expect (query_passes "--ready" "A" "" "" "Planned" !+) "open with settled dependencies is ready"
    testing.expect (query_passes "--ready" "A" "" "" "Planned" !- = !-) "an open dependency keeps an item from ready"
    testing.expect (query_passes "--ready" "A" "" "" "Done" !+ = !-) "a done item is not ready"
    testing.expect (query_passes "--blocked" "A" "" "" "Active" !-) "open with an open dependency is blocked"
    testing.expect (query_passes "--blocked" "A" "" "" "Blocked" !+) "the Blocked status is blocked"
    testing.expect (query_passes "--blocked" "A" "" "" "Active" !+ = !-) "settled open work is not blocked"
    testing.expect
        (query_reads_deps "--team ops --ready" && query_reads_deps "--open" = !-)
        "only ready and blocked read dependencies"
    testing.expect (query_shown_of "--blocked --team web" = " blocked team=web") (query_shown_of "--blocked --team web")

:= usage_shows_flag (named : bool) (flag : any_flag) : bool =
    := usage = any_usage flag
    named
    && sm'.contains usage (agile_subcommand_domain.subcommand.agile_subcommand_shape "list")
    && sm'.contains usage (agile_subcommand_domain.subcommand.agile_subcommand_shape "next")

///> rust
:# list_and_next_usage_name_every_query_flag =
    testing.expect (each_flag usage_shows_flag !+) "agile list and next usage shapes name every query flag"

///> rust
:# words_match_whole_words_in_titles_and_tags =
    := title = "One record for tree leases: a tree-read window"
    testing.expect
        (query_passes "--words lease,window" "T-1" title "lease,windows" "Active" !+)
        "each word hits the title or a tag"
    testing.expect (query_passes "--words LEASES" "T-1" title "" "Active" !+) "case and punctuation do not matter"
    testing.expect (query_passes "--words lea" "T-1" title "lease" "Active" !+ = !-) "a prefix is not a word"
    testing.expect (query_passes "--words tree,rows" "T-1" title "" "Active" !+ = !-) "one missing word fails the item"
    testing.expect (query_passes "--words record --open" "T-1" title "" "Done" !+ = !-) "words combine with the other filters"
    testing.expect (flag_read_shown (flag_read_of "--words" "a,b") = "words=a,b used=2") "the words flag reads its value"
    testing.expect
        (flag_read_shown (flag_read_of "--words" "") = "--words expects comma-separated words")
        "an empty value is refused"
