:< query

:= main () : i32 =
    !!!!Export("kit_query_flag_width", ((\ (argument, value) => flag_width argument value) : string * string -> i32))
    !!!!Export(
        "kit_query_flag_refusal",
        ((\ (argument, value) => flag_refusal argument value) : string * string -> string)
    )
    !!!!Export(
        "kit_query_passes",
        (
            \ (query, id, title, tags, status, settled) => query_passes query id title tags status settled
            : string * string * string * string * string * bool -> bool
        )
    )
    !!!!Export("kit_query_reads_deps", ((\ query => query_reads_deps query) : string -> bool))
    !!!!Export("kit_query_shown", ((\ query => query_shown_of query) : string -> string))
    !!!!Export("kit_query_usage", ((\ () => query_usage ()) : () -> string))
    := _ = flag_width "--open" ""
    := _ = flag_refusal "--team" "Ops"
    := _ = query_passes "--open" "ID" "" "" "Active" !+
    := _ = query_reads_deps "--ready"
    0i32
