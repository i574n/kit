:< patch_preflight_contract.model

:= main () : i32 =
    ?= patch_preflight_witness_binding 3i32 3i32 ?|
    | 1 =>
        ?= patch_preflight_mode_binding 0i32 1i32 ?|
        | 1 =>
            ?= patch_preflight_check_binding 0i32 0i32 ?|
            | 1 => 0i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
