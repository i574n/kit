///- --package .
test lint static =
    open sm'_operators

open sm'_operators
open file_system_operators
open model

inl skipped_dir (name : string) : bool =
    sm'.starts_with "." name || name = "target" || name = "node_modules" || name = "_build" || name = "deps"
    || name = "bin" || name = "obj"

let entry_names (path : string) : list string =
    file_system.read_dir_names path
    |> resultm.unwrap'
    |> am'.vec_fold' (fun names name => sm'.from_std_string name :: names) []
    |> listm.rev

let rec spi_files (todo : list string) (found : list string) : list string =
    match todo with
    | [] => listm.rev found
    | path :: rest =>
        if file_system.file_exists path then spi_files rest (if sm'.ends_with ".spi" path then path :: found else found)
        elif file_system.directory_exists path then
            inl deeper =
                entry_names path
                |> listm.rev
                |> listm.fold
                    fun ahead (name : string) => if skipped_dir name then ahead else (path </> name) :: ahead
                    rest
            spi_files deeper found
        else spi_files rest found

let relative_to (~root : string) (path : string) : string =
    inl base = sm'.replace "\\" "/" root ++# "/"
    inl slashed = sm'.replace "\\" "/" path
    inl skip : i32 = sm'.length base
    if sm'.starts_with base slashed then sm'.substring skip ((sm'.length slashed : i32) - skip) slashed else slashed

type lint_report =
    {
        rows : list string
        tally : lint_tally
    }

let lint_report (~root : string) (paths : list string) (baseline : list known_violation) : lint_report =
    inl starts = match paths with | [] => [ root ] | _ => paths |> listm.map (fun (path : string) => root </> path)
    inl named = starts |> listm'.filter fun (path : string) => file_system.file_exists path
    inl walked = spi_files (starts |> listm'.filter fun (path : string) => file_system.file_exists path |> not) []
    inl files = listm.fold (fun all path => path :: all) (listm.rev named) walked |> listm.rev
    inl macros, found =
        files
        |> listm.fold
            fun (macros, found) (path : string) =>
                inl read = file_system.read_all_text path
                inl text = if sm'.ends_with ".diff" path || sm'.ends_with ".patch" path then added_text read else read
                inl count : i32 = listm.length (file_macros text)
                inl here = file_violations (relative_to root path) text
                macros + count, listm.fold (fun all item => item :: all) found here
            (0i32, [])
    inl found = listm.rev found
    inl fresh = found |> listm'.filter fun (item : violation) => not (known baseline item)
    inl width = name_width fresh
    inl violations : i32 = listm.length found
    inl tally = { files = listm.length files; macros = macros; violations = violations; fresh = listm.length fresh }
    { rows = listm.map (violation_row width) fresh; tally = tally }

let argument (index : i32) : string = optionm'.default_value "" (env.try_command_line_argument index)

let rec paths_from (index : i32) (count : i32) (found : list string) : list string =
    if count <= index || sm'.starts_with "--" (argument index) then listm.rev found
    else paths_from (index + 1i32) count (argument index :: found)

let rec value_after (~flag : string) (index : i32) (count : i32) : string =
    if count <= index + 1i32 then ""
    elif argument index = flag then argument (index + 1i32)
    else value_after flag (index + 1i32) count

let lint_run () : i32 =
    inl started = eoie_receipt.receipt.now_ms ()
    inl count = env.command_line_argument_count ()
    inl root = argument 2i32
    inl given = value_after "--baseline" 3i32 count
    inl baseline_path = if given = "" || file_system.file_exists given then given else root </> given
    if root = "" || file_system.directory_exists root |> not then
        console.write_error_line "eoie error: lint usage: lint macros <root> [<path>...] [--baseline <rows>]"
        2i32
    elif baseline_path <> "" && file_system.file_exists baseline_path |> not then
        console.write_error_line ("eoie error: lint macros: no baseline file at " ++# given)
        2i32
    else
        inl baseline = if baseline_path = "" then [] else baseline_of (file_system.read_all_text baseline_path)
        inl report = lint_report root (paths_from 3i32 count []) baseline
        report.rows |> listm.iter console.write_line
        inl elapsed = eoie_receipt.receipt.elapsed_text started
        inl clock = eoie_receipt.receipt.clock_text ()
        console.write_line (tally_head report.tally ++# "  " ++# elapsed ++# "  " ++# clock)
        if report.tally.fresh = 0i32 then 0i32 else 1i32

///> rust
test the_sample_tree_reports_its_three_rows =
    inl root = file_system.get_temp_path () </> "eoie-lint-macros-sample"
    inl _ = file_system.create_dir_all (root </> "lib")
    file_system.write_all_text (root </> "lib" </> "sample.spi") (sample ())
    inl report = lint_report root [ "lib" ] []
    expect ((listm.length report.rows : i32) = 3i32) "three rows"
    expect (tally_head report.tally = "failed  files 1  macros 5  violations 3  new 3") "tally"
    inl known_two = baseline_of "lib/sample.spi:9  widen  cast\nlib/sample.spi:9  pick  flow\n"
    inl quieter = lint_report root [ "lib" ] known_two
    expect (tally_head quieter.tally = "failed  files 1  macros 5  violations 3  new 1") "baseline"
