:! series_idle = ()
:! series_validated = ()
:! series_appended = ()
:! series_typechecked = ()

:| series_kind =
    | RatingSeries
    | BenchmarkSeries

:| series_op from to =
    | ValidateSeriesSources :: series_op series_idle series_validated
    | AppendSeriesRecord :: series_op series_validated series_appended
    | TypecheckSeriesHistory :: series_op series_appended series_typechecked

:| ^ series_plan from to =
    | SeriesStep :: \* from to. series_op from to -> series_plan from to
    | SeriesThen :: \* from to. (\? middle. series_plan from middle * series_plan middle to) -> series_plan from to

:= append_only_series_plan () : series_plan series_idle series_typechecked =
    SeriesThen (\? (
        SeriesStep ValidateSeriesSources,
        SeriesThen (\? (SeriesStep AppendSeriesRecord, SeriesStep TypecheckSeriesHistory))
    ))

:~ series_sequence_binding (previous : i32) (next : i32) : i32 =
    ? previous < 0i32 ?> 0i32
    |? previous + 1i32 = next ?> 1i32
    |: 0i32

:~ series_source_binding (path_length : i32) (packed_shape : i32) : i32 =
    ? path_length < 1i32 ?> 0i32
    |? packed_shape = 32i32 ?> 1i32
    |: 0i32

:~ series_pair_binding (ratings_present : i32) (bench_present : i32) : i32 =
    ? ratings_present = 1i32 ?>
        ? bench_present = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:~ series_monotonic_binding (previous : i32) (next : i32) : i32 =
    ? previous < 0i32 ?> 0i32
    |? next < previous ?> 0i32
    |: 1i32

:~ series_fingerprint_binding (ratings_nonzero : i32) (bench_nonzero : i32) : i32 =
    ? ratings_nonzero = 1i32 ?>
        ? bench_nonzero = 1i32 ?> 1i32 |: 0i32
    |: 0i32
