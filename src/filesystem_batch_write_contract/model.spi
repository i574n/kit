:! batch_write_raw = ()
:! batch_write_validated = ()
:! batch_write_staged = ()
:! batch_write_verified = ()
:! batch_write_committed = ()
:! batch_write_rolled_back = ()

:| batch_write_kind =
    | CreateKind
    | ReplaceKind

:| batch_write_operation =
    | BatchCreate : string * string
    | BatchReplace : string * string * string

:| batch_write_transition from to =
    | ValidateBatch :: batch_write_transition batch_write_raw batch_write_validated
    | StageBatch :: batch_write_transition batch_write_validated batch_write_staged
    | VerifyBatch :: batch_write_transition batch_write_staged batch_write_verified
    | CommitBatch :: batch_write_transition batch_write_verified batch_write_committed

:| ^ batch_write_plan from to =
    | BatchWriteStep :: \* from to. batch_write_transition from to -> batch_write_plan from to
    | BatchWriteThen :: \* from to.
        (\? middle. batch_write_plan from middle * batch_write_plan middle to) ->
        batch_write_plan from to

:= public_plan () : batch_write_plan batch_write_raw batch_write_committed =
    BatchWriteThen (\? (
        BatchWriteStep ValidateBatch,
        BatchWriteThen (\? (
            BatchWriteStep StageBatch,
            BatchWriteThen (\? (
                BatchWriteStep VerifyBatch,
                BatchWriteStep CommitBatch
            ))
        ))
    ))
