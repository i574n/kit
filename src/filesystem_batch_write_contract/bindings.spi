:< model

:~ batch_write_shape_binding (row_count : i32) (problem_count : i32) : i32 =
    ? row_count < 1i32 ?> 0i32
    |? problem_count < 0i32 ?> 0i32
    |? 0i32 < problem_count ?> 0i32
    |: 1i32

:~ batch_write_freshness_binding (kind_code : i32) (expected_ok : i32) : i32 =
    ? kind_code < 0i32 ?> 0i32
    |? 1i32 < kind_code ?> 0i32
    |? expected_ok < 1i32 ?> 0i32
    |: 1i32

:~ batch_write_stage_binding (row_count : i32) (staged_count : i32) : i32 =
    ? row_count < 1i32 ?> 0i32
    |? staged_count < row_count ?> 0i32
    |? row_count < staged_count ?> 0i32
    |: 1i32

:~ batch_write_verify_binding (row_count : i32) (verified_count : i32) : i32 =
    ? row_count < 1i32 ?> 0i32
    |? verified_count < row_count ?> 0i32
    |? row_count < verified_count ?> 0i32
    |: 1i32

:~ batch_write_rollback_binding (row_count : i32) (restored_count : i32) : i32 =
    ? row_count < 1i32 ?> 0i32
    |? restored_count < row_count ?> 0i32
    |? row_count < restored_count ?> 0i32
    |: 1i32
