:< sm'_operators
:< kit_table_sequence_args.args

:| measure_request =
    | IntervalOf : string * string * u64
    | WindowOf : string * string * u64 * u64
    | OrderOf : string * string
    | LatencyOf : string * string

:== sequence_request =
    {
        name : string
        time : string
        measure : measure_request
    }

:= roles_of (measure : measure_request) : string * string =
    ?= measure ?|
    | IntervalOf (marked, between, _) => marked, between
    | WindowOf (counted, marker, _, _) => counted, marker
    | OrderOf (first, second) => first, second
    | LatencyOf (starting, ending) => starting, ending

:= measured_text (~file : string) (~events : string) (measure : measure_request) : string =
    ?= measure ?|
    | IntervalOf (_, between, modulo) =>
        := second = ? between = "" ?> "" |: "second"
        $'kit_log_sequences::kit_sequence_interval(&*!file, &*!events, "first", &*!second, !modulo)' : string
    | WindowOf (_, _, low, high) => $'kit_log_sequences::kit_sequence_window(&*!file, &*!events, "first", "second", \
        !low, !high)' : string
    | OrderOf _ => $'kit_log_sequences::kit_sequence_order(&*!file, &*!events, "first", "second")' : string
    | LatencyOf _ => $'kit_log_sequences::kit_sequence_latency(&*!file, &*!events, "first", "second")' : string

:~ file_table_of (~path : string) (request : sequence_request) : file_table =
    := first, second = roles_of request.measure
    := log = file_system.read_all_text path
    := time = request.time
    := events = $'kit_log_sequences::kit_sequence_events(&*!log, &*!time, &*!first, &*!second)' : string
    data_rows (sm'.split "\n" (measured_text path events request.measure) |> array) 0i32 { text = ""; rows = 0u64 }

:~ measure_from (words : list string) : string * option measure_request =
    := interval = value_after (flag_word FlagInterval) words
    := window = value_after (flag_word FlagWindow) words
    := order = value_after (flag_word FlagOrder) words
    := latency = value_after (flag_word FlagLatency) words
    ? interval <> ""
    ?>
        := name, pattern = split_pair interval "="
        name,
        Some (IntervalOf (pattern, value_after (flag_word FlagBetween) words, decimal (value_after (flag_word FlagModulo) words)))
    |? window <> ""
    ?>
        := name, pattern = split_pair window "="
        := marker = value_after (flag_word FlagFrom) words
        := low, high = split_pair (value_after (flag_word FlagMs) words) ".."
        name, (? marker = "" ?> None |: Some (WindowOf (pattern, marker, decimal low, decimal high)))
    |? order <> ""
    ?>
        := name, pattern = split_pair order "="
        := first, second = split_pair pattern ","
        name, (? second = "" ?> None |: Some (OrderOf (first, second)))
    |? latency <> ""
    ?>
        := name, pattern = split_pair latency "="
        := ending = value_after (flag_word FlagTo) words
        name, (? ending = "" ?> None |: Some (LatencyOf (pattern, ending)))
    |: "", None

:~ ^ tables_of (files : list string) (request : sequence_request) (acc : file_table) : file_table =
    ?= files ?|
    | [] => acc
    | path :: rest =>
        := found = file_table_of path request
        tables_of rest request { text = acc.text ++# found.text; rows = acc.rows + found.rows }

:~ table_written (~name : string) (~out : string) (files : list string) (found : file_table) : i32 =
    := table = "file\tline\t" ++# name ++# "\n" ++# found.text
    := receipt =
        "kit table sequences ok files=" ++# sm'.format (listm.length files : i32) ++# " rows=" ++# sm'.format found.rows
    ? out = "" ?>
        console.write_line (sm'.trim_end_suffix "\n" table)
        console.write_error_line receipt
    |:
        file_system.write_all_text out table
        console.write_error_line (receipt ++# " out=" ++# out)
    0i32

:~ measures_run () : i32 =
    := words = sequence_words ()
    := paths, refusal = paths_from words [] ""
    := name, measure = measure_from words
    := time = value_after (flag_word FlagTime) words
    ? refusal <> ""
    ?> refused refusal
    |:
        ?= measure ?|
        | None => refused "needs one measure with both its patterns"
        | Some measure =>
            ? time = "" || name = ""
            ?> refused "needs --time and a measure name"
            |:
                ?= paths ?|
                | [] => refused "needs at least one file or directory"
                | _ =>
                    := missing = missing_path paths
                    ? missing <> ""
                    ?> refused ("no such file or directory: " ++# missing)
                    |:
                        := files = files_in paths []
                        := request = { name = name; time = time; measure = measure }
                        table_written name
                            (value_after (flag_word FlagOut) words)
                            files
                            (tables_of files request { text = ""; rows = 0u64 })

:= main () : i32 =
    export "kit_table_sequence_measures_run" ((\ () => measures_run ()) : () -> i32)
    0i32
