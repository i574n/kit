///- --package .
:# ranking static =
    :< rust_std_string.model
    :< workspace_primitives.bytes

:< workspace_primitives.bytes

:| rank_role =
    | MainAgent
    | Subagent

:== backlog_task =
    {
        id : string
        title : string
        priority : i32
        difficulty : i32
        status : string
        deps : string
        tags : string
        estimate : i32
        progress : i32
    }

:| ^ task_list =
    | NoTasks
    | TaskThen : backlog_task * task_list

:== ranked_task =
    {
        id : string
        title : string
        priority : i32
        difficulty : i32
        minutes : i32
        estimated : bool
        unblocks : i32
        key : i32
    }

:| ^ ranked_list =
    | NoRanked
    | RankedThen : ranked_task * ranked_list

:= rank_role_word = \|
    | MainAgent => "main"
    | Subagent => "subagent"

:= level_of (~token : string) : i32 =
    $'(!token).get(1..).and_then(|digits| digits.parse::<i32>().ok()).unwrap_or(9)' : i32

:= priority_weight (priority : i32) : i32 = $'1i32 << (2 * (5 - (!priority).clamp(0, 5)))' : i32

:= fallback_minutes (difficulty : i32) : i32 =
    ?= difficulty ?|
    | 0i32 => 15i32
    | 1i32 => 30i32
    | 2i32 => 60i32
    | 3i32 => 180i32
    | 4i32 => 300i32
    | 5i32 => 600i32
    | 6i32 => 1200i32
    | 7i32 => 2400i32
    | _ => 3600i32

:= remaining_share (minutes : i32) (progress : i32) : i32 = $'((!minutes as i64) * (100 - (!progress).clamp(0, \
    100)) as i64 / 100).max(15) as i32' : i32

:= task_minutes (task : backlog_task) : i32 =
    ? 0i32 < task.estimate ?> task.estimate |: remaining_share (fallback_minutes task.difficulty) task.progress

:~ task_open (task : backlog_task) : bool =
    union_reflection.cases.union_case_where
        \ (status : agile_mutation_policy.model.agile_status) =>
            task.status = agile_mutation_policy.model.agile_case_text status
        agile_mutation_policy.model.agile_status_open
        !-

:= listed_in (~items : string) (~item : string) : bool =
    rust_std_string.model.pipe_member
        (rust_std_string.model.replace (rust_std_string.model.replace items ", " "|") "," "|")
        item

:= query_passes (~query : string) (~id : string) (~title : string) (~tags : string) (~status : string) : bool =
    ? query = ""
    ?> !+
    |: $'agile_task_query::kit_query_passes(&*!query, &*!id, &*!title, &*!tags, &*!status, true)' : bool

:= task_passes (query : string) (task : backlog_task) : bool =
    query_passes query task.id task.title task.tags task.status

:~ ^ status_of (tasks : task_list) (~id : string) : string =
    ?= tasks ?|
    | NoTasks => ""
    | TaskThen (task, rest) => ? task.id = id ?> task.status |: status_of rest id

:~ ^ deps_settled (tasks : task_list) (~deps : string) (offset : i32) : bool =
    ? byte_len deps <= offset ?> !+
    |:
        := comma = byte_find_from deps "," offset
        := stop = ? comma < 0i32 ?> byte_len deps |: comma
        := status = status_of tasks (rust_std_string.model.trim (byte_slice deps offset stop))
        ? status = "" || status = "Done" ?> deps_settled tasks deps (stop + 1i32) |: !-

:~ ^ open_deps (tasks : task_list) (~deps : string) (offset : i32) (count : i32) : i32 =
    ? byte_len deps <= offset ?> count
    |:
        := comma = byte_find_from deps "," offset
        := stop = ? comma < 0i32 ?> byte_len deps |: comma
        := status = status_of tasks (rust_std_string.model.trim (byte_slice deps offset stop))
        open_deps tasks deps (stop + 1i32) (? status = "" || status = "Done" ?> count |: count + 1i32)

:~ ^ unblocked_weight (tasks : task_list) (~id : string) (sum : i32) : i32 =
    ?= tasks ?|
    | NoTasks => sum
    | TaskThen (task, rest) =>
        := gained =
            ? task_open task && listed_in task.deps id ?>
                := waiting = open_deps tasks task.deps 0i32 0i32
                priority_weight task.priority / (? waiting < 1i32 ?> 1i32 |: waiting)
            |: 0i32
        unblocked_weight rest id (sum + gained)

:= rank_key (role : rank_role) (weight : i32) (minutes : i32) (priority : i32) : i32 =
    ?= role ?|
    | MainAgent => $'((!weight as i64) * 6000 / (!minutes).max(1) as i64).min(i32::MAX as i64) as i32' : i32
    | Subagent => minutes * 8i32 + 5i32 - priority

:~ ranked_of (role : rank_role) (tasks : task_list) (task : backlog_task) : ranked_task =
    := minutes = task_minutes task
    := unblocks = unblocked_weight tasks task.id 0i32
    {
        id = task.id
        title = task.title
        priority = task.priority
        difficulty = task.difficulty
        minutes = minutes
        estimated = 0i32 < task.estimate
        unblocks = unblocks
        key = rank_key role (priority_weight task.priority + unblocks) minutes task.priority
    }

:= candidate (passes : backlog_task -> bool) (tasks : task_list) (task : backlog_task) : bool =
    task_open task && deps_settled tasks task.deps 0i32 && passes task

:~ ^ inserted (item : ranked_task) (list : ranked_list) : ranked_list =
    ?= list ?|
    | NoRanked => RankedThen (item, NoRanked)
    | RankedThen (head, rest) =>
        ? head.key < item.key ?> RankedThen (item, list) |: RankedThen (head, inserted item rest)

:~ ^ ranked_from
    (role : rank_role) (passes : backlog_task -> bool) (tasks : task_list) (remaining : task_list) (list : ranked_list)
    : ranked_list
    =
    ?= remaining ?|
    | NoTasks => list
    | TaskThen (task, rest) =>
        ? candidate passes tasks task ?> ranked_from role passes tasks rest (inserted (ranked_of role tasks task) list)
        |: ranked_from role passes tasks rest list

:= ranking_where (role : rank_role) (passes : backlog_task -> bool) (tasks : task_list) : ranked_list =
    ranked_from role passes tasks tasks NoRanked

:= ranking (role : rank_role) (tasks : task_list) : ranked_list = ranking_where role (\ _ => !+) tasks

:= ranking_filtered (role : rank_role) (filters : string) (tasks : task_list) : ranked_list =
    ranking_where role (\ task => task_passes filters task) tasks

:~ ^ ranked_ids (list : ranked_list) : string =
    ?= list ?|
    | NoRanked => ""
    | RankedThen (head, NoRanked) => head.id
    | RankedThen (head, rest) => rust_std_string.model.concat5 head.id " " (ranked_ids rest) "" ""


:= task_at
    (~id : string) (priority : i32) (difficulty : i32) (~status : string) (~deps : string) (~tags : string)
    (estimate : i32)
    : backlog_task
    =
    {
        id = id
        title = id
        priority = priority
        difficulty = difficulty
        status = status
        deps = deps
        tags = tags
        estimate = estimate
        progress = 0i32
    }

:= sample_backlog () : task_list =
    TaskThen (task_at "BIG-P0" 0i32 8i32 "Active" "" "" 0i32,
        TaskThen (task_at "SMALL-P2" 2i32 2i32 "Planned" "" "" 0i32,
            TaskThen (task_at "WAITS" 1i32 2i32 "Planned" "GATE" "" 0i32,
                TaskThen (task_at "GATE" 3i32 3i32 "Active" "" "" 0i32,
                    TaskThen (task_at "KIT-SIDE" 1i32 4i32 "Planned" "" "kit,agile" 0i32,
                        TaskThen (task_at "SHIPPED" 0i32 1i32 "Done" "" "" 0i32,
                            TaskThen (task_at "PARKED" 0i32 1i32 "Paused" "" "" 0i32, NoTasks)))))))

///> rust
:# priorities_weigh_four_times_per_step_and_estimates_fall_back_to_difficulty =
    testing.expect (priority_weight 0i32 = 1024i32) "P0"
    testing.expect (priority_weight 2i32 = 64i32) "P2"
    testing.expect (priority_weight 5i32 = 1i32) "P5"
    testing.expect (level_of "D6" = 6i32) "difficulty token"
    testing.expect (task_minutes (task_at "A" 0i32 6i32 "Active" "" "" 0i32) = 1200i32) "difficulty fallback"
    testing.expect (task_minutes (task_at "A" 0i32 6i32 "Active" "" "" 45i32) = 45i32) "estimate wins"

///> rust
:# main_ranks_ready_open_items_by_weight_over_duration =
    := tasks = sample_backlog ()
    testing.expect
        (ranked_ids (ranking MainAgent tasks) = "GATE SMALL-P2 KIT-SIDE BIG-P0")
        (ranked_ids (ranking MainAgent tasks))
    testing.expect (deps_settled tasks "GATE" 0i32 = !-) "an open dependency blocks"
    testing.expect (deps_settled tasks "SHIPPED, MISSING" 0i32) "done and unknown dependencies do not block"
    testing.expect (unblocked_weight tasks "GATE" 0i32 = 256i32) "GATE unblocks a P1"

///> rust
:# an_epic_shares_its_weight_across_the_open_items_it_waits_on =
    := tasks =
        TaskThen (task_at "EPIC" 1i32 7i32 "Planned" "A,B,C,D,DONE" "" 0i32,
            TaskThen (task_at "A" 4i32 2i32 "Planned" "" "" 0i32, TaskThen (task_at "B" 1i32 2i32 "Active" "" "" 0i32,
            TaskThen (task_at "C" 1i32 2i32 "Planned" "" "" 0i32, TaskThen (task_at "D" 1i32 2i32 "Planned" "" "" 0i32,
            TaskThen (task_at "DONE" 1i32 1i32 "Done" "" "" 0i32, NoTasks))))))
    testing.expect (open_deps tasks "A,B,C,D,DONE" 0i32 0i32 = 4i32) "four open, one done"
    testing.expect (unblocked_weight tasks "A" 0i32 = 64i32) "a P1 epic waiting on four open items gives each a quarter"

///> rust
:# subagents_take_the_longest_items_first =
    := elsewhere = \ (task : backlog_task) => rust_std_string.model.starts_with task.id "KIT-" = !-
    testing.expect (ranked_ids (ranking_where Subagent elsewhere (sample_backlog ())) = "BIG-P0 GATE SMALL-P2") (ranked_ids (
        ranking_where Subagent elsewhere (sample_backlog ())))

///> rust
:# teams_filter_the_ranking_and_progress_shrinks_the_fallback_estimate =
    := tasks = sample_backlog ()
    testing.expect
        (
            ranked_ids (ranking_where MainAgent (\ task => rust_std_string.model.starts_with task.id "KIT-") tasks)
            = "KIT-SIDE"
        )
        "a predicate narrows the ranking"
    testing.expect
        (
            ranked_ids (ranking_where MainAgent (\ task => rust_std_string.model.starts_with task.id "SMALL") tasks)
            = "SMALL-P2"
        )
        "prefix predicate"

    := half = task_at "HALF" 1i32 6i32 "Active" "" "" 0i32
    := nearly = task_at "NEARLY" 1i32 1i32 "Active" "" "" 0i32
    := set = task_at "SET" 1i32 6i32 "Active" "" "" 45i32
    testing.expect (task_minutes { half ?| progress = 50i32 } = 600i32) "half done halves the difficulty fallback"
    testing.expect (task_minutes { nearly ?| progress = 99i32 } = 15i32) "never below 15 minutes"
    testing.expect (task_minutes { set ?| progress = 90i32 } = 45i32) "an explicit estimate is already the remaining time"
