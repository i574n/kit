:< rust_std_fs.model
:< agile_task_text.model
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< workspace_primitives.clock
:< workspace_primitives.console
:< workspace_primitives.files
:< ranking
:< sm'_operators

:= planned_load_selected (~text : string) (~id : string) (~load : string) : bool =
    $'agile_planning_filters::kit_agile_planning_selected(&*!text, &*!id, &*!load, "all")' : bool

:~ load_words (~loads : string) : array string = sm'.split "," loads |> array

:~ ^ loads_pass (~text : string) (~id : string) (words : array string) (at : i32) : bool =
    ? am'.length words <= at ?> !-
    |? planned_load_selected text id (am'.index at words) ?> !+
    |: loads_pass text id words (at + 1i32)
:= argument_owned index : string = rust_std_env.model.argument_owned index
:= unquoted (~token : string) : string = byte_slice token 1i32 (byte_len token - 1i32)
:= padded (~text : string) (width : i32) : string =
    $'{ let text = !text; let filler = (!width as usize).saturating_sub(text.chars().count()); \
        std::rc::Rc::<str>::from(text.to_string() + &" ".repeat(filler)) }' : string
:= right_aligned (~text : string) (width : i32) : string =
    $'{ let text = !text; let filler = (!width as usize).saturating_sub(text.chars().count()); \
        std::rc::Rc::<str>::from(" ".repeat(filler) + &*text) }' : string
:= clipped (~text : string) (width : i32) : string =
    $'{ let text = !text; if text.chars().count() <= !width as usize { text } else { \
        std::rc::Rc::<str>::from(text.chars().take((!width as usize).saturating_sub(3)).collect::<String>() + "...") \
        } }' : string

:= progress_of (~token : string) : i32 = $'(!token).trim().trim_end_matches("u32").parse::<i32>().unwrap_or(0)' : i32

:~ backlog_task_at (text : string) (arguments : i32) (length : i32) : backlog_task =
    := field = tuple_field text arguments length
    := id = unquoted (field 0i32)
    {
        id = id
        title = unquoted (field 1i32)
        priority = level_of (field 3i32)
        difficulty = level_of (field 4i32)
        status = field 6i32
        deps = unquoted (field 7i32)
        tags = unquoted (field 8i32)
        estimate = $'agile_planning_fields::kit_agile_planning_minutes_near(&*!text, &*!id, !arguments)' : i32
        progress = progress_of (field 5i32)
    }

:~ ^ tasks_from (text : string) (offset : i32) (length : i32) (tasks : task_list) : task_list =
    := found = byte_find_from text (task_marker ()) offset
    ? found < 0i32
    ?> tasks
    |:
        := arguments = (found + (task_arguments_offset ()))
        ? declared_task text found
        ?> tasks_from text arguments length (TaskThen (backlog_task_at text arguments length, tasks))
        |: tasks_from text arguments length tasks

:~ ranked_line (role : rank_role) (rank : i32) (item : ranked_task) : string =
    := minutes = rust_std_string.model.concat5 (i32_text item.minutes) "m" (? item.estimated ?> " " |: "~") "" ""
    := score =
        ?= role ?|
        | MainAgent => rust_std_string.model.concat5 "  wsjf=" (padded (i32_text item.key) 7i32) "" "" ""
        | Subagent => ""
    := head =
        rust_std_string.model.concat5
            (right_aligned (i32_text rank) 3i32)
            "  "
            (padded item.id 28i32)
            " P"
            (i32_text item.priority)
    := middle = rust_std_string.model.concat5 " D" (i32_text item.difficulty) "  " (right_aligned minutes 7i32) score
    rust_std_string.model.concat5 head middle
        "  unblocks="
        (padded (i32_text item.unblocks) 5i32)
        (rust_std_string.model.concat5 "  " (clipped item.title 72i32) "" "" "")

:~ ^ printed (role : rank_role) (list : ranked_list) (rank : i32) (limit : i32) : i32 =
    ?= list ?|
    | NoRanked => rank - 1i32
    | RankedThen (head, rest) =>
        ? limit < rank ?> rank - 1i32
        |:
            := _ = stdout_line (ranked_line role rank head)
            printed role rest (rank + 1i32) limit

:~ ^ ranked_count (list : ranked_list) (counted : i32) : i32 =
    ?= list ?|
    | NoRanked => counted
    | RankedThen (_, rest) => ranked_count rest (counted + 1i32)

:| next_format =
    | NextText
    | NextJson

:== next_request =
    {
        role : rank_role
        limit : i32
        filters : string
        load : string
        format : next_format
    }

:~ ranked_json (rank : i32) (item : ranked_task) : string =
    := head = rust_std_string.model.concat5 "{\"rank\":" (i32_text rank) ",\"id\":\"" item.id "\""
    := middle =
        rust_std_string.model.concat5
            ",\"priority\":"
            (i32_text item.priority)
            ",\"difficulty\":"
            (i32_text item.difficulty)
            (
                rust_std_string.model.concat5
                    ",\"minutes\":"
                    (i32_text item.minutes)
                    ",\"estimated\":"
                    (? item.estimated ?> "true" |: "false")
                    ""
            )
    rust_std_string.model.concat5 head middle
        ",\"wsjf\":"
        (i32_text item.key)
        (rust_std_string.model.concat5 ",\"unblocks\":" (i32_text item.unblocks) ",\"title\":\"" item.title "\"}")

:~ ^ json_items (list : ranked_list) (rank : i32) (limit : i32) (~items : string) : string * i32 =
    ?= list ?|
    | NoRanked => items, rank - 1i32
    | RankedThen (head, rest) =>
        ? limit < rank
        ?> items, rank - 1i32
        |:
            json_items rest
                (rank + 1i32)
                limit
                (
                    ? items = ""
                    ?> ranked_json rank head
                    |: rust_std_string.model.concat5 items "," (ranked_json rank head) "" ""
                )

:= next_failure (~reason : string) : i32 =
    stderr_failure (rust_std_string.model.concat5 "agile next rejected: " reason "" "" "")

:~ agile_next (~root : string) (request : next_request) : i32 =
    := role = request.role
    := limit = request.limit
    := started = unix_ms ()
    ?= probe (unchecked (backlog_state_path root)) ?|
    | FileMissing _ => next_failure "state/agile.spi is missing"
    | FileReadable file =>
        := text = records_text (loaded_string (read_text file))
        := length = byte_len text
        := malformed = first_malformed_task text 0i32 length
        ? malformed < 0i32
        ?>
            := list =
                ranking_where role
                    \ task => task_passes request.filters task && loads_pass text task.id (load_words request.load) 0i32
                    (tasks_from text 0i32 length NoTasks)
            ?= request.format ?|
            | NextJson =>
                := items, shown = json_items list 1i32 limit ""
                stdout_line (
                    rust_std_string.model.concat5
                        "{\"role\":\""
                        (rank_role_word role)
                        "\",\"ready\":"
                        (i32_text (ranked_count list 0i32))
                        (rust_std_string.model.concat5 ",\"shown\":" (i32_text shown) ",\"items\":[" items "]}")
                )
            | NextText =>
                := shown = printed role list 1i32 limit
                := ready =
                    rust_std_string.model.concat5
                        " ready="
                        (i32_text (ranked_count list 0i32))
                        " shown="
                        (i32_text shown)
                        ""
                    ++# (? request.load = "all" ?> "" |: " load=" ++# request.load)
                stdout_line (
                    rust_std_string.model.concat5 "kit agile next ok role=" (rank_role_word role) ready " elapsed_ms=" (
                    u64_text (ms_since started)))
        |: next_failure (rust_std_string.model.concat5 "malformed Task fields at byte " (i32_text malformed) "" "" "")

:~ agile_next_entry () : i32 =
    := parsed, reason, role, limit, filters, load, json =
        $'kit_agile_next_args::kit_agile_next_request()' : bool * string * string * i32 * string * string * bool
    ? parsed
    ?>
        := request =
            {
                role = (? role = "subagent" ?> Subagent |: MainAgent)
                limit = limit
                filters = filters
                load = load
                format = (? json ?> NextJson |: NextText)
            }
        agile_next (argument_owned 1i32) request
    |: next_failure reason
:= main () : i32 =
    !!!!Export("kit_agile_next_run", ((\ () => agile_next_entry ()) : () -> i32))
    := _ = agile_next_entry ()
    0i32
