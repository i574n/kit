///- --package ../kit_cli_check --timeout 900000
:< cli

:= quoted (~text : string) : string = $'std::rc::Rc::<str>::from(format\!("{}{}{}", char::from(34u8), &*!text, \
    char::from(34u8)).as_str())' : string

:= task_row
    (~id : string) (~priority : string) (~difficulty : string) (~status : string) (~deps : string) (~tags : string)
    : string
    =
    $'std::rc::Rc::<str>::from(format\!("inl task_{0} () = Task ({1}{0}{1}, {1}title of {0}{1}, Story, {2}, {3}, \
        0u32, {4}, {1}{5}{1}, {1}{6}{1}, {1}current{1}, {1}current{1})\n", &*!id, char::from(34u8), &*!priority, \
        &*!difficulty, &*!status, &*!deps, &*!tags).as_str())' : string
:= small_planning () : string =
    cat (cat "inl planning_of_small () = Planning (" (quoted "SMALL")) ", Minutes 600u32, LoadUnset, Unassigned)\n"

:= backlog_root () : fixture_root =
    := root = fixture_root_create "agile next"
    := rows =
        cat
            (
                cat
                    (
                        cat
                            (task_row "BIG" "P0" "D8" "Active" "" "")
                            (cat (task_row "SMALL" "P2" "D2" "Planned" "" "") (small_planning ()))
                    )
                    (cat (task_row "WAITS" "P1" "D2" "Planned" "GATE" "") (task_row "GATE" "P3" "D3" "Active" "" ""))
            )
            (cat (task_row "OPS-SIDE" "P1" "D4" "Planned" "" "ops") (task_row "SHIPPED" "P0" "D1" "Done" "" ""))
    fixture_write root "state/agile.spi" rows
    root

:= next_run (root : fixture_root) (args : cli_args) : cli_run =
    kit_run (fixture_text_of root) NoArgs NoArgs (Arg ("agile", Arg ("next", Arg (fixture_text_of root, args))))

:= ranked_word (~stdout : string) (~rank : string) : string =
    word_after (line_starting stdout (cat (padded "" (3i32 - byte_count rank)) rank)) (cat rank "  ")

///> rust
:# main_ranks_ready_items_by_wsjf_and_marks_fallback_durations =
    := root = backlog_root ()
    := out = succeeded (next_run root NoArgs)
    same (ranked_word out "1") "GATE"
    same (ranked_word out "2") "OPS-SIDE"
    same (ranked_word out "3") "BIG"
    same (ranked_word out "4") "SMALL"
    shows (line_starting out "  1") "180m~"
    shows (line_starting out "  1") "unblocks=256"
    shows (line_starting out "  4") "600m "
    hides out "WAITS"
    hides out "SHIPPED"
    shows out "kit agile next ok role=main ready=4 shown=4 elapsed_ms="
    fixture_root_remove root

///> rust
:# subagents_get_the_longest_items_first_and_a_count_limits_the_list =
    := root = backlog_root ()
    := out = succeeded (next_run root (Arg ("--as", Arg ("subagent", Arg ("2", NoArgs)))))
    same (ranked_word out "1") "BIG"
    same (ranked_word out "2") "SMALL"
    hides out "OPS-SIDE"
    hides out "wsjf="
    shows out "kit agile next ok role=subagent ready=4 shown=2 elapsed_ms="
    := team = succeeded (next_run root (Arg ("--as", Arg ("subagent", Arg ("--team", Arg ("ops", NoArgs))))))
    same (ranked_word team "1") "OPS-SIDE"
    shows team "kit agile next ok role=subagent ready=1 shown=1 elapsed_ms="
    rejected_with
        (next_run root (Arg ("--as", Arg ("boss", NoArgs))))
        2i32
        "agile next rejected: --as expects main or subagent, got boss"
    rejected_with (next_run root (Arg ("zero", NoArgs))) 2i32 "agile next rejected: unexpected argument zero"
    fixture_root_remove root

///> rust
:# teams_and_prefixes_filter_the_ranking_and_json_carries_the_ranks =
    := root = backlog_root ()
    := json = succeeded (next_run root (Arg ("--team", Arg ("ops", Arg ("--json", NoArgs)))))
    shows json "{\"role\":\"main\",\"ready\":1,\"shown\":1,\"items\":[{\"rank\":1,\"id\":\"OPS-SIDE\""
    shows json "\"wsjf\":"
    hides json "\"id\":\"GATE\""
    := prefixed = succeeded (next_run root (Arg ("--prefix", Arg ("SM", NoArgs))))
    same (ranked_word prefixed "1") "SMALL"
    shows prefixed "ready=1 shown=1"
    rejected_with
        (next_run root (Arg ("--team", Arg ("Ops", NoArgs))))
        2i32
        "agile next rejected: --team expects a lower-case team word, got Ops"
    fixture_root_remove root

///> rust
:# a_flag_in_the_root_slot_is_refused_with_the_verbs_usage =
    := root = backlog_root ()
    := run =
        kit_run (fixture_text_of root) NoArgs NoArgs (Arg ("agile", Arg ("next", Arg ("--team", Arg ("ops", NoArgs)))))
    rejected_with run 2i32 "agile next takes <root> before any flag, got --team; usage: agile next <root>"
    fixture_root_remove root

///> rust
:# load_keeps_only_items_whose_planned_load_matches =
    := root = fixture_root_create "agile next load"
    := tasks = cat (task_row "LIGHT" "P1" "D2" "Active" "" "") (task_row "HEAVYONE" "P0" "D2" "Active" "" "")
    := light_plan =
        cat (cat "inl planning_of_light () = Planning (" (quoted "LIGHT")) ", Minutes 60u32, Load Light, Unassigned)\n"
    := heavy_plan =
        cat
            (cat "inl planning_of_heavyone () = Planning (" (quoted "HEAVYONE"))
            ", Minutes 60u32, Load Heavy, Unassigned)\n"
    fixture_write root "state/agile.spi" (cat tasks (cat light_plan heavy_plan))
    := light = succeeded (next_run root (Arg ("--load", Arg ("light", NoArgs))))
    shows light "LIGHT"
    hides light "HEAVYONE"
    shows light "ready=1 shown=1"
    := both = succeeded (next_run root (Arg ("--load", Arg ("light,heavy", NoArgs))))
    shows both "HEAVYONE"
    shows both "ready=2"
    rejected_with
        (next_run root (Arg ("--load", Arg ("huge", NoArgs))))
        2i32
        "agile next rejected: --load expects light, medium, heavy or none"
    fixture_root_remove root

///> rust
:# fits_ranks_what_the_machine_admits_now_and_names_it =
    := root = backlog_root ()
    := out = succeeded (next_run root (Arg ("--fits", NoArgs)))
    shows out " load=light,none"
    fixture_root_remove root
