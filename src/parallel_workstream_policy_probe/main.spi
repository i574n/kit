:< parallel_workstream_contract.model

:! proof_baseline = ()

:= physical_group_failure_cancel () : i32 =
    := started = rust_std_process.model.wall_clock_millis ()
    := word = rust_std_process.model.trigger_then_kill_group2_word1 "/bin/sleep" "5" "/usr/bin/test" "" "/bin/kill" "--"
    := elapsed = rust_std_process.model.elapsed_millis started
    := trigger = rust_std_process.model.fail_trigger_group2_trigger_code word
    := cancelled = rust_std_process.model.fail_trigger_group2_cancelled word
    := kill_sent = rust_std_process.model.fail_trigger_group2_kill_sent word
    := completion = workstream_completion_binding 3i32 3i32 0i32 1i32 cancelled 3i32
    := no_merge = workstream_failure_binding 0i32 1i32 cancelled 0i32
    ? trigger = 1i32 ?>
        ? cancelled = 2i32 ?>
            ? kill_sent = 1i32 ?>
                ? completion = 1i32 ?>
                    ? no_merge = 1i32 ?>
                        ? elapsed < 1000u64 ?> 1i32 |: 0i32
                    |: 0i32
                |: 0i32
            |: 0i32
        |: 0i32
    |: 0i32

:= main () : i32 =
    := search_receipt : workstream_receipt proof_baseline owner_search =
        WorkstreamReceipt (11u64, 21u64, 7u32, WorkstreamPassed)
    := agile_receipt : workstream_receipt proof_baseline owner_agile =
        WorkstreamReceipt (12u64, 22u64, 8u32, WorkstreamPassed)
    := handoff_receipt : workstream_receipt proof_baseline owner_handoff =
        WorkstreamReceipt (13u64, 23u64, 9u32, WorkstreamPassed)
    := handoff_batch : workstream_batch proof_baseline (owner_cons owner_handoff owner_nil) =
        WorkstreamCons (OwnerAbsentNil, handoff_receipt, WorkstreamNil)
    := agile_batch : workstream_batch proof_baseline (owner_cons owner_agile (owner_cons owner_handoff owner_nil)) =
        WorkstreamCons (OwnerAbsentCons (AgileDistinctHandoff, OwnerAbsentNil), agile_receipt, handoff_batch)
    := batch
        : workstream_batch proof_baseline
            (owner_cons owner_search (owner_cons owner_agile (owner_cons owner_handoff owner_nil)))
        =
        WorkstreamCons (
            OwnerAbsentCons (SearchDistinctAgile, OwnerAbsentCons (SearchDistinctHandoff, OwnerAbsentNil)),
            search_receipt,
            agile_batch
        )
    := search_plan : workstream_plan proof_baseline owner_search workstream_draft workstream_receipted =
        WorkstreamThen (\? (
            WorkstreamStep ValidateOwnerWorkstream,
            WorkstreamThen (\? (
                WorkstreamStep ExecuteOwnerWorkstream,
                WorkstreamStep CommitOwnerReceipt
            ))
        ))
    := merge
        : merge_plan proof_baseline
            (owner_cons owner_search (owner_cons owner_agile (owner_cons owner_handoff owner_nil))) merge_unchecked
            merge_committed
        =
        MergeThen (\? (
            MergeStep (ValidateWorkstreamBatch batch),
            MergeStep (CommitWorkstreamBatch batch)
        ))
    := cancellation : workstream_cancellation_plan owner_agile =
        CancelAfterFailure (StageSiblingOutput, ObserveSiblingFailure, CancelSiblingOutput)
    := _ = search_plan
    := _ = merge
    := _ = cancellation
    := concurrency = workstream_concurrency_binding 3i32 49i32 133i32 45i32
    := completion = workstream_completion_binding 3i32 3i32 3i32 0i32 0i32 3i32
    := merge_authorized = workstream_merge_authorization_binding 3i32 3i32 0i32 0i32 3i32 1i32 1i32 1i32
    := cancel_safe = workstream_cancel_before_promotion_binding 1i32 2i32 1i32 2i32 0i32 0i32 2i32
    := cancel_before_stage_safe = workstream_cancel_before_promotion_binding 1i32 2i32 1i32 0i32 0i32 0i32 0i32
    := physical_cancel = physical_group_failure_cancel ()
    := gate0 = concurrency * completion
    := gate1 = gate0 * merge_authorized
    := gate2 = gate1 * cancel_safe
    := gate3 = gate2 * cancel_before_stage_safe
    := gate = gate3 * physical_cancel
    ?= workstream_receipt_binding gate 1i32 0i32 7i32 ?|
    | 1 =>
        ?= workstream_parallel_binding 3i32 56i32 3i32 3i32 ?|
        | 1 =>
            ?= workstream_merge_binding 3i32 3i32 1i32 1i32 1i32 ?|
            | 1 =>
                ?= workstream_failure_binding 3i32 0i32 0i32 1i32 ?|
                | 1 => 0i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
