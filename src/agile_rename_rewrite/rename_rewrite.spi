///- --package . --timeout 900000
:# rename_rewrite static =
    :< agile_task_text.model
    :< agile_note_model.model
    :< workspace_primitives.outcome
    :< workspace_primitives.numbers
    :< workspace_primitives.bytes
    :< sm'_operators

:< agile_task_text.model
:< agile_note_model.model
:< workspace_primitives.outcome
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< sm'_operators

:= negated (value : bool) : bool = ? value ?> !- |: !+

:== rename_tally =
    {
        items : i32
        deps_tasks : string
        deps_count : i32
        title_tasks : string
        title_count : i32
    }

:= listed (~list : string) (~id : string) : string = ? list = "" ?> id |: list ++# "," ++# id

:~ ^ deps_renamed
    (~deps : string) (~offset : i32) (~length : i32) (~old : string) (~new : string) (~kept : string) (~changed : bool)
    : string * bool
    =
    ? length <= offset ?> kept, changed
    |:
        := found = byte_find_from deps "," offset
        := stop = ? found < 0i32 ?> length |: found
        := next = ? found < 0i32 ?> length |: found + 1i32
        := entry = sm'.trim (byte_slice deps offset stop)
        := hit = entry = old
        := written = ? hit ?> new |: entry
        deps_renamed deps next length old new (listed kept written) (? hit ?> !+ |: changed)

:= task_field_bounds (~line : string) (found : i32) (position : i32) : i32 * i32 =
    := length = byte_len line
    := start = field_start line (found + item_arguments_offset TaskItem) length position
    start, field_end line start length ScanPlain

:~ dependent_line
    (~line : string) (found : i32) (~old : string) (~new : string) (~tally : rename_tally)
    : string * rename_tally
    =
    := id_start, id_stop = task_field_bounds line found 0i32
    := owner = unquoted (byte_slice line id_start id_stop)
    := title_start, title_stop = task_field_bounds line found 1i32
    := mentions = ? byte_find (byte_slice line title_start title_stop) old < 0i32 ?> !- |: !+
    := tally =
        ? mentions
        ?> { tally ?| title_tasks = listed tally.title_tasks owner; title_count = (tally.title_count + 1i32) }
        |: tally
    := deps_start, deps_stop = task_field_bounds line found 7i32
    := deps = unquoted (byte_slice line deps_start deps_stop)
    := renamed, changed = deps_renamed deps 0i32 (byte_len deps) old new "" !-
    ? changed
    ?>
        spliced line deps_start deps_stop (spi_quoted renamed),
        { tally ?| deps_tasks = listed tally.deps_tasks owner; deps_count = (tally.deps_count + 1i32) }
    |: line, tally

:= rebound
    (~line : string) (found : i32) (kind : item_kind) (~binding : string) (~old : string) (~new : string)
    : string
    =
    := rest = byte_slice line (found + byte_len (item_anchor kind old)) (byte_len line)
    "inl " ++# binding ++# " () = " ++# item_anchor kind new ++# rest

:= note_sequence (~line : string) (found : i32) : string = sm'.replace "u32" "" (item_field line NoteItem found 1i32)

:~ renamed_line (~line : string) (~old : string) (~new : string) (~tally : rename_tally) : string * rename_tally =
    ? sm'.starts_with "inl " line ?>
        := task = byte_find line (item_anchor TaskItem old)
        := planning = byte_find line (item_anchor PlanningItem old)
        := note = byte_find line (item_anchor NoteItem old)
        := counted = { tally ?| items = (tally.items + 1i32) }
        ? negated (task < 0i32) ?> rebound line task TaskItem (item_binding new) old new, counted
        |? negated (planning < 0i32) ?> rebound line planning PlanningItem (planning_binding new) old new, counted
        |? negated (note < 0i32) ?>
            := binding = "note_of_" ++# item_binding new ++# "_" ++# note_sequence line note
            rebound line note NoteItem binding old new, counted
        |:
            := other = byte_find line (task_marker ())
            ? other < 0i32 ?> line, tally |: dependent_line line other old new tally
    |: line, tally

:= empty_tally () : rename_tally =
    { items = 0i32; deps_tasks = ""; deps_count = 0i32; title_tasks = ""; title_count = 0i32 }

:~ renamed_text (~text : string) (~old : string) (~new : string) : string * i32 * i32 * string * i32 * string =
    := step = \ ((lines, tally) : list string * rename_tally) (line : string) =>
        := written, counted = renamed_line line old new tally
        written :: lines, counted
    := lines, tally = sm'.split_list "\n" text |> listm.fold step ([], empty_tally ())
    := updated = lines |> listm.rev |> sm'.concat_list "\n"
    updated, tally.items, tally.deps_count, tally.deps_tasks, tally.title_count, tally.title_tasks

///> rust
:# a_rename_rewrites_the_item_rows_and_its_dependents_and_keeps_every_other_byte =
    := row = \ (id : string) (title : string) (deps : string) =>
        "inl task_" ++# sm'.to_lower id ++# " () = Task (\"" ++# id ++# "\", \"" ++# title
        ++# "\", Story, P1, D2, 0u32, Planned, \"" ++# deps ++# "\", \"kit\", \"c\", \"c\")"
    := text = row "A" "first" "" ++# "\n" ++# row "B" "after A" "A" ++# "\n// kept\n" ++# row "C" "other" "" ++# "\n"
    := updated, items, deps_count, deps_tasks, title_count, title_tasks = renamed_text text "A" "Z"
    testing.expect (sm'.contains "Task (\"Z\", \"first\"" updated && sm'.contains "Task (\"A\"" updated = !-) "item"
    testing.expect (sm'.contains "Planned, \"Z\", \"kit\"" updated) "the dependent's deps name the new id"
    testing.expect (items = 1i32 && deps_count = 1i32 && deps_tasks = "B") "tally"
    testing.expect (title_count = 1i32 && title_tasks = "B") "old-id titles: counted"
    testing.expect (sm'.ends_with (row "C" "other" "" ++# "\n") updated && sm'.contains "\n// kept\n" updated) "rest"
    := unchanged, _, _, _, _, _ = renamed_text "x\ny" "A" "Z"
    testing.expect (unchanged = "x\ny") "no trailing newline is added"

///> _
:= main () : i32 =
    export
        "kit_agile_renamed_text"
        (
            \ (text, old, new) => renamed_text text old new
            : string * string * string -> string * i32 * i32 * string * i32 * string
        )
    := _ = renamed_text "" "A" "B"
    0i32
