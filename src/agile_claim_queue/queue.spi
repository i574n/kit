///- --package .
:# queue static =
    :< sm'_operators
    :< agile_claim_model.claim

:< sm'_operators
:< agile_claim_model.claim

:~ position_of (~id : string) (ids : list string) : i32 = optionm'.default_value -1i32 (listm'.try_index_of_ id ids) + 1i32

:~ words (~text : string) : list string = sm'.split_list " " text |> listm'.filter (\ (w : string) => w <> "")

:~ held_paths (claims : list claim) (~item : string) : list string =
    claims |> listm.fold (\ found (c : claim) => ? c.item = item ?> c.paths |: found) []

:~ claim_next
    (~lane : string) (ttl_min : i32) (~wsjf : string) (~active : string) (~live : string) (~rows : string) (now_ms : u64)
    : string * string * string * u64 * i32 * i32 * string * string
    =
    := ranked = words wsjf
    := started = words active
    := claims = claims_of_text rows
    := order = listm.append started (ranked |> listm'.filter (\ (id : string) => listm'.contains id started = !-))
    := running = words live
    ?= choose order claims (\ (id : string) => ? listm'.contains id running ?> LiveJob id |: Idle) lane now_ms ?|
    | Claimed (item, _) =>
        := lease = { item = item; owner = lane; expires_ms = now_ms + (conv ttl_min : u64) * 60000u64; paths = held_paths claims item }
        := wip = live_count (upserted claims lease) now_ms
        := paths = sm'.concat_list ";" lease.paths
        outcome_word OutcomeGranted, item, lane, lease.expires_ms, position_of item ranked, wip, paths, change_word ChangeUpsert
    | none => outcome_word OutcomeNone, "", lane, 0u64, 0i32, live_count claims now_ms, none_reason none, change_word ChangeNone

:= rows_of (claims : list claim) : string = claims_text claims

:= lease_of (~item : string) (~owner : string) (expires_ms : u64) (paths : list string) : claim =
    { item = item; owner = owner; expires_ms = expires_ms; paths = paths }

:= wsjf () : string = "GATE SMALL-P2 KIT-SIDE BIG-P0"

///> rust
:# next_any_hands_active_work_first_and_never_the_same_item_twice =
    := kind, item, owner, expires, rank, wip, _, change = claim_next "x" 90i32 (wsjf ()) "GATE BIG-P0" "" (rows_of []) 1000u64
    testing.expect (kind = "granted" && item = "GATE" && owner = "x" && rank = 1i32 && wip = 1i32 && change = "upsert") item
    testing.expect (expires = 5401000u64) "ttl"
    := held = rows_of [ lease_of "GATE" "x" 5401000u64 [] ]
    := _, second, _, _, rank, wip, _, _ = claim_next "z" 90i32 (wsjf ()) "GATE BIG-P0" "" held 1000u64
    testing.expect (second = "BIG-P0" && rank = 4i32 && wip = 2i32) second

///> rust
:# an_expired_lease_is_offered_before_new_work_and_a_full_queue_says_why =
    := stale = rows_of [ lease_of "KIT-SIDE" "old" 10u64 [ "src/kit/**" ] ]
    := _, item, _, _, rank, _, paths, _ = claim_next "x" 90i32 (wsjf ()) "GATE BIG-P0" "" stale 1000u64
    testing.expect (item = "KIT-SIDE" && rank = 3i32 && paths = "src/kit/**") item
    := busy =
        rows_of
            [ lease_of "GATE" "a" 9000u64 []; lease_of "BIG-P0" "b" 9000u64 []; lease_of "SMALL-P2" "c" 9000u64 []
              lease_of "KIT-SIDE" "d" 9000u64 [] ]
    := kind, _, _, _, _, wip, reason, change = claim_next "x" 90i32 (wsjf ()) "GATE BIG-P0" "" busy 1000u64
    testing.expect (kind = "none" && reason = "all-leased" && wip = 4i32 && change = "none") reason

///> rust
:# a_live_job_keeps_other_lanes_off_its_item =
    := _, item, _, _, _, _, _, _ = claim_next "x" 90i32 (wsjf ()) "GATE BIG-P0" "GATE" (rows_of []) 1000u64
    testing.expect (item = "BIG-P0") "GATE has a running job, so the next active item is handed out"
    := kind, _, _, _, _, _, reason, _ = claim_next "x" 90i32 "GATE" "GATE" "GATE" (rows_of []) 1000u64
    testing.expect (kind = "none" && reason = "all-live") reason

///> rust
:# a_released_item_is_not_offered_back_to_the_lane_that_declined_it =
    := declined = rows_of [ lease_of "GATE" "~x" 5401000u64 [] ]
    := _, mine, _, _, _, wip, _, _ = claim_next "x" 90i32 (wsjf ()) "GATE BIG-P0" "" declined 1000u64
    testing.expect (mine = "BIG-P0" && wip = 1i32) "the decliner gets the next active item and the decline is not WIP"
    := _, theirs, _, _, _, _, _, _ = claim_next "z" 90i32 (wsjf ()) "GATE BIG-P0" "" declined 1000u64
    testing.expect (theirs = "GATE") "another lane is still offered the declined item"
///> _
:= main () : i32 =
    export "kit_claim_next" (
        (\ (lane, ttl, wsjf, active, live, rows, now) => claim_next lane ttl wsjf active live rows now)
        : string * i32 * string * string * string * string * u64 -> string * string * string * u64 * i32 * i32 * string * string
    )
    0i32
