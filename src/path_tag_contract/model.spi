:! path_tag_raw = ()
:! path_tag_normalized = ()
:! path_tag_hashed = ()
:! path_tag_indexed = ()
:! path_tag_rendered = ()

:! adjective_bank = ()
:! landmark_bank = ()
:! artifact_bank = ()
:! word_index bank = i32

:== path_tag_indices = {
    adjective : word_index adjective_bank
    landmark : word_index landmark_bank
    artifact : word_index artifact_bank
}

:| path_tag_policy =
    | RejectAbsolutePath
    | RejectParentTraversal
    | NormalizeSeparators
    | HashRelativePathWithSha256
    | DecodeFirstEighteenBits
    | SelectThreeDistinctWordBanks
    | RenderHyphenatedMnemonic

:| path_tag_op from to =
    | ValidateRelativePath :: path_tag_op path_tag_raw path_tag_normalized
    | HashNormalizedPath :: path_tag_op path_tag_normalized path_tag_hashed
    | DecodeWordIndices :: path_tag_op path_tag_hashed path_tag_indexed
    | RenderMnemonicTag :: path_tag_op path_tag_indexed path_tag_rendered

:| ^ path_tag_plan from to =
    | PathTagStep :: \* from to. path_tag_op from to -> path_tag_plan from to
    | PathTagThen :: \* from to.
        (\? middle. path_tag_plan from middle * path_tag_plan middle to) ->
        path_tag_plan from to

:= path_tag_public_plan () : path_tag_plan path_tag_raw path_tag_rendered =
    PathTagThen (\? (
        PathTagStep ValidateRelativePath,
        PathTagThen (\? (
            PathTagStep HashNormalizedPath,
            PathTagThen (\? (
                PathTagStep DecodeWordIndices,
                PathTagStep RenderMnemonicTag
            ))
        ))
    ))

:= path_tag_indices adjective landmark artifact : path_tag_indices = {
    adjective = word_index adjective
    landmark = word_index landmark
    artifact = word_index artifact
}

:~ path_tag_relative_binding (is_absolute : i32) (has_parent : i32) (segments : i32) : i32 =
    ? 0i32 < is_absolute ?> 0i32
    |? 0i32 < has_parent ?> 0i32
    |? segments < 1i32 ?> 0i32
    |: 1i32

:~ path_tag_indices_binding (adjective : i32) (landmark : i32) (artifact : i32) : i32 =
    ? adjective < 0i32 ?> 0i32
    |? 63i32 < adjective ?> 0i32
    |? landmark < 0i32 ?> 0i32
    |? 63i32 < landmark ?> 0i32
    |? artifact < 0i32 ?> 0i32
    |? 63i32 < artifact ?> 0i32
    |: 1i32

:~ path_tag_relative_packed_binding (flags : i32) (segments : i32) : i32 =
    ? flags < 0i32 ?> 0i32
    |? 0i32 < flags ?> 0i32
    |? segments < 1i32 ?> 0i32
    |: 1i32

:~ path_tag_packed_indices_binding (packed : i32) (bank_size : i32) : i32 =
    ? packed < 0i32 ?> 0i32
    |? 262143i32 < packed ?> 0i32
    |? bank_size < 64i32 ?> 0i32
    |? 64i32 < bank_size ?> 0i32
    |: 1i32

:~ path_tag_shape_binding (words : i32) (separators : i32) : i32 =
    ? words < 3i32 ?> 0i32
    |? 3i32 < words ?> 0i32
    |? separators < 2i32 ?> 0i32
    |? 2i32 < separators ?> 0i32
    |: 1i32

:~ path_tag_determinism_binding (same_normalized_path : i32) (same_tag : i32) : i32 =
    ? same_normalized_path < 1i32 ?> 0i32
    |? same_tag < 1i32 ?> 0i32
    |: 1i32

:~ path_tag_collision_binding (same_tag : i32) (same_normalized_path : i32) : i32 =
    ? same_tag < 1i32 ?> 1i32
    |? same_normalized_path < 1i32 ?> 0i32
    |: 1i32
