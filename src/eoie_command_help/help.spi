open agile_subcommand_domain.subcommand

let root_flag_refusal (~name : string) (~flag : string) : string =
    match agile_subcommand_of name with
    | AgileKnown subcommand => agile_root_flag_refusal subcommand flag
    | AgileUnknownName => ""

inl main () : i32 =
    !!!!Export("eoie_agile_root_flag_refusal", ((fun (name, flag) => root_flag_refusal name flag) : string * string -> string))
    !!!!Export("eoie_command_more_usages", ((fun () => command_spec_domain.model.command_more_usages ()) : () -> string))
    !!!!Export("eoie_agile_subcommand_known", ((fun value => agile_subcommand_domain.subcommand.agile_subcommand_known value) : string -> i32))
    0i32
