:< workspace_primitives.numbers
:< sm'_operators
:< workspace_primitives.bytes
:< agile_todo_model.model

:= git_timeout_ms () : u64 = 60000u64
:= nul_text () : string = $'std::rc::Rc::<str>::from(char::from(0u8).to_string())' : string

:= git_output (~directory : string) (~arguments : string) : bool * string =
    := timeout = git_timeout_ms ()
    $'{ let mut command = std::process::Command::new("git"); command.arg("-C").arg(&*!directory).args(!arguments.split\
        (char::from(9u8))); match kit_process::run_bounded_capture_with_input(&mut command, !timeout, \
        None) { Ok(capture) => (capture.termination == kit_process::ProcessTermination::Exited(0), \
        std::rc::Rc::<str>::from(String::from_utf8_lossy(&capture.stdout).as_ref())), Err(error) => (false, \
        std::rc::Rc::<str>::from(error)) } }' : bool * string

:= walked_directory_code () : i32 = 2i32

:= entry_code (~path : string) : i32 =
    $'std::fs::symlink_metadata(&*!path).map(|metadata| if metadata.file_type().is_symlink() { 3 } else if \
        metadata.is_dir() { 2 } else if metadata.is_file() { 1 } else { 0 }).unwrap_or(0)' : i32

:= listed_names (~path : string) : string =
    $'std::rc::Rc::<str>::from(kit_rust_std_fs::rooted_list_names(std::path::Path::new(&*!path)).unwrap_or_default().j\
        oin(&char::from(10u8).to_string()).as_str())' : string

:= joined_path (~base : string) (~relative : string) : string =
    ? (base = "") ?> relative
    |: base ++# "/" ++# relative

:= appended (~listing : string) (~relative : string) : string = listing ++# relative ++# (nul_text ())

:~ ^ walked_names
    (~directory : string) (~relative : string) (~names : string) (~offset : i32) (~listing : string)
    : string
    =
    ? byte_len names <= offset
    ?> listing
    |:
        := newline = byte_find_from names "\n" offset
        := stop = ? newline < 0i32 ?> byte_len names |: newline
        := name = byte_slice names offset stop
        := next = stop + 1i32
        := absolute = joined_path directory name
        := child = joined_path relative name
        := visited =
            ? (name = "")
            ?> listing
            |? both (entry_code absolute = walked_directory_code ()) (vendor_directory name)
            ?> appended listing (joined_path child ".")
            |? entry_code absolute = walked_directory_code ()
            ?> walked_directory absolute child listing
            |: appended listing child
        walked_names directory relative names next visited
:& :~ walked_directory (~directory : string) (~relative : string) (~listing : string) : string =
    walked_names directory relative (listed_names directory) 0i32 listing

:~ todo_sources (~path : string) : bool * string =
    ? entry_code path = walked_directory_code () ?>
        := inside, _ = git_output path "rev-parse\t--is-inside-work-tree"
        ? inside ?> git_output path "ls-files\t-co\t--exclude-standard\t-z"
        |: !+, walked_directory path "" ""
    |: !-, ""

:= main () : i32 =
    !!!!Export("kit_agile_todo_sources", ((\ path => todo_sources path) : string -> bool * string))
    := _ = todo_sources ""
    0i32
