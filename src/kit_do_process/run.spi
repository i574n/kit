:< rust_std_string.model
:< kit_receipt.receipt
:< host
:< grammar
:< kit_do_records.records

:== run_tally =
    {
        report : string
        failed : bool
        runs : u64
        exit_known : bool
        exit_code : i64
        processes : u64
        listings : u64
        stopped : u64
        stops : u64
        errors : u64
        groupings : u64
        matches : u64
        searches : u64
    }

:~ empty_run_tally () : run_tally =
    {
        report = ""
        failed = !-
        runs = 0u64
        exit_known = !-
        exit_code = 0i64
        processes = 0u64
        listings = 0u64
        stopped = 0u64
        stops = 0u64
        errors = 0u64
        groupings = 0u64
        matches = 0u64
        searches = 0u64
    }

:~ lines_joined (~left : string) (~right : string) : string =
    ? right = "" ?> left |? left = "" ?> right |: concat5 left "\n" right "" ""

:~ reported (~state : run_tally) (~text : string) (~failed : bool) : run_tally =
    { state ?| report = lines_joined state.report text; failed = state.failed || failed }

:~ foreground_run
    (~runs : run_state) (~state : run_tally) (~records : record_list) (~record : i32) (~command : string)
    (~needle : string) (~timeout : u64)
    : run_tally
    =
    := raw = run_ended runs needle timeout
    := finish = run_end_of (raw_kind raw) (raw_value raw)
    := line = run_end_text command needle timeout (raw_elapsed raw) (raw_lines raw) finish
    := shown =
        ?= finish ?|
        | Exited _ => ? later_reads_output records record ?> line |: lines_joined line (output_lines runs 40u64 !-)
        | _ => line
    := counted = { (reported state shown (run_end_failed finish)) ?| runs = state.runs + 1u64 }
    ?= finish ?|
    | Exited code => { counted ?| exit_known = !+; exit_code = code }
    | _ => counted

:~ run_started (~runs : run_state) (~root : string) (~command : string) (~name : string) : string =
    run_spawned runs root (launch_argv_via root command) (launch_line_via root command) name

:~ step_run
    (~root : string) (~runs : run_state) (~records : record_list) (~record : i32) (~state : run_tally)
    (step : process_step)
    : run_tally
    =
    ?= step ?|
    | RunForeground (command, timeout) =>
        := problem = run_started runs root command ""
        ? problem = "" ?> foreground_run runs state records record command "" timeout
        |: { (reported state (concat5 "run " command "  " problem "") !+) ?| runs = state.runs + 1u64 }
    | RunUntil (command, needle, timeout) =>
        := problem = run_started runs root command ""
        ? problem = "" ?> foreground_run runs state records record command needle timeout
        |: { (reported state (concat5 "run " command "  " problem "") !+) ?| runs = state.runs + 1u64 }
    | RunBackground (command, name) =>
        := problem = run_started runs root command name
        := line =
            ? problem = ""
            ?>
                concat5
                    "run "
                    command
                    "  background as "
                    name
                    (concat5 "  pid " (decimal_text (background_pid runs)) "" "" "")
            |: concat5 "run " command "  " problem ""
        { (reported state line (problem <> "")) ?| runs = state.runs + 1u64 }
    | TailOutput count => reported state (output_lines runs count !+) !-
    | SearchOutput needle =>
        := outcome = output_searched runs needle
        { (reported state (outcome_report outcome) (outcome_failed outcome)) ?|
            matches = state.matches + outcome_count outcome
            searches = state.searches + 1u64
        }
    | ErrorsBy needle =>
        := outcome = errors_grouped runs needle
        { (reported state (outcome_report outcome) (outcome_failed outcome)) ?|
            errors = state.errors + outcome_count outcome
            groupings = state.groupings + 1u64
        }
    | ProcessesMatching needle =>
        := outcome = processes_listed needle (local_offset_minutes ())
        { (reported state (outcome_report outcome) (outcome_failed outcome)) ?|
            processes = state.processes + outcome_count outcome
            listings = state.listings + 1u64
        }
    | StopNamed name =>
        := found = run_stopped runs name
        := line =
            ? found
            ?> concat5 "stop " name "  stopped (tree)" "" ""
            |: concat5 "stop " name "  no run by that name" "" ""
        { (reported state line (found = !-)) ?|
            stopped = state.stopped + (? found ?> 1u64 |: 0u64)
            stops = state.stops + 1u64
        }

:~ ^ steps_run
    (~root : string) (~runs : run_state) (~records : record_list) (~index : i32) (~state : run_tally)
    : run_tally
    =
    ? index < record_count records ?>
        ?= step_parsed records index ?|
        | StepParsed step => steps_run root runs records (index + 1i32) (step_run root runs records index state step)
        | StepRejected _ => steps_run root runs records (index + 1i32) state
    |: state

:~ ^ first_rejection (~records : record_list) (~index : i32) : string =
    ? index < record_count records
    ?>
        ? field_at records index 0i32 <> "query"
        ?> "edit and run statements cannot share one program yet; run them as two calls"
        |:
            ?= step_parsed records index ?|
            | StepRejected message => message
            | StepParsed _ => first_rejection records (index + 1i32)
    |: ""

:~ segments_joined (~left : string) (~right : string) : string =
    ? left = "" ?> right |: concat5 left "  " right "" ""

:~ counted_segment (~shown : bool) (~text : string) (~label : string) (~value : u64) : string =
    ? shown ?> segments_joined text (concat5 label " " (decimal_text value) "" "") |: text

:~ receipt_counts (~state : run_tally) : string =
    := runs = concat5 "runs " (decimal_text state.runs) "" "" ""
    := exit = ? state.exit_known ?> concat5 runs "  exit " (signed_text state.exit_code) "" "" |: runs
    := processes = counted_segment (state.listings > 0u64) exit "processes" state.processes
    := stopped = counted_segment (state.stops > 0u64) processes "stopped" state.stopped
    := errors = counted_segment (state.groupings > 0u64) stopped "errors" state.errors
    counted_segment (state.searches > 0u64) errors "matches" state.matches

:~ run_program_run (~root : string) (~encoded : string) : i32 =
    := started = now_ms ()
    := records = records_of encoded
    := rejection = first_rejection records 1i32
    ? rejection = "" ?>
        := state = steps_run root (state_new ()) records 1i32 (empty_run_tally ())
        := report = state.report
        ? report = "" ?> () |: stdout_line report
        := counts = receipt_counts state
        ? state.failed ?>
            receipt_line Failed counts started
            1i32
        |:
            receipt_line Succeeded counts started
            0i32
    |:
        stdout_line (concat5 "program rejected: " rejection "" "" "")
        receipt_line Failed "runs 0" started
        2i32

:~ ^ query_rejection (~records : record_list) (~index : i32) : string =
    ? index < record_count records ?>
        ? field_at records index 0i32 <> "query" ?> query_rejection records (index + 1i32)
        |:
            ?= step_parsed records index ?|
            | StepRejected message => message
            | StepParsed _ => query_rejection records (index + 1i32)
    |: ""

:= record_separator () : string = $'std::rc::Rc::<str>::from(char::from(30u8).to_string())' : string

:~ after_edits_run (~root : string) (~encoded : string) : string =
    := state = steps_run root (state_new ()) (records_of encoded) 1i32 (empty_run_tally ())
    concat5 state.report
        (record_separator ())
        (receipt_counts state)
        (record_separator ())
        (? state.failed ?> "1" |: "0")

:= main () : i32 =
    !!!!Export(
        "kit_do_process_rejection",
        ((\ encoded => query_rejection (records_of encoded) 1i32) : string -> string)
    )
    !!!!Export(
        "kit_do_process_after_edits",
        ((\ (root, encoded) => after_edits_run root encoded) : string * string -> string)
    )
    !!!!Export("kit_do_process_run", ((\ (root, encoded) => run_program_run root encoded) : string * string -> i32))
    0i32
