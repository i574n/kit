:! existing_backup_slot = i32
:! next_backup_slot = i32
:! backup_slot = i32
:! backup_count = i32
:! validated_stage_index = i32
:! captured_original_slot = i32
:! staged_backup_slot = i32
:! promoted_backup_slot = i32
:! rollback_backup_slot = i32
:! capture_limit = i32
:! observed_content_length = i32
:! capture_authorization = i32
:! captured_content_slot = i32
:! expected_temporary_length = i32
:! observed_temporary_length = i32
:! temporary_write_authorization = i32
:! temporary_write_slot = i32
:! expected_promotion_stage = i32
:! observed_promotion_stage = i32
:! expected_promotion_slot = i32
:! observed_promotion_slot = i32
:! promotion_authorization = i32
:! promotion_slot = i32

:| promotion_decision =
    | PromotionAuthorized
    | PromotionDenied

:| temporary_write_decision =
    | TemporaryWriteAuthorized
    | TemporaryWriteDenied

:| capture_decision =
    | CaptureAuthorized
    | CaptureDenied

:= plan_capture (observed_content_length observed) (capture_limit limit) : capture_decision =
    ? observed < 0i32 ?> CaptureDenied
    |? limit < 0i32 ?> CaptureDenied
    |? limit < observed ?> CaptureDenied
    |: CaptureAuthorized

:~ capture_authorized (observed : i32) (limit : i32) : i32 =
    ? observed < 0i32 ?> 0i32
    |? limit < 0i32 ?> 0i32
    |? limit < observed ?> 0i32
    |: 1i32

:~ capture_binding_slot (slot : i32) (authorized : i32) : i32 =
    ? slot < 0i32 ?> -1i32
    |? authorized < 1i32 ?> -1i32
    |? 1i32 < authorized ?> -1i32
    |: slot

:= plan_temporary_write
    (expected_temporary_length expected) (observed_temporary_length observed)
    : temporary_write_decision
    =
    ? expected < 0i32 ?> TemporaryWriteDenied
    |? observed < 0i32 ?> TemporaryWriteDenied
    |? expected < observed ?> TemporaryWriteDenied
    |? observed < expected ?> TemporaryWriteDenied
    |: TemporaryWriteAuthorized

:~ temporary_write_authorized (expected : i32) (observed : i32) : i32 =
    ? expected < 0i32 ?> 0i32
    |? observed < 0i32 ?> 0i32
    |? expected < observed ?> 0i32
    |? observed < expected ?> 0i32
    |: 1i32

:~ temporary_write_binding_slot (slot : i32) (authorized : i32) : i32 =
    ? slot < 0i32 ?> -1i32
    |? authorized < 1i32 ?> -1i32
    |? 1i32 < authorized ?> -1i32
    |: slot

:= plan_promotion
    (expected_promotion_stage expected_stage)
    (observed_promotion_stage observed_stage)
    (expected_promotion_slot expected_slot)
    (observed_promotion_slot observed_slot)
    : promotion_decision =
    ? expected_stage < 0i32 ?> PromotionDenied
    |? observed_stage < 0i32 ?> PromotionDenied
    |? expected_stage < observed_stage ?> PromotionDenied
    |? observed_stage < expected_stage ?> PromotionDenied
    |? expected_slot < 0i32 ?> PromotionDenied
    |? observed_slot < 0i32 ?> PromotionDenied
    |? expected_slot < observed_slot ?> PromotionDenied
    |? observed_slot < expected_slot ?> PromotionDenied
    |: PromotionAuthorized

:~ promotion_stage_authorized (expected : i32) (observed : i32) : i32 =
    ? expected < 0i32 ?> 0i32
    |? observed < 0i32 ?> 0i32
    |? expected < observed ?> 0i32
    |? observed < expected ?> 0i32
    |: 1i32

:~ promotion_slot_authorized (expected : i32) (observed : i32) : i32 =
    ? expected < 0i32 ?> 0i32
    |? observed < 0i32 ?> 0i32
    |? expected < observed ?> 0i32
    |? observed < expected ?> 0i32
    |: 1i32

:~ promotion_authorized (stage_authorized : i32) (slot_authorized : i32) : i32 =
    ? stage_authorized < 1i32 ?> 0i32
    |? 1i32 < stage_authorized ?> 0i32
    |? slot_authorized < 1i32 ?> 0i32
    |? 1i32 < slot_authorized ?> 0i32
    |: 1i32

:~ promotion_binding_slot (slot : i32) (authorized : i32) : i32 =
    ? slot < 0i32 ?> -1i32
    |? authorized < 1i32 ?> -1i32
    |? 1i32 < authorized ?> -1i32
    |: slot

:= capture_original_slot (backup_slot slot) (validated_stage_index stage) : captured_original_slot =
    captured_original_slot (
        ? slot < 0i32 ?> -1i32
        |? stage < 0i32 ?> -1i32
        |: slot
    )

:= stage_backup_slot (captured_original_slot slot) : staged_backup_slot = staged_backup_slot slot
:= promote_backup_slot (staged_backup_slot slot) : promoted_backup_slot = promoted_backup_slot slot
:= select_rollback_slot (promoted_backup_slot slot) : rollback_backup_slot = rollback_backup_slot slot

:~ backup_binding_slot (slot : i32) (stage : i32) : i32 =
    := (captured_original_slot captured) = capture_original_slot (backup_slot slot) (validated_stage_index stage)
    := (staged_backup_slot staged) = stage_backup_slot (captured_original_slot captured)
    := (promoted_backup_slot promoted) = promote_backup_slot (staged_backup_slot staged)
    := (rollback_backup_slot rollback) = select_rollback_slot (promoted_backup_slot promoted)
    rollback

:| backup_collection =
    | CaptureBackup
    | ReuseBackup

:= collect_backup (existing_backup_slot existing) (next_backup_slot next) : backup_collection =
    ? existing < 0i32 ?> CaptureBackup |: ReuseBackup

:~ backup_slot_for (existing : i32) (next : i32) : i32 =
    ? existing < 0i32 ?> next |: existing

:~ backup_next_count (existing : i32) (next : i32) : i32 =
    ? existing < 0i32 ?> next + 1i32 |: next

:~ backup_should_capture (existing : i32) (next : i32) : i32 =
    ? next < 0i32 ?> 0i32
    |? existing < 0i32 ?> 1i32
    |: 0i32

:! committed_prefix = i32
:! rollback_cursor = i32
:! rollback_index = i32

:= next_rollback (committed_prefix committed) (rollback_cursor cursor) : rollback_index =
    rollback_index (
        ? cursor < committed
        ?> (committed - cursor) - 1i32
        |: (-(1i32))
    )

:~ rollback_next (committed : i32) (cursor : i32) : i32 =
    := (rollback_index code) = next_rollback (committed_prefix committed) (rollback_cursor cursor)
    code

:! restoration_candidate = i32
:! restoration_observed = i32
:! restoration_expected_count = i32
:! restoration_receipt_count = i32

:~ restoration_select (committed : i32) (cursor : i32) : i32 =
    rollback_next committed cursor

:~ restoration_bind (selected : i32) (observed : i32) : i32 =
    ? selected < 0i32 ?> -1i32
    |? observed < 0i32 ?> -1i32
    |? selected < observed ?> -1i32
    |? observed < selected ?> -1i32
    |: selected

:~ restoration_complete (expected : i32) (observed : i32) : i32 =
    ? expected < 0i32 ?> 0i32
    |? observed < 0i32 ?> 0i32
    |? expected < observed ?> 0i32
    |? observed < expected ?> 0i32
    |: 1i32

:! restoration_expected_attempts = i32
:! restoration_success_count = i32
:! restoration_failure_count = i32
:! restoration_attempt_count = i32
:! restoration_attempt_authorization = i32

:! restoration_accumulator_open = ()
:! restoration_accumulator_succeeded = ()
:! restoration_accumulator_partial_failure = ()

:| restoration_accumulator_step from to =
    | AccumulateRestorationSuccess ::
        restoration_accumulator_step restoration_accumulator_open restoration_accumulator_open
    | AccumulateRestorationFailure ::
        restoration_accumulator_step restoration_accumulator_open restoration_accumulator_open
    | FinishRestorationSuccess ::
        restoration_accumulator_step restoration_accumulator_open restoration_accumulator_succeeded
    | FinishRestorationWithFailures ::
        restoration_accumulator_step restoration_accumulator_open restoration_accumulator_partial_failure

:~ restoration_attempt_count (successes : i32) (failures : i32) : i32 =
    ? successes < 0i32 ?> -1i32
    |? failures < 0i32 ?> -1i32
    |? 2147483647i32 - successes < failures ?> -1i32
    |: successes + failures

:~ restoration_attempt_authorized (expected : i32) (attempted : i32) : i32 =
    ? expected < 0i32 ?> 0i32
    |? attempted < 0i32 ?> 0i32
    |? attempted < expected ?> 1i32
    |: 0i32

:~ restoration_counter_next (current : i32) (authorized : i32) : i32 =
    ? current < 0i32 ?> -1i32
    |? authorized < 1i32 ?> -1i32
    |? 1i32 < authorized ?> -1i32
    |? current < 2147483647i32 ?> current + 1i32
    |: -1i32

:~ restoration_accumulator_outcome (complete : i32) (failures : i32) : i32 =
    ? failures < 0i32 ?> -1i32
    |? complete < 0i32 ?> -1i32
    |? 1i32 < complete ?> -1i32
    |? complete < 1i32 ?> 0i32
    |? failures < 1i32 ?> 1i32
    |: 2i32

:= export_backup_slot () : () =
    !!!!Export("kit_patch_backup_slot", ((\ (first, second) => backup_slot_for first second) : i32 * i32 -> i32))

:= export_backup_next_count () : () =
    !!!!Export(
        "kit_patch_backup_next_count",
        ((\ (first, second) => backup_next_count first second) : i32 * i32 -> i32)
    )

:= export_backup_capture_flag () : () =
    !!!!Export(
        "kit_patch_backup_should_capture",
        ((\ (first, second) => backup_should_capture first second) : i32 * i32 -> i32)
    )

:= export_backup_binding_slot () : () =
    !!!!Export(
        "kit_patch_backup_binding_slot",
        ((\ (first, second) => backup_binding_slot first second) : i32 * i32 -> i32)
    )

:= export_capture_authorized () : () =
    !!!!Export(
        "kit_patch_capture_authorized",
        ((\ (first, second) => capture_authorized first second) : i32 * i32 -> i32)
    )

:= export_capture_binding_slot () : () =
    !!!!Export(
        "kit_patch_capture_binding_slot",
        ((\ (first, second) => capture_binding_slot first second) : i32 * i32 -> i32)
    )

:= export_promotion_slot_authorized () : () =
    !!!!Export(
        "kit_patch_promotion_slot_authorized",
        ((\ (first, second) => promotion_slot_authorized first second) : i32 * i32 -> i32)
    )

:= export_restoration_select () : () =
    !!!!Export(
        "kit_patch_restoration_select",
        ((\ (first, second) => restoration_select first second) : i32 * i32 -> i32)
    )

:= export_restoration_bind () : () =
    !!!!Export("kit_patch_restoration_bind", ((\ (first, second) => restoration_bind first second) : i32 * i32 -> i32))

:= export_restoration_complete () : () =
    !!!!Export(
        "kit_patch_restoration_complete",
        ((\ (first, second) => restoration_complete first second) : i32 * i32 -> i32)
    )

:= export_restoration_attempt_count () : () =
    !!!!Export(
        "kit_patch_restoration_attempt_count",
        ((\ (first, second) => restoration_attempt_count first second) : i32 * i32 -> i32)
    )

:= export_restoration_attempt_authorized () : () =
    !!!!Export(
        "kit_patch_restoration_attempt_authorized",
        ((\ (first, second) => restoration_attempt_authorized first second) : i32 * i32 -> i32)
    )

:= export_restoration_counter_next () : () =
    !!!!Export(
        "kit_patch_restoration_counter_next",
        ((\ (first, second) => restoration_counter_next first second) : i32 * i32 -> i32)
    )

:= export_restoration_accumulator_outcome () : () =
    !!!!Export(
        "kit_patch_restoration_accumulator_outcome",
        ((\ (first, second) => restoration_accumulator_outcome first second) : i32 * i32 -> i32)
    )

:= main () : i32 =
    := backup_probe = collect_backup (existing_backup_slot -1i32) (next_backup_slot 0i32)
    := capture_probe = plan_capture (observed_content_length 5i32) (capture_limit 5i32)
    := promotion_probe =
        plan_promotion
            (expected_promotion_stage 0i32)
            (observed_promotion_stage 0i32)
            (expected_promotion_slot 0i32)
            (observed_promotion_slot 0i32)
    := ~existing = -1i32
    := ~next = 0i32
    := ~stage_index = 0i32
    := ~committed = 3i32
    := ~cursor = 0i32
    := _ = backup_slot_for existing next
    := _ = backup_next_count existing next
    := _ = backup_should_capture existing next
    := _ = backup_binding_slot next stage_index
    := _ = capture_authorized 5i32 5i32
    := _ = capture_binding_slot next 1i32
    := _ = promotion_slot_authorized 0i32 0i32
    := _ = restoration_select committed cursor
    := _ = restoration_bind 0i32 0i32
    := _ = restoration_complete 1i32 1i32
    := _ = restoration_attempt_count 1i32 1i32
    := _ = restoration_attempt_authorized 2i32 1i32
    := _ = restoration_counter_next 1i32 1i32
    := _ = restoration_accumulator_outcome 1i32 0i32
    := _ = AccumulateRestorationSuccess
    := _ = AccumulateRestorationFailure
    := _ = FinishRestorationSuccess
    := _ = FinishRestorationWithFailures
    export_backup_slot ()
    export_backup_next_count ()
    export_backup_capture_flag ()
    export_backup_binding_slot ()
    export_capture_authorized ()
    export_capture_binding_slot ()
    export_promotion_slot_authorized ()
    export_restoration_select ()
    export_restoration_bind ()
    export_restoration_complete ()
    export_restoration_attempt_count ()
    export_restoration_attempt_authorized ()
    export_restoration_counter_next ()
    export_restoration_accumulator_outcome ()
    0i32
