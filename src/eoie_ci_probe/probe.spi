///- --package .
test probe static =
    open sm'_operators

open sm'_operators
open eoie_ci_model.tools

type version_probe =
    {
        program : string
        args : list string
        override_variable : option string
    }

inl otp_version_expression () : string =
    "io:format(\"~s\",[element(2,file:read_file(filename:join([code:root_dir(),\"releases\","
    ++# "erlang:system_info(otp_release),\"OTP_VERSION\"])))]),halt()."

let probe_of (tool : ci_tool) : version_probe =
    match tool with
    | ToolRust => { program = "rustup"; args = [ "show"; "active-toolchain" ]; override_variable = None }
    | ToolZig => { program = "zig"; args = [ "version" ]; override_variable = Some "SPIRAL_ZIG" }
    | ToolOtp =>
        { program = "erl"; args = [ "-noshell"; "-eval"; otp_version_expression () ]; override_variable = None }
    | ToolElixir => { program = "elixir"; args = [ "--short-version" ]; override_variable = None }
    | ToolGleam => { program = "gleam"; args = [ "--version" ]; override_variable = None }
    | ToolRebar => { program = "rebar3"; args = [ "version" ]; override_variable = None }
    | ToolPython => { program = "python"; args = [ "--version" ]; override_variable = None }

inl program_candidates (~program : string) : list string = [ program; program ++# ".cmd"; program ++# ".bat" ]

let first_line (~output : string) : string =
    sm'.replace "\r" "" output |> sm'.trim |> sm'.split "\n" |> array |> am'.index 0i32 |> sm'.trim

let word_at (index : i32) (~line : string) : string =
    inl words = sm'.split " " line |> array
    if index < (am'.length words : i32) then am'.index index words else ""

let without_host_triple (~toolchain : string) : string =
    inl cut =
        [ "-x86_64-"; "-aarch64-"; "-i686-"; "-arm" ]
        |> listm.fold
            fun (at : i32) (marker : string) =>
                inl found = sm'.index_of marker toolchain
                if found > 0i32 && (at < 0i32 || found < at) then found else at
            -1i32
    if cut < 0i32 then toolchain else sm'.substring 0i32 cut toolchain

let version_from_output (tool : ci_tool) (~output : string) : option string =
    inl line = first_line output
    inl version =
        match tool with
        | ToolRust => without_host_triple (word_at 0i32 line)
        | ToolGleam | ToolRebar | ToolPython => word_at 1i32 line
        | ToolZig | ToolOtp | ToolElixir => line
    if version = "" then None else Some version

let rec channels_from (lines : array string) (at : i32) (found : list string) : list string =
    if at >= (am'.length lines : i32) then listm.rev found
    else
        inl channel = without_host_triple (word_at 0i32 (sm'.trim (am'.index at lines)))
        channels_from lines (at + 1i32) (if channel = "" then found else channel :: found)

let installed_channels (~output : string) : list string =
    channels_from (sm'.replace "\r" "" output |> sm'.split "\n" |> array) 0i32 []

let rust_local (file_channel : option string) (installed : list string) (active : option string) : option string =
    match file_channel with
    | Some channel =>
        if listm'.try_find_ (fun (known : string) => known = channel) installed <> None then Some channel else None
    | None => active

let probe_program (probe : version_probe) : string =
    inl given =
        match probe.override_variable with
        | Some variable => optionm'.default_value "" (env.try_get_environment_variable variable)
        | None => ""
    if sm'.trim given = "" then probe.program else given

let captured (program : string) (args : list string) : option string =
    program_candidates program
    |> listm.fold
        fun found (candidate : string) =>
            match found with
            | Some _ => found
            | None => process.try_capture_combined_list candidate args
        None

let probed_version (tool : ci_tool) : option string =
    inl probe = probe_of tool
    match captured (probe_program probe) probe.args with
    | Some output => version_from_output tool output
    | None => None

let rust_installed () : list string =
    match captured "rustup" [ "toolchain"; "list" ] with
    | Some output => installed_channels output
    | None => []

let local_version (~name : string) (~repo : string) : bool * string =
    inl found =
        match tool_of_name name with
        | Some tool =>
            match tool with
            | ToolRust => rust_local (repo_toolchain repo) (rust_installed ()) (probed_version ToolRust)
            | _ => probed_version tool
        | None => None
    match found with
    | Some version => true, version
    | None => false, ""

let rust_channel_installed (~channel : string) : bool =
    listm'.try_find_ (fun (known : string) => known = channel) (rust_installed ()) <> None

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

///> rust
test tool_outputs_read_as_versions =
    inl rust = version_from_output ToolRust "nightly-2025-05-09-x86_64-pc-windows-msvc (default)\r\n"
    expect (rust = Some "nightly-2025-05-09") "rustup active toolchain without the host triple"
    expect (version_from_output ToolRust "stable-aarch64-apple-darwin" = Some "stable") "named channel"
    expect (version_from_output ToolGleam "gleam 1.19.2\n" = Some "1.19.2") "gleam --version"
    expect (version_from_output ToolRebar "rebar 3.28.0 on Erlang/OTP 29 Erts 17.1.1\n" = Some "3.28.0") "rebar3 version"
    expect (version_from_output ToolZig "0.18.0-dev.146+35accc06e\n" = Some "0.18.0-dev.146+35accc06e") "zig version"
    expect (version_from_output ToolOtp "" = None) "no output reads as missing"
    expect (version_from_output ToolPython "Python 3.15.0\n" = Some "3.15.0") "python --version"

///> rust
test rust_follows_the_toolchain_file_when_it_is_installed =
    inl listed =
        installed_channels (
            "stable-x86_64-pc-windows-msvc\nnightly-2025-05-09-x86_64-pc-windows-msvc (default)\n"
            ^^ "nightly-2026-10-18-x86_64-pc-windows-msvc\n"
        )
    expect ((listm.length listed : i32) = 3i32) "three installed toolchains"
    expect
        (rust_local (Some "nightly-2026-10-18") listed (Some "nightly-2025-05-09") = Some "nightly-2026-10-18")
        "the file wins when installed"
    expect
        (rust_local (Some "nightly-2027-01-01") listed (Some "nightly-2025-05-09") = None)
        "a file channel that is not installed is missing"
    expect (rust_local None listed (Some "nightly-2025-05-09") = Some "nightly-2025-05-09") "no file: rustup's default"

///> rust
test an_unset_override_keeps_the_program =
    inl probe = { program = "zig"; args = [ "version" ]; override_variable = Some "EOIE_CI_PARITY_TEST_UNSET" }
    expect (probe_program probe = "zig") "an unset override keeps the program"
    expect (local_version "cobol" "C:/eoie-ci-parity-no-such-repo" = (false, "")) "an unknown tool is not probed"
