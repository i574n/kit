:< sm'_operators
:< review

:= usage () : string =
    "kit error: repo usage: repo accept-review <before> <after> (passes when every changed line differs in numeric "
    ^^ "literals only)"

:~ reviewed_files (~before_path : string) (~after_path : string) : i32 =
    := review = accept_review (file_system.read_all_text before_path) (file_system.read_all_text after_path)
    := _ = ? review.report = "" ?> () |: console.write_line review.report
    := verdict = ? review.passed ?> "ok" |: "refused"
    console.write_line (
        "kit repo accept-review " ++# verdict ++# " before=" ++# before_path ++# " after=" ++# after_path
    )
    ? review.passed ?> 0i32 |: 1i32

:~ accept_review_run () : i32 =
    := before_path = optionm'.default_value "" (env.try_command_line_argument 2i32)
    := after_path = optionm'.default_value "" (env.try_command_line_argument 3i32)
    ? before_path = "" || after_path = "" ?>
        console.write_line (usage ())
        2i32
    |? file_system.file_exists before_path |> not ?>
        console.write_line ("kit error: repo accept-review: no file at " ++# before_path)
        2i32
    |? file_system.file_exists after_path |> not ?>
        console.write_line ("kit error: repo accept-review: no file at " ++# after_path)
        2i32
    |: reviewed_files before_path after_path

:= main () : i32 =
    !!!!Export("kit_repo_accept_review_run", ((\ () => accept_review_run ()) : () -> i32))
    0i32
