///- --package .
:# review static =
    :< sm'_operators

:< sm'_operators


:| token_kind =
    | WordToken
    | NumberToken
    | OperatorToken
    | MarkToken

:== token =
    {
        kind : token_kind
        text : string
    }

:| change_kind =
    | LiteralChange
    | BooleanChange
    | ComparisonChange
    | ShapeChange

:= change_rank (kind : change_kind) : i32 =
    ?= kind ?|
    | LiteralChange => 1i32
    | BooleanChange => 2i32
    | ComparisonChange => 3i32
    | ShapeChange => 4i32

:= change_word (kind : change_kind) : string =
    ?= kind ?|
    | LiteralChange => "literal"
    | BooleanChange => "BOOLEAN"
    | ComparisonChange => "COMPARISON"
    | ShapeChange => "SHAPE"

:= worse (a : change_kind) (b : change_kind) : change_kind = ? change_rank b > change_rank a ?> b |: a

:= code_at (line : string) (at : i32) : u32 = xml.code_point_at line at
:= width_at (line : string) (at : i32) : i32 = xml.code_point_width line at
:= is_digit (c : u32) : bool = 48u32 <= c && c <= 57u32
:= is_letter (c : u32) : bool = (65u32 <= c && c <= 90u32) || (97u32 <= c && c <= 122u32) || c = 95u32 || c > 127u32
:= is_word_char (c : u32) : bool = is_letter c || is_digit c || c = 39u32
:= is_operator_char (c : u32) : bool = c = 60u32 || c = 62u32 || c = 61u32 || c = 33u32
:= is_space (c : u32) : bool = c = 32u32 || c = 9u32 || c = 13u32

:~ ^ run_end (line : string) (at : i32) (count : i32) (inside : u32 -> bool) : i32 =
    ? at < count && inside (code_at line at) ?> run_end line (at + width_at line at) count inside |: at

:~ number_end (line : string) (at : i32) (count : i32) : i32 =
    := digits = run_end line at count is_digit
    := fraction =
        ? digits + 1i32 < count && code_at line digits = 46u32 && is_digit (code_at line (digits + 1i32)) ?>
            run_end line (digits + 1i32) count is_digit
        |: digits
    run_end line (run_end line fraction count is_letter) count is_digit

:~ ^ tokens_from (line : string) (at : i32) (count : i32) (found : list token) : list token =
    ? count <= at ?> listm.rev found
    |:
        := c = code_at line at
        ? is_space c ?> tokens_from line (at + 1i32) count found
        |:
            := kind, stop =
                ? is_digit c ?> NumberToken, number_end line at count
                |? is_letter c ?> WordToken, run_end line at count is_word_char
                |? is_operator_char c ?> OperatorToken, run_end line at count is_operator_char
                |: MarkToken, at + width_at line at
            tokens_from line stop count ({ kind = kind; text = sm'.substring at (stop - at) line } :: found)

:~ tokens_of (line : string) : list token = tokens_from line 0i32 (sm'.length line : i32) Nil

:= boolean_word (text : string) : bool = text = "true" || text = "false"
:= comparison_run (text : string) : bool =
    text = "<" || text = ">" || text = "<=" || text = ">=" || text = "=" || text = "<>" || text = "!=" || text = "=="

:~ token_change (before : token) (after : token) : change_kind =
    ?= before.kind, after.kind ?|
    | NumberToken, NumberToken => LiteralChange
    | WordToken, WordToken => ? boolean_word before.text && boolean_word after.text ?> BooleanChange |: ShapeChange
    | OperatorToken, OperatorToken =>
        ? comparison_run before.text || comparison_run after.text ?> ComparisonChange |: ShapeChange
    | _ => ShapeChange

:~ ^ tokens_change (before : list token) (after : list token) (seen : change_kind) : change_kind =
    ?= before, after ?|
    | Nil, Nil => seen
    | (b :: before_rest), (a :: after_rest) =>
        tokens_change before_rest after_rest (? b.text = a.text ?> seen |: worse seen (token_change b a))
    | _ => ShapeChange

:~ line_change (before : string) (after : string) : change_kind =
    tokens_change (tokens_of before) (tokens_of after) LiteralChange

:== review =
    {
        passed : bool
        report : string
    }

:~ ^ reviewed_lines
    (before : array string) (after : array string) (at : i32) (passed : bool) (report : string)
    : review
    =
    ? am'.length before <= at ?> { passed = passed; report = report }
    |:
        := b = am'.index at before
        := a = am'.index at after
        ? b = a ?> reviewed_lines before after (at + 1i32) passed report
        |:
            := kind = line_change b a
            := line = "line " ++# sm'.format (at + 1i32) ++# " " ++# change_word kind ++# ": " ++# sm'.trim a
            reviewed_lines before after
                (at + 1i32)
                (passed && change_rank kind = 1i32)
                (? report = "" ?> line |: report ++# "\n" ++# line)

:~ accept_review (before_text : string) (after_text : string) : review =
    := before = sm'.split "\n" before_text |> array
    := after = sm'.split "\n" after_text |> array
    ? am'.length before <> am'.length after ?>
        {
            passed = !-
            report =
                "SHAPE: line count " ++# sm'.format (am'.length before) ++# " -> " ++# sm'.format (am'.length after)
        }
    |: reviewed_lines before after 0i32 !+ ""

///> rust
:# numbers_words_operators_and_marks_tokenize_apart =
    := kinds =
        tokens_of "pin (42i32 + 1.5f64) <= x1"
        |> listm.map (\ t => t.text)
        |> listm.fold (\ acc text => acc ++# "|" ++# text) ""
    testing.expect (kinds = "|pin|(|42i32|+|1.5f64|)|<=|x1") "token texts"

///> rust
:# each_changed_line_gets_the_worst_kind_it_contains =
    testing.expect
        (line_change "expect (cost = 120i32) \"pin\"" "expect (cost = 118i32) \"pin\"" = LiteralChange)
        "a pinned number"
    testing.expect (line_change "expect (ok = true) \"p\"" "expect (ok = false) \"p\"" = BooleanChange) "a flipped boolean"
    testing.expect
        (line_change "expect (n <= 3i32) \"p\"" "expect (n < 4i32) \"p\"" = ComparisonChange)
        "a touched comparison outranks the literal"
    testing.expect
        (line_change "expect (x1 = 2i32) \"p\"" "expect (x2 = 2i32) \"p\"" = ShapeChange)
        "an identifier with digits is not a literal"
    testing.expect (line_change "f a b" "f a b c" = ShapeChange) "an added token"

///> rust
:# a_review_passes_only_on_literal_changes =
    := before = "a\nexpect (cost = 120i32) \"pin\"\nexpect (ok = true) \"p\""
    := literal = accept_review before "a\nexpect (cost = 118i32) \"pin\"\nexpect (ok = true) \"p\""
    testing.expect (literal.passed && literal.report = "line 2 literal: expect (cost = 118i32) \"pin\"") "literal only"
    := flipped = accept_review before "a\nexpect (cost = 118i32) \"pin\"\nexpect (ok = false) \"p\""
    testing.expect
        (flipped.passed = !- && sm'.contains "line 3 BOOLEAN: expect (ok = false)" flipped.report)
        "boolean flip refused"
    testing.expect ((accept_review before "a").passed = !-) "line count change refused"
