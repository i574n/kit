:< agile_subcommand_domain.subcommand

:~ root_flag_refusal (~name : string) (~flag : string) : string =
    ?= agile_subcommand_of name ?|
    | AgileKnown subcommand => agile_root_flag_refusal subcommand flag
    | AgileUnknownName => ""

:= main () : i32 =
    export
        "kit_agile_root_flag_refusal"
        ((\ (name, flag) => root_flag_refusal name flag) : string * string -> string)

    export
        "kit_agile_subcommand_known"
        ((\ value => agile_subcommand_domain.subcommand.agile_subcommand_known value) : string -> i32)
    0i32
