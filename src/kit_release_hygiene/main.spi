:< release_hygiene_policy.model
:< hygiene_terminal
:< incident_recovery_contract.model
:< incident_recovery_terminal
:< runtime_guard


:= main () : i32 =
    := _ = incident_recovery_complete_plan ()
    := _ = incident_recovery_leaf_binding 1i32 1i32
    := _ = incident_recovery_fault_binding 1i32 1i32
    := _ = incident_recovery_scope_mask_binding 15i32 0i32
    := _ = incident_recovery_snapshot_mask_binding 15i32 0i32
    := _ = incident_recovery_restore_mask_binding 15i32 0i32
    := _ = incident_recovery_rollback_mask_binding 7i32 0i32
    := _ = incident_recovery_completion_mask_binding 7i32 0i32
    global "#![allow(dead_code)]"
    hygiene_terminal.emit_runtime ()
    incident_recovery_terminal.emit_runtime ()
    runtime_guard.emit_runtime ()
    !!!!Export(
        "kit_hygiene_primary_binding",
        ((\ (first, second) => hygiene_primary_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_hygiene_secondary_binding",
        ((\ (first, second) => hygiene_secondary_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_hygiene_root_file_binding",
        ((\ (first, second) => hygiene_root_file_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_hygiene_root_aux_binding",
        ((\ (first, second) => hygiene_root_aux_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_hygiene_root_directory_binding",
        ((\ (first, second) => hygiene_root_directory_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export("kit_hygiene_name_classification", ((\ value => hygiene_name_classification value) : string -> u64))
    !!!!Export("kit_hygiene_directory_ignored", ((\ value => hygiene_directory_ignored value) : string -> u64))
    !!!!Export(
        "kit_incident_recovery_scope_mask_binding",
        ((\ (first, second) => incident_recovery_scope_mask_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_incident_recovery_leaf_binding",
        ((\ (first, second) => incident_recovery_leaf_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_incident_recovery_snapshot_mask_binding",
        ((\ (first, second) => incident_recovery_snapshot_mask_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_incident_recovery_restore_mask_binding",
        ((\ (first, second) => incident_recovery_restore_mask_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_incident_recovery_fault_binding",
        ((\ (first, second) => incident_recovery_fault_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_incident_recovery_rollback_mask_binding",
        ((\ (first, second) => incident_recovery_rollback_mask_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_incident_recovery_completion_mask_binding",
        ((\ (first, second) => incident_recovery_completion_mask_binding first second) : i32 * i32 -> i32)
    )
    0i32
