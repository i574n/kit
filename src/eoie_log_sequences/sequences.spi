///- --package .
test sequences static =
    open sm'_operators
    open sequence_model

open sm'_operators
open sequence_model

inl field (index : i32) (parts : array string) : string = optionm'.default_value "" (am'.try_item index parts)

inl event_of (~text : string) : option event =
    inl parts = sm'.split "\t" text |> array
    if am'.length parts < 3i32 then None
    else Some { role = field 0i32 parts; line = optionm'.default_value 0u64 (convert.try_convert (field 1i32 parts)); at_ms = optionm'.default_value 0u64 (convert.try_convert (field 2i32 parts)) }

let rec events_of (lines : array string) (index : i32) (events : list event) : list event =
    if index < 0i32 then events
    else
        match event_of (am'.index index lines) with
        | Some event => events_of lines (index - 1i32) (Cons (event, events))
        | None => events_of lines (index - 1i32) events

inl parsed_events (~text : string) : list event =
    inl lines = sm'.split "\n" text |> array
    events_of lines (am'.length lines - 1i32) Nil

inl outcome_rows (~file : string) (outcome : measure_outcome) : string = rows_text file outcome.rows "" ++# "#unpaired\t" ++# sm'.format outcome.unpaired

inl interval_fold_of (modulo : u64) : interval_fold = if modulo = 0u64 then AsRows else Modulo modulo

inl optional_role (~role : string) : option string = if role = "" then None else Some role

let interval_text (~file : string) (~events : string) (~marked : string) (~between : string) (modulo : u64) : string =
    outcome_rows file (measured (Interval { marked = marked; between = optional_role between; fold = interval_fold_of modulo }) (parsed_events events))

let window_text (~file : string) (~events : string) (~counted : string) (~marker : string) (low : u64) (high : u64) : string =
    outcome_rows file (measured (Window { counted = counted; marker = marker; range = { low = low; high = high } }) (parsed_events events))

let order_text (~file : string) (~events : string) (~first : string) (~second : string) : string =
    outcome_rows file (measured (Order { first = first; second = second }) (parsed_events events))

let latency_text (~file : string) (~events : string) (~starting : string) (~ending : string) : string =
    outcome_rows file (measured (Latency { starting = starting; ending = ending }) (parsed_events events))

let matches_in (~line : string) (pattern : sm'.regex) : u64 = sm'.regex_captures line pattern |> am'.vec_len |> convert.u64

let stamp_in (~line : string) (pattern : sm'.regex) : u64 =
    sm'.regex_captures line pattern
    |> am'.vec_fold' (fun found captures => if found <> "" then found else optionm'.default_value' found (mapm.get "ms" captures)) ""
    |> fun text => optionm'.default_value 0u64 (convert.try_convert text)

let compiled (~pattern : string) : sm'.regex = sm'.new_regex pattern |> resultm.unwrap'

let event_row (~role : string) (number : u64) (at : u64) : string = role ++# "\t" ++# sm'.format number ++# "\t" ++# sm'.format at ++# "\n"

let rec events_in (lines : array string) (index : i32) (time : sm'.regex) (first : sm'.regex) (second : option sm'.regex) (~text : string) : string =
    if index >= am'.length lines then text
    else
        inl line = am'.index index lines
        inl at = stamp_in line time
        inl number = convert.u64 (index + 1i32)
        inl text = if matches_in line first > 0u64 then text ++# event_row "first" number at else text
        inl text =
            match second with
            | Some pattern => if matches_in line pattern > 0u64 then text ++# event_row "second" number at else text
            | None => text
        events_in lines (index + 1i32) time first second text

let events_text (~log : string) (~time : string) (~first : string) (~second : string) : string =
    inl lines = sm'.split "\n" log |> array
    events_in lines 0i32 (compiled time) (compiled first) (if second = "" then None else Some (compiled second)) ""

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

///> rust
test the_text_boundary_reads_role_line_and_time_rows =
    inl events = "request\t1\t1000\nreply\t2\t1250\n\nrequest\t3\t2000\nbroken row\nreply\t4\t2600\n"
    expect (latency_text "b.log" events "request" "reply" = "b.log\t1\t250\nb.log\t3\t600\n#unpaired\t0") (latency_text "b.log" events "request" "reply")
    expect (interval_text "b.log" events "request" "" 0u64 = "b.log\t3\t1000\n#unpaired\t0") (interval_text "b.log" events "request" "" 0u64)
    expect (order_text "b.log" "" "request" "reply" = "b.log\t0\tmissing\n#unpaired\t0") "an empty log has no first occurrence"

inl main () : i32 =
    !!!!Export("eoie_sequence_interval", ((fun (file, events, marked, between, modulo) => interval_text file events marked between modulo) : string * string * string * string * u64 -> string))
    !!!!Export("eoie_sequence_window", ((fun (file, events, counted, marker, low, high) => window_text file events counted marker low high) : string * string * string * string * u64 * u64 -> string))
    !!!!Export("eoie_sequence_order", ((fun (file, events, first, second) => order_text file events first second) : string * string * string * string -> string))
    !!!!Export("eoie_sequence_latency", ((fun (file, events, starting, ending) => latency_text file events starting ending) : string * string * string * string -> string))
    !!!!Export("eoie_sequence_events", ((fun (log, time, first, second) => events_text log time first second) : string * string * string * string -> string))
    0i32
