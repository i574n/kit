:~ family_contract_equal_binding (expected : i32) (observed : i32) : i32 =
    ? expected = observed ?> 1i32 |: 0i32

:= family_contract_shape_binding (gate_mask : i32) (gate_count : i32) : i32 =
    ? gate_mask = 15i32 ?>
        ? gate_count = 4i32 ?> 1i32 |: 0i32
    |: 0i32

:= family_contract_catalog_binding
    (families : i32) (decisions : i32) (unique_families : i32) (unique_decisions : i32)
    : i32
    =
    ? families = 36i32 ?>
        ? decisions = 36i32 ?>
            ? unique_families = 36i32 ?>
                ? unique_decisions = 36i32 ?> 1i32 |: 0i32
            |: 0i32
        |: 0i32
    |: 0i32

:= family_contract_set_binding (matched : i32) (unsettled : i32) : i32 =
    ? matched = 36i32 ?>
        ? unsettled = 0i32 ?> 1i32 |: 0i32
    |: 0i32
