:< sm'_operators
///- --package .
:# agile_todo_model static =
    :< workspace_primitives.numbers

:< workspace_primitives.numbers
:< workspace_primitives.bytes

:| comment_syntax =
    | CFamily
    | HashFamily
    | DashFamily
    | HaskellFamily
    | LeanFamily
    | LispFamily
    | ErlangFamily
    | MarkupFamily
    | MlFamily
    | PascalFamily
    | BatchFamily
    | FsharpFamily

:| syntax_lookup =
    | KnownSyntax : comment_syntax
    | UnknownSyntax

:| path_skip =
    | SkipNestedRepository
    | SkipVendorDirectory
    | SkipUnknownSyntax
    | SkipGeneratedOutput
    | SkipLinkedEntry

:| path_verdict =
    | ScanPath : comment_syntax
    | SkipPath : path_skip

:| content_verdict =
    | ScanContent
    | SkipBinary
    | SkipLarge
    | SkipUnreadable

:| todo_match =
    | NoTodo
    | TodoComment : string

:== scan_tally =
    {
        files : i32
        scanned : i32
        todos : i32
        nested : i32
        vendor : i32
        syntax : i32
        generated : i32
        binary : i32
        large : i32
        links : i32
        unreadable : i32
    }

:= todo_marker () : string = rust_std_string.model.concat5 "TO" "DO" "" "" ""
:= largest_scanned_bytes () : u64 = 33554432u64

:= c_family_extensions () : string =
    "spi|spir|rs|c|h|cc|cpp|cxx|hpp|hh|cs|js|mjs|cjs|ts|tsx|jsx|go|java|kt|kts|swift|zig|gleam|scala|dar"
    ^^ "t|wgsl|glsl|hlsl|proto|jsonc|css|scss|less|php|sv|v"
:= hash_family_extensions () : string =
    "ps1|psm1|psd1|py|pyi|sh|bash|zsh|fish|rb|toml|yml|yaml|ex|exs|r|pl|pm|cmake|nix|conf|cfg|mk|tf|jl|nu|ini|gitig"
    ^^ "nore|gitattributes|editorconfig|dockerignore"
:= hash_family_names () : string = "makefile|dockerfile|justfile|gemfile|rakefile|vagrantfile"
:= dash_family_extensions () : string = "lua|sql|ada|adb|ads|vhd|vhdl"
:= haskell_family_extensions () : string = "hs|lhs|elm|purs|agda|idr"
:= lisp_family_extensions () : string = "clj|cljs|cljc|edn|lisp|lsp|el|scm|ss|rkt|asm|nasm"
:= erlang_family_extensions () : string = "erl|hrl|tex|sty|bib"
:= markup_family_extensions () : string =
    "md|markdown|livemd|html|htm|xhtml|xml|svg|xaml|vue|svelte|csproj|fsproj|props|targets|plist"
:= ml_family_extensions () : string = "ml|mli|sml"
:= pascal_family_extensions () : string = "pas|pp|dpr|dpk|lpr|inc"
:= batch_family_extensions () : string = "bat|cmd"
:= fsharp_family_extensions () : string = "fs|fsx|fsi"
:= vendor_directory_names () : string =
    "node_modules|vendor|third_party|target|dist|_build|.zig-cache|zig-out|.lake|__pycache__|.venv|venv|.gradle|.ne"
    ^^ "xt|bin|obj|deps|.git|.cache|elm-stuff|bower_components|.dart_tool|.mypy_cache|.pytest_cache|.tox"

:~ comment_leaders (syntax : comment_syntax) : string =
    ?= syntax ?|
    | CFamily => "//|/*"
    | HashFamily => "#"
    | DashFamily => "--"
    | HaskellFamily => "--|{-"
    | LeanFamily => "--|/-"
    | LispFamily => ";"
    | ErlangFamily => "%"
    | MarkupFamily => "<!--"
    | MlFamily => "(*"
    | PascalFamily => "//|(*|{"
    | BatchFamily => "::|REM|rem"
    | FsharpFamily => "//|(*"

:= line_start_leaders = \|
    | CFamily => "*"
    | PascalFamily => "{"
    | _ => ""

:= single_quote_strings = \|
    | HashFamily | DashFamily | ErlangFamily => !+
    | _ => !-

:= negated (value : bool) : bool = ? value ?> !- |: !+
:= i32_add a b : i32 = (a + b)
:= i32_sub a b : i32 = (a - b)
:= i32_remainder a b : i32 = (a % b)
:= both (a : bool) (b : bool) : bool = ? a ?> b |: !-
:= ascii_slash () : i32 = 47i32
:= ascii_dot () : i32 = 46i32
:= ascii_newline () : i32 = 10i32
:= ascii_return () : i32 = 13i32
:= ascii_space () : i32 = 32i32
:= ascii_tab () : i32 = 9i32
:= ascii_double_quote () : i32 = 34i32
:= ascii_single_quote () : i32 = 39i32

:~ ^ last_offset_of (~text : string) (~code : i32) (~offset : i32) (~found : i32) : i32 =
    ? byte_len text <= offset ?> found
    |? byte_at text offset = code ?> last_offset_of text code (offset + 1i32) offset
    |: last_offset_of text code (offset + 1i32) found

:~ ^ count_of_byte (~text : string) (~code : i32) (~offset : i32) (~stop : i32) (~count : i32) : i32 =
    ? stop <= offset ?> count
    |? byte_at text offset = code ?> count_of_byte text code (offset + 1i32) stop (count + 1i32)
    |: count_of_byte text code (offset + 1i32) stop count

:~ ^ first_visible_offset (~text : string) (~offset : i32) : i32 =
    ? byte_len text <= offset ?> offset
    |? byte_at text offset = ascii_space () ?> first_visible_offset text (offset + 1i32)
    |? byte_at text offset = ascii_tab () ?> first_visible_offset text (offset + 1i32)
    |: offset

:~ ^ visible_end (~text : string) (~stop : i32) : i32 =
    ? stop <= 0i32 ?> 0i32
    |? byte_at text (stop - 1i32) = ascii_space () ?> visible_end text (stop - 1i32)
    |? byte_at text (stop - 1i32) = ascii_tab () ?> visible_end text (stop - 1i32)
    |? byte_at text (stop - 1i32) = ascii_return () ?> visible_end text (stop - 1i32)
    |: stop

:~ ^ leader_run_start (~text : string) (~start : i32) (~code : i32) : i32 =
    ? start <= 0i32 ?> 0i32
    |? byte_at text (start - 1i32) = code ?> leader_run_start text (start - 1i32) code
    |: start

:= file_name (~relative : string) : string =
    := slash = last_offset_of relative (ascii_slash ()) 0i32 (-1i32)
    byte_slice relative (slash + 1i32) (byte_len relative)

:= extension_of (~name : string) : string =
    := dot = last_offset_of name (ascii_dot ()) 0i32 (-1i32)
    ? dot < 0i32 ?> "" |: byte_slice name (dot + 1i32) (byte_len name)

:~ syntax_of_path (~relative : string) : syntax_lookup =
    := name = ascii_lowercase (file_name relative)
    := extension = extension_of name
    := member (~members : string) : bool =
        both (negated (rust_std_string.model.equals extension "")) (rust_std_string.model.pipe_member members extension)
    ? member (c_family_extensions ()) ?> KnownSyntax CFamily
    |? member (hash_family_extensions ()) ?> KnownSyntax HashFamily
    |? rust_std_string.model.pipe_member (hash_family_names ()) name ?> KnownSyntax HashFamily
    |? member (dash_family_extensions ()) ?> KnownSyntax DashFamily
    |? member (haskell_family_extensions ()) ?> KnownSyntax HaskellFamily
    |? rust_std_string.model.equals extension "lean" ?> KnownSyntax LeanFamily
    |? member (lisp_family_extensions ()) ?> KnownSyntax LispFamily
    |? member (erlang_family_extensions ()) ?> KnownSyntax ErlangFamily
    |? member (markup_family_extensions ()) ?> KnownSyntax MarkupFamily
    |? member (ml_family_extensions ()) ?> KnownSyntax MlFamily
    |? member (pascal_family_extensions ()) ?> KnownSyntax PascalFamily
    |? member (batch_family_extensions ()) ?> KnownSyntax BatchFamily
    |? member (fsharp_family_extensions ()) ?> KnownSyntax FsharpFamily
    |: UnknownSyntax

:~ ^ vendor_segment_from (~relative : string) (~offset : i32) : bool =
    := slash = byte_find_from relative "/" offset
    ? slash < 0i32 ?> !-
    |? rust_std_string.model.pipe_member (vendor_directory_names ()) (byte_slice relative offset slash) ?> !+
    |: vendor_segment_from relative (slash + 1i32)

:= vendor_directory (~name : string) : bool = rust_std_string.model.pipe_member (vendor_directory_names ()) name

:= spiral_source (~relative : string) : bool =
    rust_std_string.model.pipe_member "spi|spir" (extension_of (ascii_lowercase (file_name relative)))

:~ path_verdict (~relative : string) (spiral_sibling : bool) : path_verdict =
    ? rust_std_string.model.ends_with relative "/" ?> SkipPath SkipNestedRepository
    |? vendor_segment_from relative 0i32 ?> SkipPath SkipVendorDirectory
    |:
        ?= syntax_of_path relative ?|
        | UnknownSyntax => SkipPath SkipUnknownSyntax
        | KnownSyntax syntax =>
            ? both spiral_sibling (negated (spiral_source relative)) ?> SkipPath SkipGeneratedOutput
            |: ScanPath syntax

:= case_index \* case_type. (value : case_type) : i32 = union_reflection.cases.union_case_index value

:= case_at \* case_type. (code : i32) (fallback : case_type) : case_type =
    union_reflection.cases.union_case_at code fallback

:= path_verdict_code (verdict : path_verdict) : i32 =
    ?= verdict ?|
    | ScanPath syntax => case_index syntax
    | SkipPath skip => 0i32 - case_index skip

:~ path_verdict_of_code (code : i32) : path_verdict =
    ? 0i32 < code ?> ScanPath (case_at code CFamily) |: SkipPath (case_at (0i32 - code) SkipUnknownSyntax)
:= size_verdict (size : u64) : content_verdict =
    ? (size > (largest_scanned_bytes ())) ?> SkipLarge |: ScanContent

:= bytes_verdict (has_nul : bool) : content_verdict = ? has_nul ?> SkipBinary |: ScanContent

:= identifier_byte (code : i32) : bool =
    ? both (65i32 <= code) (code <= 90i32) ?> !+
    |? both (97i32 <= code) (code <= 122i32) ?> !+
    |? both (48i32 <= code) (code <= 57i32) ?> !+
    |: code = 95i32

:~ outside_quotes (single : bool) (~line : string) (~stop : i32) : bool =
    := even_doubles = i32_remainder (count_of_byte line (ascii_double_quote ()) 0i32 stop 0i32) 2i32 = 0i32
    ? single
    ?> both even_doubles (i32_remainder (count_of_byte line (ascii_single_quote ()) 0i32 stop 0i32) 2i32 = 0i32)
    |: even_doubles

:~ ^ leader_before (~leaders : string) (~before : string) (~offset : i32) : string =
    := bar = byte_find_from leaders "|" offset
    := stop = ? bar < 0i32 ?> byte_len leaders |: bar
    := leader = byte_slice leaders offset stop
    ? rust_std_string.model.ends_with before leader ?> leader
    |? bar < 0i32 ?> ""
    |: leader_before leaders before (bar + 1i32)

:~ ^ earlier_comment (single : bool) (~leaders : string) (~before : string) (~offset : i32) : bool =
    := bar = byte_find_from leaders "|" offset
    := stop = ? bar < 0i32 ?> byte_len leaders |: bar
    := at = byte_find before (byte_slice leaders offset stop)
    ? both (0i32 <= at) (outside_quotes single before at) ?> !+
    |? bar < 0i32 ?> !-
    |: earlier_comment single leaders before (bar + 1i32)

:~ directive_line (~line : string) : bool =
    ? rust_std_string.model.starts_with line "///>" ?> !+ |: rust_std_string.model.starts_with line "///-"

:~ comment_text (~raw : string) : string =
    := trimmed = rust_std_string.model.trim raw
    := closed =
        ? rust_std_string.model.ends_with trimmed "-->" ?> byte_slice trimmed 0i32 (i32_sub (byte_len trimmed) 3i32)
        |? rust_std_string.model.ends_with trimmed "*/" ?> byte_slice trimmed 0i32 (i32_sub (byte_len trimmed) 2i32)
        |? rust_std_string.model.ends_with trimmed "*)" ?> byte_slice trimmed 0i32 (i32_sub (byte_len trimmed) 2i32)
        |? rust_std_string.model.ends_with trimmed "-}" ?> byte_slice trimmed 0i32 (i32_sub (byte_len trimmed) 2i32)
        |: trimmed
    rust_std_string.model.trim closed

:~ todo_in_line (syntax : comment_syntax) (~line : string) : todo_match =
    := marker = byte_find line (todo_marker ())
    ? marker < 0i32
    ?> NoTodo
    |? directive_line line
    ?> NoTodo
    |? identifier_byte (byte_at line (i32_add marker 4i32))
    ?> NoTodo
    |:
        := before = byte_slice line 0i32 (visible_end line marker)
        := leaders = comment_leaders syntax
        := leader = leader_before leaders before 0i32
        := line_leader = line_start_leaders syntax
        := leader_start = i32_sub (byte_len before) (byte_len leader)
        := first_visible = first_visible_offset line 0i32
        ? rust_std_string.model.equals leader ""
        ?>
            ?
                both
                    (negated (rust_std_string.model.equals line_leader ""))
                    (
                        both
                            (rust_std_string.model.ends_with before line_leader)
                            (i32_sub (byte_len before) (byte_len line_leader) = first_visible)
                    )
            ?> TodoComment (comment_text (byte_slice line first_visible (byte_len line)))
            |: NoTodo
        |:
            := start = leader_run_start line leader_start (byte_at leader 0i32)
            := single = single_quote_strings syntax
            ? negated (outside_quotes single line start) ?> NoTodo
            |? earlier_comment single leaders (byte_slice line 0i32 start) 0i32 ?> NoTodo
            |: TodoComment (comment_text (byte_slice line start (byte_len line)))

:= empty_tally () : scan_tally =
    {
        files = 0i32
        scanned = 0i32
        todos = 0i32
        nested = 0i32
        vendor = 0i32
        syntax = 0i32
        generated = 0i32
        binary = 0i32
        large = 0i32
        links = 0i32
        unreadable = 0i32
    }

:~ counted_path (tally : scan_tally) (verdict : path_verdict) : scan_tally =
    := listed = { tally ?| files = (tally.files + 1i32) }
    ?= verdict ?|
    | ScanPath _ => listed
    | SkipPath (SkipNestedRepository) => { listed ?| nested = (listed.nested + 1i32) }
    | SkipPath (SkipVendorDirectory) => { listed ?| vendor = (listed.vendor + 1i32) }
    | SkipPath (SkipUnknownSyntax) => { listed ?| syntax = (listed.syntax + 1i32) }
    | SkipPath (SkipGeneratedOutput) => { listed ?| generated = (listed.generated + 1i32) }
    | SkipPath (SkipLinkedEntry) => { listed ?| links = (listed.links + 1i32) }

:~ counted_content (tally : scan_tally) (verdict : content_verdict) : scan_tally =
    ?= verdict ?|
    | ScanContent => { tally ?| scanned = (tally.scanned + 1i32) }
    | SkipBinary => { tally ?| binary = (tally.binary + 1i32) }
    | SkipLarge => { tally ?| large = (tally.large + 1i32) }
    | SkipUnreadable => { tally ?| unreadable = (tally.unreadable + 1i32) }

:~ counted_todos (tally : scan_tally) (found : i32) : scan_tally = { tally ?| todos = i32_add tally.todos found }

:~ json_escaped (~text : string) : string =
    := backslashes = rust_std_string.model.replace text "\\" "\\\\"
    := quotes = rust_std_string.model.replace backslashes "\"" "\\\""
    := tabs = rust_std_string.model.replace quotes "\t" "\\t"
    rust_std_string.model.replace (rust_std_string.model.replace tabs "\r" "\\r") "\n" "\\n"

:= id_byte (code : i32) : bool =
    ? 65i32 <= code ?> code <= 90i32
    |? 48i32 <= code ?> code <= 57i32
    |: code = 45i32

:~ ^ id_end (~comment : string) (offset : i32) : i32 =
    ? byte_len comment <= offset ?> offset
    |? id_byte (byte_at comment offset) ?> id_end comment (offset + 1i32)
    |: offset

:= declared_id (~backlog : string) (~token : string) : bool =
    ? 0i32 <= byte_find token "-" ?> !+
    |: rust_std_string.model.contains backlog (rust_std_string.model.concat5 "Task (\"" token "\"," "" "")

:~ todo_id (~backlog : string) (~comment : string) : string =
    := marker = byte_find comment (todo_marker ())
    := colon = i32_add marker 4i32
    ? marker < 0i32 ?> ""
    |? byte_at comment colon = 58i32 ?>
        := start = first_visible_offset comment (colon + 1i32)
        := stop = id_end comment start
        := token = byte_slice comment start stop
        := closed = ? byte_len comment <= stop ?> !+ |: byte_at comment stop = 32i32
        := capital = ? stop <= start ?> !- |: both (65i32 <= byte_at comment start) (byte_at comment start <= 90i32)
        ? both (both closed capital) (declared_id backlog token) ?> token |: ""
    |: ""
:= finding_line (~path : string) (line : i32) (~text : string) : string =
    rust_std_string.model.concat5 path ":" (i32_text line) "  " text

:~ finding_json
    (fields_of : string -> string -> string) (~backlog : string) (~path : string) (line : i32) (~text : string)
    : string
    =
    := id = todo_id backlog text
    := fields = fields_of id text
    := identified = ? id = "" ?> "" |: "\"id\":\"" ++# json_escaped id ++# "\",\"fields\":" ++# fields ++# ","
    := head = "{\"path\":\"" ++# json_escaped path ++# "\",\"line\":" ++# i32_text line ++# ","
    head ++# identified ++# "\"text\":\"" ++# json_escaped text ++# "\"}"

:~ ^ leader_prefix (~leaders : string) (~text : string) (~offset : i32) : bool =
    := bar = byte_find_from leaders "|" offset
    := stop = ? bar < 0i32 ?> byte_len leaders |: bar
    := leader = byte_slice leaders offset stop
    ? rust_std_string.model.starts_with text leader ?> !+
    |? bar < 0i32 ?> !-
    |: leader_prefix leaders text (bar + 1i32)

:~ comment_starts_line (syntax : comment_syntax) (~line : string) : bool =
    := first = first_visible_offset line 0i32
    leader_prefix (comment_leaders syntax) (byte_slice line first (byte_len line)) 0i32

:= without_trailing_space (~text : string) : string = $'std::rc::Rc::<str>::from(!text.trim_end())' : string

:~ todo_free (syntax : comment_syntax) (~line : string) : bool =
    ?= todo_in_line syntax line ?|
    | NoTodo => !+
    | TodoComment _ => !-

:~ ^ block_from
    (syntax : comment_syntax) (~text : string) (~column : i32) (~offset : i32) (~block : string) (~lines : i32)
    : string * i32 * i32
    =
    ? byte_len text <= offset
    ?> block, offset, lines
    |:
        := newline = byte_find_from text "\n" offset
        := stop = ? newline < 0i32 ?> byte_len text |: newline
        := line = without_trailing_space (byte_slice text offset stop)
        := aligned = first_visible_offset line 0i32 = column
        := body = byte_slice line column (byte_len line)
        ?
            both (both aligned (comment_starts_line syntax line)) (both (todo_free syntax line) (negated (
                directive_line body)))
        ?>
            block_from syntax text column
                (stop + 1i32)
                (rust_std_string.model.concat5 block "\n" body "" "")
                (lines + 1i32)
        |: block, offset, lines

:| todo_filter =
    | AllTodos
    | TaggedTodos
    | TodosOf : string

:= todo_filter_of (~text : string) : todo_filter =
    ? rust_std_string.model.equals text "" ?> AllTodos
    |? rust_std_string.model.equals text "*" ?> TaggedTodos
    |: TodosOf text

:= selected (filter : todo_filter) (~id : string) : bool =
    ?= filter ?|
    | AllTodos => !+
    | TaggedTodos => negated (rust_std_string.model.equals id "")
    | TodosOf wanted => rust_std_string.model.equals id wanted

:= wide_limit () : i32 = 120i32
:= widest_line (~segment : string) : i32 = $'(!segment).lines().map(|line| line.trim_end().chars().count()).max().unwr\
    ap_or(0) as i32' : i32

:= wides_with (spiral : bool) (~wides : string) (~path : string) (number : i32) (~segment : string) : string =
    ? both spiral (wide_limit () < widest_line segment)
    ?> rust_std_string.model.concat5 wides path ":" (i32_text number) "\n"
    |: wides

:~ ^ findings_from
    (fields_of : string -> string -> string)
    (syntax : comment_syntax) (filter : todo_filter) (spiral : bool) (~backlog : string) (~text : string)
    (~path : string) (json : bool) (~offset : i32) (~number : i32) (~rendered : string) (~count : i32) (~wides : string)
    : string * i32 * string
    =
    ? byte_len text <= offset
    ?> rendered, count, wides
    |:
        := newline = byte_find_from text "\n" offset
        := stop = ? newline < 0i32 ?> byte_len text |: newline
        := line = byte_slice text offset stop
        := next = stop + 1i32
        ?= todo_in_line syntax line ?|
        | NoTodo => findings_from fields_of syntax filter spiral backlog text path json next (number + 1i32) rendered count wides
        | TodoComment comment =>
            := block, after, extra =
                ? comment_starts_line syntax line
                ?> block_from syntax text (first_visible_offset line 0i32) next comment 0i32
                |: comment, next, 0i32
            := following = i32_add (number + 1i32) extra
            ? selected filter (todo_id backlog block)
            ?>
                := entry = ? json ?> finding_json fields_of backlog path number block |: finding_line path number block
                := joined =
                    ? rust_std_string.model.equals rendered ""
                    ?> entry
                    |? json
                    ?> rust_std_string.model.concat5 rendered ",\n" entry "" ""
                    |: rust_std_string.model.concat5 rendered "\n" entry "" ""
                findings_from fields_of syntax filter spiral backlog text path json after following joined
                    (count + 1i32)
                    (wides_with spiral wides path number (byte_slice text offset after))
            |: findings_from fields_of syntax filter spiral backlog text path json after following rendered count wides

:= marker_fields_json (~id : string) (~comment : string) : string =
    marker_fields.fields_json (marker_fields.marker_fields (marker_fields.tail_after id comment))

:= findings
    (fields_of : string -> string -> string)
    (syntax : comment_syntax) (filter : todo_filter) (~backlog : string) (~text : string) (~path : string) (json : bool)
    : string * i32 * string
    =
    findings_from fields_of syntax filter (spiral_source path) backlog text path json 0i32 1i32 "" 0i32 ""

:= tally_skips (tally : scan_tally) : string =
    := a =
        rust_std_string.model.concat5 "nested:" (i32_text tally.nested) ",vendor:" (i32_text tally.vendor) ",generated:"
    := b =
        rust_std_string.model.concat5
            (i32_text tally.generated)
            ",syntax:"
            (i32_text tally.syntax)
            ",binary:"
            (i32_text tally.binary)
    rust_std_string.model.concat5 a b
        ",large:"
        (i32_text tally.large)
        (rust_std_string.model.concat5 ",links:" (i32_text tally.links) ",unreadable:" (i32_text tally.unreadable) "")

:= tally_receipt (roots : i32) (tally : scan_tally) (elapsed : u64) : string =
    := head =
        rust_std_string.model.concat5
            "kit agile todos ok roots="
            (i32_text roots)
            " files="
            (i32_text tally.files)
            " scanned="
    := middle =
        rust_std_string.model.concat5
            (i32_text tally.scanned)
            " todos="
            (i32_text tally.todos)
            " skipped="
            (tally_skips tally)
    rust_std_string.model.concat5 head middle " elapsed_ms=" (u64_text elapsed) ""

:= tally_json_tail (roots : i32) (tally : scan_tally) (elapsed : u64) : string =
    := head =
        rust_std_string.model.concat5
            "],\"roots\":"
            (i32_text roots)
            ",\"files\":"
            (i32_text tally.files)
            ",\"scanned\":"
    := middle =
        rust_std_string.model.concat5
            (i32_text tally.scanned)
            ",\"todo_count\":"
            (i32_text tally.todos)
            ",\"skipped\":{\"nested\":"
            (i32_text tally.nested)
    := skips =
        rust_std_string.model.concat5
            ",\"vendor\":"
            (i32_text tally.vendor)
            ",\"generated\":"
            (i32_text tally.generated)
            ",\"syntax\":"
    := rest =
        rust_std_string.model.concat5
            (i32_text tally.syntax)
            ",\"binary\":"
            (i32_text tally.binary)
            ",\"large\":"
            (
                rust_std_string.model.concat5
                    (i32_text tally.large)
                    ",\"links\":"
                    (i32_text tally.links)
                    ",\"unreadable\":"
                    (i32_text tally.unreadable)
            )
    rust_std_string.model.concat5
        (rust_std_string.model.concat5 head middle skips rest "")
        "},\"elapsed_ms\":"
        (u64_text elapsed)
        "}"
        ""

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail

:= comment_found (found : todo_match) : string =
    ?= found ?|
    | NoTodo => "<none>"
    | TodoComment text => text

:= syntax_label (syntax : comment_syntax) : string =
    ?= syntax ?|
    | CFamily => "c"
    | HashFamily => "hash"
    | FsharpFamily => "fsharp"
    | _ => "other"

:= path_label (verdict : path_verdict) : string =
    ?= verdict ?|
    | ScanPath syntax => rust_std_string.model.concat5 "scan " (syntax_label syntax) "" "" ""
    | SkipPath (SkipNestedRepository) => "nested"
    | SkipPath (SkipVendorDirectory) => "vendor"
    | SkipPath (SkipUnknownSyntax) => "syntax"
    | SkipPath (SkipGeneratedOutput) => "generated"
    | SkipPath (SkipLinkedEntry) => "link"

:= content_label (verdict : content_verdict) : string =
    ?= verdict ?|
    | ScanContent => "scan"
    | SkipBinary => "binary"
    | SkipLarge => "large"
    | SkipUnreadable => "unreadable"

:= labelled (~actual : string) (~expected : string) : () =
    expect
        (rust_std_string.model.equals actual expected)
        (rust_std_string.model.concat5 "expected " expected ", got " actual "")
:= marked (~prefix : string) (~suffix : string) : string =
    rust_std_string.model.concat5 prefix (todo_marker ()) suffix "" ""

///> rust
:# leaders_are_chosen_per_language =
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line CFamily (marked "    // " ": split the crate")))
                (marked "// " ": split the crate")
        )
        "c-family line comment"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line CFamily (marked "inl a = 1 /// " " rename")))
                (marked "/// " " rename")
        )
        "trailing doc comment keeps its whole leader"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line HashFamily (marked "$x = 1 # " ": wire it")))
                (marked "# " ": wire it")
        )
        "powershell trailing comment"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line DashFamily (marked "-- " " port")))
                (marked "-- " " port")
        )
        "lua comment"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line MarkupFamily (marked "<!-- " ": link -->")))
                (marked "<!-- " ": link")
        )
        "markup comment loses its closer"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line FsharpFamily (marked "(* " ": swap the codec *)")))
                (marked "(* " ": swap the codec")
        )
        "fsharp block comment loses its closer"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line CFamily (marked " * " " block")))
                (marked "* " " block")
        )
        "block comment continuation at line start"

///> rust
:# strings_markdown_and_directives_are_not_comments =
    expect
        (rust_std_string.model.equals (comment_found (todo_in_line CFamily (marked "inl s = \"// " ": no\""))) "<none>")
        "a leader inside a string"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line MarkupFamily (marked "**Widget** is a tool (" ").")))
                "<none>"
        )
        "markdown prose"
    expect
        (rust_std_string.model.equals (comment_found (todo_in_line CFamily (marked "a * " " b"))) "<none>")
        "multiplication is not a block continuation"
    expect
        (rust_std_string.model.equals (comment_found (todo_in_line CFamily (marked "///> rust " ""))) "<none>")
        "spiral target directive"
    expect
        (rust_std_string.model.equals (comment_found (todo_in_line CFamily (marked "// " "LIST: words"))) "<none>")
        "marker inside a longer word"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line HashFamily (marked "Write-Output '# " "'")))
                "<none>"
        )
        "a leader inside a single-quoted string"

///> rust
:# typed_marker_fields_parse_before_the_prose =
    := typed = marker_fields.fields_json (marker_fields.marker_fields "est=30m load=light who=pair swap the codec")
    expect (rust_std_string.model.equals typed "{\"est\":30,\"load\":\"light\",\"who\":\"pair\"}") "typed fields"
    := unknown = marker_fields.unknown_count (marker_fields.marker_fields "load=huge est=soon prio=P9 kind=Story left")
    expect (unknown = 3i32) "bad values are unknown fields"
    := bare = marker_fields.fields_json (marker_fields.marker_fields "swap the codec")
    expect (rust_std_string.model.equals bare "{}") "bare marker"

///> rust
:# paths_skip_vendor_generated_and_unknown_files =
    labelled (path_label (path_verdict "deps/The-Spiral-Language/" !-)) "nested"
    labelled (path_label (path_verdict "apps/web/node_modules/x/index.js" !-)) "vendor"
    labelled (path_label (path_verdict "samples/hello/main.c" !+)) "generated"
    labelled (path_label (path_verdict "samples/hello/main.spi" !+)) "scan c"
    labelled (path_label (path_verdict "src/rust_std_fs/portable.rs" !-)) "scan c"
    labelled (path_label (path_verdict "assets/logo.png" !-)) "syntax"
    labelled (path_label (path_verdict "scripts/Makefile" !-)) "scan hash"
    labelled (path_label (path_verdict "src/compiler.fs" !-)) "scan fsharp"
    labelled (content_label (size_verdict 40000000u64)) "large"
    labelled (content_label (bytes_verdict !+)) "binary"

///> rust
:# findings_render_with_line_numbers_and_json =
    := text =
        rust_std_string.model.concat5
            "inl a = 1\n"
            (marked "// " " split")
            "\r\nlet b = 2\n"
            (marked "    // " ": \"quoted\"")
            "\n"
    := lines, count, _ = findings marker_fields_json CFamily AllTodos "" text "repo/a.spi" !-
    expect (count = 2i32) "two findings"
    expect
        (
            rust_std_string.model.equals lines (
                rust_std_string.model.concat5
                    (marked "repo/a.spi:2  // " " split")
                    "\n"
                    (marked "repo/a.spi:4  // " ": \"quoted\"")
                    ""
                    ""
            )
        )
        lines
    := json, json_count, _ = findings marker_fields_json CFamily AllTodos "" text "repo/a.spi" !+
    expect (json_count = 2i32) "two json findings"
    expect
        (
            rust_std_string.model.contains json (
                marked "{\"path\":\"repo/a.spi\",\"line\":4,\"text\":\"// " ": \\\"quoted\\\"\"}"
            )
        )
        json
    := tally =
        counted_todos
            (
                counted_content
                    (counted_path (counted_path (empty_tally ()) (ScanPath CFamily)) (SkipPath SkipGeneratedOutput))
                    ScanContent
            )
            2i32
    expect
        (
            rust_std_string.model.equals
                (tally_skips tally)
                "nested:0,vendor:0,generated:1,syntax:0,binary:0,large:0,links:0,unreadable:0"
        )
        (tally_skips tally)
    expect
        (
            rust_std_string.model.starts_with
                (tally_receipt 1i32 tally 5u64)
                "kit agile todos ok roots=1 files=2 scanned=1 todos=2 skipped="
        )
        (tally_receipt 1i32 tally 5u64)

///> rust
:# todo_blocks_keep_their_spiral_lines_and_ids =
    inl block = rust_std_string.model.concat5 (marked "// " ": KIT-MEMORY-LINKS add the verb") """

        //     inl links root = ()
        //     links "backlog"
        """ "" "" ""
    inl text = rust_std_string.model.concat5 "inl a = 1\n" block """

        let b = 2

        """ (marked "inl c = 3 // " " trailing") """

        // not part of it

        """
    := lines, count, _ = findings marker_fields_json CFamily AllTodos "" text "repo/a.spi" !-
    expect (count = 2i32) "a block and a trailing comment"
    expect (rust_std_string.model.contains lines (rust_std_string.model.concat5 "repo/a.spi:2  " block "" "" "")) lines
    expect (rust_std_string.model.contains lines (marked "repo/a.spi:6  // " " trailing")) lines
    expect (negated (rust_std_string.model.contains lines "not part of it")) lines
    := json, json_count, _ = findings marker_fields_json CFamily AllTodos "" text "repo/a.spi" !+
    expect (json_count = 2i32) "two json findings"
    expect (rust_std_string.model.contains json "\"line\":2,\"id\":\"KIT-MEMORY-LINKS\",\"fields\":{},\"text\":") json
    expect (rust_std_string.model.contains json "\\n//     inl links root = ()\\n//     links \\\"backlog\\\"") json
    expect (rust_std_string.model.equals (todo_id "" (marked "// " " plain")) "") "no id without a tag"
    expect
        (
            rust_std_string.model.equals
                (todo_id "inl deploy () = Task (\"DEPLOY\", \"x\")" (marked "// " ": DEPLOY tune the rollout"))
                "DEPLOY"
        )
        "a single upper-case word is an id when the backlog declares it"
    expect
        (rust_std_string.model.equals (todo_id "" (marked "// " ": split the crate")) "")
        "lower-case text is not an id"
    expect
        (rust_std_string.model.equals (todo_id "" (marked "// " ": KIT-JOBS wire it")) "KIT-JOBS")
        "the tag after the colon"
    expect
        (rust_std_string.model.equals (todo_id "" (marked "# " ": DOC-REFRESH")) "DOC-REFRESH")
        "a tag at the end of the line"

///> rust
:# undeclared_words_and_commented_out_code_are_not_harvested =
    expect
        (
            rust_std_string.model.equals
                (todo_id "inl deploy () = Task (\"DEPLOY\", \"x\")" (marked "// " ": I am doing it like this"))
                ""
        )
        "an undeclared single word is prose"
    expect
        (rust_std_string.model.equals (todo_id "inl dep () = Task (\"DEP\", \"x\")" (marked "// " ": DEPLOY tune")) "")
        "a declared id must match the whole word"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line CFamily (marked "    //if seen.Add b then () // " ": I reuse this later")))
                "<none>"
        )
        "a comment inside commented-out code"
    expect
        (rust_std_string.model.equals (comment_found (todo_in_line CFamily (marked "    // // " ": nested"))) "<none>")
        "a commented-out comment"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line CFamily (marked "let url = \"http://a\" // " ": fetch")))
                (marked "// " ": fetch")
        )
        "a leader inside an earlier string does not hide the comment"
    expect
        (
            rust_std_string.model.equals
                (comment_found (todo_in_line HashFamily (marked "$x = 1 # " ": wire it")))
                (marked "# " ": wire it")
        )
        "code before a comment is fine"

///> rust
:# filters_keep_tagged_blocks_or_one_item =
    := text =
        rust_std_string.model.concat5
            (marked "// " ": KIT-JOBS stop\n")
            (marked "// " " plain\n")
            (marked "// " ": TODO-AS-SOURCE harvest\n")
            ""
            ""
    := _, all, _ = findings marker_fields_json CFamily (todo_filter_of "") "" text "a.spi" !-
    expect (all = 3i32) "every block"
    := _, tagged, _ = findings marker_fields_json CFamily (todo_filter_of "*") "" text "a.spi" !-
    expect (tagged = 2i32) "tagged blocks only"
    := one, only, _ = findings marker_fields_json CFamily (todo_filter_of "KIT-JOBS") "" text "a.spi" !-
    expect (only = 1i32) "one item"
    expect (rust_std_string.model.contains one "a.spi:1  ") one
    := none, missing, _ = findings marker_fields_json CFamily (todo_filter_of "KIT") "" text "a.spi" !-
    expect (missing = 0i32) none

///> rust
:# blocks_wider_than_120_columns_in_spiral_files_are_flagged =
    := long = $'std::rc::Rc::<str>::from("x".repeat(110).as_str())' : string
    := text = rust_std_string.model.concat5 (marked "// " ": short\n") (marked "// " ": KIT-JOBS ") long "\n" ""
    := _, count, wides = findings marker_fields_json CFamily AllTodos "" text "src/a.spi" !-
    expect (count = 2i32) "two blocks"
    expect (rust_std_string.model.equals wides "src/a.spi:2\n") wides
    := _, _, rust_wides = findings marker_fields_json CFamily AllTodos "" text "src/a.rs" !-
    expect (rust_std_string.model.equals rust_wides "") "only Spiral files are rewrapped by the formatter"

///> rust
:# verdicts_survive_the_crate_boundary_as_codes =
    labelled (path_label (path_verdict_of_code (path_verdict_code (path_verdict "lib/a.ps1" !-)))) "scan hash"
    labelled (path_label (path_verdict_of_code (path_verdict_code (path_verdict "samples/a/main.c" !+)))) "generated"
    labelled (path_label (path_verdict_of_code (path_verdict_code (SkipPath SkipLinkedEntry)))) "link"
    labelled (path_label (path_verdict_of_code (path_verdict_code (path_verdict "deps/x/" !-)))) "nested"
    expect (case_index (case_at 11i32 CFamily) = 11i32 && case_index BatchFamily = 11i32) "batch syntax code"
    expect (case_index (case_at 12i32 CFamily) = 12i32 && case_index FsharpFamily = 12i32) "fsharp syntax code"

///> rust
:# files_up_to_32_mib_are_scanned_and_larger_ones_are_skipped =
    := compiler_sized = counted_content (empty_tally ()) (size_verdict 11534336u64)
    expect (rust_std_string.model.contains (tally_skips compiler_sized) "large:0") (tally_skips compiler_sized)
    := oversized = counted_content (empty_tally ()) (size_verdict 33554433u64)
    expect (rust_std_string.model.contains (tally_skips oversized) "large:1") (tally_skips oversized)
