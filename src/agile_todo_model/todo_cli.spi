///- --package ../eoie_cli_harness --timeout 900000
open cli

inl marker () : string = cat "TO" "DO"
inl marked (~prefix : string) (~suffix : string) : string = cat (cat prefix (marker ())) suffix

inl todos (root : fixture_root) (args : cli_args) : cli_run =
    inl slashed = fixture_slashed root
    eoie_run (temp_directory ()) NoArgs NoArgs (Arg ("agile", Arg ("todos", Arg (slashed, Arg (slashed, args)))))

inl mixed_tree (~label : string) : fixture_root =
    inl root = fixture_root_create label
    fixture_write root "a.spi" (marked "inl a = 1\n// " " split\n")
    fixture_write root "main.spi" "inl main () = 0i32\n"
    fixture_write root "main.c" (marked "// " " generated\n")
    fixture_write root "node_modules/x/index.js" (marked "// " " vendored\n")
    fixture_write root "tools/b.ps1" (marked "$x = 1 # " ": wire it\n")
    fixture_write root "notes.md" (marked (marked "Prose (" ").\n<!-- ") ": link -->\n")
    fixture_write root "quoted.rs" (marked "let s = \"// " "\";\n")
    fixture_binary root "logo.bin"
    root

///> rust
test todos_walks_a_plain_directory_and_skips_by_reason =
    inl root = mixed_tree "walk"
    inl run = succeeded (todos root NoArgs)
    shows run (marked "/a.spi:2  // " " split")
    shows run (marked "/tools/b.ps1:1  # " ": wire it")
    shows run (marked "/notes.md:2  <!-- " ": link")
    hides run (marked "// " " generated")
    hides run (marked "// " " vendored")
    hides run "quoted.rs"
    shows run "todos=3"
    shows run "vendor:1"
    shows run "generated:1"
    fixture_root_remove root

///> rust
test todos_lists_a_git_work_tree_without_ignored_output =
    inl root = mixed_tree "git"
    fixture_git_init root
    fixture_write root ".gitignore" "build/\n"
    fixture_write root "build/out.spi" (marked "// " " ignored\n")
    inl run = succeeded (todos root NoArgs)
    shows run (marked "/a.spi:2  // " " split")
    hides run (marked "// " " ignored")
    shows run "todos=3"
    fixture_root_remove root

///> rust
test todos_json_lists_each_comment_once =
    inl root = mixed_tree "json"
    inl run = succeeded (todos root (Arg ("--json", NoArgs)))
    shows run "{\"todos\":["
    shows run (marked "\"line\":2,\"text\":\"// " " split\"}")
    shows run "\"todo_count\":3,\"skipped\":{"
    hides run "\"todos\":3"
    fixture_root_remove root

///> rust
test todos_flag_blocks_whose_item_is_done_or_missing =
    inl root = fixture_root_create "standing"
    inl done_row = "inl done_task () = Task (\"DONE-1\", \"t\", Epic, P0, D0, 100u32, Done, \"\", \"\", \"current\", \"current\")\n"
    inl open_row = "inl open_task () = Task (\"OPEN-1\", \"t\", Epic, P0, D0, 0u32, Active, \"\", \"\", \"current\", \"current\")\n"
    inl word_row = "inl word_task () = Task (\"WORD\", \"t\", Epic, P0, D0, 0u32, Active, \"\", \"\", \"current\", \"current\")\n"
    fixture_write root "state/agile.spi" (cat (cat done_row open_row) word_row)
    fixture_write root "a.spi" (cat (cat (marked "// " ": DONE-1 retire\n") (marked "// " ": OPEN-1 keep\n")) (marked "// " ": GONE-1 orphan\n"))
    fixture_write root "b.spi" (cat (cat (marked "// " ": WORD declared\n") (marked "// " ": I am prose\n")) (marked "    //if seen then () // " ": I reuse it\n"))
    inl run = succeeded (todos root NoArgs)
    shows run "stale (item is Done): DONE-1 at "
    shows run "unknown (no backlog item): GONE-1 at "
    hides run ": OPEN-1 at "
    hides run ": I at "
    hides run "I reuse it"
    shows run (marked "/b.spi:2  // " ": I am prose")
    shows run "todos=5"
    shows run "stale=1 unknown=1 wide=0"
    inl json = succeeded (todos root (Arg ("--json", NoArgs)))
    shows json "\"id\":\"WORD\""
    hides json "\"id\":\"I\""
    inl tagged = succeeded (todos root (Arg ("--tagged", NoArgs)))
    shows tagged (marked "/b.spi:1  // " ": WORD declared")
    hides tagged "I am prose"
    shows tagged "todos=4"
    fixture_root_remove root
