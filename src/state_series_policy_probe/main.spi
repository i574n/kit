:< state_series_contract.model

:= main () : i32 =
    ?= series_sequence_binding 10i32 11i32 ?|
    | 1 =>
        ?= series_source_binding 17i32 32i32 ?|
        | 1 =>
            ?= series_pair_binding 1i32 1i32 ?|
            | 1 =>
                ?= series_monotonic_binding 144i32 159i32 ?|
                | 1 =>
                    ?= series_fingerprint_binding 1i32 1i32 ?|
                    | 1 => 0i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
