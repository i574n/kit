:< hash_integrity_contract.model

:= main () : i32 =
    := bad_file = file_hash_binding 1i32 1i32 1i32
    := bad_tree = tree_parity_binding 2i32 1i32 1i32
    := bad_shadow_same_hash = shadow_deletion_binding 2i32 1i32 0i32
    := bad_shadow_no_deletion = shadow_deletion_binding 2i32 2i32 1i32
    := bad_symlink_accepted = symlink_rejection_binding 1i32 0i32
    ? bad_file = 0i32 ?>
        ? bad_tree = 0i32 ?>
            ? bad_shadow_same_hash = 0i32 ?>
                ? bad_shadow_no_deletion = 0i32 ?>
                    ? bad_symlink_accepted = 0i32 ?> 0i32 |: 5i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
