:! session_unassigned = ()
:! session_lane_owned = ()
:! session_revision_planned = ()
:! session_cache_classified = ()
:! session_request_completed = ()
:! session_shutdown_verified = ()

:| lane_evidence = | LaneEvidence :: i32 * i32 -> lane_evidence
:| revision_evidence = | RevisionEvidence :: i32 * i32 * i32 -> revision_evidence
:| cache_evidence = | CacheEvidence :: i32 * i32 -> cache_evidence
:| request_evidence = | RequestEvidence :: i32 -> request_evidence
:| shutdown_evidence = | ShutdownEvidence :: i32 -> shutdown_evidence

:| compiler_session_op from to =
    | AssignLane :: lane_evidence -> compiler_session_op session_unassigned session_lane_owned
    | PlanRevision :: revision_evidence -> compiler_session_op session_lane_owned session_revision_planned
    | ClassifyCache :: cache_evidence -> compiler_session_op session_revision_planned session_cache_classified
    | CompleteRequest :: request_evidence -> compiler_session_op session_cache_classified session_request_completed
    | VerifyShutdown :: shutdown_evidence -> compiler_session_op session_request_completed session_shutdown_verified

:| ^ compiler_session_plan from to =
    | SessionStep :: \* from to. compiler_session_op from to -> compiler_session_plan from to
    | SessionThen :: \* from to.
        (\? middle. compiler_session_plan from middle * compiler_session_plan middle to) ->
        compiler_session_plan from to

:~ lane_binding (lanes : i32) (lane : i32) : i32 =
    ? lanes < 1i32 ?> 0i32
    |? lane < 0i32 ?> 0i32
    |? lane < lanes ?> 1i32
    |: 0i32

:~ revision_binding (seen_before : i32) (same_source : i32) (kind_code : i32) : i32 =
    ? seen_before = 0i32 ?> ? kind_code = 0i32 ?> 1i32 |: 0i32
    |? same_source = 1i32 ?> ? kind_code = 1i32 ?> 1i32 |: 0i32
    |? kind_code = 2i32 ?> 1i32
    |: 0i32

:~ cache_binding (revision_code : i32) (cache_code : i32) : i32 =
    ? cache_code = 0i32 ?> 1i32
    |? cache_code = 1i32 ?> ? revision_code = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:~ request_binding (status : i32) : i32 = ? status = 0i32 ?> 1i32 |: 0i32
:~ shutdown_binding (survivors : i32) : i32 = ? survivors = 0i32 ?> 1i32 |: 0i32

:~ authority_binding (lane_ok : i32) (revision_ok : i32) (cache_ok : i32) (request_ok : i32) (shutdown_ok : i32) : i32 =
    := a = lane_ok * revision_ok
    := b = cache_ok * request_ok
    ((a * b) * shutdown_ok)

:= build_session_plan () : compiler_session_plan session_unassigned session_shutdown_verified =
    := lane = LaneEvidence (8i32, 5i32)
    := revision = RevisionEvidence (1i32, 0i32, 2i32)
    := cache = CacheEvidence (1i32, 1i32)
    := request = RequestEvidence 0i32
    := shutdown = ShutdownEvidence 0i32
    SessionThen (\? (
        SessionStep (AssignLane lane),
        SessionThen (\? (
            SessionStep (PlanRevision revision),
            SessionThen (\? (
                SessionStep (ClassifyCache cache),
                SessionThen (\? (
                    SessionStep (CompleteRequest request),
                    SessionStep (VerifyShutdown shutdown)
                ))
            ))
        ))
    ))

:= authority_status () : i32 =
    := _ = build_session_plan ()
    := open_ok = revision_binding 0i32 0i32 0i32
    := change_ok = revision_binding 1i32 0i32 2i32
    := unchanged_ok = revision_binding 1i32 1i32 1i32
    := revision_ok = open_ok * (change_ok * unchanged_ok)
    authority_binding
        (lane_binding 8i32 5i32)
        revision_ok
        (cache_binding 1i32 1i32)
        (request_binding 0i32)
        (shutdown_binding 0i32)
