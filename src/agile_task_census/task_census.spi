:< agile_task_text.model
:< sm'_operators
:< agile_mutation_policy.model
:< workspace_primitives.outcome
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< workspace_primitives.clock
:< workspace_primitives.console
:< workspace_primitives.files

:= i32_text (value : i32) : string = (sm'.show value)

:~ ^ count_status (text : string) (offset : i32) (length : i32) (~status : string) (counted : i32) : i32 =
    := found = byte_find_from text (task_marker ()) offset
    ? found < 0i32 ?> counted
    |:
        := arguments = (found + (task_arguments_offset ()))
        := matching = ? declared_task text found ?> ((tuple_field text arguments length 6i32) = status) |: !-
        := next = ? matching ?> counted + 1i32 |: counted
        count_status text arguments length status next

:~ status_count_text (text : string) (length : i32) (~status : string) : string =
    " " ++# (ascii_lowercase status) ++# "=" ++# (i32_text (count_status text 0i32 length status 0i32))

:~ status_counts (text : string) (length : i32) : string =
    union_reflection.cases.union_cases_joined
        \ (status : agile_status) => status_count_text text length (agile_case_text status)
        ""

:~ status_count_json (text : string) (length : i32) (~status : string) : string =
    "\"" ++# (ascii_lowercase status) ++# "\":" ++# (i32_text (count_status text 0i32 length status 0i32))

:~ status_counts_json (text : string) (length : i32) : string =
    := counts =
        union_reflection.cases.union_cases_joined
            \ (status : agile_status) => status_count_json text length (agile_case_text status)
            ","
    ",\"counts\":{" ++# counts ++# "}"
:~ census_text (text : string) : string = status_counts text (byte_len text)
:~ census_json (text : string) : string = status_counts_json text (byte_len text)

:~ ^ status_of_id (text : string) (~anchor : string) (offset : i32) (length : i32) : string =
    := found = byte_find_from text anchor offset
    ? found < 0i32 ?> ""
    |:
        := arguments = (found + (task_arguments_offset ()))
        ? declared_task text found ?> tuple_field text arguments length 6i32
        |: status_of_id text anchor (found + 1i32) length

:~ task_status_of (text : string) (~id : string) : string =
    status_of_id text ("Task (\"" ++# id ++# "\",") 0i32 (byte_len text)

:~ ^ unsettled_from (text : string) (offset : i32) (length : i32) (~ids : string) : string =
    := found = byte_find_from text (task_marker ()) offset
    ? found < 0i32
    ?> ids
    |:
        := arguments = (found + (task_arguments_offset ()))
        := settled = ? declared_task text found ?> ((tuple_field text arguments length 6i32) = "Done") |: !+
        := id = tuple_field text arguments length 0i32
        unsettled_from text arguments length (
            ? settled ?> ids |: ids ++# (byte_slice id 1i32 (byte_len id - 1i32)) ++# "\n"
        )

:~ unsettled_ids (text : string) : string = unsettled_from text 0i32 (byte_len text) ""

:= main () : i32 =
    !!!!Export("kit_agile_status_counts", ((\ text => census_text text) : string -> string))
    !!!!Export("kit_agile_status_counts_json", ((\ text => census_json text) : string -> string))
    !!!!Export("kit_agile_task_status", ((\ (text, id) => task_status_of text id) : string * string -> string))
    := _ = census_text ""
    !!!!Export("kit_agile_unsettled_ids", ((\ text => unsettled_ids text) : string -> string))
    !!!!Export(
        "kit_agile_first_malformed_task",
        ((\ text => first_malformed_task text 0i32 (byte_len text)) : string -> i32)
    )
    := _ = task_status_of "" ""
    := _ = unsettled_ids ""
    0i32
