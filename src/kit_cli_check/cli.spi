:! fixture_root = string

:| ^ cli_args =
    | NoArgs
    | Arg : string * cli_args

:== cli_run = { code : i32; stdout : string; stderr : string }

:= cat (~left : string) (~right : string) : string =
    $'std::rc::Rc::<str>::from(format\!("{}{}", &*!left, &*!right))' : string
:= contains (~text : string) (~part : string) : bool = $'!text.contains(&*!part)' : bool
:= starts (~text : string) (~part : string) : bool = $'!text.starts_with(&*!part)' : bool
:= ends (~text : string) (~part : string) : bool = $'!text.ends_with(&*!part)' : bool
:= unit_mark () : string = $'std::rc::Rc::<str>::from(char::from(31u8).to_string())' : string

:= ^ joined (args : cli_args) : string =
    ?= args ?|
    | NoArgs => ""
    | Arg (head, rest) => cat (cat head (unit_mark ())) (joined rest)

:= fixture_root_create (~label : string) : fixture_root =
    fixture_root (
        $'{ let stamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos(); \
            let root = std::env::temp_dir().join(format\!("kit spiral test {} {} {}", &*!label, std::process::id(), \
            stamp)); std::fs::create_dir_all(&root).unwrap(); std::rc::Rc::<str>::from(root.to_string_lossy().as_ref()\
            ) }'
        : string
    )

:= temp_directory () : string = $'std::rc::Rc::<str>::from(std::env::temp_dir().to_string_lossy().as_ref())' : string
:= fixture_text_of (fixture_root root) : string = root
:= fixture_path (fixture_root root) (~relative : string) : string = $'std::rc::Rc::<str>::from(std::path::Path::new(&*\
    !root).join(&*!relative).to_string_lossy().as_ref())' : string
:= fixture_read (root : fixture_root) (~relative : string) : string =
    := path = fixture_path root relative
    $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_default().as_str())' : string
:= fixture_write (root : fixture_root) (~relative : string) (~text : string) : () =
    := path = fixture_path root relative
    $'{ let path = std::path::Path::new(&*!path); std::fs::create_dir_all(path.parent().unwrap()).unwrap(); \
        std::fs::write(path, !text.as_bytes()).unwrap(); }' : ()
:= fixture_delete (root : fixture_root) (~relative : string) : () =
    := path = fixture_path root relative
    $'{ let _ = std::fs::remove_file(&*!path); }' : ()
:= fixture_append (root : fixture_root) (~relative : string) (~text : string) : () =
    fixture_write root relative (cat (fixture_read root relative) text)
:= fixture_line_count (root : fixture_root) (~relative : string) : i32 =
    := text = fixture_read root relative
    $'(!text).lines().count() as i32' : i32
:= rustc_program (root : fixture_root) (~name : string) (~source : string) : string =
    := _ = fixture_write root (cat name ".rs") source
    := input = fixture_path root (cat name ".rs")
    := suffix = $'std::rc::Rc::<str>::from(std::env::consts::EXE_SUFFIX)' : string
    := output = fixture_path root (cat name suffix)
    $'{ let built = std::process::Command::new(std::env::var_os("RUSTC").unwrap_or_else(|| \
        "rustc".into())).arg(&*!input).arg("-o").arg(&*!output).output().unwrap(); \
        if \!built.status.success() { std::panic::panic_any(String::from_utf8_lossy(&built.stderr).into_owned()); } }'
    : ()
    output
:= fixture_digest (root : fixture_root) (~relative : string) : string =
    := path = fixture_path root relative
    $'std::rc::Rc::<str>::from(match std::fs::read(&*!path) { Ok(bytes) => { use std::hash::{Hash, Hasher}; \
        let mut hasher = std::collections::hash_map::DefaultHasher::new(); bytes.hash(&mut hasher); \
        format\!("{}:{:016x}", bytes.len(), hasher.finish()) } Err(_) => String::from("absent") }.as_str())' : string
:= fixture_entries (root : fixture_root) (~relative : string) : string =
    := path = fixture_path root relative
    $'std::rc::Rc::<str>::from({ let mut names: Vec<String> = std::fs::read_dir(&*!path).map(|entries| \
        entries.flatten().map(|entry| entry.file_name().to_string_lossy().into_owned()).collect()).unwrap_or_default()\
        ; names.sort(); names.join("|") }.as_str())' : string
:= fixture_mkdir (root : fixture_root) (~relative : string) : () =
    := path = fixture_path root relative
    $'std::fs::create_dir_all(&*!path).unwrap()' : ()
:= fixture_rmdir (root : fixture_root) (~relative : string) : () =
    := path = fixture_path root relative
    $'std::fs::remove_dir(&*!path).unwrap()' : ()
:= fixture_copy (root : fixture_root) (~source : string) (~target : string) : () =
    := from = fixture_path root source
    := into = fixture_path root target
    $'{ std::fs::copy(&*!from, &*!into).unwrap(); }' : ()
:= fixture_canonical (root : fixture_root) (~relative : string) : string =
    := path = fixture_path root relative
    $'std::rc::Rc::<str>::from(std::fs::canonicalize(&*!path).unwrap().display().to_string().as_str())' : string
:= fixture_executable (root : fixture_root) (~relative : string) (~text : string) : () =
    fixture_write root relative text
    := path = fixture_path root relative
    $'{ \#[cfg(unix)] { use std::os::unix::fs::PermissionsExt; \
        std::fs::set_permissions(&*!path, std::fs::Permissions::from_mode(0o755)).unwrap(); } }' : ()
:= fixture_symlink_or_skip (root : fixture_root) (~source : string) (~target : string) : () =
    := from = fixture_path root source
    := into = fixture_path root target
    $'{ \#[cfg(windows)] match std::os::windows::fs::symlink_file(&*!from, &*!into) { Ok(()) => (), \
        Err(error) if error.raw_os_error() == Some(1314) => eprintln\!("symlink privilege unavailable"), \
        Err(error) => std::panic::panic_any(error.to_string()) } \#[cfg(unix)] std::os::unix::fs::symlink(&*!from, \
        &*!into).unwrap(); }' : ()
:= exe_suffix () : string = $'std::rc::Rc::<str>::from(std::env::consts::EXE_SUFFIX)' : string
:= native_name () : string =
    $'std::rc::Rc::<str>::from(format\!("kit{}", std::env::consts::EXE_SUFFIX).as_str())' : string
:= u64_text (~value : u64) : string = $'std::rc::Rc::<str>::from((!value).to_string().as_str())' : string
:= fixture_root_remove (fixture_root root) : () = $'{ let _ = std::fs::remove_dir_all(&*!root); }' : ()
:= fixture_slashed (fixture_root root) : string = $'std::rc::Rc::<str>::from((!root).replace(char::from(92u8), \
    "/").as_str())' : string
:= fixture_binary (root : fixture_root) (~relative : string) : () =
    := path = fixture_path root relative
    $'std::fs::write(&*!path, [0u8, 1u8, 2u8]).unwrap()' : ()
:= fixture_git_init (fixture_root root) : () =
    $'{ let status = std::process::Command::new("git").arg("-C").arg(&*!root).args(["init", "-q"]).status().unwrap(); \
        assert\!(status.success()); }' : ()

:= kit_run (~cwd : string) (sets : cli_args) (drops : cli_args) (args : cli_args) : cli_run =
    := set_text = joined sets
    := drop_text = joined drops
    := arg_text = joined args
    := code, stdout, stderr =
        $'{ let mut command = std::process::Command::new(std::env::var("KIT_BIN_UNDER_TEST").unwrap_or_else(|_| \
            "kit".to_owned())); command.current_dir(&*!cwd).args((!arg_text).split_terminator(char::from(31u8))); \
            for name in (!drop_text).split_terminator(char::from(31u8)) { command.env_remove(name); \
            } for pair in (!set_text).split_terminator(char::from(31u8)) { if let Some((key, \
            value)) = pair.split_once(char::from(61u8)) { command.env(key, value); \
            } } let output = command.output().unwrap_or_else(|error| std::panic::panic_any(format\!("cannot start \
            {:?} (set KIT_BIN_UNDER_TEST): {}", command.get_program(), error))); \
            (output.status.code().unwrap_or(-1), std::rc::Rc::<str>::from(String::from_utf8_lossy(&output.stdout).as_r\
            ef()), std::rc::Rc::<str>::from(String::from_utf8_lossy(&output.stderr).as_ref())) }'
        : i32 * string * string
    { code = code; stdout = stdout; stderr = stderr }

:= kit_run_racing
    (~cwd : string) (sets : cli_args) (drops : cli_args) (args : cli_args) (~marker : string) (~file : string)
    (~suffix : string)
    : cli_run
    =
    := set_text = joined sets
    := drop_text = joined drops
    := arg_text = joined args
    := code, stdout, stderr =
        $'{ let mut command = std::process::Command::new(std::env::var("KIT_BIN_UNDER_TEST").unwrap_or_else(|_| \
            "kit".to_owned())); command.current_dir(&*!cwd).args((!arg_text).split_terminator(char::from(31u8))).stdou\
            t(std::process::Stdio::piped()).stderr(std::process::Stdio::piped()); \
            for name in (!drop_text).split_terminator(char::from(31u8)) { command.env_remove(name); \
            } for pair in (!set_text).split_terminator(char::from(31u8)) { if let Some((key, \
            value)) = pair.split_once(char::from(61u8)) { command.env(key, value); \
            } } let child = command.spawn().unwrap_or_else(|error| std::panic::panic_any(format\!("cannot start {:?} \
            (set KIT_BIN_UNDER_TEST): {}", command.get_program(), error))); let started = std::time::Instant::now(); \
            while \!std::path::Path::new(&*!marker).exists() { if started.elapsed() > \
            std::time::Duration::from_secs(30) { std::panic::panic_any("the command never reached its pause marker"); \
            } std::thread::sleep(std::time::Duration::from_millis(20)); \
            } let before = std::fs::read_to_string(&*!file).unwrap_or_default(); \
            std::fs::write(&*!file, format\!("{}{}", before, &*!suffix)).unwrap(); \
            let output = child.wait_with_output().unwrap(); (output.status.code().unwrap_or(-1), \
            std::rc::Rc::<str>::from(String::from_utf8_lossy(&output.stdout).as_ref()), \
            std::rc::Rc::<str>::from(String::from_utf8_lossy(&output.stderr).as_ref())) }' : i32 * string * string
    { code = code; stdout = stdout; stderr = stderr }

:= kit_run_closing_stdout (~cwd : string) (args : cli_args) : cli_run =
    := arg_text = joined args
    := code, stderr =
        $'{ let mut child = std::process::Command::new(std::env::var("KIT_BIN_UNDER_TEST").unwrap_or_else(|_| \
            "kit".to_owned())).current_dir(&*!cwd).args((!arg_text).split_terminator(char::from(31u8))).stdout(std::pr\
            ocess::Stdio::piped()).stderr(std::process::Stdio::piped()).spawn().unwrap(); drop(child.stdout.take()); \
            let output = child.wait_with_output().unwrap(); (output.status.code().unwrap_or(-1), \
            std::rc::Rc::<str>::from(String::from_utf8_lossy(&output.stderr).as_ref())) }' : i32 * string
    { code = code; stdout = ""; stderr = stderr }

:= on_windows () : bool = $'cfg\!(windows)' : bool
:= on_linux () : bool = $'cfg\!(target_os = "linux")' : bool
:= fixture_link_directory (root : fixture_root) (~source : string) (~link : string) : () =
    := path = fixture_path root link
    $'{ \#[cfg(windows)] { use std::os::windows::process::CommandExt; \
        let created = std::process::Command::new("pwsh").creation_flags(0x0800_0000).args(["-NoProfile", \
        "-NonInteractive", "-Command", "New-Item -ItemType Junction -Path $env:KIT_TEST_LINK -Target \
        $env:KIT_TEST_SOURCE -ErrorAction Stop | Out-Null"]).env("KIT_TEST_LINK", &*!path).env("KIT_TEST_SOURCE", \
        &*!source).output().unwrap(); if \!created.status.success() { \
        std::panic::panic_any(String::from_utf8_lossy(&created.stderr).into_owned()); \
        } } \#[cfg(unix)] std::os::unix::fs::symlink(&*!source, &*!path).unwrap(); }' : ()
:= kit_checkout () : string = $'std::rc::Rc::<str>::from(std::path::PathBuf::from(std::env::var("KIT_BIN_UNDER_TEST").\
    unwrap()).ancestors().nth(4).unwrap().to_string_lossy().as_ref())' : string
:= now_ms () : u64 =
    $'std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis() as u64' : u64

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail
:= run_text (run : cli_run) : string = cat (cat (cat "stdout: " run.stdout) " stderr: ") run.stderr

:= succeeded (run : cli_run) : string =
    expect (run.code = 0i32) (cat "expected success, " (run_text run))
    run.stdout

:= shows (~text : string) (~part : string) : () =
    expect (contains text part) (cat (cat (cat "missing " part) " in: ") text)
:= hides (~text : string) (~part : string) : () =
    expect (contains text part = !-) (cat (cat (cat "unexpected " part) " in: ") text)
:= same (~actual : string) (~expected : string) : () =
    expect (actual = expected) (cat (cat (cat "expected: " expected) " actual: ") actual)

:= rejected_with (run : cli_run) (~code : i32) (~part : string) : () =
    expect (run.code = code) (cat "unexpected exit, " (run_text run))
    shows run.stderr part

:= failed_with (run : cli_run) (~part : string) : () =
    expect (run.code <> 0i32) (cat "expected failure, " (run_text run))
    shows run.stderr part

:= receipt_shape (~stdout : string) (~prefix : string) (~volatile : string) : string =
    $'std::rc::Rc::<str>::from((!stdout).lines().find(|line| line.starts_with(&*!prefix)).map(|line| \
        line.split(char::from(32u8)).map(|token| match token.split_once(char::from(61u8)) { Some((key, \
        _)) if (!volatile).split(char::from(124u8)).any(|name| name == key) => format\!("{}=N", key), \
        _ => token.to_owned() }).collect::<Vec<_>>().join(" ")).unwrap_or_default().as_str())' : string

:= rooted_receipt (~text : string) (~prefix : string) (~volatile : string) (~root : string) : string =
    $'std::rc::Rc::<str>::from((!text).lines().find(|line| line.starts_with(&*!prefix)).map(|line| \
        line.replace(&*!root, "<root>").split(char::from(32u8)).map(|token| match token.split_once(char::from(61u8)) \
        { Some((key, _)) if (!volatile).split(char::from(124u8)).any(|name| name == key) => format\!("{}=N", key), \
        _ => token.replace(char::from(92u8), "/") }).collect::<Vec<_>>().join(" ")).unwrap_or_default().as_str())'
    : string

:= kit_binary () : string = $'std::rc::Rc::<str>::from(std::env::var("KIT_BIN_UNDER_TEST").unwrap_or_else(|_| \
    "kit".to_owned()).as_str())' : string
:= path_exists (~path : string) : bool = $'std::path::Path::new(&*!path).exists()' : bool
:= trimmed (~text : string) : string = $'std::rc::Rc::<str>::from((!text).trim())' : string
:= line_starting (~text : string) (~prefix : string) : string = $'std::rc::Rc::<str>::from((!text).lines().find(|line| \
    line.starts_with(&*!prefix)).unwrap_or("<no such line>"))' : string
:= lines_starting_count (~text : string) (~prefix : string) : i32 = $'(!text).lines().filter(|line| \
    line.starts_with(&*!prefix)).count() as i32' : i32
:= padded (~text : string) (~width : i32) : string = $'std::rc::Rc::<str>::from(format\!("{:<1$}", &*!text, \
    !width as usize).as_str())' : string
:= first_line_of (~text : string) : string = $'std::rc::Rc::<str>::from((!text).lines().next().unwrap_or(""))' : string

:= line_after (~text : string) (~anchor : string) (~offset : i32) : string =
    $'std::rc::Rc::<str>::from({ let lines: Vec<&str> = (!text).lines().collect(); \
        lines.iter().position(|line| *line == &*!anchor).and_then(|at| lines.get(at + (!offset as \
        usize))).copied().unwrap_or("<no such line>") })' : string

:= has_line (~text : string) (~line : string) : bool = $'(!text).lines().any(|candidate| candidate == &*!line)' : bool

:= word_after (~text : string) (~marker : string) : string =
    $'std::rc::Rc::<str>::from((!text).split(&*!marker).nth(1).and_then(|rest| \
        rest.split(char::is_whitespace).next()).unwrap_or(""))' : string

:= utc_minute (~text : string) : bool =
    $'{ let bytes = (!text).as_bytes(); bytes.len() == 17 && bytes[4] == 45u8 && bytes[7] == 45u8 && bytes[10] == \
        84u8 && bytes[13] == 58u8 && bytes[16] == 90u8 }' : bool

:= byte_count (~text : string) : i32 = sm'.length text
:= pause_ms (~millis : u64) : () = $'std::thread::sleep(std::time::Duration::from_millis(!millis))' : ()
:= path_appears (~path : string) (~max_ms : u64) : bool = $'{ let started = std::time::Instant::now(); \
    while \!std::path::Path::new(&*!path).exists() && started.elapsed() < std::time::Duration::from_millis(!max_ms) { \
    std::thread::sleep(std::time::Duration::from_millis(50)); } std::path::Path::new(&*!path).exists() }' : bool
:= decimal (~value : i32) : string = $'std::rc::Rc::<str>::from((!value).to_string().as_str())' : string
