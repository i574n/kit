:= argument (index : i32) : string = $'std::env::args().nth(!index as usize).map(std::rc::Rc::<str>::from).unwrap_or_d\
    efault()' : string
:~ count () : i32 = env.command_line_argument_count () + 1i32
:= separator () : string = $'std::rc::Rc::<str>::from(char::from(0u8).to_string())' : string
:= absolute (value : string) : string = $'std::path::absolute(&*!value).ok().and_then(|p| \
    p.to_str().map(std::rc::Rc::<str>::from)).unwrap_or_default()' : string
:= valid_root (value : string) : bool = $'std::path::Path::new(&*!value).join("src/Cargo.toml").is_file()' : bool
:= running_from (target : string) : bool = $'std::env::current_exe().ok().and_then(|p| \
    p.parent().and_then(std::path::Path::parent).map(std::path::Path::to_owned)).and_then(|p| \
    std::fs::canonicalize(p).ok()).zip(std::fs::canonicalize(&*!target).ok()).is_some_and(|(running,target)| \
    running==target)' : bool
:= compiler_path (value : string) : string = $'std::fs::canonicalize(&*!value).ok().filter(|p| \
    p.is_file()).and_then(|p| p.to_str().map(std::rc::Rc::<str>::from)).unwrap_or_default()' : string
:= compiler_environment () : string = $'std::env::var("KIT_SPIRAL_COMPILE").map(std::rc::Rc::<str>::from).unwrap_or_de\
    fault()' : string
:= parse_u64 (value : string) : u64 = $'!value.parse::<u64>().unwrap_or(0)' : u64
:= print (value : string) : () = $'std::io::Write::write_all(&mut std::io::stdout(),!value.as_bytes()).unwrap()' : ()

:= cargo (root : string) (args : string) (compiler : string) (timeout : u64) : i32 =
    $'{ let mut command=std::process::Command::new("cargo"); command.current_dir(std::path::Path::new(&*!root).join("s\
        rc")); command.args(!args.split(char::from(0u8))); if !compiler.len() > 0 { command.env("KIT_SPIRAL_COMPILE", \
        &*!compiler); } if std::env::var_os("CARGO_BUILD_JOBS").is_none() { command.env("CARGO_BUILD_JOBS", "2"); \
        } if std::env::var_os("RUST_TEST_THREADS").is_none() { command.env("RUST_TEST_THREADS", "1"); \
        } match kit_process::run_bounded(&mut command,!timeout) { Ok(status) => status.code().unwrap_or(1), \
        Err(error) => { let _=std::io::Write::write_all(&mut std::io::stderr(),error.as_bytes()); 2 } } }' : i32

:= capture (root : string) (args : string) (timeout : u64) : bool * string =
    $'{ let mut command=std::process::Command::new("cargo"); command.current_dir(std::path::Path::new(&*!root).join("s\
        rc")).args(!args.split(char::from(0u8))); match kit_process::run_bounded_capture_with_input(&mut \
        command,!timeout,None) { Ok(capture) => match String::from_utf8(capture.stdout) { Ok(text) => \
        (capture.termination == kit_process::ProcessTermination::Exited(0), std::rc::Rc::<str>::from(text)), \
        Err(error) => (false,std::rc::Rc::<str>::from(error.to_string())) }, \
        Err(error) => (false,std::rc::Rc::<str>::from(error)) } }' : bool * string

:= spiral_tests (root : string) (target : string) (names : string) (dry : bool) (timeout : u64) : i32 =
    $'kit_dev_spiral_tests::kit_dev_spiral_tests_run(&*!root,&*!target,&*!names,&char::from(0u8).to_string(),!dry,!timeout\
        )'
    : i32
