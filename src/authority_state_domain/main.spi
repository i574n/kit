:= main () : i32 =
    := _ = authority_state_binding 28i32 0i32
    := _ = authority_live_mask_binding 3i32 0i32
    := _ = authority_declared_mask_binding 0i32 0i32
    := _ = authority_blocker_bit_binding 4i32 0i32
    := _ = authority_blocker_labels "v1"
    !!!!Export("kit_authority_state", ((\ (first, second) => authority_state_binding first second) : i32 * i32 -> i32))
    !!!!Export(
        "kit_authority_declared_mask",
        ((\ (first, second) => authority_declared_mask_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_authority_live_mask",
        ((\ (first, second) => authority_live_mask_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_authority_blocker_bit",
        ((\ (first, second) => authority_blocker_bit_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_authority_blocker_labels",
        ((\ value => authority_blocker_labels value) : string -> string * string * string * string * string)
    )
    0i32
