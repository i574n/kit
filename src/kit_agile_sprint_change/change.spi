///- --package .
:# change static =
    :< sm'_operators
    :< agile_sprint.model

:< sm'_operators
:< agile_sprint.model

:~ standing_of (~status : string) : item_standing =
    ? status = "" ?> ItemUnknown |? status = "Done" ?> ItemDone |: ItemOpen

:~ candidate_of (~state_text : string) (~task : string) : candidate =
    := status = agile_task_census.task_census.status_pair (state_text, task)
    := minutes = agile_planning_fields.planning_fields.minutes_pair (state_text, task)
    { task = task; minutes = minutes; standing = standing_of status }

:~ ^ sprint_has (items : array_base kit_agile_sprint_state.state.item_shown) (~task : string) (at : i32) : bool =
    ? at >= am'.length_base items ?> !-
    |? (am'.index_base at items).task = task ?> !+
    |: sprint_has items task (at + 1i32)

:~ sprint_changed (~root : string) (~id : string) (~task : string) (dropping : bool) : i32 =
    := state = sm'.replace "\\" "/" root ++# "/state"
    := sprints_path = state ++# "/sprints.spi"
    := existing = file_system.read_text_or_empty sprints_path
    := heads = kit_agile_sprint_state.state.sprint_head_of (existing, id)
    := word = ? dropping ?> "drop" |: "add"
    := refuse = \ (why : string) =>
        console.write_error_line ("kit error: agile sprint " ++# word ++# " refused: " ++# why)
        1i32
    ? am'.length_base heads = 0i32 ?> refuse ("no sprint " ++# id)
    |? (am'.index_base 0i32 heads).running |> not ?> refuse ("sprint " ++# id ++# " is closed")
    |:
        := items = kit_agile_sprint_state.state.sprint_items_of (existing, id)
        := present = sprint_has items task 0i32
        := agile_text = file_system.read_text_or_empty (state ++# "/agile.spi")
        := candidate = candidate_of agile_text task
        := problem =
            ? dropping ?> (? present ?> "" |: "item " ++# task ++# " is not in sprint " ++# id)
            |:
                ?= first_refusal [ candidate ] ?|
                | Some (ItemNotOpen _) => "item " ++# task ++# " is unknown or Done"
                | Some (ItemUnestimated _) => "item " ++# task ++# " has no estimate"
                | _ => ""
        ? problem <> "" ?> refuse problem
        |:
            := args = existing, id, task, candidate.minutes, dropping
            file_system.write_all_text sprints_path (kit_agile_sprint_append.append.sprint_item_appended args)
            console.write_line ("kit agile sprint " ++# word ++# " ok id=" ++# id ++# " item=" ++# task)
            0i32

:~ ^ finished_from
    (~agile_text : string) (items : array_base kit_agile_sprint_state.state.item_shown) (at : i32)
    (kept : array kit_agile_sprint_review.review.task_row)
    : array kit_agile_sprint_review.review.task_row
    =
    ? at >= am'.length_base items ?> kept
    |:
        := task = (am'.index_base at items).task
        := done = agile_task_census.task_census.status_pair (agile_text, task) = "Done"
        finished_from agile_text items (at + 1i32) (? done ?> kept ++ ;[ { task = task } ] |: kept)

:~ sprint_closed (~root : string) (~id : string) : i32 =
    := state = sm'.replace "\\" "/" root ++# "/state"
    := sprints_path = state ++# "/sprints.spi"
    := existing = file_system.read_text_or_empty sprints_path
    := heads = kit_agile_sprint_state.state.sprint_head_of (existing, id)
    ? am'.length_base heads = 0i32 || (am'.index_base 0i32 heads).running |> not
    ?>
        console.write_error_line ("kit error: agile sprint close refused: no open sprint " ++# id)
        1i32
    |:
        := items = kit_agile_sprint_state.state.sprint_items_of (existing, id)
        := agile_text = file_system.read_text_or_empty (state ++# "/agile.spi")
        := finished = finished_from agile_text items 0i32 ;[] |> am'.base
        := reviews = kit_agile_sprint_review.review.sprint_review_of (existing, id, finished)
        := closed = kit_agile_sprint_review.review.sprint_closed_text (existing, id, finished)
        file_system.write_all_text sprints_path closed
        := r = am'.index_base 0i32 reviews
        := minutes =
            " done=" ++# sm'.show r.done ++# "m carried=" ++# sm'.show r.carried ++# "m dropped="
            ++# sm'.show r.dropped ++# "m"
        := met = ? r.carried = 0i32 ?> "yes" |: "no"
        console.write_line ("kit agile sprint close ok id=" ++# id ++# minutes ++# " goal_met=" ++# met)
        0i32

:~ sprint_velocity (~root : string) (last : i32) : i32 =
    := text = file_system.read_text_or_empty (sm'.replace "\\" "/" root ++# "/state/sprints.spi")
    := minutes = kit_agile_sprint_state.state.velocity_of (text, last)
    console.write_line ("kit agile sprint velocity ok last=" ++# sm'.show last ++# " minutes=" ++# sm'.show minutes)
    0i32

:~ changed ((root, id, task, dropping) : string * string * string * bool) : i32 = sprint_changed root id task dropping

:~ closed ((root, id) : string * string) : i32 = sprint_closed root id

:~ velocity_shown ((root, last) : string * i32) : i32 = sprint_velocity root last

///> rust
:# an_item_stands_by_its_census_status =
    testing.expect (standing_of "" = ItemUnknown && standing_of "Done" = ItemDone) "unknown and done"
    testing.expect (standing_of "Active" = ItemOpen) "any other status is open"
///> _
:= main () : i32 =
    export "kit_agile_sprint_changed" changed
    export "kit_agile_sprint_closed_run" closed
    export "kit_agile_sprint_velocity_shown" velocity_shown
    0i32
