:< rust_std_string.model
:< kit_receipt.receipt
:< kit_do_git_host.host
:< grammar
:< kit_do_records.records

:== git_tally =
    {
        report : string
        failed : bool
        initialized : u64
        committed : u64
        commits : u64
        matches : u64
        histories : u64
        repos : u64
        changed : u64
        untracked : u64
        statuses : u64
        days : u64
        day_steps : u64
    }

:~ empty_git_tally () : git_tally =
    {
        report = ""
        failed = !-
        initialized = 0u64
        committed = 0u64
        commits = 0u64
        matches = 0u64
        histories = 0u64
        repos = 0u64
        changed = 0u64
        untracked = 0u64
        statuses = 0u64
        days = 0u64
        day_steps = 0u64
    }

:~ lines_joined (~left : string) (~right : string) : string =
    ? right = "" ?> left |? left = "" ?> right |: concat5 left "\n" right "" ""

:~ row (~cells : string) (~next : string) : string = concat5 cells (column ()) next "" ""

:~ succeeded (~outcome : string) : bool = part_at outcome 0i32 = "0"

:~ failure_row (~head : string) (~outcome : string) : string = concat5 head "  failed: " (part_at outcome 2i32) "" ""

:~ reported (~state : git_tally) (~text : string) (~failed : bool) : git_tally =
    { state ?| report = lines_joined state.report text; failed = state.failed || failed }

:~ init_run (~root : string) (~repo : string) (~state : git_tally) : git_tally =
    := outcome = git_run root "" (concat5 "init\n-q\n-b\nmain\n" repo "" "" "") ""
    := head = concat5 "git init " repo "" "" ""
    ? succeeded outcome ?> reported ({ state ?| initialized = state.initialized + 1u64 }) head !-
    |: reported state (failure_row head outcome) !+

:~ commit_run (~root : string) (~repo : string) (~message : string) (~date : string) (~state : git_tally) : git_tally =
    := head = concat5 "git commit " repo "  " message ""
    := added = git_run root repo "add\n-A" ""
    ? succeeded added ?>
        := outcome = git_run root repo (concat5 "commit\n-q\n-m\n" message "" "" "") date
        ? succeeded outcome ?> reported ({ state ?| committed = state.committed + 1u64 }) head !-
        |: reported state (failure_row head outcome) !+
    |: reported state (failure_row head added) !+

:~ history_run (~root : string) (~repo : string) (~needle : string) (~path : string) (~state : git_tally) : git_tally =
    := report, failed, commits, matches =
        $'kit_do_git_reports::kit_do_git_history(&*!root, &*!repo, &*!needle, &*!path)' : string * bool * u64 * u64
    ? failed
    ?> reported state report !+
    |:
        reported
            (
                { state ?|
                    commits = state.commits + commits
                    matches = state.matches + matches
                    histories = state.histories + 1u64
                }
            )
            report
            !-
:~ state_row (~repo : string) (~label : string) (~paths : string) : string =
    ? paths = "" ?> "" |: row repo (row label (row (decimal_text (line_count paths)) (replace paths "\n" ", ")))

:~ ^ repos_status (~root : string) (~repos : string) (~index : u64) (~rows : string) (~state : git_tally) : git_tally =
    ? index < line_count repos
    ?>
        := repo = line_at repos index
        := outcome = git_run root repo "status\n--porcelain\n--untracked-files=all" ""
        ? succeeded outcome
        ?>
            := lines = part_at outcome 1i32
            := modified = porcelain_paths lines !-
            := untracked = porcelain_paths lines !+
            := shown =
                ? lines = ""
                ?> row repo (row "clean" "0")
                |: lines_joined (state_row repo "modified" modified) (state_row repo "untracked" untracked)
            := counted =
                { state ?|
                    repos = state.repos + 1u64
                    changed = state.changed + line_count modified
                    untracked = state.untracked + line_count untracked
                }
            repos_status root repos (index + 1u64) (lines_joined rows shown) counted
        |:
            repos_status root repos
                (index + 1u64)
                (lines_joined rows (row repo (row "failed" (row "-" (part_at outcome 2i32)))))
                { state ?| failed = !+ }
    |: reported ({ state ?| statuses = state.statuses + 1u64 }) (aligned rows) !-

:~ days_run (~root : string) (~repo : string) (~since : string) (~state : git_tally) : git_tally =
    := report, failed, commits, days =
        $'kit_do_git_reports::kit_do_git_days(&*!root, &*!repo, &*!since)' : string * bool * u64 * u64
    ? failed
    ?> reported state report !+
    |:
        reported
            (
                { state ?|
                    commits = state.commits + commits
                    days = state.days + days
                    day_steps = state.day_steps + 1u64
                }
            )
            report
            !-
:~ step_run (~root : string) (step : git_step) (~state : git_tally) : git_tally =
    ?= step ?|
    | GitInit repo => init_run root repo state
    | GitCommit (repo, message, date) => commit_run root repo message date state
    | GitHistory (repo, needle, path) => history_run root repo needle path state
    | GitStatus repos => repos_status root repos 0u64 (row "repo" (row "state" (row "count" "paths"))) state
    | GitDays (repo, since) => days_run root repo since state
    | Blank => state

:~ ^ gits_run (~root : string) (~records : record_list) (~index : i32) (~state : git_tally) : git_tally =
    ? index < record_count records ?>
        ?= git_parsed records index ?|
        | GitParsed step => gits_run root records (index + 1i32) (step_run root step state)
        | GitRejected _ => gits_run root records (index + 1i32) state
    |: state

:~ ^ first_rejection (~records : record_list) (~index : i32) : string =
    ? index < record_count records ?>
        ?= git_parsed records index ?|
        | GitRejected message => message
        | GitParsed _ => first_rejection records (index + 1i32)
    |: ""

:~ segments_joined (~left : string) (~right : string) : string =
    ? left = "" ?> right |? right = "" ?> left |: concat5 left "  " right "" ""

:~ receipt_counts (~state : git_tally) : string =
    := made =
        ? state.initialized + state.committed > 0u64
        ?> concat5 "initialized " (decimal_text state.initialized) "  committed " (decimal_text state.committed) ""
        |: ""
    := history =
        ? state.histories > 0u64
        ?> concat5 "commits " (decimal_text state.commits) "  matches " (decimal_text state.matches) ""
        |: ""
    := status =
        ? state.statuses > 0u64
        ?>
            concat5
                "repos "
                (decimal_text state.repos)
                "  changed "
                (decimal_text state.changed)
                (concat5 "  untracked " (decimal_text state.untracked) "" "" "")
        |: ""
    := days =
        ? state.day_steps > 0u64 && state.histories = 0u64
        ?> concat5 "commits " (decimal_text state.commits) "  days " (decimal_text state.days) ""
        |: ""
    segments_joined (segments_joined made history) (segments_joined status days)

:~ git_program_run (~root : string) (~encoded : string) : i32 =
    := started = now_ms ()
    := records = records_of encoded
    := rejection = first_rejection records 1i32
    ? rejection = "" ?>
        := state = gits_run root records 1i32 (empty_git_tally ())
        := report = state.report
        ? report = "" ?> () |: stdout_line report
        ? state.failed ?>
            receipt_line Failed (receipt_counts state) started
            1i32
        |:
            receipt_line Succeeded (receipt_counts state) started
            0i32
    |:
        stdout_line (concat5 "program rejected: " rejection "" "" "")
        receipt_line Failed "repos 0" started
        2i32

:= main () : i32 =
    !!!!Export("kit_do_git_run", ((\ (root, encoded) => git_program_run root encoded) : string * string -> i32))
    0i32
