:! external_payload_empty = ()
:! external_payload_identified = ()
:! external_payload_cache_selected = ()
:! external_payload_staged = ()
:! external_payload_verified = ()
:! external_payload_promoted = ()

:| external_payload_op from to =
    | IdentifyExternalPayload :: external_payload_op external_payload_empty external_payload_identified
    | SelectExternalPayloadCache :: external_payload_op external_payload_identified external_payload_cache_selected
    | StageExternalPayload :: external_payload_op external_payload_cache_selected external_payload_staged
    | VerifyExternalPayloadStage :: external_payload_op external_payload_staged external_payload_verified
    | PromoteExternalPayload :: external_payload_op external_payload_verified external_payload_promoted

:| ^ external_payload_plan from to =
    | ExternalPayloadStep :: \* from to. external_payload_op from to -> external_payload_plan from to
    | ExternalPayloadThen :: \* from to.
        (\? middle. external_payload_plan from middle * external_payload_plan middle to) ->
        external_payload_plan from to

:= external_payload_hydrate_plan () : external_payload_plan external_payload_empty external_payload_promoted =
    ExternalPayloadThen (\? (
        ExternalPayloadStep IdentifyExternalPayload,
        ExternalPayloadThen (\? (
            ExternalPayloadStep SelectExternalPayloadCache,
            ExternalPayloadThen (\? (
                ExternalPayloadStep StageExternalPayload,
                ExternalPayloadThen (\? (
                    ExternalPayloadStep VerifyExternalPayloadStage,
                    ExternalPayloadStep PromoteExternalPayload
                ))
            ))
        ))
    ))

:~ external_payload_scope_binding
    (payload_safe : i32) (cache_safe : i32) (receipt_safe : i32) (paths_separated : i32)
    : i32
    =
    ? payload_safe < 1i32 ?> 0i32
    |? 1i32 < payload_safe ?> 0i32
    |? cache_safe < 1i32 ?> 0i32
    |? 1i32 < cache_safe ?> 0i32
    |? receipt_safe < 1i32 ?> 0i32
    |? 1i32 < receipt_safe ?> 0i32
    |? paths_separated < 1i32 ?> 0i32
    |? 1i32 < paths_separated ?> 0i32
    |: 1i32

:~ external_payload_identity_binding (receipt_match : i32) (expected_bytes_positive : i32) (hash_shape_ok : i32) : i32 =
    ? receipt_match < 1i32 ?> 0i32
    |? 1i32 < receipt_match ?> 0i32
    |? expected_bytes_positive < 1i32 ?> 0i32
    |? 1i32 < expected_bytes_positive ?> 0i32
    |? hash_shape_ok < 1i32 ?> 0i32
    |? 1i32 < hash_shape_ok ?> 0i32
    |: 1i32

:~ external_payload_hydrate_binding
    (payload_present : i32) (cache_present : i32) (payload_match : i32) (cache_match : i32)
    : i32
    =
    ? payload_present < 0i32 ?> 0i32
    |? 1i32 < payload_present ?> 0i32
    |? cache_present < 0i32 ?> 0i32
    |? 1i32 < cache_present ?> 0i32
    |? payload_match < 0i32 ?> 0i32
    |? 1i32 < payload_match ?> 0i32
    |? cache_match < 0i32 ?> 0i32
    |? 1i32 < cache_match ?> 0i32
    |? payload_present < 1i32 ?>
        ? cache_present < 1i32 ?> 0i32 |: cache_match
    |: payload_match

:~ external_payload_dehydrate_binding
    (payload_present : i32) (payload_match : i32) (cache_present : i32) (cache_match : i32)
    : i32
    =
    ? payload_present < 0i32 ?> 0i32
    |? 1i32 < payload_present ?> 0i32
    |? payload_match < 0i32 ?> 0i32
    |? 1i32 < payload_match ?> 0i32
    |? cache_present < 0i32 ?> 0i32
    |? 1i32 < cache_present ?> 0i32
    |? cache_match < 0i32 ?> 0i32
    |? 1i32 < cache_match ?> 0i32
    |? payload_present < 1i32 ?> 1i32
    |? payload_match < 1i32 ?> 0i32
    |? cache_present < 1i32 ?> 1i32
    |: cache_match

:~ external_payload_stage_binding (cache_match : i32) (stage_absent : i32) (stage_match : i32) : i32 =
    ? cache_match < 1i32 ?> 0i32
    |? 1i32 < cache_match ?> 0i32
    |? stage_absent < 1i32 ?> 0i32
    |? 1i32 < stage_absent ?> 0i32
    |? stage_match < 1i32 ?> 0i32
    |? 1i32 < stage_match ?> 0i32
    |: 1i32

:~ external_payload_completion_binding (expected_match : i32) (other_copy_verified : i32) (cleanup_ok : i32) : i32 =
    ? expected_match < 1i32 ?> 0i32
    |? 1i32 < expected_match ?> 0i32
    |? other_copy_verified < 1i32 ?> 0i32
    |? 1i32 < other_copy_verified ?> 0i32
    |? cleanup_ok < 1i32 ?> 0i32
    |? 1i32 < cleanup_ok ?> 0i32
    |: 1i32

:~ external_payload_scope_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 15i32 ?> 0i32 |? 15i32 < mask ?> 0i32 |? witness < 0i32 ?> 0i32 |? 0i32 < witness ?> 0i32 |: 1i32

:~ external_payload_identity_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 7i32 ?> 0i32 |? 7i32 < mask ?> 0i32 |? witness < 0i32 ?> 0i32 |? 0i32 < witness ?> 0i32 |: 1i32

:~ external_payload_stage_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 7i32 ?> 0i32 |? 7i32 < mask ?> 0i32 |? witness < 0i32 ?> 0i32 |? 0i32 < witness ?> 0i32 |: 1i32

:~ external_payload_completion_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 7i32 ?> 0i32 |? 7i32 < mask ?> 0i32 |? witness < 0i32 ?> 0i32 |? 0i32 < witness ?> 0i32 |: 1i32
