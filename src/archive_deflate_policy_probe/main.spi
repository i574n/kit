
:= main () : i32 =
    global "#![allow(clippy::needless_late_init)]"
    := _ = archive_deflate_domain.deflate_extract_plan ()
    := preflight = archive_deflate_domain.archive_preflight_binding 1i32 1i32
    := entry = archive_deflate_domain.archive_entry_binding 1i32 1i32
    := tar_symlink = archive_deflate_domain.archive_tar_symlink_binding 1i32 1i32
    := tar_hardlink = archive_deflate_domain.archive_tar_hardlink_binding 1i32 1i32
    := tar_long_link = archive_deflate_domain.archive_tar_long_link_binding 1i32 1i32
    := tar_pax_path = archive_deflate_domain.archive_tar_pax_path_binding 1i32 1i32
    := compression = archive_deflate_domain.archive_compression_binding entry 1i32
    := budget = archive_deflate_domain.archive_budget_binding 4096i32 2048i32
    := complete = archive_deflate_domain.archive_complete_binding 2i32 2i32
    := tree = archive_deflate_domain.archive_tree_binding complete 1i32
    := format =
        archive_deflate_domain.archive_format_binding
            (archive_deflate_domain.archive_format_code archive_deflate_domain.TarXzArchive)
            1i32
    ? preflight < 1i32 ?> 1i32
    |? tar_symlink < 1i32 ?> 1i32
    |? tar_hardlink < 1i32 ?> 1i32
    |? tar_long_link < 1i32 ?> 1i32
    |? tar_pax_path < 1i32 ?> 1i32
    |? compression < 1i32 ?> 1i32
    |? budget < 1i32 ?> 1i32
    |? tree < 1i32 ?> 1i32
    |? format < 1i32 ?> 1i32
    |: 0i32
