:~ ^ projection_has_content_loop (text : string) (at : i32) (text_len : i32) : bool =
    ? (=.) at text_len
    ?> !-
    |:
        := current = sm.index text at
        := space = codec_runtime_char " "
        ?
            (=.) current space
            || (=.) current (char_tab ())
            || (=.) current (char_newline ())
            || (=.) current (char_carriage_return ())
        ?> projection_has_content_loop text ((+.) at 1i32) text_len
        |: !+

:= projection_has_content (text : string) : bool =
    projection_has_content_loop text 0i32 (sm.length text : i32)

:= projection_handoff_title (line : string) : string =
    := line_len = sm.length line : i32
    := quote0 = find_char line 0i32 (char_quote ())
    ? (=.) quote0 line_len ?> codec_empty ()
    |:
        := title, after_title, title_ok = parse_quoted line quote0
        ? title_ok && (<=) after_title line_len && projection_has_content title ?> title |: codec_empty ()

:= projection_handoff_body (line : string) : string =
    := line_len = sm.length line : i32
    := quote0 = find_char line 0i32 (char_quote ())
    ? (=.) quote0 line_len
    ?> codec_empty ()
    |:
        := title, after_title, title_ok = parse_quoted line quote0
        ? title_ok && projection_has_content title
        ?>
            := quote1 = find_char line after_title (char_quote ())
            ? (=.) quote1 line_len
            ?> codec_empty ()
            |:
                := body, after_body, body_ok = parse_quoted line quote1
                := quote2 = find_char line after_body (char_quote ())
                ? body_ok && (<=) after_body line_len && (=.) quote2 line_len && projection_has_content body
                ?> body
                |: codec_empty ()
        |: codec_empty ()

:~ ^ projection_handoff_title_seen_loop
    (source : string) (at : i32) (stop_at : i32) (source_len : i32) (title : string)
    : bool
    =
    ? (<) at stop_at ?>
        := line_near_to = find_char source at (char_newline ())
        := line = slice_exclusive source at line_near_to
        := line_len = sm.length line : i32
        := next_at = ? (=.) line_near_to source_len ?> source_len |: (+.) line_near_to 1i32
        ? (<) (find_text line 0i32 "HandoffSection (") line_len ?>
            := prior_title = projection_handoff_title line
            ? (=.) prior_title title ?> !+ |: projection_handoff_title_seen_loop source next_at stop_at source_len title
        |: projection_handoff_title_seen_loop source next_at stop_at source_len title
    |: !-

:= projection_handoff_title_seen_before (source : string) (stop_at : i32) (title : string) : bool =
    projection_handoff_title_seen_loop source 0i32 stop_at (sm.length source : i32) title

:~ ^ handoff_sections_projection_loop
    (source : string) (at : i32) (source_len : i32) (count : i32) (out : string)
    : string
    =
    ? (=.) at source_len ?>
        ? (<) count 4i32 ?> codec_empty ()
        |? (<) 10i32 count ?> codec_empty ()
        |: out
    |:
        := line_near_to = find_char source at (char_newline ())
        := line = slice_exclusive source at line_near_to
        := line_len = sm.length line : i32
        := next_at = ? (=.) line_near_to source_len ?> source_len |: (+.) line_near_to 1i32
        ? (<) (find_text line 0i32 "HandoffSection (") line_len ?>
            := title = projection_handoff_title line
            := body = projection_handoff_body line
            ? (=.) title "" || (=.) body "" || projection_handoff_title_seen_before source at title ?> codec_empty ()
            |:
                := section_prefix = ? (=.) count 0i32 ?> "\n## " |: "\n\n## "
                := out0 = sm.concat out section_prefix
                := out1 = sm.concat out0 title
                inl out2 = sm.concat out1 """



                    """
                := out3 = sm.concat out2 body
                handoff_sections_projection_loop source next_at source_len ((+.) count 1i32) out3
        |: handoff_sections_projection_loop source next_at source_len count out

:~ handoff_sections_projection (source : string) : string =
    handoff_sections_projection_loop source 0i32 (sm.length source : i32) 0i32 "ok"

:= fixture_handoff () : string =
    """
        inl a () = HandoffSection ("A", "one")
        inl b () = HandoffSection ("B", "two")
        inl c () = HandoffSection ("C", "three")
        inl d () = HandoffSection ("D", "four")

        """

:= fixture_handoff_duplicate () : string =
    """
        inl a () = HandoffSection ("A", "one")
        inl b () = HandoffSection ("B", "two")
        inl c () = HandoffSection ("A", "three")
        inl d () = HandoffSection ("D", "four")

        """
