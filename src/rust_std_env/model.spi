:= argument_flag_present (skip : i32) (~flag : string) : bool =
    $'std::env::args().skip(!skip as usize).any(|argument| argument == &*!flag)' : bool

:= argument_count_after (skip : i32) : i32 = $'std::env::args().skip(!skip as usize).count() as i32' : i32

:= argument_after_flag (~flag : string) : string =
    $'std::rc::Rc::<str>::from(std::env::args().skip_while(|arg| arg \!= &*!flag).nth(1).unwrap_or_default())' : string

:= argument_at (~index : i32) : string =
    $'std::rc::Rc::<str>::from(std::env::args().nth(!index as usize).unwrap_or_default())' : string

:= argument_count_is (~expected : i32) : bool =
    $'i32::try_from(std::env::args().skip(2).count()).unwrap_or(i32::MAX) == !expected ' : bool

:= argument_byte_count (~index : i32) : i32 =
    $'usize::try_from(!index).ok().and_then(|index| std::env::args().skip(2).nth(index)).map_or(-1, \
        |value| i32::try_from(value.len()).unwrap_or(i32::MAX))' : i32

:= argument_byte (~index : i32) (~offset : i32) : i32 =
    $'usize::try_from(!index).ok().and_then(|index| std::env::args().skip(2).nth(index)).and_then(|value| \
        usize::try_from(!offset).ok().and_then(|offset| value.as_bytes().get(offset).copied())).map_or(-1, i32::from)'
    : i32

:= argument_equals (~index : i32) (~expected : string) : bool =
    $'usize::try_from(!index).ok().and_then(|index| std::env::args().skip(2).nth(index)).is_some_and(|value| \
        value.as_str() == !expected.as_ref())' : bool

:= variable_or_empty (~name : string) : string =
    $'std::env::var(&*!name).map_or_else(|_| std::rc::Rc::<str>::default(), std::rc::Rc::<str>::from)' : string

:= argument_owned (~index : i32) : string =
    $'usize::try_from(!index).ok().and_then(|index| std::env::args().skip(2).nth(index)).map_or_else(std::rc::Rc::<str\
        >::default, std::rc::Rc::<str>::from)' : string
