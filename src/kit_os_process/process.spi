///- --package .
:# process static =
    :< sm'_operators

:< sm'_operators

:= emit_commit_host () : () =
    global """
        #[cfg(windows)]
        #[repr(C)]
        struct KitProcMem {
            cb: u32, fault: u32, peak_ws: usize, ws: usize, qpp: usize, qp: usize, qpnp: usize, qnp: usize,
            pagefile: usize, peak_pagefile: usize, private_usage: usize,
        }
        #[cfg(windows)]
        fn kit_process_commit(pid: u32) -> u64 {
            unsafe extern "system" {
                fn OpenProcess(access: u32, inherit: i32, pid: u32) -> *mut std::ffi::c_void;
                fn CloseHandle(handle: *mut std::ffi::c_void) -> i32;
                fn K32GetProcessMemoryInfo(process: *mut std::ffi::c_void, counters: *mut KitProcMem, cb: u32) -> i32;
            }
            if pid == 0 { return 0; }
            unsafe {
                let handle = OpenProcess(0x0410, 0, pid);
                if handle.is_null() { return 0; }
                let mut pmc: KitProcMem = std::mem::zeroed();
                pmc.cb = std::mem::size_of::<KitProcMem>() as u32;
                let ok = K32GetProcessMemoryInfo(handle, &mut pmc, pmc.cb) != 0;
                CloseHandle(handle);
                if ok { pmc.private_usage as u64 } else { 0 }
            }
        }
        #[cfg(not(windows))]
        fn kit_process_commit(pid: u32) -> u64 {
            let mut path = String::from("/proc/");
            path.push_str(&pid.to_string());
            path.push_str("/status");
            if let Ok(text) = std::fs::read_to_string(path) {
                for line in text.lines() {
                    if let Some(rest) = line.strip_prefix("VmData:") {
                        return rest.trim().trim_end_matches("kB").trim().parse::<u64>().unwrap_or(0) * 1024;
                    }
                }
            }
            0
        }
        """

:= process_commit_bytes (pid : u32) : u64 =
    := _ = emit_commit_host ()
    $'kit_process_commit(!pid)' : u64

///> rust
:# own_commit_bytes_is_populated =
    := raw = process_commit_bytes ($'std::process::id()' : u32)
    $'assert\!(!raw > 0u64, "own-process commit is zero: PrivateUsage not populated (got {} bytes)", !raw)' : ()
