        "Get-Content C:\\work\\file; pwsh -NoProfile -File C:\\work\\file 2>&1", !+;
        "pwsh -NoProfile -File C:\\work\\file 2>&1 | Select-Object -Last 10", !+;
        "pwsh -NoProfile -File C:\\work\\file -SkipShadows 2>&1", !+;
        "$d = 'C:\\work\\file'; New-Item -ItemType Directory -Force $d | Out-Null; $prog = @'", !+;
        "? at < 0i32 || width = 0i32 ?> [ s ]", !+;
