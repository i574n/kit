        "Push-Location $tmp; & $k do p.do 2>&1 | Select-Object -First 3; Pop-Location", !+;
        "Remove-Item $tmp -Recurse -Force", !+;
        "$w='C:\\work\\file'; if(Test-Path $w){Remove-Item $w -Recurse -Force}", !+;
        "\"live dry-run:\"; & $k do C:\\work\\file --dry-run $p 2>&1 | Select-Object -Last 2", !+;
        "\"scratch apply:\"; & $k do \"$w\\src\" $p 2>&1 | Select-Object -Last 2", !+;
        "Get-Date -Format \"yyyy-MM-dd HH:mm:ss zzz\"", !-;
        "& 'C:\\work\\file' -Path C:\\work\\file -Keep 40 -MaxChars 2500", !-;
        "$cmd = @'", !-;
        "foreach ($root in 'C:\\work\\file','C:\\work\\file') {", !-;
        "Where-Object { $_.LastWriteTime -gt [datetime]'2026-10-27' -and $_.Name -match $pat } |", !-;
        "$enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($cmd))", !-;
        "foreach ($b in 'train3-bundle','train4-bundle') {", !-;
        "\"##### $b\"", !-;
        "$r = \"C:\\work\\file\"", !-;
        "$files = @{}", !-;
