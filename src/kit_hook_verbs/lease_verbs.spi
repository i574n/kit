        ">>> with <<<", !+;
        "pwsh -NoProfile -File C:\\work\\file 2>&1 | Select-Object -Last 8", !+;
        "$d = 'C:\\work\\file'; New-Item -ItemType Directory -Force $d | Out-Null", !+;
