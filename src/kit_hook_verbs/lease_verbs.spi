        "$rel = $_.FullName.Substring((\"$r\\$side\").Length)", !-;
        "if (-not $files.ContainsKey($rel)) { $files[$rel] = @{} }", !-;
        "$files[$rel][$side] = (Get-FileHash $_.FullName -Algorithm SHA1).Hash", !-;
        "\"files compared: $($files.Count); differing: $(@($diff).Count)\"", !-;
        "$rel = $_.FullName.Substring(\"$r\\cand\\\".Length)", !-;
