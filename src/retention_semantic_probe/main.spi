:< rust_std_env.model
:< rust_std_process.model
:< rust_std_fs.model
:< rust_std_fs.rooted_effects

:! retention_probe_start = ()
:! retention_probe_fixture_ready = ()
:! retention_probe_planned = ()
:! retention_probe_receipt_verified = ()
:! retention_probe_complete = ()

:| retention_semantic_transition from to =
    | PrepareRetentionFixture :: retention_semantic_transition retention_probe_start retention_probe_fixture_ready
    | PlanRetentionWindow :: retention_semantic_transition retention_probe_fixture_ready retention_probe_planned
    | VerifyOpaqueReceipt :: retention_semantic_transition retention_probe_planned retention_probe_receipt_verified
    | ConfirmNestedCurrentRejected ::
        retention_semantic_transition retention_probe_receipt_verified retention_probe_complete

:= main () : i32 =
    := kit = argument_owned 0i32
    := base = "/mnt/data/kit-retention-semantic-probe"
    := state = "/mnt/data/kit-retention-semantic-probe/state"
    := package = "/mnt/data/kit-retention-semantic-probe/state/package.spiproj"
    := receipt = "/mnt/data/kit-retention-semantic-probe/state/retention_receipt.spi"
    := rejected_receipt = "/mnt/data/kit-retention-semantic-probe/state/rejected_receipt.spi"
    := _ = cleanup_tree base
    := _ : retention_semantic_transition retention_probe_start retention_probe_fixture_ready = PrepareRetentionFixture
    inl prepared = create_dir state && write_text package """
        modules:
            retention_receipt

        """ && write_text "/mnt/data/kit-retention-semantic-probe/bundle_kit_alpha1.zip" "one" && write_text "/mnt/data/kit-retention-semantic-probe/bundle_kit_alpha2.zip" "two" && write_text "/mnt/data/kit-retention-semantic-probe/bundle_kit_alpha3.zip" "three" && write_text "/mnt/data/kit-retention-semantic-probe/bundle_kit_alpha4.zip" "four" && write_text "/mnt/data/kit-retention-semantic-probe/bundle_kit_alpha5.zip" "five"
    ? prepared
    ?>
        := _ : retention_semantic_transition retention_probe_fixture_ready retention_probe_planned = PlanRetentionWindow
        := plan_code = status_code5 kit "bundle" "retention-plan" base "bundle_kit_alpha5.zip" receipt
        ? plan_code = 0i32
        ?>
            := _ : retention_semantic_transition retention_probe_planned retention_probe_receipt_verified =
                VerifyOpaqueReceipt
            := ok =
                text_contains "fingerprint=" receipt
                && text_contains "current=" receipt
                && text_contains "candidates=5" receipt
                && text_contains "deletes=2" receipt
                && text_contains "remaining=5" receipt
                && text_contains "status=planned" receipt
                && text_excludes "bundle_kit_alpha" receipt
            ? ok
            ?>
                := invalid_code = status_code5 kit "bundle" "retention-plan" base "nested/current.zip" rejected_receipt
                := _ = cleanup_tree base
                ? invalid_code = 0i32
                ?> 31i32
                |:
                    := _ : retention_semantic_transition retention_probe_receipt_verified retention_probe_complete =
                        ConfirmNestedCurrentRejected
                    0i32
            |:
                := _ = cleanup_tree base
                21i32
        |:
            := _ = cleanup_tree base
            11i32
    |: 1i32
