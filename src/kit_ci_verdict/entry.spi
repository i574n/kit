:< verdict

:~ probe_local (name : string) (repo : string) : bool * string =
    $'kit_ci_probe::kit_ci_local_version(&*!name, &*!repo)' : bool * string

:~ rust_installed (channel : string) : bool = $'kit_ci_probe::kit_ci_rust_installed(&*!channel)' : bool

:= main () : i32 =
    !!!!Export(
        "kit_ci_parity_row",
        (
            \ (name, ci, repo) => row_of probe_local rust_installed name ci repo
            : string * string * string -> string * bool
        )
    )
    0i32
