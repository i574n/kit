:< rust_std_process.model

:! probe_start = ()
:! probe_input = ()
:! probe_channels = ()
:! probe_done = ()

:| process_probe from to =
    | ProveInputRoundtrip :: process_probe probe_start probe_input
    | ProveBothChannels :: process_probe probe_input probe_channels
    | ProveClosedStdin :: process_probe probe_channels probe_done

:= main () : i32 =
    := _ : process_probe probe_start probe_input = ProveInputRoundtrip
    := stdin_word = cat_roundtrip_word "stdin-value"
    := stdin_code = capture_word_code stdin_word
    := stdin_stdout = capture_word_stdout_metric stdin_word
    := stdin_stderr = capture_word_stderr_metric stdin_word
    ? stdin_code = 0i32 ?>
        ? stdin_stdout = 1i32 ?>
            ? stdin_stderr = 1i32 ?>
                := _ : process_probe probe_input probe_channels = ProveBothChannels
                := channels_word = shell_capture_word "printf stdout-value && printf stderr-value >&2"
                := channels_code = capture_word_code channels_word
                := channels_stdout = capture_word_stdout_metric channels_word
                := channels_stderr = capture_word_stderr_metric channels_word
                ? channels_code = 0i32 ?>
                    ? channels_stdout = 12i32 ?>
                        ? channels_stderr = 12i32 ?>
                            := _ : process_probe probe_channels probe_done = ProveClosedStdin
                            := closed_word = shell_closed_stdin_word "read value || printf done"
                            := closed_code = capture_word_code closed_word
                            := closed_stdout = capture_word_stdout_metric closed_word
                            := closed_stderr = capture_word_stderr_metric closed_word
                            ? closed_code = 0i32 ?>
                                ? closed_stdout = 4i32 ?>
                                    ? closed_stderr = 0i32 ?> 0i32 |: 33i32
                                |: 32i32
                            |: 31i32
                        |: 23i32
                    |: 22i32
                |: 21i32
            |: 13i32
        |: 12i32
    |: 11i32
