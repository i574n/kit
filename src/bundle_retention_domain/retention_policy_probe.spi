
:= main () : i32 =
    global "#![allow(clippy::needless_return, clippy::needless_late_init)]"
    := _ = current_plus_two_plan ()
    := deletes = retention_window_binding 5i32 3i32
    := current_ok = retention_current_binding 1i32 1i32
    := dry_run_ok = retention_dry_run_binding 2i32 deletes
    := apply_ok = retention_apply_binding dry_run_ok 1i32
    := complete_ok = retention_complete_binding 3i32 3i32
    ? deletes < 2i32 ?> 1i32
    |? 2i32 < deletes ?> 1i32
    |? current_ok < 1i32 ?> 1i32
    |? dry_run_ok < 1i32 ?> 1i32
    |? apply_ok < 1i32 ?> 1i32
    |? complete_ok < 1i32 ?> 1i32
    |: 0i32
