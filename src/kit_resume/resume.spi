:< sm'_operators
:< agile_note_model.model

:~ argument (~index : i32) : string = optionm'.default_value "" (env.try_command_line_argument (index - 1i32))
:= option_value (~name : string) : string = $'std::rc::Rc::<str>::from({ let args = \
    std::env::args().collect::<Vec<_>>(); args.iter().position(|argument| argument == &*!name).and_then(|at| \
    args.get(at + 1)).cloned().unwrap_or_default() }.as_str())' : string
:= stdout_line (~text : string) : () = console.write_line text
:= stderr_line (~text : string) : () = console.write_error_line text
:= clock_text () : string = $'std::rc::Rc::<str>::from(std::time::SystemTime::now().duration_since(std::time::UNIX_EPO\
    CH).map(|elapsed| elapsed.as_secs()).unwrap_or(0).to_string().as_str())' : string
:= own_output (~arguments : string) : string = $'std::rc::Rc::<str>::from(std::env::current_exe().ok().and_then(|exe| \
    std::process::Command::new(exe).args((!arguments).split(char::from(10u8)).filter(|item| \
    \!item.is_empty())).output().ok()).map(|out| String::from_utf8_lossy(&out.stdout).trim_end().to_owned()).unwrap_or\
    _default().as_str())' : string
:= count_text (value : i32) : string = (sm'.show value)
:= state_text (~root : string) : string = $'std::rc::Rc::<str>::from(std::fs::read_to_string(format\!("{}/state/agile.\
    spi", &*!root)).unwrap_or_default().as_str())' : string
:= one_line_clipped (~text : string) (limit : i32) : string = $'std::rc::Rc::<str>::from((!text).replace(char::from(10\
    u8), " ").chars().take(!limit as usize).collect::<String>().as_str())' : string
:= newest_first (~rows : string) (limit : i32) : string = $'std::rc::Rc::<str>::from({ let mut rows = \
    (!rows).split(char::from(10u8)).filter(|row| \!row.is_empty()).collect::<Vec<_>>(); \
    rows.sort_by(|a, b| b.cmp(a)); rows.truncate(!limit as usize); \
    rows.join(&char::from(10u8).to_string()) }.as_str())' : string

:| resume_section =
    | NextWork
    | RecentJobs
    | MachineWindows
    | AuthorNotes

:== resume_scope =
    {
        root : string
        team : string
        author : string
    }

:= section_title (section : resume_section) : string =
    ?= section ?|
    | NextWork => "== next work (agile next, WSJF)"
    | RecentJobs => "== recent jobs (job list)"
    | MachineWindows => "== machine windows (window list)"
    | AuthorNotes => "== recent notes by author (agile notes --as)"

:= spawned_arguments (scope : resume_scope) (section : resume_section) : string =
    ?= section ?|
    | NextWork => "agile\nnext\n" ++# scope.root ++# "\n8" ++# (? scope.team = "" ?> "" |: "\n--team\n" ++# scope.team)
    | RecentJobs => "job\nlist\n12"
    | MachineWindows => "window\nlist"
    | AuthorNotes => ""

:= note_needle () : string = (item_constructor NoteItem) ++# "\""

:~ authored_row (text : string) (found : i32) (~note_text : string) (~at : string) : string =
    at ++# "  " ++# (unquoted (item_field text NoteItem found 0i32)) ++# "  " ++# (one_line_clipped note_text 160i32)

:~ ^ authored_rows_from (text : string) (~needle : string) (~author : string) (offset : i32) (~rows : string) : string =
    := found = declared_from text needle offset
    ? found < 0i32 ?> rows
    |:
        := note = note_at text found
        := kept = ? note.author = author ?> rows ++# "\n" ++# (authored_row text found note.text note.at) |: rows
        authored_rows_from text needle author (found + 1i32) kept

:~ author_notes (scope : resume_scope) : string =
    := rows =
        newest_first
            (
                authored_rows_from
                    (agile_task_text.model.records_text (state_text scope.root))
                    (note_needle ())
                    scope.author
                    0i32
                    ""
            )
            8i32
    ? rows = "" ?> "no notes by " ++# scope.author |: rows

:= section_wanted (scope : resume_scope) (section : resume_section) : bool =
    ?= section ?|
    | AuthorNotes => ? scope.author = "" ?> !- |: !+
    | _ => !+

:= section_body (scope : resume_scope) (section : resume_section) : string =
    ?= section ?|
    | AuthorNotes => author_notes scope
    | spawned => own_output (spawned_arguments scope spawned)

:~ section_shown (scope : resume_scope) (section : resume_section) (shown : i32) : i32 =
    ? section_wanted scope section ?>
        stdout_line (section_title section)
        stdout_line (section_body scope section)
        shown + 1i32
    |: shown

:= scope_suffix (scope : resume_scope) : string =
    (? scope.team = "" ?> "" |: " team=" ++# scope.team) ++# (? scope.author = "" ?> "" |: " author=" ++# scope.author)

:~ resume_run () : i32 =
    := scope = { root = argument 2i32; team = option_value "--team"; author = option_value "--as" }
    ? scope.root = "" || sm'.starts_with "--" scope.root
    ?>
        stderr_line "kit error: usage: kit resume <backlog-root> [--team <team>] [--as <author>]"
        2i32
    |:
        := shown =
            union_reflection.cases.union_cases_fold
                \ shown (section : resume_section) => section_shown scope section shown
                0i32
        stdout_line (
            "kit resume ok sections=" ++# (count_text shown) ++# (scope_suffix scope) ++# " unix=" ++# (clock_text ())
        )
        0i32

:= main () : i32 =
    !!!!Export("kit_resume_run", ((\ () => resume_run ()) : () -> i32))
    0i32
