open sm'_operators
open eoie_receipt.receipt
open eoie_do_write_host.host

type copy_tally =
    {
        report : string
        failed : bool
        copied : u64
        skipped : u64
        bytes : u64
    }

let joined (~left : string) (~right : string) : string =
    if right = "" then left elif left = "" then right else left ++# "\n" ++# right

let counted (~count : u64) (~one : string) (~many : string) : string =
    (decimal_text count) ++# " " ++# (if count = 1u64 then one else many)

let append_step (~root : string) (~path : string) (~line : string) : string * bool * u64 * u64 =
    inl before = file_text root path
    inl newline = if uses_crlf before then crlf () else "\n"
    inl filled = clock_filled line (local_offset_minutes ())
    inl added = (if ended_with_newline before then "" else newline) ++# filled ++# newline
    inl problem = appended_to root path added
    if problem = "" then
        inl after = file_text root path
        inl bytes = text_bytes added
        inl lines = line_count filled
        inl totals = "  now " ++# (counted (line_count after) "line" "lines") ++# ", " ++# (counted (text_bytes after) "byte" "bytes")
        inl row = "append " ++# path ++# "  " ++# (counted lines "line" "lines") ++# ("  " ++# (counted bytes "byte" "bytes") ++# totals)
        row, false, lines, bytes
    else problem, true, 0u64, 0u64

let rec copies_run
    (~root : string) (~base : string) (~destination : string) (~excluded : string) (~paths : string) (~index : u64)
    (~state : copy_tally)
    : copy_tally
    =
    if index < line_count paths then
        inl path = line_at paths index
        inl next =
            if excluded_by excluded path then { state with skipped = state.skipped + 1u64 }
            else
                inl bytes = copied_bytes root path (destination ++# "/" ++# (relative_under base path))
                if bytes < 0i64
                then { state with failed = true; report = joined state.report ("copy " ++# path ++# "  failed") }
                else { state with copied = state.copied + 1u64; bytes = state.bytes + unsigned bytes }
        copies_run root base destination excluded paths (index + 1u64) next
    else state

let copy_step (~root : string) (~source : string) (~destination : string) (~excluded : string) : string * bool * u64 * u64 * u64 =
    inl base = glob_base source
    inl paths = matching root source
    inl after = copies_run root base destination excluded paths 0u64 { report = ""; failed = false; copied = 0u64; skipped = 0u64; bytes = 0u64 }
    inl exclusions =
        if excluded = "" then ""
        else "  " ++# decimal_text after.skipped ++# " skipped (" ++# (sm'.replace "\n" ", " excluded) ++# ")"
    inl row =
        "copy " ++# (if base = "" then "." else base) ++# " -> " ++# destination
        ++# ("  " ++# (counted after.copied "file" "files") ++# "  " ++# (counted after.bytes "byte" "bytes") ++# exclusions)
    inl failed = after.failed || paths = ""
    inl report = if paths = "" then "copy: no file matched " ++# source else row
    joined after.report report, failed, after.copied, after.skipped, after.bytes

inl main () : i32 =
    !!!!Export("eoie_do_append_step", ((fun (root, path, line) => append_step root path line) : string * string * string -> string * bool * u64 * u64))
    !!!!Export("eoie_do_copy_step", ((fun (root, source, destination, excluded) => copy_step root source destination excluded) : string * string * string * string -> string * bool * u64 * u64 * u64))
    0i32
