:< rust_std_env.model

:= mix_low (~low : i32) (~byte : i32) : i32 =
    $'state_receipt_fingerprint_domain::kit_state_receipt_mix_low(!low, !byte)' : i32

:= low_step (~mixed_low : i32) : i32 =
    $'state_receipt_fingerprint_domain::kit_state_receipt_low_step(!mixed_low, 0)' : i32

:= high_step (~high : i32) (~mixed_low : i32) : i32 =
    $'state_receipt_fingerprint_domain::kit_state_receipt_high_step(!high, !mixed_low)' : i32

:= pair_exit (~high : i32) (~low : i32) : i32 =
    $'if !high == -1352410036 && !low == -2046694260 { 0 } else { 1 }' : i32

:= main () : i32 =
    := mixed_low = mix_low -2078137563i32 97i32
    pair_exit (high_step -873292572i32 mixed_low) (low_step mixed_low)
