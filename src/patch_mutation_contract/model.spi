:! patch_idle = ()
:! patch_arguments_ready = ()
:! patch_validated = ()
:! patch_promoted = ()
:! patch_postgate_checked = ()
:! patch_committed = ()
:! patch_restored = ()
:! patch_rehearsed = ()

:| patch_op from to =
    | CollectPatchArguments :: patch_op patch_idle patch_arguments_ready
    | ValidatePatchProtocol :: patch_op patch_arguments_ready patch_validated
    | CommitPatchMutation :: patch_op patch_validated patch_promoted
    | VerifyPatchPostgate :: patch_op patch_promoted patch_postgate_checked
    | ClosePatchMutation :: patch_op patch_postgate_checked patch_committed
    | RestorePatchMutation :: patch_op patch_promoted patch_restored
    | VerifyPatchRestoration :: patch_op patch_restored patch_rehearsed

:| ^ patch_plan from to =
    | PatchStep :: \* from to. patch_op from to -> patch_plan from to
    | PatchThen :: \* from to. (\? middle. patch_plan from middle * patch_plan middle to) -> patch_plan from to

:= typed_patch_plan () : patch_plan patch_idle patch_committed =
    PatchThen (\? (
        PatchStep CollectPatchArguments,
        PatchThen (\? (
            PatchStep ValidatePatchProtocol,
            PatchThen (\? (
                PatchStep CommitPatchMutation,
                PatchThen (\? (PatchStep VerifyPatchPostgate, PatchStep ClosePatchMutation))
            ))
        ))
    ))

:= typed_patch_rehearsal_plan () : patch_plan patch_idle patch_rehearsed =
    PatchThen (\? (
        PatchStep CollectPatchArguments,
        PatchThen (\? (
            PatchStep ValidatePatchProtocol,
            PatchThen (\? (
                PatchStep CommitPatchMutation,
                PatchThen (\? (PatchStep RestorePatchMutation, PatchStep VerifyPatchRestoration))
            ))
        ))
    ))

:= args_len_is expected : bool = rust_std_env.model.args_len_is expected
:= argument_owned index : string = rust_std_env.model.argument_owned index
:= patch_is_apply () : bool = rust_std_env.model.argument_equals 0i32 "apply"
:= patch_is_check () : bool = rust_std_env.model.argument_equals 0i32 "check"
:= patch_is_rehearse () : bool = rust_std_env.model.argument_equals 0i32 "rehearse"
:= patch_is_gated () : bool = rust_std_env.model.argument_equals 0i32 "gated"
:= i32_positive value : bool = $"0 < !value"
:= patch_usage_error () : i32 = $"patch_mutation_error(\"patch supports only: apply|check <root> <plan.spi>\")"
:= patch_rehearse_usage_error () : i32 = $"patch_mutation_error(\"patch rehearse expects: rehearse <root> <plan.spi>\")"
:= patch_gated_usage_error () : i32 = $"patch_gated_error(\"patch gated expects: gated <root> <plan.spi> \
    <gate-program>\")"
:= patch_prepare_context (~root : string) (~plan : string) : string = $"patch_prepare_source_owned(!root.as_ref(), \
    !plan.as_ref())"
:= patch_source_ready source : bool = i32_positive (patch_domain.context.source_len source)
:= patch_apply_context (~context : patch_domain.context.patch_context) (~count : i32) : i32 =
    := root = patch_domain.context.root context
    := source = patch_domain.context.source context
    $"patch_apply_context_owned(!root.as_ref(), !source.as_ref(), !count)"
:= patch_rehearse_context (~context : patch_domain.context.patch_context) (~count : i32) : i32 =
    := root = patch_domain.context.root context
    := source = patch_domain.context.source context
    $"patch_rehearse_context_owned(!root.as_ref(), !source.as_ref(), !count)"
:= patch_gate_timeout_ms () : u64 = 30000u64
:= patch_gated_context
    (~context : patch_domain.context.patch_context) (~count : i32) (~gate_program : string) (~timeout_ms : u64)
    : i32
    =
    := root = patch_domain.context.root context
    := source = patch_domain.context.source context
    $"patch_gated_context_owned(!root.as_ref(), !source.as_ref(), !count, !gate_program.as_ref(), !timeout_ms)"
:= patch_check_physical (~root : string) (~source : string) (~count : i32) : i32 =
    $"patch_check_context_owned(!root.as_ref(), !source.as_ref(), !count)"
:= patch_plan_error code : i32 = $"patch_plan_error(!code)"
:= patch_check_success count : i32 = $"patch_check_success(!count)"
:= patch_preflight_error () : i32 = $"patch_preflight_error()"

:= patch_check_context root source count : i32 =
    := observed = patch_check_physical root source count
    ?= patch_preflight_contract.model.patch_preflight_witness_binding count observed ?|
    | 1 =>
        ?= patch_preflight_contract.model.patch_preflight_mode_binding 0i32 1i32 ?|
        | 1 =>
            ?= patch_preflight_contract.model.patch_preflight_check_binding 0i32 0i32 ?|
            | 1 => patch_check_success observed
            | _ => patch_preflight_error ()
        | _ => patch_preflight_error ()
    | _ => patch_preflight_error ()

:~ patch_entry () : i32 =
    ? args_len_is 3i32 ?>
        := root = argument_owned 1i32
        := plan = argument_owned 2i32
        := source = patch_prepare_context root plan
        ? patch_source_ready source ?>
            := context = patch_domain.context.context root source
            := count = patch_model.model.validation_witness (patch_domain.context.validate_context context)
            ? patch_is_apply () ?>
                ?= patch_preflight_contract.model.patch_preflight_mode_binding 1i32 0i32 ?|
                | 1 => ? i32_positive count ?> patch_apply_context context count |: patch_plan_error count
                | _ => patch_preflight_error ()
            |? patch_is_check () ?>
                ? i32_positive count ?> patch_check_context root source count |: patch_plan_error count
            |: patch_usage_error ()
        |: 2i32
    |: patch_usage_error ()

:~ patch_rehearse_entry () : i32 =
    ? args_len_is 3i32 ?>
        := root = argument_owned 1i32
        := plan = argument_owned 2i32
        := source = patch_prepare_context root plan
        ? patch_source_ready source ?>
            := context = patch_domain.context.context root source
            := count = patch_model.model.validation_witness (patch_domain.context.validate_context context)
            ? patch_is_rehearse () ?>
                ? i32_positive count ?> patch_rehearse_context context count |: patch_plan_error count
            |: patch_rehearse_usage_error ()
        |: 2i32
    |: patch_rehearse_usage_error ()

:~ patch_gated_entry () : i32 =
    ? args_len_is 4i32
    ?>
        := root = argument_owned 1i32
        := plan = argument_owned 2i32
        := gate_program = argument_owned 3i32
        := source = patch_prepare_context root plan
        ? patch_source_ready source
        ?>
            := context = patch_domain.context.context root source
            := count = patch_model.model.validation_witness (patch_domain.context.validate_context context)
            ? patch_is_gated ()
            ?>
                ? i32_positive count
                ?> patch_gated_context context count gate_program (patch_gate_timeout_ms ())
                |: patch_plan_error count
            |: patch_gated_usage_error ()
        |: 2i32
    |: patch_gated_usage_error ()
