open sm'_operators
open pins

inl argument (index : i32) : string = optionm'.default_value "" (env.try_command_line_argument index)

inl split_pair (~text : string) (~separator : string) : string * string =
    inl at = sm'.index_of separator text
    if at <= 0 then text, "" else sm'.substring 0i32 at text, sm'.substring (at + 1i32) (sm'.length text - at - 1i32) text

inl executable_name (~tool : string) : string = if sm'.contains "." tool then tool else tool ++# platform.get_executable_suffix ()

inl path_entries () : array string = sm'.split (if platform.is_windows () then ";" else ":") (env.get_environment_variable "PATH") |> array

let rec found_on_path (entries : array string) (index : i32) (~name : string) (acc : list string) : list string =
    if index < 0i32 then acc
    else
        inl entry = sm'.trim_end_suffix "\\" (sm'.trim_end_suffix "/" (am'.index index entries))
        inl candidate = entry ++# "/" ++# name
        found_on_path entries (index - 1i32) name (if entry <> "" && file_system.file_exists candidate then Cons (candidate, acc) else acc)

let rec pins_from (index : i32) (count : i32) (acc : list tool_pin) (~refusal : string) : list tool_pin * string =
    if index >= count || refusal <> "" then listm.rev acc, refusal
    else
        inl tool, path = split_pair (argument index) "="
        if path = "" then acc, "expects tool=pinned-path, received " ++# argument index
        else pins_from (index + 1i32) count (Cons ({ tool = tool; path = path }, acc)) ""

let rec checked (entries : array string) (pins : list tool_pin) (~text : string) (drifted : u64) : string * u64 =
    match pins with
    | Nil => text, drifted
    | Cons (pin, rest) =>
        inl drift = drift_of pin (found_on_path entries (am'.length entries - 1i32) (executable_name pin.tool) Nil)
        checked entries rest (text ++# drift_text pin drift ++# "\n") (if holds drift then drifted else drifted + 1u64)

inl usage () : string = "usage: env check <tool>=<pinned-path>... (each tool is looked up on PATH in order; the first copy found must be the pinned one)"

let env_run () : i32 =
    inl count = env.command_line_argument_count ()
    if argument 1i32 <> "check" || count < 3i32 then
        console.write_error_line ("eoie error: env " ++# usage ())
        2i32
    else
        inl pins, refusal = pins_from 2i32 count Nil ""
        if refusal <> "" then
            console.write_error_line ("eoie error: env check " ++# refusal ++# "; " ++# usage ())
            2i32
        else
            inl lines, drifted = checked (path_entries ()) pins "" 0u64
            console.write_line (sm'.trim_end_suffix "\n" lines)
            console.write_error_line ("eoie env check " ++# (if drifted = 0u64 then "ok" else "drift") ++# " pins=" ++# sm'.format (listm.length pins : i32) ++# " drifted=" ++# sm'.format drifted)
            if drifted = 0u64 then 0i32 else 1i32

inl main () : i32 =
    !!!!Export("eoie_env_run", ((fun () => env_run ()) : () -> i32))
    0i32
