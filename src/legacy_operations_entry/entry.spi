:< dogfood_shim_bindings
:< exact_replace_contract.model

:! operations_idle = ()
:! operations_completed = ()
:| operations_family = | BundleFamily | ProxyFamily
:| operations_op from to =
    | DispatchOperations :: operations_family -> operations_op operations_idle operations_completed
:| ^ operations_plan from to =
    | OperationsStep :: \* from to. operations_op from to -> operations_plan from to
    | OperationsChoice :: \* from to. operations_plan from to * operations_plan from to -> operations_plan from to
:= migration_frontier () : operations_plan operations_idle operations_completed =
    OperationsChoice (OperationsStep (DispatchOperations BundleFamily), OperationsStep (DispatchOperations ProxyFamily))

:~ proxy_exact_replace_preflight_binding (regular_and_nonempty : i32) (distinct_payloads : i32) : i32 =
    bool_pair_binding regular_and_nonempty distinct_payloads

:~ proxy_exact_replace_authorize_binding (match_count : i32) (mode_valid : i32) : i32 =
    bool_pair_binding (unique_match_binding match_count) mode_valid

:~ proxy_exact_replace_verify_binding (candidate_exact : i32) (rollback_available : i32) : i32 =
    verification_binding candidate_exact 0i32 rollback_available

:| proxy_run_token =
    | RunTimeout
    | RunWorkingDirectory
    | RunProgram
    | RunEnvironment
    | RunUnset
    | RunSeparator

:= run_token_word = \|
    | RunTimeout => "--timeout-ms"
    | RunWorkingDirectory => "--cwd"
    | RunProgram => "--program"
    | RunEnvironment => "--env"
    | RunUnset => "--unset"
    | RunSeparator => "--"

:| proxy_write_token =
    | WriteReplaceExisting
    | WriteExpectHash
    | WriteExpectNonempty
    | WriteSeparator
    | WriteCreateOrReplace

:= write_token_word = \|
    | WriteReplaceExisting => "--replace-existing"
    | WriteExpectHash => "--expect-hash"
    | WriteExpectNonempty => "--expect-nonempty"
    | WriteSeparator => "--"
    | WriteCreateOrReplace => "--create-or-replace"

:= token_code \* token. (value : token) : u64 = $'(!(union_reflection.cases.union_case_index value) - 1) as u64' : u64
:= unmatched_code () : u64 = $'u64::MAX' : u64
:= run_token_named (~input : string) (token : proxy_run_token) : bool = run_token_word token = input
:= write_token_named (~input : string) (token : proxy_write_token) : bool = write_token_word token = input

:~ proxy_run_token_code (~input : string) : u64 =
    union_reflection.cases.union_case_where (run_token_named input) token_code (unmatched_code ())

:~ proxy_write_token_code (~input : string) : u64 =
    union_reflection.cases.union_case_where (write_token_named input) token_code (unmatched_code ())

:| proxy_write_action =
    | CreateMissingFile
    | ReplaceExistingFile
    | RejectOverwriteWithoutFlag
    | RejectEmptyTarget
    | RejectPreconditionsOnMissingFile
    | RejectEmptyPayload

:== proxy_write_flags =
    {
        replace_existing : bool
        create_or_replace : bool
        expect_hash : bool
        expect_nonempty : bool
        original_empty : bool
        payload_empty : bool
    }

:= packed_flag (packed : i32) (bit : i32) : bool = (packed / bit) % 2i32 = 1i32

:= proxy_write_flags_of (packed : i32) : proxy_write_flags =
    {
        replace_existing = packed_flag packed 1i32
        create_or_replace = packed_flag packed 2i32
        expect_hash = packed_flag packed 4i32
        expect_nonempty = packed_flag packed 8i32
        original_empty = packed_flag packed 16i32
        payload_empty = packed_flag packed 32i32
    }

:~ proxy_write_action (existed : bool) (flags : proxy_write_flags) : proxy_write_action =
    ? existed ?>
        ? flags.replace_existing || flags.create_or_replace ?>
            ? flags.expect_nonempty && flags.original_empty ?> RejectEmptyTarget
            |? flags.payload_empty && flags.original_empty = !- && flags.expect_hash = !- ?> RejectEmptyPayload
            |: ReplaceExistingFile
        |: RejectOverwriteWithoutFlag
    |? flags.replace_existing || flags.expect_hash || flags.expect_nonempty ?> RejectPreconditionsOnMissingFile
    |: CreateMissingFile

:= proxy_write_action_code (action : proxy_write_action) : i32 =
    ?= action ?|
    | CreateMissingFile => 0i32
    | ReplaceExistingFile => 1i32
    | RejectOverwriteWithoutFlag => 2i32
    | RejectEmptyTarget => 3i32
    | RejectPreconditionsOnMissingFile => 4i32
    | RejectEmptyPayload => 5i32

:~ proxy_write_action_binding (existed : i32) (packed : i32) : i32 =
    ? packed < 0i32 ?> -1i32
    |? 63i32 < packed ?> -1i32
    |? existed < 0i32 ?> -1i32
    |? 1i32 < existed ?> -1i32
    |: proxy_write_action_code (proxy_write_action (existed = 1i32) (proxy_write_flags_of packed))
:~ proxy_usage_bridge (~input : string) : string =
    command_spec_domain.model.proxy_usage input

:= emit_main () : i32 =
    dogfood_shim_terminal.emit_runtime ()
    legacy_terminal.emit_runtime ()
    restart_baton_terminal.emit_runtime ()
    := _ = proxy_dogfood_shim_decision_packed_binding 0i32 0i32
    := _ = proxy_dogfood_shim_install_packed_binding 9i32 0i32
    := _ = proxy_dogfood_shim_uninstall_binding 1i32 4i32
    := _ = proxy_exact_replace_preflight_binding 1i32 1i32
    := _ = proxy_exact_replace_authorize_binding 1i32 1i32
    := _ = proxy_exact_replace_verify_binding 1i32 1i32
    := _ = proxy_run_token_code "--cwd"
    := _ = proxy_write_token_code "--expect-hash"
    := _ = proxy_write_action_binding 0i32 2i32
    := _ = proxy_usage_bridge "fs-read"
    !!!!Export(
        "kit_legacy_operations_proxy_dogfood_shim_decision_packed_binding",
        ((\ (first, second) => proxy_dogfood_shim_decision_packed_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_legacy_operations_proxy_dogfood_shim_install_packed_binding",
        ((\ (first, second) => proxy_dogfood_shim_install_packed_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_legacy_operations_proxy_dogfood_shim_uninstall_binding",
        ((\ (first, second) => proxy_dogfood_shim_uninstall_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_legacy_operations_proxy_exact_replace_preflight_binding",
        ((\ (first, second) => proxy_exact_replace_preflight_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_legacy_operations_proxy_exact_replace_authorize_binding",
        ((\ (first, second) => proxy_exact_replace_authorize_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_legacy_operations_proxy_exact_replace_verify_binding",
        ((\ (first, second) => proxy_exact_replace_verify_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export("kit_legacy_operations_proxy_run_token_code", ((\ value => proxy_run_token_code value) : string -> u64))
    !!!!Export(
        "kit_legacy_operations_proxy_write_token_code",
        ((\ value => proxy_write_token_code value) : string -> u64)
    )
    !!!!Export(
        "kit_legacy_operations_proxy_write_action_binding",
        ((\ (existed, packed) => proxy_write_action_binding existed packed) : i32 * i32 -> i32)
    )
    !!!!Export("kit_legacy_operations_proxy_usage", ((\ value => proxy_usage_bridge value) : string -> string))
    0i32
