///- --package .
test chain static =
    open sm'_operators

open sm'_operators
open eoie_job_after_model.model

let rec arguments_from (index : i32) (count : i32) (found : list string) : list string =
    if count <= index then listm.rev found
    else arguments_from (index + 1i32) count (optionm'.default_value "" (env.try_command_line_argument index) :: found)

let rec chain_started
    (~program : string) (mode : after_mode) (~previous : string) (links : list (list string)) (ids : list string)
    : i32
    =
    match links with
    | [] =>
        console.write_line (
            "eoie job chain ok jobs="
            ++# sm'.format (listm.length ids : i32)
            ++# " ids="
            ++# sm'.concat_list "," (listm.rev ids)
        )
        0i32
    | link :: rest =>
        inl output =
            optionm'.default_value "" (process.try_capture_combined_list program (start_arguments mode previous link))
        inl id = started_id output
        if id = "" then
            console.write_error_line (
                "eoie error: job chain stopped: link "
                ++# sm'.format ((listm.length ids : i32) + 1i32)
                ++# " did not start ("
                ++# sm'.trim output
                ++# "); started before it: "
                ++# sm'.concat_list "," (listm.rev ids)
            )
            2i32
        else
            console.write_line (sm'.trim output)
            chain_started program mode id rest (id :: ids)

let chain_run () : i32 =
    match chain_of (arguments_from 2i32 (env.command_line_argument_count ()) []) with
    | ChainRefused reason =>
        console.write_error_line ("eoie error: job chain refused: " ++# reason)
        2i32
    | ChainPlanned plan => chain_started (env.current_executable ()) plan.mode plan.first plan.links []

///> rust
test an_empty_argument_range_reads_as_no_arguments =
    expect ((listm.length (arguments_from 99i32 0i32 []) : i32) = 0i32) "no arguments past the count"
