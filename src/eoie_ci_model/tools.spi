///- --package .
test tools static =
    open sm'_operators

open sm'_operators
open file_system_operators

union ci_tool =
    | ToolRust
    | ToolZig
    | ToolOtp
    | ToolElixir
    | ToolGleam
    | ToolRebar
    | ToolPython

let tool_name (tool : ci_tool) : string =
    match tool with
    | ToolRust => "rust"
    | ToolZig => "zig"
    | ToolOtp => "otp"
    | ToolElixir => "elixir"
    | ToolGleam => "gleam"
    | ToolRebar => "rebar3"
    | ToolPython => "python"

let tool_of_name (~name : string) : option ci_tool =
    if name = "rust" then Some ToolRust
    elif name = "zig" then Some ToolZig
    elif name = "otp" then Some ToolOtp
    elif name = "elixir" then Some ToolElixir
    elif name = "gleam" then Some ToolGleam
    elif name = "rebar3" then Some ToolRebar
    elif name = "python" then Some ToolPython
    else None

let unquoted (~text : string) : string = sm'.trim text |> sm'.replace "\"" "" |> sm'.replace "'" ""

let rec channel_line (lines : array string) (at : i32) : option string =
    if at >= (am'.length lines : i32) then None
    else
        inl line = sm'.trim (am'.index at lines)
        if sm'.starts_with "channel" line && sm'.contains "=" line then
            inl value = sm'.split "=" line |> array |> am'.index 1i32 |> unquoted
            if value = "" then None else Some value
        else channel_line lines (at + 1i32)

let toolchain_file_channel (~text : string) : option string =
    inl plain = sm'.trim (sm'.replace "\r" "" text)
    if sm'.contains "[toolchain]" plain then channel_line (sm'.split "\n" plain |> array) 0i32
    elif plain = "" || sm'.contains "\n" plain then None
    else Some plain

let text_at (path : string) : string = if file_system.file_exists path then file_system.read_all_text path else ""

let repo_toolchain (repo : string) : option string =
    match toolchain_file_channel (text_at (repo </> "rust-toolchain.toml")) with
    | Some channel => Some channel
    | None => toolchain_file_channel (text_at (repo </> "rust-toolchain"))

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

///> rust
test tool_names_round_trip =
    expect (tool_of_name "rebar3" = Some ToolRebar) "rebar3 names Rebar"
    expect (tool_of_name "otp" = Some ToolOtp) "otp names Otp"
    expect (tool_of_name "cobol" = None) "an unknown name"

///> rust
test the_toolchain_file_names_the_rust_channel =
    expect
        (
            toolchain_file_channel "[toolchain]\nchannel = \"nightly-2026-10-18\"\ncomponents = [\"rustfmt\"]\n"
            = Some "nightly-2026-10-18"
        )
        "toml channel"
    expect (toolchain_file_channel "nightly-2026-10-18\n" = Some "nightly-2026-10-18") "legacy one-line file"
    expect (toolchain_file_channel "" = None) "no file"
