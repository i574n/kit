open sm'_operators
open eoie_jobs.model
open eoie_jobs.host
open eoie_jobs.jobs

inl after_field (~text : string) (index : i32) : string =
    inl fields = sm'.split "\t" text |> array
    if index < (am'.length fields : i32) then sm'.trim (am'.index index fields) else ""

union after_outcome =
    | AfterCleared
    | AfterHalted : i32

type awaited_end =
    {
        state : job_state
        stopped : bool
        after_text : string
    }

let rec awaited (~id : string) (beat : u64) : awaited_end =
    inl after_text = text_or_empty (job_file id "after")
    if file_exists (job_file id "stop") then { state = Settled JobStopped; stopped = true; after_text = after_text }
    else
        inl state = job_state_now (after_field after_text 0i32)
        if state_settled state then { state = state; stopped = false; after_text = after_text }
        else
            inl now = now_ms ()
            inl next =
                if now > beat + 1000u64 then
                    inl _ = text_written (job_file id "heartbeat_ms") (decimal_text now)
                    now
                else beat
            sleep_ms 250u64
            awaited id next

let after_outcome_of (~id : string) : after_outcome =
    inl started = now_ms ()
    inl ended = awaited id 0u64
    inl other = after_field ended.after_text 0i32
    if ended.stopped then
        inl _ = text_written (job_file id "exit") (exit_line 143i32 (now_ms ()) JobStopped ("stopped on request while waiting for " ++# other))
        AfterHalted 143i32
    elif after_field ended.after_text 1i32 = "ok" && state_exit ended.state <> 0i32 then
        inl detail = "--after-ok: " ++# other ++# " ended " ++# state_word ended.state ++# " exit " ++# sm'.format (state_exit ended.state)
        inl _ = text_written (job_file id "exit") (exit_line 125i32 (now_ms ()) (JobSkipped "") detail)
        AfterHalted 125i32
    else
        inl _ = text_written (job_file id "after-done") (other ++# " " ++# state_word ended.state ++# " waited_ms=" ++# decimal_text (now_ms () - started))
        AfterCleared

let after_wait (~id : string) : i32 =
    match after_outcome_of id with
    | AfterHalted code => code
    | AfterCleared => 0i32

inl main () : i32 =
    !!!!Export("eoie_job_after_wait", ((fun id => after_wait id) : string -> i32))
    0i32
