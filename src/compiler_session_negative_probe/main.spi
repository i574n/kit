:< compiler_session_contract.model

:= main () : i32 =
    := bad_lane = lane_binding 8i32 8i32
    := bad_open = revision_binding 1i32 0i32 0i32
    := bad_change = revision_binding 1i32 1i32 2i32
    := bad_cache = cache_binding 2i32 1i32
    := bad_request = request_binding 5i32
    := bad_shutdown = shutdown_binding 1i32
    ? bad_lane = 0i32 ?>
        ? bad_open = 0i32 ?>
            ? bad_change = 0i32 ?>
                ? bad_cache = 0i32 ?>
                    ? bad_request = 0i32 ?>
                        ? bad_shutdown = 0i32 ?> 0i32 |: 6i32
                    |: 5i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
