:< sm'_operators
:< kit_jobs.host
:< kit_machine_windows.window_model
:< kit_machine_windows.windows

:~ ^ shown_rows (~rows : string) (now : u64) (count : u64) : u64 =
    ? rows = ""
    ?> count
    |:
        := row = first_row rows
        := timing =
            ? tab_field row 2i32 = "waiting"
            ?> "waited " ++# (number_text ((now - decimal_of (tab_field row 4i32)) / 60000u64)) ++# "m"
            |: (number_text (minutes_left (decimal_of (tab_field row 5i32)) now)) ++# "m left"
        stdout_line ((tab_field row 0i32) ++# "  " ++# (tab_field row 1i32) ++# "  " ++# (
            (tab_field row 2i32) ++# "  " ++# timing ++# "  " ++# (tab_field row 3i32)))
        shown_rows (other_rows rows) now (count + 1u64)

:~ window_listed () : i32 =
    := root = windows_root ()
    := now = now_ms ()
    := count = shown_rows (live_rows root (stored_rows root) now "") now 0u64
    := holders = $'kit_window_run::kit_heavy_holders_text()' : string
    := _ = ? holders = "" ?> () |: stdout_line holders
    := slots = $'(!holders).lines().count() as u64' : u64
    stdout_line (
        "kit window list ok windows=" ++# (number_text count) ++# " free_mb=" ++# (number_text (free_mb ())) ++# (
        " heavy_slots=" ++# (number_text slots)))
    0i32

:~ window_checked () : i32 =
    ?= class_of (argument 3i32) ?|
    | ClassUnknown => refused ("check: unknown class '" ++# (argument 3i32) ++# "'; " ++# (window_usage ()))
    | ClassKnown wanted =>
        := root = windows_root ()
        := now = now_ms ()
        := terms = verdict_text wanted "" now 0u64 (live_rows root (stored_rows root) now "") (free_mb ()) now 0u64
        ? terms = "" ?>
            stdout_line ("kit window check ok class=" ++# (class_word wanted) ++# " free")
            0i32
        |:
            stdout_line ("kit window check blocked class=" ++# (class_word wanted) ++# " " ++# terms)
            1i32

:~ class_admitted (~word : string) : bool =
    ?= class_of word ?|
    | ClassUnknown => !-
    | ClassKnown wanted =>
        := root = windows_root ()
        := moment = now_ms ()
        := rows = live_rows root (stored_rows root) moment ""
        verdict_text wanted "" moment 0u64 rows (free_mb ()) moment 0u64 = ""

:~ fitting_loads () : string =
    := holders = $'kit_window_run::kit_heavy_holders_text()' : string
    := slots = $'(!holders).lines().count() as u64' : u64
    := medium = ? class_admitted "compile" ?> ",medium" |: ""
    := heavy = ? slots < 2u64 && class_admitted "heavy-build" ?> ",heavy" |: ""
    "light,none" ++# medium ++# heavy

:= main () : i32 =
    !!!!Export("kit_fitting_loads", ((\ () => fitting_loads ()) : () -> string))
    !!!!Export("kit_window_list_run", ((\ () => window_listed ()) : () -> i32))
    !!!!Export("kit_window_check_run", ((\ () => window_checked ()) : () -> i32))
    0i32
