:< sm'_operators
:< kit_jobs.host
:< kit_machine_windows.window_model
:< kit_machine_windows.windows

:~ ^ shown_rows (~rows : string) (now : u64) (count : u64) : u64 =
    ? rows = ""
    ?> count
    |:
        ?= row_of (first_row rows) ?|
        | RowKnown row =>
            := timing =
                ?= row.state ?|
                | Waiting => "waited " ++# (number_text ((now - row.start_ms) / 60000u64)) ++# "m"
                | Held => (number_text (minutes_left row.until_ms now)) ++# "m left"
            stdout_line (
                row.id ++# "  " ++# (class_word row.kind) ++# "  " ++# (state_word row.state) ++# "  " ++# timing ++# "  "
                ++# row.label
            )
            shown_rows (other_rows rows) now (count + 1u64)
        | RowUnknown => shown_rows (other_rows rows) now count

:~ window_listed () : i32 =
    := root = windows_root ()
    := now = now_ms ()
    := count = shown_rows (live_rows root (stored_rows root) now "") now 0u64
    := holders = $'kit_window_run::kit_heavy_holders_text()' : string
    := _ = ? holders = "" ?> () |: stdout_line holders
    := slots = $'(!holders).lines().count() as u64' : u64
    stdout_line (
        "kit window list ok windows=" ++# (number_text count) ++# " free_mb=" ++# (number_text (free_mb ())) ++# (
        " heavy_slots=" ++# (number_text slots)))
    0i32

:~ ^ shared_with (~rows : string) (~found : string) : string =
    ? rows = ""
    ?> found
    |:
        ?= row_of (first_row rows) ?|
        | RowKnown row =>
            := item = (class_word row.kind) ++# " " ++# row.label
            := held = row.state = Held
            shared_with (other_rows rows) (? held && found <> "" ?> found ++# ", " ++# item |? held ?> item |: found)
        | RowUnknown => shared_with (other_rows rows) found

:~ window_checked (~class_text : string) : i32 =
    ?= class_of class_text ?|
    | ClassUnknown => refused ("check: unknown class '" ++# class_text ++# "'; " ++# (window_usage ()))
    | ClassKnown wanted =>
        := root = windows_root ()
        := now = now_ms ()
        := rows = live_rows root (stored_rows root) now ""
        := terms = verdict_text wanted "" "" now 0u64 rows (free_mb ()) now 0u64
        ? terms = "" ?>
            := shared = shared_with rows ""
            := note = ? shared = "" ?> "" |: " (shares with " ++# shared ++# ")"
            stdout_line ("kit window check ok class=" ++# (class_word wanted) ++# " free" ++# note)
            0i32
        |:
            stdout_line ("kit window check blocked class=" ++# (class_word wanted) ++# " " ++# terms)
            1i32

:~ class_admitted (wanted : window_class) : bool =
    := root = windows_root ()
    := moment = now_ms ()
    := rows = live_rows root (stored_rows root) moment ""
    verdict_text wanted "" "" moment 0u64 rows (free_mb ()) moment 0u64 = ""

:~ fitting_loads () : string =
    := holders = $'kit_window_run::kit_heavy_holders_text()' : string
    := slots : i32 = sm'.split_list "\n" holders |> listm'.filter (\ (line : string) => line <> "") |> listm.length
    := medium = ? class_admitted Compile ?> ",medium" |: ""
    := heavy = ? slots < 2i32 && class_admitted HeavyBuild ?> ",heavy" |: ""
    "light,none" ++# medium ++# heavy

:~ check_run () : i32 =
    ?= env.command_line_arguments () ?|
    | _ :: _ :: class_text :: _ => window_checked class_text
    | _ => window_checked ""

:= main () : i32 =
    export "kit_fitting_loads" ((\ () => fitting_loads ()) : () -> string)
    export "kit_window_list_run" ((\ () => window_listed ()) : () -> i32)
    export "kit_window_check_run" ((\ () => check_run ()) : () -> i32)
    0i32