:< incident_recovery_contract.model

:= main () : i32 =
    := _ = incident_recovery_complete_plan ()
    ?= incident_recovery_scope_binding 1i32 1i32 1i32 1i32 ?|
    | 1 =>
        ?= incident_recovery_leaf_binding 1i32 1i32 ?|
        | 1 =>
            ?= incident_recovery_snapshot_binding 1i32 1i32 1i32 1i32 ?|
            | 1 =>
                ?= incident_recovery_restore_binding 1i32 (incident_recovery_target_code TargetDirectory) 1i32 1i32 ?|
                | 1 =>
                    ?= incident_recovery_rollback_binding 1i32 1i32 1i32 ?|
                    | 1 =>
                        ?= incident_recovery_completion_binding 1i32 1i32 1i32 ?|
                        | 1 => 0i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
