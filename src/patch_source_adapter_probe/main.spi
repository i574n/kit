:= main () : i32 =
    := minus_one = (-(1i32))
    := pair_ok = patch_source_adapter.main.source_resume_pair_binding 1i32 1i32
    := pair_bad = patch_source_adapter.main.source_resume_pair_binding 1i32 0i32
    := decision_resume = patch_source_adapter.main.source_resume_decision_binding 1i32 1i32
    := decision_absent = patch_source_adapter.main.source_resume_decision_binding 0i32 0i32
    := decision_stale = patch_source_adapter.main.source_resume_decision_binding 1i32 0i32
    := completion_ok = patch_source_adapter.main.source_resume_completion_binding 1i32 1i32
    := completion_bad = patch_source_adapter.main.source_resume_completion_binding 1i32 0i32
    ?
        pair_ok = 1i32
        && pair_bad = 0i32
        && decision_resume = 1i32
        && decision_absent = 0i32
        && decision_stale = minus_one
        && completion_ok = 1i32
        && completion_bad = 0i32
    ?> 0i32
    |: 1i32
