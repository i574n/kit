///- --package .
:# ownership static =
    :< sm'_operators

:< sm'_operators

:| job_owner =
    | YourJob : string
    | TheirJob : string * string
    | NoOwningJob

:~ job_owner_of (~job : string) (~job_author : string) (~author : string) : job_owner =
    ? job = "" ?> NoOwningJob
    |? author <> "" && job_author = author ?> YourJob job
    |: TheirJob (job, job_author)

:~ mine_verdict (in_session : bool) (owner : job_owner) (~theirs : string) : option string =
    ? in_session
    ?> None
    |:
        ?= owner ?|
        | YourJob _ => None
        | TheirJob (job, by) =>
            ? theirs = job
            ?> None
            |:
                Some (
                    "it belongs to job "
                    ++# job
                    ++# " by "
                    ++# (? by = "" ?> "no author" |: by)
                    ++# "; pass --theirs "
                    ++# job
                    ++# " to stop it anyway"
                )
        | NoOwningJob => Some "no kit job started it and it is outside this agent session"

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail

///> rust
:# a_kill_with_mine_stops_only_my_session_or_my_jobs =
    expect (mine_verdict !+ NoOwningJob "" = None) "a process under my agent session"
    expect (mine_verdict !- (job_owner_of "job-1-a" "alpha" "alpha") "" = None) "my own job's tree"
    expect
        (
            mine_verdict !- (job_owner_of "job-2-b" "beta" "alpha") ""
            = Some "it belongs to job job-2-b by beta; pass --theirs job-2-b to stop it anyway"
        )
        "another author's job"
    expect (mine_verdict !- (job_owner_of "job-2-b" "beta" "alpha") "job-2-b" = None) "named with --theirs"
    expect
        (
            mine_verdict !- (job_owner_of "job-3-c" "" "") ""
            = Some "it belongs to job job-3-c by no author; pass --theirs job-3-c to stop it anyway"
        )
        "without KIT_AUTHOR no job is mine by default"
    expect
        (
            mine_verdict !- (job_owner_of "" "" "alpha") ""
            = Some "no kit job started it and it is outside this agent session"
        )
        "untraced"
