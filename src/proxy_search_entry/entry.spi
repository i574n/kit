:< path_tag_contract.model
:< path_tag_contract.path_tag_bindings
:< parallel_search_contract.model
:< parallel_search_contract.parallel_search_bindings
:= emit_main () : i32 =
    := _ = path_tag_public_plan ()
    := _ = parallel_search_public_plan ()
    := _ =
        proxy_path_tag_relative_packed_binding 0i32 1i32,
        proxy_path_tag_packed_indices_binding 0i32 64i32,
        proxy_path_tag_shape_binding 3i32 2i32,
        proxy_path_tag_determinism_binding 1i32 1i32,
        proxy_path_tag_collision_binding 0i32 0i32,
        proxy_parallel_search_request_binding 0i32 1i32,
        proxy_parallel_search_worker_binding 1i32 56i32,
        proxy_parallel_search_parity_binding 0i32 0i32,
        proxy_parallel_manifest_order_binding 1i32 1i32,
        proxy_parallel_manifest_parity_binding 1i32 1i32,
        proxy_parallel_consumer_mode_binding 1i32 1i32,
        proxy_parallel_consumer_output_binding 1i32 1i32,
        proxy_hash_tree_request_binding 1i32 1i32
    parallel_search_contract.search_terminal.emit_runtime ()
    path_tag_contract.path_tag_terminal.emit_runtime ()
    !!!!Export("kit_proxy_search_descends_into", ((\ path => proxy_search_descends_into path) : string -> bool))
    !!!!Export("kit_proxy_search_scope_binding", ((\ relative => proxy_search_scope_binding relative) : string -> i32))
    !!!!Export(
        "kit_proxy_search_proxy_path_tag_relative_packed_binding",
        ((\ (first, second) => proxy_path_tag_relative_packed_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_path_tag_packed_indices_binding",
        ((\ (first, second) => proxy_path_tag_packed_indices_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_path_tag_shape_binding",
        ((\ (first, second) => proxy_path_tag_shape_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_path_tag_determinism_binding",
        ((\ (first, second) => proxy_path_tag_determinism_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_path_tag_collision_binding",
        ((\ (first, second) => proxy_path_tag_collision_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_parallel_search_request_binding",
        ((\ (first, second) => proxy_parallel_search_request_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_parallel_search_worker_binding",
        ((\ (first, second) => proxy_parallel_search_worker_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_parallel_search_parity_binding",
        ((\ (first, second) => proxy_parallel_search_parity_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_parallel_manifest_order_binding",
        ((\ (first, second) => proxy_parallel_manifest_order_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_parallel_manifest_parity_binding",
        ((\ (first, second) => proxy_parallel_manifest_parity_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_parallel_consumer_mode_binding",
        ((\ (first, second) => proxy_parallel_consumer_mode_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_parallel_consumer_output_binding",
        ((\ (first, second) => proxy_parallel_consumer_output_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_proxy_search_proxy_hash_tree_request_binding",
        ((\ (first, second) => proxy_hash_tree_request_binding first second) : i32 * i32 -> i32)
    )
    0i32
