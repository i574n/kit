:< rust_std_string.model
:< kit_jobs.host
:< kit_jobs.model
:< kit_jobs.jobs
:< kit_machine_windows.window_model
:< kit_machine_windows.windows

:~ window_blocker (ask : request) : string =
    := root = windows_root ()
    ? lock_taken root = !-
    ?> "reason=registry-lock-busy"
    |:
        := now = now_ms ()
        := terms =
            verdict_text ask.wanted ask.id ask.since ask.minutes
                (live_rows root (stored_rows root) now "")
                (free_mb ())
                now
                ask.min_free
        ? terms = ""
        ?>
            := _ =
                text_written
                    (window_file root ask.id)
                    (request_row { ask ?| since = now } Held (now + ask.minutes * 60000u64))
            event_logged root WindowGranted (request_row { ask ?| since = now } Held (now + ask.minutes * 60000u64))
            lock_released root
            ""
        |:
            := _ = text_written (window_file root ask.id) (request_row ask Waiting (now + 30000u64))
            lock_released root
            terms

:~ gate_step (~id : string) (ask : request) (limit : u64) (now : u64) : i32 =
    ? now > limit
    ?>
        := _ = file_removed (window_file (windows_root ()) ask.id)
        := _ =
            text_written
                (job_file id "exit")
                (
                    exit_line 75i32 now JobExpiredInQueue (
                        concat5
                            "no "
                            (class_word ask.wanted)
                            " window before the deadline (24 hours, or --slot-within); the job never started"
                            ""
                            ""
                    )
                )
        75i32
    |? file_exists (released_mark (windows_root ()) ask.id)
    ?>
        := root = windows_root ()
        := _ = file_removed (released_mark root ask.id)
        := _ = file_removed (window_file root ask.id)
        := _ =
            text_written
                (job_file id "exit")
                (
                    exit_line 75i32 now JobExpiredInQueue (
                        concat5
                            "its waiting "
                            (class_word ask.wanted)
                            " window was released (kit window release); the job never started"
                            ""
                            ""
                    )
                )
        75i32
    |:
        := blocker = window_blocker ask
        ? blocker = ""
        ?>
            := _ =
                text_written
                    (job_file id "window")
                    (concat5 "granted id=" ask.id " waited_ms=" (decimal_text (now - ask.since)) "")
            0i32
        |:
            := _ = text_written (job_file id "window") (concat5 "waiting id=" ask.id " " blocker "")
            1i32

:~ ^ gate_loop (~id : string) (ask : request) (limit : u64) : i32 =
    := now = now_ms ()
    := _ = text_written (job_file id "heartbeat_ms") (decimal_text now)
    ? file_exists (job_file id "stop")
    ?>
        := _ = file_removed (window_file (windows_root ()) ask.id)
        := _ = text_written (job_file id "exit") (halt_line HaltOnRequest now (tree_stop_of 0u64))
        143i32
    |:
        := step = gate_step id ask limit now
        ? step = 1i32
        ?>
            sleep_ms 500u64
            gate_loop id ask limit
        |: step

:~ window_named (wanted : window_class) (since : u64) : string =
    concat5 "win-" (number_text since) "-" (number_text (process_number ())) (concat5 "-" (class_word wanted) "" "" "")

:~ window_since (~window : string) : u64 =
    $'(!window).split(char::from(45u8)).nth(1).and_then(|since| since.parse::<u64>().ok()).unwrap_or(0)' : u64

:~ asked (~id : string) (wanted : window_class) (~window : string) : request =
    := since = window_since window
    := timeout = decimal_u64 (text_or_empty (job_file id "timeout_ms"))
    := by = decimal_u64 (text_or_empty (job_file id "slot_by_ms"))
    {
        wanted = wanted
        minutes = timeout / 60000u64 + 1u64
        label = concat5 (text_or_empty (job_file id "label")) " (kit job " id ")" ""
        id = window
        since = since
        deadline = ? by <> 0u64 && by < since + 86400000u64 ?> by |: since + 86400000u64
        min_free = decimal_u64 (text_or_empty (job_file id "min_free_mb"))
    }

:~ owned_window (~held : string) : string =
    $'std::rc::Rc::<str>::from({ let parts = (!held).splitn(4, char::from(45u8)).collect::<Vec<_>>(); if parts.len() \
        == 4 { format\!("{}-{}-{}-{}", parts[0], parts[1], std::process::id(), parts[3]) } else { \
        (!held).to_string() } }.as_str())' : string

:~ row_rest (~row : string) (~held : string) : string =
    $'std::rc::Rc::<str>::from((!row).strip_prefix(&*!held).unwrap_or(&*!row))' : string

:~ ^ window_adopted (~held : string) (tries : i32) : string =
    := root = windows_root ()
    := owned = owned_window held
    := row = text_or_empty (window_file root held)
    ? row = "" || owned = held
    ?> held
    |? lock_taken root
    ?>
        := _ = text_written (window_file root owned) (concat5 owned (row_rest row held) "" "" "")
        := _ = file_removed (window_file root held)
        lock_released root
        owned
    |? tries > 0i32
    ?>
        sleep_ms 100u64
        window_adopted held (tries - 1i32)
    |: held

:~ granted_by_host (~id : string) : bool =
    := text = text_or_empty (job_file id "window")
    $'(!text).starts_with("granted")' : bool

:~ windowed_gate (~id : string) (wanted : window_class) : i32 =
    := held = text_or_empty (job_file id "window_request")
    ? held <> "" && granted_by_host id
    ?>
        := owned = window_adopted held 50i32
        := _ = text_written (job_file id "window") (concat5 "granted id=" owned " adopted from the job host" "" "")
        0i32
    |:
        := ask = asked id wanted (window_named wanted (now_ms ()))
        gate_loop id ask ask.deadline

:~ held_window_of (~id : string) (wanted : window_class) : i32 =
    := now = now_ms ()
    := recorded = text_or_empty (job_file id "window_request")
    := window = ? recorded = "" ?> window_named wanted now |: recorded
    := _ = ? recorded = "" ?> text_written (job_file id "window_request") window |: ""
    := ask = asked id wanted window
    := step = gate_step id ask ask.deadline now
    ? step = 75i32 ?> 2i32 |: step

:~ held_window_step (~id : string) : i32 =
    ? file_exists (job_file id "heavy-wrapper.ps1") ?> held_window_of id HeavyBuild
    |? file_exists (job_file id "window-class") ?> held_window_of id Compile
    |: 0i32

:~ held_window_dropped (~id : string) : () =
    := held = text_or_empty (job_file id "window_request")
    ? held = ""
    ?> ()
    |:
        := _ = file_removed (window_file (windows_root ()) held)
        ()

:~ ^ compile_hold_loop (~id : string) (ask : request) (limit : u64) : () =
    := now = now_ms ()
    ? file_exists (job_file id "stop")
    ?> ()
    |? now > limit
    ?>
        := _ = file_removed (window_file (windows_root ()) ask.id)
        := _ =
            text_written
                (job_file id "quiet")
                (
                    concat5
                        "started beside compile windows after "
                        (decimal_text ((now - ask.since) / 60000u64))
                        " min of --quiet-wait"
                        ""
                        ""
                )
        ()
    |:
        := blocker = window_blocker ask
        ? blocker = ""
        ?>
            := _ =
                text_written
                    (job_file id "quiet")
                    (concat5 "holding compiles id=" ask.id " waited_ms=" (decimal_text (now - ask.since)) "")
            ()
        |:
            := _ = text_written (job_file id "quiet") (concat5 "waiting for compiles to end id=" ask.id " " blocker "")
            sleep_ms 500u64
            compile_hold_loop id ask limit

:~ compile_hold_taken (~id : string) : i32 =
    := hold = decimal_u64 (text_or_empty (job_file id "quiet_hold_min"))
    ? hold = 0u64
    ?> 0i32
    |:
        := since = now_ms ()
        := wait = decimal_u64 (text_or_empty (job_file id "quiet_wait_min"))
        := label = concat5 (text_or_empty (job_file id "label")) " (kit job " id ")" ""
        := window = concat5 "win-" (number_text since) "-" (number_text (process_number ())) "-compile-hold"
        compile_hold_loop id
            {
                wanted = CompileHold
                minutes = hold
                label = label
                id = window
                since = since
                deadline = since + wait * 60000u64
                min_free = 0u64
            }
            (since + wait * 60000u64)
        0i32

:~ job_window_gate (~id : string) : i32 =
    := slotted = $'kit_job_slot::kit_job_slot_gate(&*!id)' : i32
    ? slotted <> 0i32 ?> slotted
    |:
        := windowed = windowed_gate id HeavyBuild
        ? windowed <> 0i32 ?> windowed |: compile_hold_taken id

:~ job_compile_gate (~id : string) : i32 = windowed_gate id Compile

:= main () : i32 =
    !!!!Export("kit_job_window_gate", ((\ id => job_window_gate id) : string -> i32))
    !!!!Export("kit_job_compile_gate", ((\ id => job_compile_gate id) : string -> i32))
    !!!!Export("kit_job_gate_held_step", ((\ id => held_window_step id) : string -> i32))
    !!!!Export("kit_job_gate_window_dropped", ((\ id => held_window_dropped id) : string -> ()))
    0i32
