:< filesystem_copy_contract.model

:= main () : i32 =
    ?=
        agile_rejection
            "/tmp/kit-copy-negative-source.txt"
            "/tmp/kit-copy-negative-target.txt"
            "expected-copy"
            "actual-copy"
    ?|
    | CopyAccepted _ => 1i32
    | CopyRejected _ => 0i32
    | CopyFailed _ => 2i32
