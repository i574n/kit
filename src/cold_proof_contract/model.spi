:! cold_proof_raw = ()
:! cold_proof_inspected = ()
:! cold_proof_verified = ()
:! cold_proof_closed = ()

:| cold_proof_gate =
    | CensusGate
    | MigrationGate
    | WorkspaceGate
    | StateCoreGate
    | BinaryGate

:| cold_proof_policy =
    | RejectColdProofHeader
    | RejectColdProofGateShape
    | RejectColdProofStaleEvidence
    | RejectColdProofCensusDrift
    | RejectColdProofReplayGap
    | AuthorizeColdProofClosure

:| cold_proof_op from to =
    | InspectColdProof :: cold_proof_op cold_proof_raw cold_proof_inspected
    | VerifyColdProof :: cold_proof_op cold_proof_inspected cold_proof_verified
    | CloseColdProof :: cold_proof_op cold_proof_verified cold_proof_closed

:| ^ cold_proof_plan from to =
    | ColdProofStep :: \* from to. cold_proof_op from to -> cold_proof_plan from to
    | ColdProofThen :: \* from to.
        (\? middle. cold_proof_plan from middle * cold_proof_plan middle to) ->
        cold_proof_plan from to

:= cold_proof_public_plan () : cold_proof_plan cold_proof_raw cold_proof_closed =
    ColdProofThen (\? (
        ColdProofStep InspectColdProof,
        ColdProofThen (\? (
            ColdProofStep VerifyColdProof,
            ColdProofStep CloseColdProof
        ))
    ))
