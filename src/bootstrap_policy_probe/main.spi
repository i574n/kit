:< rust_std_fs.model

:= filesystem_path () = "/tmp/kit-bootstrap-policy-fs.txt"

:= positive_filesystem_probe () : bool =
    := path = filesystem_path ()
    := clean_before = remove_file path
    ? clean_before && write_text path "policy-snapshot" ?>
        := passed =
            ? file_exists path ?>
            loaded_nonempty (snapshot (readable_file path)) && text_equals "policy-snapshot" path
            |: !-
        := clean_after = remove_file (filesystem_path ())
        passed && clean_after
    |: !-

:= bootstrap_seed_positive_probe () : bool =
    := _
        : bootstrap_experiment_contract.model.bootstrap_seed_plan
            bootstrap_experiment_contract.model.bootstrap_seed_bundle_only
            bootstrap_experiment_contract.model.bootstrap_seed_canonical_verified
        =
        bootstrap_experiment_contract.model.bootstrap_seed_complete_plan ()
    := route =
        bootstrap_experiment_contract.model.bootstrap_seed_route_code
            bootstrap_experiment_contract.model.BootstrapUnzipSeed
    bootstrap_policy.outcome.all4
        (bootstrap_policy.outcome.i32_eq
            (bootstrap_experiment_contract.model.bootstrap_seed_preflight_binding 1i32 0i32 0i32 route)
            1i32)
        (bootstrap_policy.outcome.i32_eq
            (bootstrap_experiment_contract.model.bootstrap_seed_extract_binding 1i32 1i32 1i32)
            1i32)
        (bootstrap_policy.outcome.i32_eq
            (bootstrap_experiment_contract.model.bootstrap_seed_install_binding 1i32 1i32 1i32)
            1i32)
        (bootstrap_policy.outcome.i32_eq
            (bootstrap_experiment_contract.model.bootstrap_seed_rollback_binding 1i32 1i32 1i32)
            1i32)

:= main () : i32 =
    := wrap_after = rust_std_env.clock.session_wrap_after 4200i32
    := deadline = rust_std_env.clock.session_deadline_from_now wrap_after
    := physical_code, physical_elapsed = bootstrap_policy.process.timed_success_physical_probe ()
    := physical_receipt = bootstrap_policy.outcome.exit_receipt physical_code physical_elapsed
    := stdout_word = bootstrap_policy.process.stdout_capture_physical_probe ()
    := stdout_receipt = bootstrap_policy.outcome.stream_receipt stdout_word
    := stderr_word = bootstrap_policy.process.stderr_capture_physical_probe ()
    := stderr_receipt = bootstrap_policy.outcome.stream_receipt stderr_word
    := streams_ok =
        bootstrap_policy.outcome.all2
            (bootstrap_policy.outcome.stdout_capture_ok stdout_receipt)
            (bootstrap_policy.outcome.stderr_capture_ok stderr_receipt)
    := physical_process_ok =
        bootstrap_policy.outcome.all3
            (bootstrap_policy.outcome.i32_eq
                (bootstrap_policy.outcome.receipt_code physical_receipt)
                0i32)
            (bootstrap_policy.outcome.u64_lte
                (bootstrap_policy.outcome.receipt_elapsed physical_receipt)
                5000u64)
            (bootstrap_policy.outcome.receipt_within_budget physical_receipt)
    := lifecycle_code, termination_elapsed = bootstrap_policy.process.direct_termination_physical_probe ()
    := termination_receipt = bootstrap_policy.outcome.terminated_receipt termination_elapsed
    := direct_termination_ok =
        bootstrap_policy.outcome.all4
            (bootstrap_policy.outcome.i32_eq lifecycle_code 0i32)
            (bootstrap_policy.outcome.i32_eq
                (bootstrap_policy.outcome.receipt_code termination_receipt)
                137i32)
            (bootstrap_policy.outcome.u64_lte
                (bootstrap_policy.outcome.receipt_elapsed termination_receipt)
                5000u64)
            (bootstrap_policy.outcome.termination_probe_ok ())
    := toolchain_ok =
        bootstrap_policy.outcome.all4
            (rust_std_env.clock.within_budget deadline)
            (bootstrap_policy.outcome.i32_eq
                (toolchain_command_domain.model.toolchain_mapping_probe_code ())
                6i32)
            (bootstrap_policy.outcome.i32_eq
                (toolchain_command_domain.model.toolchain_command_plan_probe_code ())
                1012i32)
            (bootstrap_policy.outcome.i32_eq
                (toolchain_command_domain.model.toolchain_command_negative_probe_code ())
                -2i32)
    := process_ok =
        bootstrap_policy.outcome.all3 physical_process_ok streams_ok direct_termination_ok
    := contract =
        bootstrap_experiment_contract.model.policy_plan
            (positive_filesystem_probe ()) process_ok toolchain_ok
    ? bootstrap_experiment_contract.model.terminal contract
        && bootstrap_seed_positive_probe ()
        && bootstrap_policy.outcome.success_probe_ok ()
        && bootstrap_policy.state_check.full_probe_ok ()
    ?> bootstrap_policy.model.patch_probe_result ()
    |: 60i32
