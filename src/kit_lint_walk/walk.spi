///- --package .
:# walk static =
    :< sm'_operators
    :< file_system_operators

:< sm'_operators
:< file_system_operators

:= skipped_dir (name : string) : bool =
    sm'.starts_with "." name || name = "target" || name = "node_modules" || name = "_build" || name = "deps"
    || name = "bin" || name = "obj"

:~ entry_names (path : string) : list string =
    file_system.read_dir_names path
    |> resultm.unwrap'
    |> am'.vec_fold' (\ names name => sm'.from_std_string name :: names) []
    |> listm.rev

:~ ^ spi_files (todo : list string) (found : list string) : list string =
    ?= todo ?|
    | [] => listm.rev found
    | path :: rest =>
        ? file_system.file_exists path ?> spi_files rest (? sm'.ends_with ".spi" path ?> path :: found |: found)
        |? file_system.directory_exists path ?>
            := deeper =
                entry_names path
                |> listm.rev
                |> listm.fold
                    \ ahead (name : string) => ? skipped_dir name ?> ahead |: (path </> name) :: ahead
                    rest
            spi_files deeper found
        |: spi_files rest found

:~ relative_to (~root : string) (path : string) : string =
    := base = sm'.replace "\\" "/" root ++# "/"
    := slashed = sm'.replace "\\" "/" path
    := skip : i32 = sm'.length base
    ? sm'.starts_with base slashed ?> sm'.substring skip ((sm'.length slashed : i32) - skip) slashed |: slashed


:! path_list = $'std::rc::Rc<Vec<std::rc::Rc<str>>>'
:! path_buffer = $'std::rc::Rc<std::cell::RefCell<Vec<std::rc::Rc<str>>>>'

:= buffer_new () : path_buffer = $'std::rc::Rc::new(std::cell::RefCell::new(Vec::new()))' : path_buffer
:= buffer_pushed (~buffer : path_buffer) (~path : string) : () = $'!buffer.borrow_mut().push(!path)' : ()
:= paths_of (~buffer : path_buffer) : path_list = $'std::rc::Rc::new(!buffer.borrow().clone())' : path_list

:~ files_under (~start : string) : path_list =
    := buffer = buffer_new ()
    spi_files [ start ] [] |> listm.iter (buffer_pushed buffer)
    paths_of buffer

///> rust
:# a_walk_keeps_spi_files_and_skips_hidden_and_build_folders =
    := root = file_system.get_temp_path () </> "kit-lint-walk-test"
    file_system.remove_dir_all root |> ignore
    := made (path : string) =
        := parent = file_system.directory_get_parent (root </> path) |> optionm'.default_value' ""
        file_system.create_dir_all parent |> ignore
        file_system.write_all_text (root </> path) "x"
    [ "a/b.spi"; "a/c.txt"; "a/.hidden/d.spi"; "a/target/e.spi"; "f.spi" ] |> listm.iter made
    := found = spi_files [ root ] [] |> listm.map (relative_to root)
    ? found = [ "a/b.spi"; "f.spi" ] ?> () |: failwith (sm'.concat_list ", " found)
    file_system.remove_dir_all root |> ignore