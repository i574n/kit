:! archive_idle = ()
:! archive_preflighted = ()
:! archive_entries_validated = ()
:! archive_links_validated = ()
:! archive_payloads_written = ()
:! archive_tree_validated = ()
:! archive_committed = ()

:| archive_extract_op from to =
    | ArchivePreflight :: archive_extract_op archive_idle archive_preflighted
    | ValidateArchiveEntries :: archive_extract_op archive_preflighted archive_entries_validated
    | ValidateArchiveLinks :: archive_extract_op archive_entries_validated archive_links_validated
    | WriteArchivePayloads :: archive_extract_op archive_links_validated archive_payloads_written
    | ValidateExtractedTree :: archive_extract_op archive_payloads_written archive_tree_validated
    | CommitArchiveExtraction :: archive_extract_op archive_tree_validated archive_committed

:| ^ archive_extract_plan from to =
    | ArchiveExtractStep :: \* from to. archive_extract_op from to -> archive_extract_plan from to
    | ArchiveExtractThen :: \* from to.
        (\? middle. archive_extract_plan from middle * archive_extract_plan middle to) ->
        archive_extract_plan from to

:= deflate_extract_plan () : archive_extract_plan archive_idle archive_committed =
    ArchiveExtractThen (\? (
        ArchiveExtractStep ArchivePreflight,
        ArchiveExtractThen (\? (
            ArchiveExtractStep ValidateArchiveEntries,
            ArchiveExtractThen (\? (
                ArchiveExtractStep ValidateArchiveLinks,
                ArchiveExtractThen (\? (
                    ArchiveExtractStep WriteArchivePayloads,
                ArchiveExtractThen (\? (
                    ArchiveExtractStep ValidateExtractedTree,
                        ArchiveExtractStep CommitArchiveExtraction
                    ))
                ))
            ))
        ))
    ))

:~ archive_preflight_binding (archive_regular : i32) (destination_absent : i32) : i32 =
    ? archive_regular < 1i32 ?> 0i32
    |? 1i32 < archive_regular ?> 0i32
    |? destination_absent < 1i32 ?> 0i32
    |? 1i32 < destination_absent ?> 0i32
    |: 1i32

:~ archive_entry_binding (path_safe : i32) (not_symlink : i32) : i32 =
    ? path_safe < 1i32 ?> 0i32
    |? 1i32 < path_safe ?> 0i32
    |? not_symlink < 1i32 ?> 0i32
    |? 1i32 < not_symlink ?> 0i32
    |: 1i32

:~ archive_tar_symlink_binding (target_confined : i32) (zero_payload : i32) : i32 =
    ? target_confined < 1i32 ?> 0i32
    |? 1i32 < target_confined ?> 0i32
    |? zero_payload < 1i32 ?> 0i32
    |? 1i32 < zero_payload ?> 0i32
    |: 1i32

:~ archive_tar_hardlink_binding (target_ready : i32) (zero_payload : i32) : i32 =
    ? target_ready < 1i32 ?> 0i32
    |? 1i32 < target_ready ?> 0i32
    |? zero_payload < 1i32 ?> 0i32
    |? 1i32 < zero_payload ?> 0i32
    |: 1i32

:~ archive_tar_long_link_binding (target_bounded : i32) (target_utf8 : i32) : i32 =
    ? target_bounded < 1i32 ?> 0i32
    |? 1i32 < target_bounded ?> 0i32
    |? target_utf8 < 1i32 ?> 0i32
    |? 1i32 < target_utf8 ?> 0i32
    |: 1i32

:~ archive_tar_pax_path_binding (path_safe : i32) (path_record_supported : i32) : i32 =
    ? path_safe < 1i32 ?> 0i32
    |? 1i32 < path_safe ?> 0i32
    |? path_record_supported < 1i32 ?> 0i32
    |? 1i32 < path_record_supported ?> 0i32
    |: 1i32

:~ archive_compression_binding (entry_safe : i32) (compression_supported : i32) : i32 =
    ? entry_safe < 1i32 ?> 0i32
    |? 1i32 < entry_safe ?> 0i32
    |? compression_supported < 1i32 ?> 0i32
    |? 1i32 < compression_supported ?> 0i32
    |: 1i32

:~ archive_budget_binding (limit_bytes : i32) (observed_bytes : i32) : i32 =
    ? limit_bytes < 1i32 ?> 0i32
    |? observed_bytes < 0i32 ?> 0i32
    |? limit_bytes < observed_bytes ?> 0i32
    |: 1i32

:~ archive_complete_binding (expected_payloads : i32) (written_payloads : i32) : i32 =
    ? expected_payloads < 0i32 ?> 0i32
    |? written_payloads < 0i32 ?> 0i32
    |? expected_payloads < written_payloads ?> 0i32
    |? written_payloads < expected_payloads ?> 0i32
    |: 1i32

:~ archive_tree_binding (counts_match : i32) (tree_safe : i32) : i32 =
    ? counts_match < 1i32 ?> 0i32
    |? 1i32 < counts_match ?> 0i32
    |? tree_safe < 1i32 ?> 0i32
    |? 1i32 < tree_safe ?> 0i32
    |: 1i32

:| archive_format =
    | ZipArchive
    | TarArchive
    | TarGzipArchive
    | TarXzArchive
    | TarBzip2Archive

:= archive_format_code = \|
    | ZipArchive => 0i32
    | TarArchive => 1i32
    | TarGzipArchive => 2i32
    | TarXzArchive => 3i32
    | TarBzip2Archive => 4i32

:~ archive_format_binding (format_code : i32) (tool_available : i32) : i32 =
    ? format_code < 0i32 ?> 0i32
    |? 4i32 < format_code ?> 0i32
    |? tool_available < 1i32 ?> 0i32
    |? 1i32 < tool_available ?> 0i32
    |: 1i32

:| archive_fault_point =
    | NoArchiveFault
    | FailAfterFirstPayload
    | FailBeforeCommit

:= archive_fault_code = \|
    | NoArchiveFault => 0i32
    | FailAfterFirstPayload => 1i32
    | FailBeforeCommit => 2i32

:~ archive_fault_binding (configured : i32) (observed : i32) : i32 =
    ? configured < 0i32 ?> 0i32
    |? 2i32 < configured ?> 0i32
    |? observed < 1i32 ?> 0i32
    |? 2i32 < observed ?> 0i32
    |? configured < observed ?> 0i32
    |? observed < configured ?> 0i32
    |: 1i32
