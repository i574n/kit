///- --package .
:# status static =
    :< sm'_operators

:< sm'_operators
:< workspace_primitives.bytes

:== remote_windows =
    {
        windows : u64
        free_mb : u64
        heavy_slots : u64
    }

:| remote_status =
    | RemoteUnreachable : string
    | RemoteReported : remote_windows

:~ summary_marker () : string = " window list ok "

:~ field_value (~line : string) (~key : string) : u64 =
    := at = byte_find_from line (" " ++# key ++# "=") 0i32
    ? at < 0i32
    ?> 0u64
    |:
        := start = at + byte_len key + 2i32
        := space = byte_find_from line " " start
        := stop = ? space < 0i32 ?> byte_len line |: space
        optionm'.default_value 0u64 (convert.try_convert (byte_slice line start stop))

:~ status_of (~output : string) : remote_status =
    := at = byte_find_from output (summary_marker ()) 0i32
    ? at < 0i32
    ?> RemoteUnreachable (sm'.trim output)
    |:
        := newline = byte_find_from output "\n" at
        := line = byte_slice output at (? newline < 0i32 ?> byte_len output |: newline)
        RemoteReported {
            windows = field_value line "windows"
            free_mb = field_value line "free_mb"
            heavy_slots = field_value line "heavy_slots"
        }

:~ status_line (~machine : string) (status : remote_status) : string =
    ?= status ?|
    | RemoteReported report =>
        "kit remote status ok machine=" ++# machine
        ++# " windows=" ++# sm'.show report.windows
        ++# " free_mb=" ++# sm'.show report.free_mb
        ++# " heavy_slots=" ++# sm'.show report.heavy_slots
    | RemoteUnreachable reason => "kit remote status unreachable machine=" ++# machine ++# " reason=" ++# reason

:~ ssh_arguments (~alias : string) (~binary : string) : list string =
    [ "-o"; "BatchMode=yes"; "-o"; "ConnectTimeout=10"; alias; binary ++# " window list" ]

:~ remote_status_of (~alias : string) (~binary : string) : remote_status =
    ?= process.try_capture_combined_list "ssh" (ssh_arguments alias binary) ?|
    | Some output => status_of output
    | None => RemoteUnreachable "ssh did not run"

:~ remote_status_run (~alias : string) (~binary : string) : i32 =
    := status = remote_status_of alias binary
    console.write_line (status_line alias status)
    ?= status ?|
    | RemoteReported _ => 0i32
    | RemoteUnreachable _ => 1i32

///> rust
:# a_window_summary_becomes_typed_remote_status =
    := summary = "eoie window list ok windows=5 free_mb=3805 heavy_slots=0\n"
    := output = "win-1  compile  held  5m left  x\n" ++# summary
    ?= status_of output ?|
    | RemoteReported report =>
        ? report.windows = 5u64 && report.free_mb = 3805u64 && report.heavy_slots = 0u64 ?> () |: failwith "fields"
    | RemoteUnreachable reason => failwith reason
    ?= status_of "ssh: connect to host node port 22: Connection timed out\n" ?|
    | RemoteUnreachable reason => ? sm'.starts_with "ssh: connect" reason ?> () |: failwith reason
    | RemoteReported _ => failwith "an ssh error is unreachable"
    ? field_value " windows=7 free_mb=9" "free_mb" = 9u64 ?> () |: failwith "a field at the line end"
    ? field_value " windows=7" "heavy_slots" = 0u64 ?> () |: failwith "a missing field is zero"
    := line = status_line "node" (RemoteReported { windows = 1u64; free_mb = 2u64; heavy_slots = 3u64 })
    ? line = "kit remote status ok machine=node windows=1 free_mb=2 heavy_slots=3" ?> () |: failwith line
