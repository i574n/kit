:! incident_recovery_empty = ()
:! incident_recovery_validated = ()
:! incident_recovery_snapshot_captured = ()
:! incident_recovery_snapshot_verified = ()
:! incident_recovery_incident_declared = ()
:! incident_recovery_restore_staged = ()
:! incident_recovery_promoted = ()
:! incident_recovery_verified = ()

:| incident_recovery_op from to =
    | ValidateIncidentRecovery :: incident_recovery_op incident_recovery_empty incident_recovery_validated
    | CaptureIncidentSnapshot :: incident_recovery_op incident_recovery_validated incident_recovery_snapshot_captured
    | VerifyIncidentSnapshot ::
        incident_recovery_op incident_recovery_snapshot_captured incident_recovery_snapshot_verified
    | DeclareDestructiveIncident ::
        incident_recovery_op incident_recovery_snapshot_verified incident_recovery_incident_declared
    | StageIncidentRestore :: incident_recovery_op incident_recovery_incident_declared incident_recovery_restore_staged
    | PromoteIncidentRestore :: incident_recovery_op incident_recovery_restore_staged incident_recovery_promoted
    | VerifyIncidentRestore :: incident_recovery_op incident_recovery_promoted incident_recovery_verified

:| ^ incident_recovery_plan from to =
    | IncidentRecoveryStep :: \* from to. incident_recovery_op from to -> incident_recovery_plan from to
    | IncidentRecoveryThen :: \* from to.
        (\? middle. incident_recovery_plan from middle * incident_recovery_plan middle to) ->
        incident_recovery_plan from to

:= incident_recovery_complete_plan () : incident_recovery_plan incident_recovery_empty incident_recovery_verified =
    IncidentRecoveryThen (\? (
        IncidentRecoveryStep ValidateIncidentRecovery,
        IncidentRecoveryThen (\? (
            IncidentRecoveryStep CaptureIncidentSnapshot,
            IncidentRecoveryThen (\? (
                IncidentRecoveryStep VerifyIncidentSnapshot,
                IncidentRecoveryThen (\? (
                    IncidentRecoveryStep DeclareDestructiveIncident,
                    IncidentRecoveryThen (\? (
                        IncidentRecoveryStep StageIncidentRestore,
                        IncidentRecoveryThen (\? (
                            IncidentRecoveryStep PromoteIncidentRestore,
                            IncidentRecoveryStep VerifyIncidentRestore
                        ))
                    ))
                ))
            ))
        ))
    ))

:| incident_recovery_target =
    | TargetAbsent
    | TargetDirectory

:| incident_recovery_fault =
    | NoIncidentRecoveryFault
    | FaultAfterQuarantine
    | FaultAfterPromotion

:= incident_recovery_target_code = \|
    | TargetAbsent => 0i32
    | TargetDirectory => 1i32

:= incident_recovery_fault_code = \|
    | NoIncidentRecoveryFault => 0i32
    | FaultAfterQuarantine => 1i32
    | FaultAfterPromotion => 2i32

:~ incident_recovery_scope_binding
    (root_safe : i32) (source_safe : i32) (snapshot_safe : i32) (receipt_safe : i32)
    : i32
    =
    ? root_safe < 1i32 ?> 0i32
    |? 1i32 < root_safe ?> 0i32
    |? source_safe < 1i32 ?> 0i32
    |? 1i32 < source_safe ?> 0i32
    |? snapshot_safe < 1i32 ?> 0i32
    |? 1i32 < snapshot_safe ?> 0i32
    |? receipt_safe < 1i32 ?> 0i32
    |? 1i32 < receipt_safe ?> 0i32
    |: 1i32

:~ incident_recovery_leaf_binding (same_leaf : i32) (paths_separated : i32) : i32 =
    ? same_leaf < 1i32 ?> 0i32
    |? 1i32 < same_leaf ?> 0i32
    |? paths_separated < 1i32 ?> 0i32
    |? 1i32 < paths_separated ?> 0i32
    |: 1i32

:~ incident_recovery_snapshot_binding
    (source_directory : i32) (snapshot_absent : i32) (copy_complete : i32) (hash_parity : i32)
    : i32
    =
    ? source_directory < 1i32 ?> 0i32
    |? 1i32 < source_directory ?> 0i32
    |? snapshot_absent < 1i32 ?> 0i32
    |? 1i32 < snapshot_absent ?> 0i32
    |? copy_complete < 1i32 ?> 0i32
    |? 1i32 < copy_complete ?> 0i32
    |? hash_parity < 1i32 ?> 0i32
    |? 1i32 < hash_parity ?> 0i32
    |: 1i32

:~ incident_recovery_restore_binding
    (snapshot_directory : i32) (target_kind : i32) (stage_absent : i32) (receipt_match : i32)
    : i32
    =
    ? snapshot_directory < 1i32 ?> 0i32
    |? 1i32 < snapshot_directory ?> 0i32
    |? target_kind < 0i32 ?> 0i32
    |? 1i32 < target_kind ?> 0i32
    |? stage_absent < 1i32 ?> 0i32
    |? 1i32 < stage_absent ?> 0i32
    |? receipt_match < 1i32 ?> 0i32
    |? 1i32 < receipt_match ?> 0i32
    |: 1i32

:~ incident_recovery_fault_binding (configured : i32) (observed : i32) : i32 =
    ? configured < 1i32 ?> 0i32
    |? 2i32 < configured ?> 0i32
    |? configured < observed ?> 0i32
    |? observed < configured ?> 0i32
    |: 1i32

:~ incident_recovery_rollback_binding
    (original_present : i32) (rollback_restored : i32) (original_hash_match : i32)
    : i32
    =
    ? original_present < 0i32 ?> 0i32
    |? 1i32 < original_present ?> 0i32
    |? rollback_restored < 1i32 ?> 0i32
    |? 1i32 < rollback_restored ?> 0i32
    |? original_hash_match < 1i32 ?> 0i32
    |? 1i32 < original_hash_match ?> 0i32
    |: 1i32

:~ incident_recovery_completion_binding
    (snapshot_hash_match : i32) (stage_hash_match : i32) (final_hash_match : i32)
    : i32
    =
    ? snapshot_hash_match < 1i32 ?> 0i32
    |? 1i32 < snapshot_hash_match ?> 0i32
    |? stage_hash_match < 1i32 ?> 0i32
    |? 1i32 < stage_hash_match ?> 0i32
    |? final_hash_match < 1i32 ?> 0i32
    |? 1i32 < final_hash_match ?> 0i32
    |: 1i32

:~ incident_recovery_scope_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 15i32 ?> 0i32 |? 15i32 < mask ?> 0i32 |? witness < 0i32 ?> 0i32 |? 0i32 < witness ?> 0i32 |: 1i32

:~ incident_recovery_snapshot_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 15i32 ?> 0i32 |? 15i32 < mask ?> 0i32 |? witness < 0i32 ?> 0i32 |? 0i32 < witness ?> 0i32 |: 1i32

:~ incident_recovery_restore_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 7i32 ?> 0i32
    |? 7i32 < mask ?>
        ? mask < 15i32 ?> 0i32
        |? 15i32 < mask ?> 0i32
        |? witness < 0i32 ?> 0i32
        |? 0i32 < witness ?> 0i32
        |: 1i32
    |? witness < 0i32 ?> 0i32
    |? 0i32 < witness ?> 0i32
    |: 1i32

:~ incident_recovery_rollback_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 6i32 ?> 0i32 |? 7i32 < mask ?> 0i32 |? witness < 0i32 ?> 0i32 |? 0i32 < witness ?> 0i32 |: 1i32

:~ incident_recovery_completion_mask_binding (mask : i32) (witness : i32) : i32 =
    ? mask < 7i32 ?> 0i32 |? 7i32 < mask ?> 0i32 |? witness < 0i32 ?> 0i32 |? 0i32 < witness ?> 0i32 |: 1i32
