///- --package .
:# lease static =
    :< sm'_operators

:< sm'_operators

:! reads = ()
:! shapes = ()

:== lease_terms =
    {
        root : string
        holder : string
        until_ms : u64
    }

:| tree_lease use =
    | ReadLease :: lease_terms -> tree_lease reads
    | ShapeLease :: lease_terms -> tree_lease shapes

:| stored_lease =
    | StoredRead : lease_terms
    | StoredShape : lease_terms

:| ^ stored_leases =
    | NoLeases
    | LeaseThen : stored_lease * stored_leases

:| tree_claim =
    | TreeFree
    | TreeHeld : lease_terms

:| edit_verdict =
    | EditAllowed
    | EditRefused : lease_terms

:= path_key (~path : string) : string = sm'.to_lower (sm'.replace "\\" "/" path)

:= root_key (~root : string) : string =
    := key = path_key root
    ? sm'.ends_with "/" key ?> key |: key ++# "/"

:= path_inside (~root : string) (~path : string) : bool =
    := key = path_key path
    key ++# "/" = root_key root || sm'.starts_with (root_key root) key

:= terms_bind (terms : lease_terms) (~path : string) (now : u64) : bool =
    now < terms.until_ms && path_inside terms.root path

:= stored \* use. (lease : tree_lease use) : stored_lease =
    ?= lease ?|
    | ReadLease terms => StoredRead terms
    | ShapeLease terms => StoredShape terms

:= blocking_terms (row : stored_lease) : option lease_terms =
    ?= row ?|
    | StoredRead terms => Some terms
    | StoredShape _ => None

:~ ^ claim_of (leases : stored_leases) (~path : string) (now : u64) : tree_claim =
    ?= leases ?|
    | NoLeases => TreeFree
    | LeaseThen (stored, rest) =>
        ?= blocking_terms stored ?|
        | Some terms => ? terms_bind terms path now ?> TreeHeld terms |: claim_of rest path now
        | None => claim_of rest path now

:= edit_verdict_of (claim : tree_claim) : edit_verdict =
    ?= claim ?|
    | TreeFree => EditAllowed
    | TreeHeld terms => EditRefused terms

:= minutes_left (terms : lease_terms) (now : u64) : u64 = (terms.until_ms - now + 59999u64) / 60000u64

:= verdict_text (verdict : edit_verdict) (now : u64) : string =
    ?= verdict ?|
    | EditAllowed => "edit allowed"
    | EditRefused terms =>
        "edit refused: "
        ++# terms.root
        ++# " is read by "
        ++# terms.holder
        ++# " for "
        ++# sm'.format (minutes_left terms now)
        ++# " more min"


:= release_terms () : lease_terms = { root = "C:\\work\\repo"; holder = "release job-7"; until_ms = 600000u64 }

:= release_leases () : stored_leases = LeaseThen (stored (ReadLease (release_terms ())), NoLeases)

///> rust
:# a_reading_lease_refuses_edits_inside_its_root =
    testing.expect
        (
            edit_verdict_of (claim_of (release_leases ()) "C:\\work\\repo\\lab\\probe.ps1" 1000u64)
            = EditRefused (release_terms ())
        )
        "a file in lab/ under the leased root is refused"
    testing.expect
        (
            edit_verdict_of (claim_of (release_leases ()) "c:/WORK/repo/src/a.spi" 1000u64)
            = EditRefused (release_terms ())
        )
        "case and separators do not matter on Windows"
    testing.expect
        (edit_verdict_of (claim_of (release_leases ()) "C:\\work\\repo" 1000u64) = EditRefused (release_terms ()))
        "the root itself is inside"

///> rust
:# edits_outside_the_root_after_the_lease_or_under_a_shaping_lease_pass =
    testing.expect
        (edit_verdict_of (claim_of (release_leases ()) "C:\\work\\repository\\a.spi" 1000u64) = EditAllowed)
        "a sibling with the same prefix is outside"
    testing.expect
        (edit_verdict_of (claim_of (release_leases ()) "C:\\work\\repo\\a.spi" 600000u64) = EditAllowed)
        "an expired lease binds nothing"
    := shaping = LeaseThen (stored (ShapeLease (release_terms ())), NoLeases)
    testing.expect
        (edit_verdict_of (claim_of shaping "C:\\work\\repo\\a.spi" 1000u64) = EditAllowed)
        "a shaping lease cannot block by its type"
    := mixed = LeaseThen (stored (ShapeLease (release_terms ())), release_leases ())
    testing.expect
        (edit_verdict_of (claim_of mixed "C:\\work\\repo\\a.spi" 1000u64) = EditRefused (release_terms ()))
        "a reader behind a shaper still blocks"

///> rust
:# a_refusal_names_the_holder_and_the_time_left =
    := verdict = edit_verdict_of (claim_of (release_leases ()) "C:\\work\\repo\\a.spi" 60000u64)
    testing.expect
        (verdict_text verdict 60000u64 = "edit refused: C:\\work\\repo is read by release job-7 for 9 more min")
        (verdict_text verdict 60000u64)
    testing.expect (verdict_text EditAllowed 0u64 = "edit allowed") "allowed"
