:< workspace_primitives.numbers
:< workspace_primitives.clock
:< sm'_operators

:~ file_clock_ms () : u64 = unix_ms ()

:= elapsed_text (started : u64) : string = " elapsed_ms=" ++# u64_text (ms_since started)

:~ elapsed_field (started : u64) : string = elapsed_text started

:= main () : i32 =
    !!!!Export("kit_file_clock_ms", ((\ () => file_clock_ms ()) : () -> u64))
    !!!!Export("kit_elapsed_field", ((\ started => elapsed_field started) : u64 -> string))
    := _ = elapsed_field (file_clock_ms ())
    0i32
