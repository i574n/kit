open sm'_operators
open eoie_jobs.host
open eoie_machine_windows.window_model
open eoie_machine_windows.windows
open settle

let rec rows_busy (~words : string) (~rows : string) : bool =
    if rows = "" then false
    else sm'.index_of ("," ++# tab_field (first_row rows) 1i32 ++# ",") ("," ++# words ++# ",") >= 0 || rows_busy words (other_rows rows)

let rec waited (~words : string) (terms : settle_terms) (progress : settle_progress) (every : u64) : settle_verdict * settle_progress =
    inl root = windows_root ()
    inl next = observed progress (rows_busy words (live_rows root (stored_rows root) (now_ms ()) ""))
    match verdict_of terms next with
    | KeepWaiting =>
        sleep_ms every
        waited words terms next every
    | finished => finished, next

inl unknown_class (~word : string) : bool =
    match class_of word with
    | ClassUnknown => true
    | ClassKnown _ => false

inl contention_text (progress : settle_progress) : string =
    match contention_of progress with
    | Quiet => "quiet"
    | Contended busy => "contended busy_samples=" ++# number_text busy

inl option_or (~flag : string) (fallback : u64) : u64 = if option_value flag = "" then fallback else decimal_of (option_value flag)

let window_wait_cleared () : i32 =
    inl words = argument 3i32
    inl every = option_or "--every" 30u64 * 1000u64
    if words = "" || sm'.starts_with "--" words || (sm'.split "," words |> am'.any (fun word => unknown_class word)) then
        refused ("wait-clear: give known window classes separated by commas, e.g. window wait-clear live-gui,compiler-install --settle 2 --max 120; classes " ++# class_words ())
    elif every = 0u64 then refused "wait-clear: --every needs a positive number of seconds"
    else
        inl terms = { clear_samples_needed = option_or "--settle" 2u64; max_samples = option_or "--max" 60u64 * 60000u64 / every + 1u64 }
        inl verdict, progress = waited words terms (progress_start ()) every
        inl tail = " classes=" ++# words ++# " samples=" ++# number_text progress.samples_taken ++# " " ++# contention_text progress
        match verdict with
        | ClearNow =>
            stdout_line ("eoie window wait-clear ok" ++# tail)
            0i32
        | _ =>
            stdout_line ("eoie window wait-clear gave-up" ++# tail)
            1i32

inl main () : i32 =
    !!!!Export("eoie_window_wait_run", ((fun () => window_wait_cleared ()) : () -> i32))
    0i32