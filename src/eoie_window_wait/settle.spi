///- --package .
test settle static =
    open sm'_operators

open sm'_operators

union window_hold =
    | HeldNow
    | WaitingNow

type sampled_window =
    {
        class_word : string
        hold : window_hold
    }

union rec window_sample =
    | NoWindows
    | WindowThen : sampled_window * window_sample

union rec watched_classes =
    | NoClasses
    | ClassThen : string * watched_classes

type settle_terms =
    {
        clear_samples_needed : u64
        max_samples : u64
    }

type settle_progress =
    {
        clear_streak : u64
        samples_taken : u64
        busy_samples : u64
    }

union settle_verdict =
    | KeepWaiting
    | ClearNow
    | GaveUp

union run_contention =
    | Quiet
    | Contended : u64

let rec watched (classes : watched_classes) (~word : string) : bool =
    match classes with
    | NoClasses => false
    | ClassThen (name, rest) => name = word || watched rest word

let rec sample_busy (classes : watched_classes) (sample : window_sample) : bool =
    match sample with
    | NoWindows => false
    | WindowThen (window, rest) => watched classes window.class_word || sample_busy classes rest

inl progress_start () : settle_progress = { clear_streak = 0u64; samples_taken = 0u64; busy_samples = 0u64 }

inl observed (progress : settle_progress) (busy : bool) : settle_progress =
    inl taken = progress.samples_taken + 1u64
    if busy then { clear_streak = 0u64; samples_taken = taken; busy_samples = progress.busy_samples + 1u64 }
    else { progress with clear_streak = progress.clear_streak + 1u64; samples_taken = taken }

inl verdict_of (terms : settle_terms) (progress : settle_progress) : settle_verdict =
    if progress.clear_streak >= terms.clear_samples_needed then ClearNow
    elif progress.samples_taken >= terms.max_samples then GaveUp
    else KeepWaiting

inl contention_of (progress : settle_progress) : run_contention =
    if progress.busy_samples = 0u64 then Quiet else Contended progress.busy_samples

union rec sample_series sample =
    | SeriesEnd
    | SampleThen : sample * sample_series sample

let rec settled forall sample. (terms : settle_terms) (busy : sample -> bool) (series : sample_series sample)
        (progress : settle_progress) : settle_verdict * settle_progress =
    match series with
    | SeriesEnd => verdict_of terms progress, progress
    | SampleThen (current, rest) =>
        inl next = observed progress (busy current)
        match verdict_of terms next with
        | KeepWaiting => settled terms busy rest next
        | finished => finished, next

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

inl blocks () : watched_classes = ClassThen ("live-gui", ClassThen ("compiler-install", NoClasses))

inl gui () : window_sample = WindowThen ({ class_word = "live-gui"; hold = HeldNow }, NoWindows)

inl compile_only () : window_sample = WindowThen ({ class_word = "compile"; hold = HeldNow }, NoWindows)

inl two_samples () : settle_terms = { clear_samples_needed = 2u64; max_samples = 10u64 }

inl limit_three () : settle_terms = { clear_samples_needed = 2u64; max_samples = 3u64 }

///> rust
test a_gap_between_back_to_back_blocks_is_not_the_end =
    inl second_block = SampleThen (gui (), SampleThen (NoWindows, SeriesEnd))
    inl gap_then_block = SampleThen (gui (), SampleThen (NoWindows, second_block))
    inl verdict, progress = settled (two_samples ()) (sample_busy (blocks ())) gap_then_block (progress_start ())
    expect (verdict = KeepWaiting) "one clear sample after a block is a gap, not the end"
    expect (progress.samples_taken = 4u64) "every sample counted"
    inl ended = SampleThen (gui (), SampleThen (compile_only (), SampleThen (NoWindows, SeriesEnd)))
    inl verdict_after, _ = settled (two_samples ()) (sample_busy (blocks ())) ended (progress_start ())
    expect (verdict_after = ClearNow) "a compile window is not a block, so two clear samples end it"

///> rust
test a_watch_gives_up_at_its_limit_and_a_run_knows_its_contention =
    inl busy_forever = SampleThen (gui (), SampleThen (gui (), SampleThen (gui (), SeriesEnd)))
    inl verdict, progress = settled (limit_three ()) (sample_busy (blocks ())) busy_forever (progress_start ())
    expect (verdict = GaveUp) "three busy samples reach the limit"
    expect (contention_of progress = Contended 3u64) "all three samples were busy"
    inl compiles = ClassThen ("compile", NoClasses)
    inl one_gui = SampleThen (gui (), SeriesEnd)
    inl _, quiet_progress = settled (two_samples ()) (sample_busy compiles) one_gui (progress_start ())
    expect (contention_of quiet_progress = Quiet) "a live window does not contend with a compile-only watch"
