///- --package .
:# model static =
    :< rust_std_fs.model
    :< agile_task_text.model
    :< workspace_primitives.outcome
    :< workspace_primitives.numbers
    :< workspace_primitives.bytes
    :< workspace_primitives.files

:< rust_std_fs.model
:< agile_task_text.model
:< workspace_primitives.outcome
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< workspace_primitives.files

:== task_note =
    {
        at : string
        author : string
        text : string
    }

:| item_kind =
    | TaskItem
    | PlanningItem
    | NoteItem

:= item_constructor = \|
    | TaskItem => "Task ("
    | PlanningItem => "Planning ("
    | NoteItem => "Note ("

:= item_anchor (kind : item_kind) (~id : string) : string =
    rust_std_string.model.concat5 (item_constructor kind) "\"" id "\"," ""
:= item_arguments_offset (kind : item_kind) : i32 = byte_len (item_constructor kind)

:= item_binding (~id : string) : string = ascii_lowercase (rust_std_string.model.replace id "-" "_")
:= planning_binding (~id : string) : string = rust_std_string.model.concat5 "planning_of_" (item_binding id) "" "" ""
:= note_binding (~id : string) (seq : i32) : string =
    rust_std_string.model.concat5 "note_of_" (item_binding id) "_" (i32_text seq) ""

:= note_schema () : string = "union task_note =\n    | Note :: string * u32 * string * string * string -> task_note"
:= note_schema_marker () : string = "union task_note ="
:= planning_union_marker () : string = "-> task_planning"
:= agile_item_marker () : string = "-> agile_item"

:~ note_row (~id : string) (seq : i32) (note : task_note) : string =
    := head = rust_std_string.model.concat5 "inl " (note_binding id seq) " () = Note (" (spi_quoted id) ", "
    := middle = rust_std_string.model.concat5 (i32_text seq) "u32, " (spi_quoted note.at) ", " (spi_quoted note.author)
    rust_std_string.model.concat5 head middle ", " (spi_quoted note.text) ")"

:~ ^ declared_from (text : string) (~needle : string) (offset : i32) : i32 =
    := found = byte_find_from text needle offset
    ? found < 0i32 ?> found
    |? declared_task text found ?> found
    |: declared_from text needle (found + 1i32)

:~ ^ declared_count (text : string) (~needle : string) (offset : i32) (counted : i32) : i32 =
    := found = declared_from text needle offset
    ? found < 0i32 ?> counted |: declared_count text needle (found + 1i32) (counted + 1i32)

:~ ^ last_declared (text : string) (~needle : string) (offset : i32) (latest : i32) : i32 =
    := found = declared_from text needle offset
    ? found < 0i32 ?> latest |: last_declared text needle (found + 1i32) found

:= item_offset (text : string) (kind : item_kind) (~id : string) : i32 = declared_from text (item_anchor kind id) 0i32
:= task_declared (text : string) (~id : string) : bool = ? item_offset text TaskItem id < 0i32 ?> !- |: !+
:= note_count (text : string) (~id : string) : i32 = declared_count text (item_anchor NoteItem id) 0i32 0i32

:= line_end_after (text : string) (offset : i32) : i32 =
    := found = byte_find_from text "\n" offset
    ? found < 0i32 ?> byte_len text |: found

:= spliced (text : string) (start : i32) (stop : i32) (~middle : string) : string =
    rust_std_string.model.concat5 (byte_slice text 0i32 start) middle (byte_slice text stop (byte_len text)) "" ""

:= later (a : i32) (b : i32) : i32 = ? a <= b ?> b |: a

:~ notes_insertion (text : string) (~id : string) : i32 =
    := task = item_offset text TaskItem id
    := planning = item_offset text PlanningItem id
    := note = last_declared text (item_anchor NoteItem id) 0i32 (-1i32)
    line_end_after text (later task (later planning note))

:~ note_schema_ensured (text : string) : string =
    ? byte_find text (note_schema_marker ()) < 0i32 ?>
        := planning = byte_find text (planning_union_marker ())
        := anchor = ? planning < 0i32 ?> byte_find text (agile_item_marker ()) |: planning
        if anchor < 0i32 then rust_std_string.model.concat5 (note_schema ()) """



            """ text "" ""
        |:
            := stop = line_end_after text anchor
            spliced text stop stop (rust_std_string.model.concat5 """



                """ (note_schema ()) "" "" "")
    |: text

:~ notes_appended (text : string) (~id : string) (~rows : string) : string =
    := at = notes_insertion text id
    spliced text at at (rust_std_string.model.concat5 "\n" rows "" "" "")

:= ascii_n () : i32 = 110i32
:= ascii_r () : i32 = 114i32
:= ascii_t () : i32 = 116i32

:= escape_target (text : string) (escaped : i32) : string =
    := code = byte_at text escaped
    ? code = ascii_n () ?> "\n"
    |? code = ascii_r () ?> "\r"
    |? code = ascii_t () ?> "\t"
    |: byte_slice text escaped (escaped + 1i32)

:~ ^ unescaped_from
    (~text : string) (~offset : i32) (~run_start : i32) (~length : i32) (~decoded : string)
    : string
    =
    ? length <= offset ?> rust_std_string.model.concat5 decoded (byte_slice text run_start length) "" "" ""
    |? byte_at text offset = backslash_byte () ?>
        := escaped = offset + 1i32
        := resumed = escaped + 1i32
        unescaped_from text resumed resumed length (
            rust_std_string.model.concat5 decoded (byte_slice text run_start offset) (escape_target text escaped) "" ""
        )
    |: unescaped_from text (offset + 1i32) run_start length decoded

:= quote_stripped (~token : string) : string = byte_slice token 1i32 (byte_len token - 1i32)

:~ unquoted (~token : string) : string =
    := inner = quote_stripped token
    unescaped_from inner 0i32 0i32 (byte_len inner) ""

:= item_field (text : string) (kind : item_kind) (found : i32) (position : i32) : string =
    tuple_field text ((found + (item_arguments_offset kind))) (byte_len text) position

:~ note_at (text : string) (found : i32) : task_note =
    {
        at = unquoted (item_field text NoteItem found 2i32)
        author = unquoted (item_field text NoteItem found 3i32)
        text = unquoted (item_field text NoteItem found 4i32)
    }

:~ local_stamp (~at : string) : string =
    := offset = kit_receipt.receipt.local_offset_minutes ()
    $'{ let at = &*!at; let offset = !offset; let parsed = (|| -> Option<i64> { let hours: i64 = \
        at.get(11..13)?.parse().ok()?; let minutes: i64 = at.get(14..16)?.parse().ok()?; Some(hours * 60 + minutes) \
        })(); std::rc::Rc::<str>::from(match parsed { Some(total) => { let local = (total + offset).rem_euclid(1440); \
        let sign = if offset < 0 { char::from(45u8) } else { char::from(43u8) }; format\!(" ({:02}:{:02} \
        {}{:02}:{:02})", local / 60, local % 60, sign, offset.abs() / 60, offset.abs() % 60) } None => String::new() \
        }) }' : string

:= note_line (note : task_note) : string =
    rust_std_string.model.concat5 note.at
        (local_stamp note.at)
        "  "
        note.author
        (rust_std_string.model.concat5 "  " note.text "" "" "")

:~ note_json_at (text : string) (found : i32) : string =
    := field = item_field text NoteItem found
    := head = rust_std_string.model.concat5 "{\"at\":" (field 2i32) ",\"author\":" (field 3i32) ","
    rust_std_string.model.concat5 head "\"text\":" (field 4i32) "}" ""

:~ ^ note_lines_from (text : string) (~needle : string) (offset : i32) (~lines : string) : string =
    := found = declared_from text needle offset
    ? found < 0i32 ?> lines
    |:
        note_lines_from text needle
            (found + 1i32)
            (rust_std_string.model.concat5 lines "\n" (note_line (note_at text found)) "" "")

:~ ^ note_json_from (text : string) (~needle : string) (offset : i32) (~items : string) (~joint : string) : string =
    := found = declared_from text needle offset
    ? found < 0i32 ?> items
    |:
        note_json_from text needle
            (found + 1i32)
            (rust_std_string.model.concat5 items joint (note_json_at text found) "" "")
            ","

:~ notes_text (text : string) (~id : string) : string =
    := count = note_count text id
    ? count = 0i32 ?> ""
    |:
        note_lines_from text
            (item_anchor NoteItem id)
            0i32
            (rust_std_string.model.concat5 "notes (" (i32_text count) ")" "" "")

:~ notes_json (text : string) (~id : string) : string =
    rust_std_string.model.concat5 "\"notes\":[" (note_json_from text (item_anchor NoteItem id) 0i32 "" "") "]" "" ""

:= u64_div (a : u64) (b : u64) : u64 = (a / b)
:= u64_rem (a : u64) (b : u64) : u64 = (a % b)
:= u64_add (a : u64) (b : u64) : u64 = (a + b)
:= u64_sub (a : u64) (b : u64) : u64 = (a - b)
:= u64_mul (a : u64) (b : u64) : u64 = (a * b)
:= u64_lt (a : u64) (b : u64) : bool = (a < b)

:= two_digits (value : u64) : string =
    ? value < 10u64 ?> rust_std_string.model.concat5 "0" (u64_text value) "" "" "" |: u64_text value

:== civil_date =
    {
        year : u64
        month : u64
        day : u64
    }

:~ civil_of_days (days : u64) : civil_date =
    := z = days + 719468u64
    := era = z / 146097u64
    := doe = z - (era * 146097u64)
    := yoe = (((doe - (doe / 1460u64)) + (doe / 36524u64)) - (doe / 146096u64)) / 365u64
    := doy = doe - (((365u64 * yoe) + (yoe / 4u64)) - (yoe / 100u64))
    := mp = ((5u64 * doy) + 2u64) / 153u64
    := day = (doy - (((153u64 * mp) + 2u64) / 5u64)) + 1u64
    := month = ? mp < 10u64 ?> mp + 3u64 |: mp - 9u64
    := year = (yoe + (era * 400u64)) + (? month < 3u64 ?> 1u64 |: 0u64)
    { year = year; month = month; day = day }

:~ utc_stamp (unix_ms : u64) : string =
    := seconds = unix_ms / 1000u64
    := date = civil_of_days (seconds / 86400u64)
    := minute_of_day = (seconds % 86400u64) / 60u64
    := head = rust_std_string.model.concat5 (u64_text date.year) "-" (two_digits date.month) "-" (two_digits date.day)
    := clock =
        rust_std_string.model.concat5
            (two_digits (minute_of_day / 60u64))
            ":"
            (two_digits (minute_of_day % 60u64))
            "Z"
            ""
    rust_std_string.model.concat5 head "T" clock "" ""

:| state_write =
    | StateWritten
    | StateChangedSinceRead
    | StateWriteFailed : string

:= pause_marker (~path : string) : string = rust_std_string.model.concat5 path ".paused" "" "" ""
:= pause_after_read_for_tests (~path : string) : () =
    := marker = pause_marker path
    $'std::env::var("KIT_AGILE_TEST_PAUSE_MS").ok().and_then(|value| value.parse::<u64>().ok()).map(|ms| { let _ = \
        std::fs::write(&*!marker, b""); std::thread::sleep(std::time::Duration::from_millis(ms)); let _ = \
        std::fs::remove_file(&*!marker); }).unwrap_or(())' : ()

:~ state_written (~path : string) (~original : string) (~updated : string) : state_write =
    := _ = pause_after_read_for_tests path
    ? text_equals original path ?>
        ?= replace_file_checked path updated ?|
        | Replaced => StateWritten
        | problem => StateWriteFailed (file_replacement_problem problem)
    |: StateChangedSinceRead

:= state_write_problem = \|
    | StateWritten => ""
    | StateChangedSinceRead => "state/agile.spi changed since it was read; nothing written, run the call again"
    | StateWriteFailed reason => reason

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail

///> rust
:# notes_show_local_time_next_to_utc =
    := shown = local_stamp "2026-10-21T20:45Z"
    expect (rust_std_string.model.starts_with shown " (" && rust_std_string.model.contains shown ":") shown
    expect (local_stamp "not a stamp" = "") "a malformed stamp shows nothing extra"
