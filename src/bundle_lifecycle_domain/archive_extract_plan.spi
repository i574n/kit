:! archive_extract_idle = ()
:! archive_extract_preflighted = ()
:! archive_extract_running = ()
:! archive_extract_observed = ()
:! archive_extract_confined = ()

:| archive_extract_op from to =
    | RejectExistingDestination :: archive_extract_op archive_extract_idle archive_extract_preflighted
    | LaunchNativeExtractor :: archive_extract_op archive_extract_preflighted archive_extract_running
    | ObserveNativeExtractor :: archive_extract_op archive_extract_running archive_extract_observed
    | ValidateExtractedArchive :: archive_extract_op archive_extract_observed archive_extract_confined

:| ^ archive_extract_plan from to =
    | ArchiveExtractStep :: \* from to. archive_extract_op from to -> archive_extract_plan from to
    | ArchiveExtractThen :: \* from to.
        (\? middle. archive_extract_plan from middle * archive_extract_plan middle to) ->
        archive_extract_plan from to

:= native_extract_plan () : archive_extract_plan archive_extract_idle archive_extract_confined =
    ArchiveExtractThen (\? (
        ArchiveExtractStep RejectExistingDestination,
        ArchiveExtractThen (\? (
            ArchiveExtractStep LaunchNativeExtractor,
            ArchiveExtractThen (\? (
                ArchiveExtractStep ObserveNativeExtractor,
                ArchiveExtractStep ValidateExtractedArchive
            ))
        ))
    ))

:~ archive_extract_preflight_binding (destination_exists : i32) (archive_entries_safe : i32) : i32 =
    ? destination_exists < 0i32 ?> 0i32
    |? 1i32 < destination_exists ?> 0i32
    |? archive_entries_safe < 1i32 ?> 0i32
    |? 1i32 < archive_entries_safe ?> 0i32
    |? destination_exists < 1i32 ?> 1i32
    |: 0i32

:~ archive_extract_process_binding (extractor_ok : i32) (staging_confined : i32) : i32 =
    ? extractor_ok < 1i32 ?> 0i32
    |? 1i32 < extractor_ok ?> 0i32
    |? staging_confined < 1i32 ?> 0i32
    |? 1i32 < staging_confined ?> 0i32
    |: 1i32

:~ archive_extract_complete_binding (expected_payloads : i32) (observed_payloads : i32) : i32 =
    bundle_extract_binding expected_payloads observed_payloads

:~ archive_extract_receipt_binding (preflight_ok : i32) (completion_ok : i32) : i32 =
    bundle_complete_binding preflight_ok completion_ok
