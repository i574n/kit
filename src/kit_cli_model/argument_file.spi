///- --package .
:| argument_source =
    | DirectArguments
    | FileArguments : string
    | StdinArguments

:! argument_text = $'Result<std::rc::Rc<str>, std::rc::Rc<str>>'

:= argument_flag () : string = "--args-from"

:= standard_input_marker () : string = "-"

:= process_argument (~index : i32) : string =
    $'std::rc::Rc::<str>::from(std::env::args().nth(!index as usize).unwrap_or_default())' : string

:~ argument_source () : argument_source =
    ? process_argument 1i32 = argument_flag () ?>
        := origin = process_argument 2i32
        ? origin = standard_input_marker () ?> StdinArguments |: FileArguments origin
    |: DirectArguments

:= file_text (~path : string) : argument_text =
    $'std::fs::read_to_string(&*!path).map(std::rc::Rc::<str>::from).map_err(|error| \
        std::rc::Rc::<str>::from(format\!("--args-from {}: {error}", &*!path)))' : argument_text

:= stdin_text () : argument_text =
    $'{ let mut text = String::new(); std::io::Read::read_to_string(&mut std::io::stdin(), \
        &mut text).map(|_| std::rc::Rc::<str>::from(text)).map_err(|error| \
        std::rc::Rc::<str>::from(format\!("--args-from -: {error}"))) }' : argument_text

:= text_read (~text : argument_text) : bool = $'!text.is_ok()' : bool

:= text_value (~text : argument_text) : string =
    $'!text.clone().unwrap_or_else(|error| error)' : string

:= argument_count (~text : string) : i32 =
    $'!text.lines().map(|line| line.trim_end_matches(char::from(13u8))).count() as i32' : i32

:= standard_handles_private () : () =
    $'\#[cfg(windows)] { unsafe extern "system" { fn SetHandleInformation(handle: *mut std::ffi::c_void, mask: u32, \
        flags: u32) -> i32; } use std::os::windows::io::AsRawHandle; \
        unsafe { SetHandleInformation(std::io::stdin().as_raw_handle(), 1, 0); \
        SetHandleInformation(std::io::stdout().as_raw_handle(), 1, 0); \
        SetHandleInformation(std::io::stderr().as_raw_handle(), 1, 0); } }' : ()

:= relaunched_with (~text : string) : i32 =
    $'{ let arguments = !text.lines().map(|line| line.trim_end_matches(char::from(13u8)).to_owned()).chain(std::env::a\
        rgs().skip(3)).collect::<Vec<_>>(); match std::env::current_exe().and_then(|exe| \
        std::process::Command::new(exe).args(&arguments).status()) { Ok(status) => status.code().unwrap_or(1), \
        Err(error) => { eprintln\!("kit error: --args-from relaunch: {error}"); 2 } } }' : i32

:= rejected (~message : string) : i32 =
    $'{ eprintln\!("kit error: {}", &*!message); 2 }' : i32

:= relaunched (text : argument_text) : i32 =
    ? text_read text ?> relaunched_with (text_value text) |: rejected (text_value text)

:~ run_from (source : argument_source) (direct : () -> i32) : i32 =
    standard_handles_private ()
    ?= source ?|
    | DirectArguments => direct ()
    | FileArguments path => relaunched (file_text path)
    | StdinArguments => relaunched (stdin_text ())

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail

///> rust
:# each_line_is_one_argument_and_quotes_survive =
    expect (argument_count "agile\nnote\nroot\nID\nsay \"hi\" twice" = 5i32) "five lines"
    expect (argument_count "a\r\nb\r\n" = 2i32) "crlf lines and a final newline"
