open rust_std_string.model
open eoie_machine_watch_model.model

inl line_count (~text : string) : i32 = $'(&*!text).lines().filter(|line| \!line.is_empty()).count() as i32' : i32
inl line_at (~text : string) (index : i32) : string = $'std::rc::Rc::<str>::from((&*!text).lines().filter(|line| \
    \!line.is_empty()).nth(!index as usize).unwrap_or(""))' : string
inl appended (~text : string) (~line : string) : string = if text = "" then line else concat5 text "\n" line "" ""
inl job_state_word (~id : string) : string = $'eoie_job_control::eoie_job_state_word(&*!id)' : string
inl tab_field (~row : string) (index : i32) : string = $'std::rc::Rc::<str>::from((&*!row).split(char::from(9u8)).nth(\
    !index as usize).unwrap_or(""))' : string
inl label_job (~label : string) : string = $'std::rc::Rc::<str>::from((&*!label).split("(eoie job \
    ").nth(1).and_then(|rest| rest.split(char::from(41u8)).next()).unwrap_or(""))' : string

let rec windows_watched (~windows : string) (index : i32) (~report : string) : string =
    if index >= line_count windows then report
    else
        inl row = line_at windows index
        inl job = label_job (tab_field row 3i32)
        inl state = if job = "" then "" else job_state_word job
        inl line =
            concat5 "  " (tab_field row 0i32) "  " (tab_field row 1i32) (
                concat5 "  " (tab_field row 2i32) "  " (tab_field row 3i32) (window_text (
                window_health_of (tab_field row 2i32 = "held") state)))
        windows_watched windows (index + 1i32) (appended report line)

let gate_summary () : string =
    $'{ let path = std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME")).map(std::path::PathBuf::from).\
        unwrap_or_default().join(".claude").join("autonomous").join("gate.log"); let text = \
        std::fs::read_to_string(&path).unwrap_or_default(); let mut sessions: std::collections::BTreeMap<String, \
        (u64, u64)> = std::collections::BTreeMap::new(); let lines = text.lines().collect::<Vec<_>>(); for line in \
        lines.iter().rev().take(4000) { let fields = line.split_whitespace().collect::<Vec<_>>(); if fields.len() < 4 \
        { continue; } let entry = sessions.entry(fields[2].to_owned()).or_insert((0, 0)); if fields[3] == "block" { \
        entry.0 += 1; } else if line.contains("idle") && fields[3] == "pass" { entry.1 += 1; } } \
        std::rc::Rc::<str>::from(sessions.into_iter().map(|(session, (blocks, idle))| format\!("  {session}: blocks \
        {blocks}, idle passes {idle}{}", if idle > 0 { "  <- idled" } else { "" \
        })).collect::<Vec<_>>().join("\n").as_str()) }' : string

inl main () : i32 =
    !!!!Export("eoie_machine_windows_lines", ((fun windows => windows_watched windows 0i32 "") : string -> string))
    !!!!Export("eoie_machine_gate_summary", ((fun () => gate_summary ()) : () -> string))
    0i32
