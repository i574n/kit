///- --package .
:# receipt static =
    :< sm'_operators

:< sm'_operators

:| receipt_outcome =
    | Succeeded
    | Failed

:~ now_ms () : u64 =
    $'std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|elapsed| elapsed.as_millis() as \
        u64).unwrap_or(0)' : u64

:~ decimal_text (~value : u64) : string = $'std::rc::Rc::<str>::from((!value).to_string())' : string

:~ elapsed_text (~started : u64) : string =
    $'{ let millis = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|elapsed| \
        elapsed.as_millis() as u64).unwrap_or(0).saturating_sub(!started); \
        std::rc::Rc::<str>::from(if millis < 10000 { format\!("{millis}ms") } else { format\!("{:.1}s", \
        millis as f64 / 1000.0) }) }' : string

:~ local_offset_minutes () : i64 =
    $'{ \#[cfg(windows)] fn offset() -> i64 { \#[repr(C)] \#[derive(Default)] \#[allow(dead_code)] struct WindowsTime \
        { year: u16, month: u16, weekday: u16, day: u16, hour: u16, minute: u16, second: u16, \
        millis: u16 } unsafe extern "system" { fn GetLocalTime(time: *mut WindowsTime); \
        fn GetSystemTime(time: *mut WindowsTime); } let mut local = WindowsTime::default(); \
        let mut universal = WindowsTime::default(); unsafe { GetLocalTime(&mut local); GetSystemTime(&mut universal); \
        } let minutes = |time: &WindowsTime| time.day as i64 * 1440 + time.hour as i64 * 60 + time.minute as i64; \
        let raw = (minutes(&local) - minutes(&universal)).rem_euclid(1440); \
        ((if raw > 840 { raw - 1440 } else { raw }) as f64 / 15.0).round() as i64 * 15 } \#[cfg(not(windows))] fn \
        offset() -> i64 { 0 } offset() }' : i64

:~ clock_text () : string =
    := offset = local_offset_minutes ()
    $'{ let offset = !offset; let seconds = (std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|e\
        lapsed| elapsed.as_secs()).unwrap_or(0) as i64 + offset * 60).rem_euclid(86400); \
        let sign = if offset < 0 { char::from(45u8) } else { char::from(43u8) }; \
        std::rc::Rc::<str>::from(if cfg\!(windows) { format\!("{:02}:{:02}:{:02}{}{:02}:{:02}", seconds / 3600, \
        seconds / 60 % 60, seconds % 60, sign, offset.abs() / 60, \
        offset.abs() % 60) } else { format\!("{:02}:{:02}:{:02}Z", seconds / 3600, seconds / 60 % 60, \
        seconds % 60) }) }' : string

:= outcome_word = \|
    | Succeeded => "ok"
    | Failed => "failed"

:~ receipt_line (outcome : receipt_outcome) (~counts : string) (~started : u64) : () =
    console.write_line (
        outcome_word outcome ++# "  " ++# counts ++# "  " ++# elapsed_text started ++# "  " ++# clock_text ()
    )

///> rust
:# receipt_parts_carry_elapsed_and_clock =
    testing.expect (sm'.contains "ms" (elapsed_text (now_ms ()))) "elapsed under ten seconds is in milliseconds"
    testing.expect (sm'.contains ":" (clock_text ())) "clock has hour and minute"
    testing.expect (outcome_word Failed = "failed") "failed word"
    := offset = local_offset_minutes ()
    testing.expect (offset > (-841i64) && offset < 841i64) "offset within fourteen hours"
