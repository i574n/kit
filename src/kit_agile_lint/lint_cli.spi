///- --package .
:# lint_cli static =
    :< sm'_operators

:< sm'_operators

:= summary_line (checks : i32) (items : i32) : string =
    "kit agile lint ok failing_items=" ++# sm'.show items ++# " failing_checks=" ++# sm'.show checks
    ++# " (report only; legacy items ratchet)"

:~ ^ distinct_ids
    (rows : array_base agile_quality_lint.lint.failure_row) (at : i32) (~last : string) (n : i32)
    : i32
    =
    ? at >= am'.length_base rows ?> n
    |:
        := id = (am'.index_base at rows).id
        distinct_ids rows (at + 1i32) id (? id = last ?> n |: n + 1i32)

:~ ^ printed (rows : array_base agile_quality_lint.lint.failure_row) (at : i32) : () =
    ? at < am'.length_base rows
    ?>
        := row = am'.index_base at rows
        console.write_line (row.id ++# " " ++# row.status ++# " " ++# row.check)
        printed rows (at + 1i32)
    |: ()

:~ ^ census_printed (rows : array_base agile_quality_state.state_rows.census_row) (at : i32) : () =
    ? at < am'.length_base rows
    ?>
        := row = am'.index_base at rows
        console.write_line ("kit agile lint census check=" ++# row.check ++# " items=" ++# sm'.show row.items)
        census_printed rows (at + 1i32)
    |: ()

:~ state_text (~root : string) : string =
    file_system.read_text_or_empty (sm'.replace "\\" "/" root ++# "/state/agile.spi")

:~ lint_run () : i32 =
    ?= env.command_line_arguments () ?|
    | _ :: _ :: root :: flag :: _ ?& flag = "--census" =>
        census_printed (agile_quality_state.state_rows.census_text_of (state_text root)) 0i32
        0i32
    | _ :: _ :: root :: rest ?& sm'.starts_with "-" root |> not =>
        := team = ?= rest ?| | flag :: value :: _ ?& flag = "--team" => value | _ => ""
        := rows = agile_quality_state.state_rows.team_failures_of (state_text root, team)
        printed rows 0i32
        console.write_line (summary_line (am'.length_base rows) (distinct_ids rows 0i32 "" 0i32))
        0i32
    | _ =>
        console.write_error_line "usage: kit agile lint <root> [--census | --team <team>]"
        2i32

///> rust
:# the_summary_names_items_and_checks =
    := expected = "kit agile lint ok failing_items=2 failing_checks=3 "
    testing.expect (sm'.starts_with expected (summary_line 3i32 2i32)) (summary_line 3i32 2i32)
///> _
:= main () : i32 =
    export "kit_agile_lint_run" lint_run
    0i32
