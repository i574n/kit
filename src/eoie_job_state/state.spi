open rust_std_string.model
open eoie_jobs.model
open eoie_jobs.host
open eoie_jobs.jobs

let state_parts (~id : string) : string * i32 * string =
    inl state = job_state_now id
    state_word state, state_exit state, state_detail state

inl main () : i32 =
    !!!!Export("eoie_job_summary", ((fun (verb, id) => job_summary verb id) : string * string -> string))
    !!!!Export("eoie_job_state_parts", ((fun id => state_parts id) : string -> string * i32 * string))
    0i32
