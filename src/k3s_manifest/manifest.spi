///- --package .
:# manifest static =
    :< sm'_operators

:< sm'_operators

:! cpu = ()

:! memory = ()

:| quantity u =
    | Millicores :: u32 -> quantity cpu
    | Mebibytes :: u32 -> quantity memory

:= quantity_text \* u. (q : quantity u) : string =
    ?= q ?|
    | Millicores n => sm'.concat_list "" [ sm'.show n; "m" ]
    | Mebibytes n => sm'.concat_list "" [ sm'.show n; "Mi" ]

:| access =
    | ReadOnly
    | ReadWrite

:| volume_source =
    | HostPath : string
    | EmptyDir

:== volume = { name : string; source : volume_source; mount : string; access : access }

:== resources = { cpu_request : quantity cpu; memory_request : quantity memory; memory_limit : quantity memory }

:| strategy =
    | Recreate
    | Rolling

:== container = { name : string; image : string; command : list string; workdir : string }

:== deployment =
    {
        name : string
        namespace : string
        lane : string
        strategy : strategy
        container : container
        resources : resources
        volumes : list volume
    }

:~ text_value (s : string) : string = json.quote s

:~ field (key : string) (value : string) : string = sm'.concat_list "" [ json.quote key; ":"; value ]

:~ object (fields : list string) : string = sm'.concat_list "" [ "{"; sm'.concat_list "," fields; "}" ]

:~ items (values : list string) : string = sm'.concat_list "" [ "["; sm'.concat_list "," values; "]" ]

:~ labels (d : deployment) : string = object [ field "app" (text_value d.name); field "lane" (text_value d.lane) ]

:~ resources_json (r : resources) : string =
    := cpu_request = field "cpu" (text_value (quantity_text r.cpu_request))
    := memory_request = field "memory" (text_value (quantity_text r.memory_request))
    := limits = object [ field "memory" (text_value (quantity_text r.memory_limit)) ]
    object [ field "requests" (object [ cpu_request; memory_request ]); field "limits" limits ]

:~ strategy_json (s : strategy) : string =
    ?= s ?|
    | Recreate => object [ field "type" (text_value "Recreate") ]
    | Rolling => object [ field "type" (text_value "RollingUpdate") ]

:~ volume_json (v : volume) : string =
    ?= v.source ?|
    | HostPath path =>
        := host = object [ field "path" (text_value path); field "type" (text_value "Directory") ]
        object [ field "name" (text_value v.name); field "hostPath" host ]
    | EmptyDir => object [ field "name" (text_value v.name); field "emptyDir" "{}" ]

:~ mount_json (v : volume) : string =
    := read_only = ?= v.access ?| | ReadOnly => "true" | ReadWrite => "false"
    object [ field "name" (text_value v.name); field "mountPath" (text_value v.mount); field "readOnly" read_only ]

:~ ^ texts (xs : list string) : list string =
    ?= xs ?|
    | [] => []
    | x :: rest => text_value x :: texts rest

:~ ^ mounts_json (vs : list volume) : list string =
    ?= vs ?|
    | [] => []
    | v :: rest => mount_json v :: mounts_json rest

:~ ^ volumes_json (vs : list volume) : list string =
    ?= vs ?|
    | [] => []
    | v :: rest => volume_json v :: volumes_json rest

:~ container_json (d : deployment) : string =
    := c = d.container
    := command = items (texts c.command)
    := mounts = items (mounts_json d.volumes)
    := identity = [ field "name" (text_value c.name); field "image" (text_value c.image) ]
    := run = [ field "workingDir" (text_value c.workdir); field "command" command ]
    := limits = [ field "resources" (resources_json d.resources); field "volumeMounts" mounts ]
    object (listm.append identity (listm.append run limits))

:~ header (api : string) (kind : string) : list string =
    [ field "apiVersion" (text_value api); field "kind" (text_value kind) ]

:~ deployment_json (d : deployment) : string =
    := naming = [ field "name" (text_value d.name); field "namespace" (text_value d.namespace) ]
    := meta = object (listm.append naming [ field "labels" (labels d) ])
    := selector = object [ field "matchLabels" (object [ field "app" (text_value d.name) ]) ]
    := volumes = items (volumes_json d.volumes)
    := pod = object [ field "containers" (items [ container_json d ]); field "volumes" volumes ]
    := template = object [ field "metadata" (object [ field "labels" (labels d) ]); field "spec" pod ]
    := rollout = [ field "replicas" "1"; field "strategy" (strategy_json d.strategy) ]
    := spec = object (listm.append rollout [ field "selector" selector; field "template" template ])
    object (listm.append (header "apps/v1" "Deployment") [ field "metadata" meta; field "spec" spec ])

:~ namespace_json (name : string) : string =
    := meta = object [ field "name" (text_value name) ]
    object (listm.append (header "v1" "Namespace") [ field "metadata" meta ])

:~ ^ documents (ds : list deployment) : list string =
    ?= ds ?|
    | [] => []
    | d :: rest => namespace_json d.namespace :: deployment_json d :: documents rest

:~ manifest_json (deployments : list deployment) : string =
    object (listm.append (header "v1" "List") [ field "items" (items (documents deployments)) ])

:| spec_error =
    | UnknownRow : string
    | MissingCells : string
    | UnknownUnit : string
    | BadNumber : string
    | RowBeforeDeployment : string

:| spec_outcome =
    | Rendered : string
    | Refused : spec_error

:| building =
    | Building : list deployment
    | Failed : spec_error

:| scan =
    | Outside
    | InCell : string
    | AfterEscape : string

:= scanned (state : scan * list string) (ch : string) : scan * list string =
    := mode, cells = state
    ?= mode ?|
    | Outside => ? ch = "\"" ?> InCell "", cells |: Outside, cells
    | InCell text =>
        ? ch = "\\" ?> AfterEscape text, cells
        |? ch = "\"" ?> Outside, text :: cells
        |: InCell (text ++# ch), cells
    | AfterEscape text => InCell (text ++# ch), cells

:~ ^ chars_from (line : string) (i : i32) (acc : list string) : list string =
    ? i < 0i32 ?> acc |: chars_from line (i - 1i32) (sm'.substring i 1i32 line :: acc)

:~ cells_of (line : string) : list string =
    := open_at = sm'.index_of "[" line
    ? open_at < 0i32 ?> []
    |:
        := body = sm'.substring open_at ((sm'.length line : i32) - open_at) line
        := _, cells = chars_from body ((sm'.length body : i32) - 1i32) [] |> listm.fold scanned (Outside, [])
        listm.rev cells

:~ ctor_of (line : string) : string =
    := at = sm'.index_of "() = " line
    ? at < 0i32 ?> ""
    |:
        := rest = sm'.substring (at + 5i32) ((sm'.length line : i32) - at - 5i32) line
        := bracket = sm'.index_of " [" rest
        ? bracket < 0i32 ?> sm'.trim rest |: sm'.substring 0i32 bracket rest

:~ count_of (n : string) : option u32 = convert.try_convert (sm'.trim n)

:~ cpu_of (unit : string) (n : string) : option (quantity cpu) =
    ?= count_of n ?|
    | Some v => ? unit = "Millicores" ?> Some (Millicores v) |: None
    | None => None

:~ memory_of (unit : string) (n : string) : option (quantity memory) =
    ?= count_of n ?|
    | Some v => ? unit = "Mebibytes" ?> Some (Mebibytes v) |: None
    | None => None

:| built =
    | Built : deployment
    | Broken : spec_error

:~ started (cells : list string) : built =
    ?= cells ?|
    | name :: namespace :: lane :: how :: _ =>
        := c = { name = name; image = ""; command = []; workdir = "/" }
        := r = { cpu_request = Millicores 0u32; memory_request = Mebibytes 0u32; memory_limit = Mebibytes 0u32 }
        := s = ? how = "Recreate" ?> Recreate |: Rolling
        Built
            {
                name = name
                namespace = namespace
                lane = lane
                strategy = s
                container = c
                resources = r
                volumes = []
            }
    | _ => Broken (MissingCells "Deployment")

:~ sized (d : deployment) (cells : list string) : built =
    ?= cells ?|
    | cu :: c :: ru :: rq :: lu :: lm :: _ =>
        ?= (cpu_of cu c, memory_of ru rq, memory_of lu lm) ?|
        | (Some cpu), (Some request), (Some limit) =>
            Built { d ?| resources = { cpu_request = cpu; memory_request = request; memory_limit = limit } }
        | _ => Broken (UnknownUnit (sm'.concat_list " " cells))
    | _ => Broken (MissingCells "Resources")

:~ mounted (d : deployment) (cells : list string) : built =
    ?= cells ?|
    | name :: host :: mount :: how :: _ =>
        := source = ? host = "" ?> EmptyDir |: HostPath host
        := access = ? how = "ReadOnly" ?> ReadOnly |: ReadWrite
        := v = { name = name; source = source; mount = mount; access = access }
        Built { d ?| volumes = listm.append d.volumes [ v ] }
    | _ => Broken (MissingCells "Volume")

:~ attached (d : deployment) (ctor : string) (cells : list string) : built =
    ? ctor = "Container" ?>
        ?= cells ?|
        | image :: workdir :: command =>
            Built { d ?| container = { name = d.name; image = image; command = command; workdir = workdir } }
        | _ => Broken (MissingCells "Container")
    |? ctor = "Resources" ?> sized d cells
    |? ctor = "Volume" ?> mounted d cells
    |: Broken (UnknownRow ctor)

:~ step (done : list deployment) (line : string) : building =
    := ctor = ctor_of line
    := cells = cells_of line
    ? ctor = "Deployment" ?>
        ?= started cells ?| | Built d => Building (d :: done) | Broken why => Failed why
    |:
        ?= done ?|
        | [] => Failed (RowBeforeDeployment ctor)
        | d :: rest =>
            ?= attached d ctor cells ?| | Built updated => Building (updated :: rest) | Broken why => Failed why

:~ ^ steps (done : list deployment) (lines : list string) : building =
    ?= lines ?|
    | [] => Building done
    | line :: rest =>
        ? not (sm'.starts_with "inl row_" line) ?> steps done rest
        |:
            ?= step done line ?|
            | Building next => steps next rest
            | Failed why => Failed why

:~ rendered (spec_text : string) : spec_outcome =
    ?= steps [] (sm'.split_list "\n" (sm'.replace "\r" "" spec_text)) ?|
    | Building done => Rendered (manifest_json (listm.rev done))
    | Failed why => Refused why

:= fixture_resources () : resources =
    { cpu_request = Millicores 50u32; memory_request = Mebibytes 64u32; memory_limit = Mebibytes 512u32 }

:= fixture_container () : container =
    := command = [ "/bin/sh"; "-c"; "echo up; sleep 1" ]
    { name = "web"; image = "docker.io/library/busybox:1"; command = command; workdir = "/srv" }

:= fixture () : deployment =
    {
        name = "web"
        namespace = "demo"
        lane = "demo-lane"
        strategy = Recreate
        container = fixture_container ()
        resources = fixture_resources ()
        volumes = [ { name = "data"; source = HostPath "/srv/data"; mount = "/srv"; access = ReadWrite } ]
    }

///> rust
:# quantities_render_with_their_unit =
    testing.expect (quantity_text (Millicores 50u32) = "50m") "cpu is in millicores"
    testing.expect (quantity_text (Mebibytes 512u32) = "512Mi") "memory is in mebibytes"

///> rust
:# a_deployment_renders_as_kubernetes_json =
    := text = deployment_json (fixture ())
    testing.expect (text |> sm'.starts_with "{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\"") "apps/v1 Deployment"
    testing.expect (text |> sm'.contains "\"strategy\":{\"type\":\"Recreate\"}") "the strategy is a typed case"
    := requests = "\"requests\":{\"cpu\":\"50m\",\"memory\":\"64Mi\"}"
    testing.expect (text |> sm'.contains requests) "requests carry their units"
    := host = "\"hostPath\":{\"path\":\"/srv/data\",\"type\":\"Directory\"}"
    testing.expect (text |> sm'.contains host) "host paths are directories"
    := command = "\"command\":[\"/bin/sh\",\"-c\",\"echo up; sleep 1\"]"
    testing.expect (text |> sm'.contains command) "commands are escaped json"

///> rust
:# a_manifest_lists_each_namespace_before_its_deployment =
    := text = manifest_json [ fixture () ]
    := first = "{\"apiVersion\":\"v1\",\"kind\":\"List\",\"items\":[{\"apiVersion\":\"v1\",\"kind\":\"Namespace\""
    testing.expect (text |> sm'.starts_with first) "namespace first"
    testing.expect (text |> sm'.contains "\"readOnly\":false") "access renders as readOnly"

:= container_row () : string =
    := image = "inl row_2 () = Container [ \"docker.io/library/busybox:1\"; \"/srv\"; "
    image ++# "\"/bin/sh\"; \"-c\"; \"echo up; sleep 1\" ]"

///> rust
:# a_row_spec_reads_into_the_same_manifest =
    := spec_text =
        sm'.concat_list "\n" [
            "///- --no-respell"
            "union k3s_row = | Deployment :: list string -> k3s_row | Container :: list string -> k3s_row"
            "inl row_1 () = Deployment [ \"web\"; \"demo\"; \"demo-lane\"; \"Recreate\" ]"
            container_row ()
            "inl row_3 () = Resources [ \"Millicores\"; \"50\"; \"Mebibytes\"; \"64\"; \"Mebibytes\"; \"512\" ]"
            "inl row_4 () = Volume [ \"data\"; \"/srv/data\"; \"/srv\"; \"ReadWrite\" ]"
        ]
    testing.expect (rendered spec_text = Rendered (manifest_json [ fixture () ])) "rows render like the typed fixture"

///> rust
:# a_row_spec_refuses_unknown_units_and_orphan_rows =
    := deployment = "inl row_1 () = Deployment [ \"a\"; \"b\"; \"c\"; \"Recreate\" ]"
    := cores = "inl row_2 () = Resources [ \"Cores\"; \"1\"; \"Mebibytes\"; \"1\"; \"Mebibytes\"; \"1\" ]"
    := refused = Refused (UnknownUnit "Cores 1 Mebibytes 1 Mebibytes 1")
    testing.expect (rendered (sm'.concat_list "\n" [ deployment; cores ]) = refused) "only Millicores/Mebibytes"
    := orphan = "inl row_1 () = Volume [ \"data\"; \"\"; \"/d\"; \"ReadWrite\" ]"
    testing.expect (rendered orphan = Refused (RowBeforeDeployment "Volume")) "a row needs a Deployment first"
