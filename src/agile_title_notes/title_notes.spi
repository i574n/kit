:< rust_std_fs.model
:< sm'_operators
:< agile_task_text.model
:< agile_note_model.model
:< workspace_primitives.outcome
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< workspace_primitives.clock
:< workspace_primitives.console
:< workspace_primitives.files

:= argument_owned index : string = rust_std_env.model.argument_owned index
:~ argument_count () : i32 =
    := user = env.command_line_argument_count ()
    ? user > 0i32 ?> user - 1i32 |: 0i32

:= tail_rows (~title : string) (~id : string) (seq : i32) (~fallback : string) : i32 * string =
    $'agile_title_tails::kit_agile_title_tail_rows(&*!title, &*!id, !seq, &*!fallback)' : i32 * string

:= kept_end (~title : string) : i32 = $'agile_title_tails::kit_agile_title_kept_end(&*!title)' : i32

:= from_title_failure (~reason : string) (~id : string) : i32 =
    stderr_failure ("agile notes from-title " ++# id ++# " rejected: " ++# reason)

:= from_title_success
    (~id : string) (moved : i32) (title_before : i32) (title_after : i32) (before : u64) (after : u64) (elapsed : u64)
    : i32
    =
    := head = "kit agile notes ok id=" ++# id ++# " moved=" ++# (i32_text moved) ++# " title_bytes_before="
    := middle = (i32_text title_before) ++# " title_bytes_after=" ++# (i32_text title_after)
    stdout_line (head ++# middle ++# (measured_sizes before after elapsed))

:= title_bounds (text : string) (found : i32) : i32 * i32 =
    := length = byte_len text
    := start = field_start text ((found + (item_arguments_offset TaskItem))) length 1i32
    start, field_end text start length ScanPlain

:~ title_moved (~state : string) (~id : string) (~raw : string) (~original : string) (started : u64) : i32 =
    := schema_ready = note_schema_ensured original
    := found = item_offset schema_ready TaskItem id
    := start, stop = title_bounds schema_ready found
    := title = unquoted (byte_slice schema_ready start stop)
    := first = kept_end title
    ? first < 0i32
    ?> from_title_failure "the title has no \"; \" tail starting with a date or time to move" id
    |:
        := kept = sm'.trim (byte_slice title 0i32 first)
        := moved, rows = tail_rows title id (note_count schema_ready id + 1i32) (utc_stamp started)
        := retitled = spliced schema_ready start stop (spi_quoted kept)
        := updated = notes_appended retitled id rows
        ?= state_written state raw updated ?|
        | StateWritten =>
            from_title_success id moved
                (byte_len title)
                (byte_len kept)
                (text_bytes original)
                (text_bytes updated)
                (ms_since started)
        | problem => from_title_failure (state_write_problem problem) id

:~ from_title_entry () : i32 =
    := id = argument_owned 3i32
    ? argument_count () = 4i32 ?>
        ? ((argument_owned 1i32) = "from-title") ?>
            := started = unix_ms ()
            := state = backlog_state_path (argument_owned 2i32)
            ?= probe (unchecked state) ?|
            | FileMissing _ => from_title_failure "state/agile.spi is missing" id
            | FileReadable file =>
                := raw = loaded_string (read_text file)
                := original = records_text raw
                ? task_declared original id ?> title_moved state id raw original started
                |: from_title_failure "no task with this id" id
        |: from_title_failure "usage: agile notes from-title <root> <id>" id
    |: from_title_failure "usage: agile notes from-title <root> <id>" id

:= main () : i32 =
    !!!!Export("kit_agile_notes_from_title_run", ((\ () => from_title_entry ()) : () -> i32))
    := _ = from_title_entry ()
    0i32
