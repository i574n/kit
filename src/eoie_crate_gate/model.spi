///- --package .
test model static =
    open sm'_operators

open sm'_operators

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

type spiral_manifest =
    {
        entry : string
        output : string
    }

union manifest_read =
    | SpiralCrate : spiral_manifest
    | NotSpiralCrate

type crate_measure =
    {
        crate : string
        output : string
        lines : i32
    }

union crate_verdict =
    | CrateWithin
    | CrateOver
    | CrateUnbuilt

let quoted_value (line : string) : string =
    inl pieces = sm'.split "\"" line |> array
    if am'.length pieces >= 3i32 then am'.index 1i32 pieces else ""

let rec section_fields (lines : array string) (at : i32) (entry : string) (output : string) : manifest_read =
    if am'.length lines <= at
    then if entry <> "" && output <> "" then SpiralCrate { entry = entry; output = output } else NotSpiralCrate
    else
        inl line = sm'.trim (am'.index at lines)
        if sm'.starts_with "[" line then section_fields lines (am'.length lines) entry output
        elif sm'.starts_with "entry" line then section_fields lines (at + 1i32) (quoted_value line) output
        elif sm'.starts_with "output" line then section_fields lines (at + 1i32) entry (quoted_value line)
        else section_fields lines (at + 1i32) entry output

let rec manifest_from (lines : array string) (at : i32) : manifest_read =
    if am'.length lines <= at then NotSpiralCrate
    elif sm'.trim (am'.index at lines) = "[package.metadata.spiral]" then section_fields lines (at + 1i32) "" ""
    else manifest_from lines (at + 1i32)

let manifest_of (text : string) : manifest_read =
    manifest_from (sm'.split "\n" (sm'.replace "\r" "" text) |> array) 0i32

let line_count (text : string) : i32 =
    if text = "" then 0i32
    else
        inl pieces = am'.length (sm'.split "\n" text |> array)
        if sm'.ends_with "\n" text then pieces - 1i32 else pieces

let verdict_of (limit : i32) (measure : crate_measure) : crate_verdict =
    if measure.lines < 0i32 then CrateUnbuilt elif measure.lines > limit then CrateOver else CrateWithin

let verdict_text (limit : i32) (measure : crate_measure) : string =
    match verdict_of limit measure with
    | CrateWithin => "ok"
    | CrateOver => "OVER " ++# sm'.format limit
    | CrateUnbuilt => "no generated output yet"

let measure_line (limit : i32) (measure : crate_measure) : string =
    "gate / "
    ++# measure.crate
    ++# " "
    ++# measure.output
    ++# " "
    ++# sm'.format measure.lines
    ++# " lines "
    ++# verdict_text limit measure

let over_count (limit : i32) (measures : list crate_measure) : i32 =
    measures |> listm.fold (fun count (m : crate_measure) => match verdict_of limit m with | CrateOver => count + 1i32 | _ => count) 0i32

union gate_outcome =
    | GatePassed
    | GateFailedOver : i32
    | GateFailedMissing : i32
    | GateFailedVacuous

let missing_count (limit : i32) (measures : list crate_measure) : i32 =
    measures |> listm.fold (fun count (m : crate_measure) => match verdict_of limit m with | CrateUnbuilt => count + 1i32 | _ => count) 0i32

let gate_outcome_of (enforce : bool) (limit : i32) (measures : list crate_measure) : gate_outcome =
    inl over = over_count limit measures
    inl missing = missing_count limit measures
    if enforce && listm.length measures = 0i32 then GateFailedVacuous
    elif enforce && over > 0i32 then GateFailedOver over
    elif enforce && missing > 0i32 then GateFailedMissing missing
    else GatePassed

///> rust
test a_spiral_manifest_yields_entry_and_output =
    inl text = "[package.metadata.spiral]\r\nentry = \"run.spi\"\noutput = \"watch.rs\"\n\n[package]\nname = \"x\"\n"
    expect
        (
            match manifest_of text with
            | SpiralCrate m => m.entry = "run.spi" && m.output = "watch.rs"
            | NotSpiralCrate => false
        )
        "entry and output"
    expect
        match manifest_of "[package]\nname = \"plain\"\n" with
        | SpiralCrate _ => false
        | NotSpiralCrate => true
        "a plain crate is skipped"
    expect
        (
            match manifest_of "[package.metadata.spiral]\nentry = \"a.spi\"\n[package]\noutput = \"b.rs\"\n" with
            | SpiralCrate _ => false
            | NotSpiralCrate => true
        )
        "fields stop at the next section"

///> rust
test lines_verdicts_and_the_vacuity_rule =
    expect (line_count "a\nb\nc\n" = 3i32 && line_count "a\nb" = 2i32 && line_count "" = 0i32) "line counts"
    inl small = { crate = "small"; output = "s.rs"; lines = 900i32 }
    inl big = { crate = "big"; output = "b.rs"; lines = 1200i32 }
    inl unbuilt = { crate = "new"; output = "n.rs"; lines = -1i32 }
    expect (measure_line 1000i32 big = "gate / big b.rs 1200 lines OVER 1000") "over line"
    expect (measure_line 1000i32 small = "gate / small s.rs 900 lines ok") "ok line"
    expect (verdict_of 1000i32 unbuilt = CrateUnbuilt) "missing output is not counted as over"
    expect
        match gate_outcome_of true 1000i32 [ small; big; unbuilt ] with
        | GateFailedOver n => n = 1i32
        | _ => false
        "enforce fails on one crate over"
    expect
        match gate_outcome_of true 1000i32 [] with
        | GateFailedVacuous => true
        | _ => false
        "enforce fails when nothing was measured"
    expect (match gate_outcome_of false 1000i32 [ big ] with | GatePassed => true | _ => false) "report-only passes"
    expect (match gate_outcome_of true 1000i32 [ small; unbuilt ] with | GateFailedMissing n => n = 1i32 | _ => false) "enforce fails on a missing output"
    expect (match gate_outcome_of false 1000i32 [ unbuilt ] with | GatePassed => true | _ => false) "report-only keeps a missing output as a report"
