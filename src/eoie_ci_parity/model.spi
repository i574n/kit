///- --package .
test model static =
    open sm'_operators

open sm'_operators
open eoie_ci_model.tools

union setup_action =
    | OtherAction
    | SetupRust
    | SetupZig
    | SetupBeam
    | SetupPython

type tool_pin =
    {
        tool : ci_tool
        version : string
    }

let action_of (~line : string) (current : setup_action) : setup_action =
    if sm'.contains "uses:" line = false then current
    elif sm'.contains "setup-rust" line || sm'.contains "rust-toolchain" line then SetupRust
    elif sm'.contains "setup-zig" line then SetupZig
    elif sm'.contains "setup-beam" line then SetupBeam
    elif sm'.contains "setup-python" line then SetupPython
    else OtherAction

let beam_tool (~key : string) : option ci_tool =
    if key = "otp-version" then Some ToolOtp
    elif key = "elixir-version" then Some ToolElixir
    elif key = "gleam-version" then Some ToolGleam
    elif key = "rebar3-version" then Some ToolRebar
    else None

let key_tool (action : setup_action) (~key : string) : option ci_tool =
    match action with
    | SetupRust => if key = "channel" || key = "toolchain" then Some ToolRust else None
    | SetupZig => if key = "version" then Some ToolZig else None
    | SetupBeam => beam_tool key
    | SetupPython => if key = "python-version" then Some ToolPython else None
    | OtherAction => None

let key_of (~line : string) : string = sm'.trim line |> sm'.split ":" |> array |> am'.index 0i32

let value_of (~line : string) (~key : string) : string =
    inl trimmed = sm'.trim line
    inl skip = (sm'.length key : i32) + 1i32
    unquoted (sm'.substring skip ((sm'.length trimmed : i32) - skip) trimmed)

let already_pinned (pins : list tool_pin) (pin : tool_pin) : bool =
    pins |> listm'.try_find_ (fun (seen : tool_pin) => seen.tool = pin.tool && seen.version = pin.version) <> None

let rec pins_from (lines : array string) (at : i32) (action : setup_action) (found : list tool_pin) : list tool_pin =
    if at >= (am'.length lines : i32) then listm.rev found
    else
        inl line = am'.index at lines
        inl next_action = action_of line action
        inl key = if sm'.contains ":" line then key_of line else ""
        match key_tool next_action key with
        | Some tool =>
            inl pin = { tool = tool; version = value_of line key }
            inl found = if already_pinned found pin then found else pin :: found
            pins_from lines (at + 1i32) next_action found
        | None => pins_from lines (at + 1i32) next_action found

let workflow_pins (~workflow : string) : list tool_pin =
    pins_from (sm'.replace "\r" "" workflow |> sm'.split "\n" |> array) 0i32 OtherAction []

inl usage () : string =
    "ci parity <repo> (setup-* pins in <repo>/.github/workflows and its rust-toolchain file against the local toolchain; "
    ^^ "one row per tool, a fix line per mismatch, exit 1 on a difference)"

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

inl eoie_workflow () : string =
    inl rust =
        "      - uses: moonrepo/setup-rust@v1.3.0\r\n        with:\r\n          channel: \"nightly-2026-10-18\"\r\n"
    inl beam = "      - uses: erlef/setup-beam@v1.24.1\n        with:\n          otp-version: \"29\"\n"
    inl gleam = "          gleam-version: \"1.19.2\"\n          rebar3-version: '3.27.3'\n\n"
    inl zig = "      - uses: mlugg/setup-zig@v2.2.1\n        with:\n          version: 0.17.0\n"
    inl head = "    steps:\n      - uses: actions/checkout@v6.1.0\n\n"
    head ++# rust ++# "          components: \"rustfmt\"\n\n" ++# beam ++# gleam ++# zig ++# zig

inl version_of (pins : list tool_pin) (tool : ci_tool) : option string =
    pins
    |> listm'.try_find_ (fun (pin : tool_pin) => pin.tool = tool)
    |> optionm.map fun (pin : tool_pin) => pin.version

///> rust
test a_workflow_yields_one_pin_per_setup_key_in_file_order =
    inl pins = workflow_pins (eoie_workflow ())
    expect (version_of pins ToolRust = Some "nightly-2026-10-18") "setup-rust channel, CRLF dropped"
    expect (version_of pins ToolZig = Some "0.17.0") "setup-zig version"
    expect (version_of pins ToolRebar = Some "3.27.3") "single-quoted rebar3-version"
    expect (version_of pins ToolElixir = None) "a key the workflow does not set"
    expect ((listm.length pins : i32) = 5i32) "the repeated setup-zig step pins zig once"
    match pins with
    | pin :: _ => expect (pin.tool = ToolRust) "rows follow the workflow"
    | [] => failwith "no pins"

///> rust
test a_python_setup_step_pins_python =
    inl pins =
        workflow_pins (
            "    steps:\n      - uses: actions/setup-python@v6.0.0\n        with:\n"
            ^^ "          python-version: \"3.12.10\"\n"
        )
    match pins with
    | pin :: _ => expect (pin.tool = ToolPython && pin.version = "3.12.10") "setup-python pin"
    | [] => failwith "no python pin"
