///- --package .
test parity static =
    open sm'_operators

open sm'_operators
open file_system_operators
open eoie_ci_model.tools
open model

let workflow_file (name : string) : bool = sm'.ends_with ".yml" name || sm'.ends_with ".yaml" name

let names_in (directory : string) : list string =
    if file_system.directory_exists directory |> not then []
    else
        file_system.read_dir_names directory
        |> resultm.unwrap'
        |> am'.vec_fold' (fun names name => Cons (sm'.from_std_string name, names)) Nil

let workflows_text (directory : string) : string =
    names_in directory
    |> listm'.filter workflow_file
    |> listm.fold fun text (name : string) =>
            text ++# "\n- uses: workflow-boundary\n" ++# file_system.read_all_text (directory </> name)
        ""

let workflow_and_file_pins (repo : string) (directory : string) : list tool_pin =
    inl pins = workflow_pins (workflows_text directory)
    inl pinned_rust = listm'.try_find_ (fun (pin : tool_pin) => pin.tool = ToolRust) pins <> None
    match repo_toolchain repo with
    | Some channel => if pinned_rust then pins else listm.rev ({ tool = ToolRust; version = channel } :: listm.rev pins)
    | None => pins

let rec rows_printed (row_of : tool_pin -> string * bool) (pins : list tool_pin) (differing : i32) : i32 =
    match pins with
    | Nil => differing
    | Cons (pin, rest) =>
        inl line, differs = row_of pin
        console.write_line line
        rows_printed row_of rest (if differs then differing + 1i32 else differing)

let probe_row (repo : string) (pin : tool_pin) : string * bool =
    inl name = tool_name pin.tool
    inl ci = pin.version
    $'eoie_ci_verdict::eoie_ci_parity_row(&*!name, &*!ci, &*!repo)' : string * bool

let argument (index : i32) : string = optionm'.default_value "" (env.try_command_line_argument index)

let parity_run () : i32 =
    inl repo = argument 2i32
    inl directory = repo </> ".github" </> "workflows"
    if argument 1i32 <> "parity" || repo = "" then
        console.write_line ("eoie error: ci usage: " ++# usage ())
        2i32
    elif file_system.directory_exists directory |> not then
        console.write_line ("eoie ci parity refused: no workflow folder at " ++# directory)
        1i32
    else
        inl pins = workflow_and_file_pins repo directory
        inl differing = rows_printed (probe_row repo) pins 0i32
        inl count = (listm.length pins : i32)
        inl summary = " tools=" ++# sm'.format count ++# " differs=" ++# sm'.format differing ++# " repo=" ++# repo
        if count = 0i32 then
            console.write_line ("eoie ci parity refused: no setup-* or rust-toolchain pin found;" ++# summary)
            1i32
        elif differing > 0i32 then
            console.write_line (
                "eoie ci parity refused: " ++# sm'.format differing ++# " tool(s) differ from CI;" ++# summary
            )
            1i32
        else
            console.write_line ("eoie ci parity ok" ++# summary)
            0i32

///> rust
test workflow_files_and_rows =
    expect
        (workflow_file "ci.yml" && workflow_file "pages.yaml" && workflow_file "notes.md" = false)
        "workflow file names"
    expect (names_in "C:/eoie-ci-parity-no-such-folder" = []) "a missing folder lists nothing"
    inl stand_in (pin : tool_pin) : string * bool = tool_name pin.tool ++# " " ++# pin.version, pin.tool = ToolZig
    inl pins = [ { tool = ToolRust; version = "nightly" }; { tool = ToolZig; version = "0.17.0" } ]
    expect (rows_printed stand_in pins 0i32 = 1i32) "one stand-in row differs"
