:| ^ predicate input =
    | Range :: u64 * u64 -> predicate u64
    | Minimum :: u64 -> predicate u64
    | Either :: \* input. predicate input * predicate input -> predicate input
    | Both :: \* input. predicate input * predicate input -> predicate input
    | EveryByte :: predicate u64 -> predicate string
    | Project :: \* input. (\? middle. (input -> middle) * predicate middle) -> predicate input

:= byte_length (text : string) : u64 = !!!!StringLength(`u64, text)
:= byte_at (text : string) (index : u64) : u64 =
    $'!text.as_bytes()[!index as usize] as u64' : u64

:= ^ evaluate \* input. (rule : predicate input) (value : input) : bool =
    ?= rule ?|
    | Range (low, high) =>
        ? value < low ?> !- |: value <= high
    | Minimum low => (low <= value)
    | Either (left, right) =>
        ? evaluate left value ?> !+ |: evaluate right value
    | Both (left, right) =>
        ? evaluate left value ?> evaluate right value |: !-
    | Project payload =>
        := \? middle. project, inner = payload
        evaluate inner (project value)
    | EveryByte inner =>
        := length = byte_length value
        :~ ^ loop (index : u64) : bool =
            ? index = length ?> !+
            |? evaluate inner (byte_at value index) ?> loop (index + 1u64)
            |: !-
        loop 0u64

:= digit () : predicate u64 = Range (48u64, 57u64)
:= hex () : predicate u64 = Either (digit (), Either (Range (65u64, 70u64), Range (97u64, 102u64)))
:= alphanumeric () : predicate u64 = Either (digit (), Either (Range (65u64, 90u64), Range (97u64, 122u64)))
:= length_between (low : u64) (high : u64) : predicate string = Project (\? (byte_length, Range (low, high)))
:= sha256_text () : predicate string = Both (length_between 64u64 64u64, EveryByte (hex ()))
:= safe_receipt_text () : predicate string =
    Both (Project (\? (byte_length, Minimum 1u64)),
        EveryByte (Either (alphanumeric (), Either (Range (45u64, 47u64), Range (95u64, 95u64)))))

:| representation input =
    | Text :: representation string
    | Byte :: representation u64
:! named input = { name : string; representation : representation input; rule : predicate input }
:| emitted input = | Emitted :: \* input. emitted input
:! inspected input = string

:| ^ registry (f : * -> *) shape =
    | One :: \* (f : * -> *) input. f input -> registry f input
    | Pair :: \* (f : * -> *) left right. registry f left * registry f right -> registry f (left * right)

:= ^ map \* (f : * -> *) (g : * -> *) shape.
    (transform : \* input. f input -> g input) (items : registry f shape) : registry g shape =
    ?= items ?|
    | One item => One (transform item)
    | Pair (left, right) => Pair (map `$transform left, map `$transform right)

:= emit_one \* input. (named item : named input) : emitted input =
    := _ =
        ?= item.representation ?|
        | Text =>
            :~ check (value : string) : bool = evaluate item.rule value
            !!!!Export(item.name, ((\ value => check value) : string -> bool))
        | Byte =>
            :~ check (value : u64) : bool = evaluate item.rule value
            !!!!Export(item.name, ((\ value => check value) : u64 -> bool))
    Emitted

:= inspect_one \* input. (named item : named input) : inspected input = inspected item.name

:= emit \* shape. (items : registry named shape) : () =
    := _ = map `$emit_one items
    ()

:= lift_sha256 (name : string) (remaining : string) : string =
    emit (One (named { name = name; representation = Text; rule = sha256_text () }))
    remaining

:= lift_receipt_text (name : string) (remaining : string) : string =
    emit (One (named { name = name; representation = Text; rule = safe_receipt_text () }))
    remaining
