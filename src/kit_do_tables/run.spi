:< sm'_operators
:< kit_receipt.receipt
:< host
:< grammar
:< kit_do_records.records

:== diff_tally =
    {
        report : string
        failed : bool
        left : u64
        right : u64
        changed : u64
        both : u64
    }

:~ empty_diff_tally () : diff_tally =
    { report = ""; failed = !-; left = 0u64; right = 0u64; changed = 0u64; both = 0u64 }

:~ lines_joined (~left : string) (~right : string) : string =
    ? right = "" ?> left |? left = "" ?> right |: left ++# "\n" ++# right

:~ ^ tables_run (~root : string) (~records : record_list) (~index : i32) (~state : diff_tally) : diff_tally =
    ? index < record_count records
    ?>
        ?= table_parsed records index ?|
        | TableParsed (TablesDiffed (left, right, keys, columns)) =>
            := outcome = tables_diffed root left right keys columns
            := merged =
                { state ?|
                    report = lines_joined state.report (outcome_report outcome)
                    failed = state.failed || outcome_failed outcome
                    left = state.left + outcome_counter outcome 0u64
                    right = state.right + outcome_counter outcome 1u64
                    changed = state.changed + outcome_counter outcome 2u64
                    both = state.both + outcome_counter outcome 3u64
                }
            tables_run root records (index + 1i32) merged
        | TableRejected _ => tables_run root records (index + 1i32) state
    |: state

:~ ^ first_rejection (~records : record_list) (~index : i32) : string =
    ? index < record_count records
    ?>
        ? field_at records index 0i32 <> "query"
        ?> "edit and diff statements cannot share one program yet; run them as two calls"
        |:
            ?= table_parsed records index ?|
            | TableRejected message => message
            | TableParsed _ => first_rejection records (index + 1i32)
    |: ""

:~ receipt_counts (~state : diff_tally) : string =
    := rows = "rows a " ++# (decimal_text state.left) ++# "  b " ++# (decimal_text state.right)
    rows ++# "  changed " ++# (decimal_text state.changed) ++# (
        "  added " ++# (decimal_text (state.right - state.both)) ++# "  removed " ++# (decimal_text (
        state.left - state.both)))

:~ tables_program_run (~root : string) (~encoded : string) : i32 =
    := started = now_ms ()
    := records = records_of encoded
    := rejection = first_rejection records 1i32
    ? rejection = "" ?>
        := state = tables_run root records 1i32 (empty_diff_tally ())
        := report = state.report
        ? report = "" ?> () |: stdout_line report
        ? state.failed ?>
            receipt_line Failed (receipt_counts state) started
            1i32
        |:
            receipt_line Succeeded (receipt_counts state) started
            0i32
    |:
        stdout_line ("program rejected: " ++# rejection)
        receipt_line Failed "rows a 0  b 0" started
        2i32

:= main () : i32 =
    !!!!Export("kit_do_tables_run", ((\ (root, encoded) => tables_program_run root encoded) : string * string -> i32))
    0i32
