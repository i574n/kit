:< multi_file_patch_contract.model

:= main () : i32 =
    := _ = multi_patch_public_plan ()
    ?= multi_patch_shape_binding 3i32 5i32 5i32 ?|
    | 1 =>
        ?= multi_patch_topology_binding 0i32 0i32 ?|
        | 1 =>
            ?= multi_patch_freshness_binding 5i32 5i32 ?|
            | 1 =>
                ?= multi_patch_mode_binding 1i32 0i32 ?|
                | 1 =>
                    ?= multi_patch_rollback_binding 3i32 3i32 ?|
                    | 1 =>
                        ?= multi_patch_commit_binding 1i32 5i32 ?|
                        | 5 => 0i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
