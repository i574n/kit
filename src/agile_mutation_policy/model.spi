:! agile_progress = i32

:| agile_status =
    | AgilePlanned
    | AgileActive
    | AgileBlocked
    | AgilePaused
    | AgileDone

:= i32_eq a b : bool = (a = b)
:= i32_le a b : bool = (a <= b)
:= i32_nonnegative value : bool = $"0 <= !value"

:| agile_task_kind =
    | AgileEpic
    | AgileFeature
    | AgileStory
    | AgileTaskKind

:= agile_case_text value : string = union_reflection.cases.union_case_suffix "Agile" value
:| agile_priority =
    | AgileP0
    | AgileP1
    | AgileP2
    | AgileP3
    | AgileP4
    | AgileP5

:| agile_difficulty =
    | AgileD0
    | AgileD1
    | AgileD2
    | AgileD3
    | AgileD4
    | AgileD5
    | AgileD6
    | AgileD7
    | AgileD8

:= agile_status_open (status : agile_status) : bool =
    ?= status ?|
    | AgilePlanned => !+
    | AgileActive => !+
    | AgileBlocked => !-
    | AgilePaused => !-
    | AgileDone => !-

:= agile_status_code status : i32 =
    ?= status ?|
    | AgilePlanned => 0i32
    | AgileActive => 1i32
    | AgileBlocked => 2i32
    | AgilePaused => 3i32
    | AgileDone => 4i32

:= agile_status_code_valid code : bool =
    ? code = 0i32 ?> !+
    |? code = 1i32 ?> !+
    |? code = 2i32 ?> !+
    |? code = 3i32 ?> !+
    |? code = 4i32 ?> !+
    |: !-

:= agile_progress_valid value : bool =
    ? i32_nonnegative value ?> value <= 100i32 |: !-

:~ agile_set_decision (progress : i32) (status_code : i32) : i32 =
    ? agile_progress_valid progress ?>
        ? agile_status_code_valid status_code ?> 1i32 |: 0i32
    |: 0i32

:~ agile_task_shape_decision (field_count : i32) : i32 =
    ? field_count = 11i32 ?> 1i32 |: 0i32

:~ agile_task_identity_decision (field_count : i32) (id_equal : i32) : i32 =
    ? agile_task_shape_decision field_count = 1i32 ?>
        ? id_equal = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:~ agile_receipt_content_decision (bytes_equal : i32) (fingerprint_equal : i32) : i32 =
    ? bytes_equal = 1i32 ?>
        ? fingerprint_equal = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:~ agile_receipt_snapshot_decision (snapshot_equal : i32) (reserved : i32) : i32 =
    ? reserved = 0i32 ?>
        ? snapshot_equal = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:~ agile_receipt_build_current_decision (content_current : i32) (build_fingerprint_equal : i32) : i32 =
    ? content_current = 1i32 ?>
        ? build_fingerprint_equal = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:= agile_tuple_space (value : char) : bool =
    ? (=.) value ' ' ?> !+ |: (=.) value (char_tab ())

:~ ^ agile_tuple_trim_right (text : string) (near_to : i32) : i32 =
    ? (=.) near_to 0i32 ?> 0i32
    |:
        := before = (-.) near_to 1i32
        ? agile_tuple_space (sm.index text before) ?> agile_tuple_trim_right text before |: near_to

:= agile_tuple_trim (text : string) : string =
    := from = skip_spaces text 0i32
    := near_to = agile_tuple_trim_right text (sm.length text : i32)
    ? (<) near_to from ?> codec_empty () |: slice_exclusive text from near_to

:~ ^ agile_tuple_parse_loop
    (input : string) (at : i32) (input_len : i32) (field_from : i32) (quoted : bool) (escaped : bool) (out : string)
    : string
    =
    ? (=.) at input_len
    ?>
        ? quoted ?> codec_empty ()
        |? escaped ?> codec_empty ()
        |:
            := field = agile_tuple_trim (slice_exclusive input field_from input_len)
            sm.concat out (sm.concat field "\n")
    |:
        := current_char = sm.index input at
        ? quoted
        ?>
            ? escaped ?>
                agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from !+ !- out
            |? (=.) current_char (char_backslash ()) ?>
                agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from !+ !+ out
            |? (=.) current_char (char_quote ()) ?>
                agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from !- !- out
            |:
                agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from !+ !- out
        |? (=.) current_char (char_quote ())
        ?> agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from !+ !- out
        |? (=.) current_char ','
        ?>
            := field = agile_tuple_trim (slice_exclusive input field_from at)
            agile_tuple_parse_loop input
                ((+.) at 1i32)
                input_len
                ((+.) at 1i32)
                !-
                !-
                (sm.concat out (sm.concat field "\n"))
        |: agile_tuple_parse_loop input ((+.) at 1i32) input_len field_from !- !- out

:~ agile_tuple_parse (input : string) : string =
    agile_tuple_parse_loop input 0i32 (sm.length input : i32) 0i32 !- !- ""

:= agile_build_prefix (input : string) : bool =
    starts_with input "build:"

:~ agile_u64_decimal_normalize (input : string) : string =
    codec_u64_decimal_normalize (agile_tuple_trim input)

:~ agile_u64_decimal_value (input : string) : u64 =
    codec_u64_decimal_value (agile_u64_decimal_normalize input)

:~ agile_u64_literal_normalize (input : string) : string =
    := input = agile_tuple_trim input
    := input_len = sm.length input : i32
    ? (<) input_len 4i32 ?> codec_empty ()
    |:
        := suffix_from = (-.) input_len 3i32
        ? (=.) (sm.index input suffix_from) 'u' ?>
            ? (=.) (sm.index input ((+.) suffix_from 1i32)) '6' ?>
                ? (=.) (sm.index input ((+.) suffix_from 2i32)) '4' ?>
                    codec_u64_decimal_normalize (slice_exclusive input 0i32 suffix_from)
                |: codec_empty ()
            |: codec_empty ()
        |: codec_empty ()

:~ agile_u64_literal_value (input : string) : u64 =
    codec_u64_decimal_value (agile_u64_literal_normalize input)

:~ agile_attestation_normalize (input : string) : string =
    := input_len = sm.length input : i32
    ? (=.) input "runtime" ?> "runtime"
    |? agile_build_prefix input ?>
        := digits = codec_u64_decimal_normalize (slice_exclusive input 6i32 input_len)
        ? (=.) digits "" ?> codec_empty () |: sm.concat "build:" digits
    |: codec_empty ()

:~ agile_attestation_value (input : string) : u64 =
    := normalized = agile_attestation_normalize input
    := normalized_len = sm.length normalized : i32
    ? (=.) normalized "runtime" ?> 0u64
    |? agile_build_prefix normalized ?>
        codec_u64_decimal_value (slice_exclusive normalized 6i32 normalized_len)
    |: 0u64
