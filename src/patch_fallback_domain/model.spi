:! candidate_idle = ()
:! candidate_selected = ()
:! candidate_forward_applied = ()
:! candidate_restored = ()
:! candidate_hash_agreed = ()

:| candidate_route_step from to =
    | SelectCandidateRoute :: candidate_route_step candidate_idle candidate_selected
    | ApplyCandidateForward :: string -> candidate_route_step candidate_selected candidate_forward_applied
    | RestoreCandidateOriginal :: string -> candidate_route_step candidate_forward_applied candidate_restored
    | AgreeCandidateHash :: string -> candidate_route_step candidate_restored candidate_hash_agreed

:| ^ candidate_route_plan from to =
    | CandidateRouteStep :: \* from to. candidate_route_step from to -> candidate_route_plan from to
    | CandidateRouteThen :: \* from to.
        (\? middle. candidate_route_plan from middle * candidate_route_plan middle to) ->
        candidate_route_plan from to

:= candidate_plan () : candidate_route_plan candidate_idle candidate_hash_agreed =
    CandidateRouteThen (\? (
        CandidateRouteStep SelectCandidateRoute,
        CandidateRouteThen (\? (
            CandidateRouteStep (ApplyCandidateForward "forward-replacement-observed"),
            CandidateRouteThen (\? (
                CandidateRouteStep (RestoreCandidateOriginal "reverse-replacement-observed"),
                CandidateRouteStep (AgreeCandidateHash "before-and-after-hashes-match")
            ))
        ))
    ))

:! primary_idle = ()
:! primary_selected = ()
:! primary_forward_applied = ()
:! primary_restored = ()
:! primary_hash_agreed = ()

:| primary_route_step from to =
    | SelectPrimaryRoute :: primary_route_step primary_idle primary_selected
    | ApplyPrimaryForward :: string -> primary_route_step primary_selected primary_forward_applied
    | RestorePrimaryOriginal :: string -> primary_route_step primary_forward_applied primary_restored
    | AgreePrimaryHash :: string -> primary_route_step primary_restored primary_hash_agreed

:| ^ primary_route_plan from to =
    | PrimaryRouteStep :: \* from to. primary_route_step from to -> primary_route_plan from to
    | PrimaryRouteThen :: \* from to.
        (\? middle. primary_route_plan from middle * primary_route_plan middle to) ->
        primary_route_plan from to

:= primary_fallback_plan () : primary_route_plan primary_idle primary_hash_agreed =
    PrimaryRouteThen (\? (
        PrimaryRouteStep SelectPrimaryRoute,
        PrimaryRouteThen (\? (
            PrimaryRouteStep (ApplyPrimaryForward "forward-replacement-observed"),
            PrimaryRouteThen (\? (
                PrimaryRouteStep (RestorePrimaryOriginal "reverse-replacement-observed"),
                PrimaryRouteStep (AgreePrimaryHash "before-and-after-hashes-match")
            ))
        ))
    ))

:! secondary_idle = ()
:! secondary_selected = ()
:! secondary_forward_applied = ()
:! secondary_restored = ()
:! secondary_hash_agreed = ()

:| secondary_route_step from to =
    | SelectSecondaryRoute :: secondary_route_step secondary_idle secondary_selected
    | ApplySecondaryForward :: string -> secondary_route_step secondary_selected secondary_forward_applied
    | RestoreSecondaryOriginal :: string -> secondary_route_step secondary_forward_applied secondary_restored
    | AgreeSecondaryHash :: string -> secondary_route_step secondary_restored secondary_hash_agreed

:| ^ secondary_route_plan from to =
    | SecondaryRouteStep :: \* from to. secondary_route_step from to -> secondary_route_plan from to
    | SecondaryRouteThen :: \* from to.
        (\? middle. secondary_route_plan from middle * secondary_route_plan middle to) ->
        secondary_route_plan from to

:= secondary_fallback_plan () : secondary_route_plan secondary_idle secondary_hash_agreed =
    SecondaryRouteThen (\? (
        SecondaryRouteStep SelectSecondaryRoute,
        SecondaryRouteThen (\? (
            SecondaryRouteStep (ApplySecondaryForward "forward-replacement-observed"),
            SecondaryRouteThen (\? (
                SecondaryRouteStep (RestoreSecondaryOriginal "reverse-replacement-observed"),
                SecondaryRouteStep (AgreeSecondaryHash "before-and-after-hashes-match")
            ))
        ))
    ))

:~ patch_route_role_binding (expected_role : i32) (observed_role : i32) : i32 =
    ? expected_role < 0i32 ?> -1i32
    |? 2i32 < expected_role ?> -1i32
    |? expected_role < observed_role ?> -1i32
    |? observed_role < expected_role ?> -1i32
    |: expected_role

:~ patch_route_forward_binding (route_token : i32) (forward_outcome : i32) : i32 =
    ? route_token < 0i32 ?> -1i32
    |? 2i32 < route_token ?> -1i32
    |? forward_outcome < 1i32 ?> -1i32
    |? 1i32 < forward_outcome ?> -1i32
    |: route_token

:~ patch_route_restore_binding (route_token : i32) (restore_outcome : i32) : i32 =
    patch_route_forward_binding route_token restore_outcome

:~ patch_route_hash_binding (before_hash : i32) (after_hash : i32) : i32 =
    ? before_hash < after_hash ?> 0i32
    |? after_hash < before_hash ?> 0i32
    |: 1i32

:~ patch_route_complete_binding (route_token : i32) (hash_agreed : i32) : i32 =
    ? route_token < 0i32 ?> 0i32
    |? 2i32 < route_token ?> 0i32
    |? hash_agreed < 1i32 ?> 0i32
    |? 1i32 < hash_agreed ?> 0i32
    |: 1i32

:~ patch_route_agreement_binding (left_complete : i32) (right_complete : i32) : i32 =
    ? left_complete < 1i32 ?> 0i32
    |? 1i32 < left_complete ?> 0i32
    |? right_complete < 1i32 ?> 0i32
    |? 1i32 < right_complete ?> 0i32
    |: 1i32
