:= fixture_path (root : string) (name : string) : string =
    $'std::path::Path::new(&*!root).join(&*!name).display().to_string().into()' : string

:= fixture_paths (root : string) : model.two_file_paths =
    {
        target_a = fixture_path root "target-a.txt"
        stage_a = fixture_path root "stage-a.txt"
        backup_a = fixture_path root "backup-a.txt"
        target_b = fixture_path root "target-b.txt"
        stage_b = fixture_path root "stage-b.txt"
        backup_b = fixture_path root "backup-b.txt"
    }
:= fixture_contents () : model.two_file_contents =
    { original_a = "original-a"; original_b = "original-b"; changed_a = "changed-a"; changed_b = "changed-b" }

:= main () : i32 =
    := _ = model.static_probe_result ()
    := root = $'std::env::temp_dir().join("kit patch batch ü ".to_owned() + &std::process::id().to_string() + "-" + \
        &std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_nanos().to_string()\
        ).display().to_string().into()' : string
    := created = $'std::fs::create_dir(&*!root).is_ok()' : bool
    ? created
    ?>
        := paths = fixture_paths root
        := contents = fixture_contents ()
        := passed = model.run_fault patch_model.model.FailBetweenPromotions contents paths
        := unsupported = ? model.run_fault patch_model.model.NoFault contents paths ?> !- |: !+
        := missing_rename =
            ? rust_std_fs.model.rename (fixture_path root "missing.txt") (fixture_path root "missing-promoted.txt")
            ?> !-
            |: !+
        := cleaned = model.cleanup paths
        := cleaned_again = model.cleanup paths
        := root_cleaned = $'std::fs::remove_dir(&*!root).is_ok()' : bool
        ? passed && unsupported && missing_rename && cleaned && cleaned_again && root_cleaned ?> 0i32 |: 1i32
    |: 10i32
