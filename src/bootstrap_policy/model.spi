:! recovered_prototype = ()
:! shared_policy_typechecked = ()
:! two_mains_compiled = ()
:! cold_proven = ()
:! settled_foundation = ()

:! spiral_source = ()
:! manual_rust = ()


:! candidate_experimental = ()
:! candidate_primary = ()
:! fallback_recovery = ()
:! candidate_exclusive = ()

:| authority_mode state =
    | CandidateExperimental :: string -> authority_mode candidate_experimental
    | CandidatePrimary :: string -> authority_mode candidate_primary
    | FallbackRecoveryOnly :: string -> authority_mode fallback_recovery
    | CandidateExclusive :: string -> authority_mode candidate_exclusive

:= current_authority () : authority_mode candidate_experimental =
    CandidateExperimental "candidate-is-an-experimental-compiler-coproduct"
:= fallback_authority () : authority_mode fallback_recovery =
    FallbackRecoveryOnly "fallback-binaries-are-explicit-recovery-routes"

:| source_authority source =
    | SpiralAuthored :: source_authority spiral_source
    | ManualRustDebt :: source_authority manual_rust

:| policy_op from to result =
    | ReuseIndexedDomain ::
        source_authority spiral_source * i32 * i32 ->
        policy_op recovered_prototype shared_policy_typechecked string
    | CompileTwoMains :: string -> policy_op shared_policy_typechecked two_mains_compiled string
    | ProveCold :: string -> policy_op two_mains_compiled cold_proven string
    | SettleFoundation :: string -> policy_op cold_proven settled_foundation string

:| ^ policy_plan from to =
    | PolicyStep :: \* from to. (\? result. policy_op from to result * result) -> policy_plan from to
    | PolicyThen :: \* from to. (\? middle. policy_plan from middle * policy_plan middle to) -> policy_plan from to

:= reuse_step () : policy_plan recovered_prototype shared_policy_typechecked =
    PolicyStep (
        \? (
            ReuseIndexedDomain (
                SpiralAuthored,
                domain.model.bootstrap_probe_result (),
                domain.model.policy_probe_result ()
            ),
            "shared-policy-typechecked"
        )
    )

:= compile_step () : policy_plan shared_policy_typechecked two_mains_compiled =
    PolicyStep (\? (CompileTwoMains "two-independent-main-functions", "two-mains-compiled"))

:= cold_step () : policy_plan two_mains_compiled cold_proven =
    PolicyStep (\? (ProveCold "cold-probes-required", "cold-proven"))

:= settle_step () : policy_plan cold_proven settled_foundation =
    PolicyStep (\? (SettleFoundation "spiral-first-foundation", "settled"))

:= build_plan () : policy_plan recovered_prototype settled_foundation =
    PolicyThen (
        \? (
            reuse_step (),
            PolicyThen (
                \? (
                    compile_step (),
                    PolicyThen (\? (cold_step (), settle_step ()))
                )
            )
        )
    )

:= ^ terminal \* from to. (plan : policy_plan from to) : i32 =
    ?= plan ?|
    | PolicyStep payload =>
        := \? result. op, _ = payload
        ?= op ?|
        | ReuseIndexedDomain _ => 3i32
        | CompileTwoMains _ => 2i32
        | ProveCold _ => 1i32
        | SettleFoundation _ => 0i32
    | PolicyThen payload =>
        := \? middle. _, right = payload
        terminal right

:= patch_probe_result () : i32 = terminal (build_plan ())
:= agile_probe_result () : i32 = terminal (build_plan ())
:= workspace_state_candidate_status () : i32 = workspace_state_contract.model.authority_status ()
:= compiler_session_candidate_status () : i32 = compiler_session_contract.model.authority_status ()
:= legacy_bundle_writer_candidate_status () : i32 = legacy_cpp_bundle_writer_contract.model.authority_status ()
:= ingest_frontier_candidate_status () : i32 = ingest_frontier_contract.model.authority_status ()
:= settled_migration_score_0_1000 () : u32 = 987u32
:= settled_migration_status_code () : i32 = 987i32
:= migration_total_capability_equivalents () : u32 = 69u32
:= migration_settled_capability_equivalents () : u32 = 69u32
:= migration_remaining_capability_equivalents () : u32 = 0u32
:= recovered_prototype_score_0_1000 () : u32 = 304u32
:= candidate_is_promotable (typed : bool) (two_mains : bool) (cold : bool) : bool = typed && two_mains && cold
:= candidate_primary_is_promotable
    (typed : bool) (two_mains : bool) (cold : bool) (hot_burnin : bool) (cold_burnin : bool) (growth_accounted : bool)
    : bool
    =
    typed && two_mains && cold && hot_burnin && cold_burnin && growth_accounted
