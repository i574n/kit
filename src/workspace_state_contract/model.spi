:! workspace_unmapped = ()
:! workspace_mapped = ()
:! workspace_scored = ()
:! workspace_budgeted = ()
:! workspace_leased = ()
:! workspace_authoritative = ()

:| workspace_map_evidence =
    | WorkspaceMapEvidence :: u32 * u32 * u32 * u32 -> workspace_map_evidence

:| workspace_score_evidence =
    | WorkspaceScoreEvidence :: u32 * u32 * u32 * u32 -> workspace_score_evidence

:| workspace_budget_evidence =
    | WorkspaceBudgetEvidence :: u32 * u32 * u32 * u32 -> workspace_budget_evidence

:| workspace_lease_evidence =
    | WorkspaceLeaseEvidence :: u64 * u64 -> workspace_lease_evidence

:| workspace_state_op from to =
    | MapWorkspace :: workspace_map_evidence -> workspace_state_op workspace_unmapped workspace_mapped
    | ScoreWorkspace :: workspace_score_evidence -> workspace_state_op workspace_mapped workspace_scored
    | BudgetWorkspace :: workspace_budget_evidence -> workspace_state_op workspace_scored workspace_budgeted
    | LeaseWorkspace :: workspace_lease_evidence -> workspace_state_op workspace_budgeted workspace_leased
    | AuthorizeWorkspace :: workspace_state_op workspace_leased workspace_authoritative

:| ^ workspace_state_plan from to =
    | WorkspaceStep :: \* from to. workspace_state_op from to -> workspace_state_plan from to
    | WorkspaceThen :: \* from to.
        (\? middle. workspace_state_plan from middle * workspace_state_plan middle to) ->
        workspace_state_plan from to

:~ map_binding (roots : i32) (cargo : i32) (mains : i32) (package_only : i32) : i32 =
    ? roots < 1i32 ?> 0i32
    |? cargo < 1i32 ?> 0i32
    |? mains < 1i32 ?> 0i32
    |? package_only < 0i32 ?> 0i32
    |? roots < cargo ?> 0i32
    |? roots - cargo = package_only ?> 1i32
    |: 0i32

:~ score_binding (settled : i32) (total : i32) (migration : i32) (coverage : i32) : i32 =
    ? settled < 1i32 ?> 0i32
    |? total < settled ?> 0i32
    |? migration < 1i32 ?> 0i32
    |? coverage < 500i32 ?> 0i32
    |: 1i32

:~ budget_binding (max_file : i32) (max_crate : i32) (_state_files : i32) (_state_limit : i32) : i32 =
    ? max_file < 1i32 ?> 0i32
    |? 1000i32 < max_file ?> 0i32
    |? max_crate < 1i32 ?> 0i32
    |? 1000i32 < max_crate ?> 0i32
    |: 1i32

:~ lease_binding (budget_ms : i32) (guard_ms : i32) : i32 =
    ? budget_ms = 4500000i32 ?>
        ? guard_ms = 600000i32 ?> 1i32 |: 0i32
    |: 0i32

:~ authority_binding (map_ok : i32) (score_ok : i32) (budget_ok : i32) (lease_ok : i32) : i32 =
    := a = map_ok * score_ok
    := b = budget_ok * lease_ok
    (a * b)

:= build_authority_plan () : workspace_state_plan workspace_unmapped workspace_authoritative =
    := map = WorkspaceMapEvidence (162u32, 68u32, 162u32, 94u32)
    := score = WorkspaceScoreEvidence (44u32, 69u32, 637u32, 500u32)
    := budget = WorkspaceBudgetEvidence (974u32, 1000u32, 59u32, 62u32)
    := lease = WorkspaceLeaseEvidence (4500000u64, 600000u64)
    WorkspaceThen (\? (
        WorkspaceStep (MapWorkspace map),
        WorkspaceThen (\? (
            WorkspaceStep (ScoreWorkspace score),
            WorkspaceThen (\? (
                WorkspaceStep (BudgetWorkspace budget),
                WorkspaceThen (\? (
                    WorkspaceStep (LeaseWorkspace lease),
                    WorkspaceStep AuthorizeWorkspace
                ))
            ))
        ))
    ))

:= authority_status () : i32 =
    := _ = build_authority_plan ()
    authority_binding
        (map_binding 162i32 68i32 162i32 94i32)
        (score_binding 44i32 69i32 637i32 500i32)
        (budget_binding 974i32 1000i32 59i32 62i32)
        (lease_binding 4500000i32 600000i32)
