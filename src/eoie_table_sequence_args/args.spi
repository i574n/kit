open sm'_operators

type file_table =
    {
        text : string
        rows : u64
    }

let rec data_rows (lines : array string) (index : i32) (acc : file_table) : file_table =
    if index >= am'.length lines then acc
    else
        inl line = am'.index index lines
        if line = "" || sm'.starts_with "#" line then data_rows lines (index + 1i32) acc
        else data_rows lines (index + 1i32) { text = acc.text ++# line ++# "\n"; rows = acc.rows + 1u64 }

let argument (index : i32) : string = optionm'.default_value "" (env.try_command_line_argument index)

let split_pair (~text : string) (~separator : string) : string * string =
    inl at = sm'.index_of separator text
    if at < 0 then text, "" else sm'.substring 0i32 at text, sm'.substring (at + sm'.length separator) (sm'.length text - at - sm'.length separator) text

let rec value_after (~flag : string) (index : i32) (count : i32) : string =
    if index + 1i32 >= count then "" elif argument index = flag then argument (index + 1i32) else value_after flag (index + 1i32) count

let decimal (~text : string) : u64 = optionm'.default_value 0u64 (convert.try_convert text)

let known_flag (~word : string) : bool = sm'.listed "|" word "--time|--interval|--window|--order|--latency|--between|--from|--to|--ms|--modulo|--out|--section-on|--carry|--first|--last"

let rec paths_from (index : i32) (count : i32) (acc : list string) (~refusal : string) : list string * string =
    if index >= count then listm.rev acc, refusal
    else
        inl word = argument index
        if sm'.starts_with "--" word then
            if known_flag word then paths_from (index + 2i32) count acc refusal
            else paths_from count count acc (if refusal = "" then "unknown option " ++# word else refusal)
        else paths_from (index + 1i32) count (Cons (word, acc)) refusal

let rec has_columns (index : i32) (count : i32) : bool =
    if index >= count then false
    elif argument index = "--first" || argument index = "--last" then true
    else has_columns (index + 1i32) count

let rec named_files (~path : string) (names : array string) (index : i32) (acc : list string) : list string =
    if index < 0i32 then acc
    else
        inl file = path ++# "/" ++# am'.index index names
        named_files path names (index - 1i32) (if file_system.file_exists file then Cons (file, acc) else acc)

let rec files_in (paths : list string) (acc : list string) : list string =
    match paths with
    | Nil => listm.rev acc
    | Cons (path, rest) =>
        if file_system.directory_exists path then
            inl names = file_system.read_dir_names path |> resultm.unwrap' |> am'.from_vec_base |> am'.map_base sm'.from_std_string |> array |> am'.sort_by id
            files_in rest (listm.fold (fun kept file => Cons (file, kept)) acc (named_files path names (am'.length names - 1i32) Nil))
        else files_in rest (Cons (path, acc))

let rec missing_path (paths : list string) : string =
    match paths with
    | Nil => ""
    | Cons (path, rest) => if file_system.file_exists path || file_system.directory_exists path then missing_path rest else path
inl usage () : string = "usage: table sequences <file|dir>... --time <regex with (?<ms>digits)> (--interval name=A [--between B] [--modulo ms] | --window name=A --from M --ms lo..hi | --order name=A,B | --latency name=A --to B | [--section-on <regex with (?<section>)>] [--carry <regex>] (--first|--last) name=<regex with (?<id>) and (?<value>)>...) [--out file.tsv]"

let refused (~reason : string) : i32 =
    console.write_error_line ("eoie error: table sequences " ++# reason ++# "; " ++# usage ())
    2i32
