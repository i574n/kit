:| tool_source =
    | OnPath : string
    | FileAt : string

:| ^ tool_sources =
    | NoMoreSources
    | ThenSource : tool_source * tool_sources

:== tool_resolver = { option : string; environment : string; fallbacks : tool_sources }

:| tool_found =
    | ByOption : string
    | ByEnvironment : string * string
    | ByFallback : tool_source * string
    | NotFound

:== tool_probe =
    {
        option : string -> string
        environment : string -> string
        locate : tool_source -> string
    }

:= ^ first_fallback (probe : tool_probe) (sources : tool_sources) : tool_found =
    ?= sources ?|
    | NoMoreSources => NotFound
    | ThenSource (source, rest) =>
        := path = probe.locate source
        ? path = "" ?> first_fallback probe rest |: ByFallback (source, path)

:= tool_resolved (probe : tool_probe) (resolver : tool_resolver) : tool_found =
    := chosen = probe.option resolver.option
    ? chosen <> "" ?> ByOption chosen
    |:
        := inherited = probe.environment resolver.environment
        ? inherited <> "" ?> ByEnvironment (resolver.environment, inherited)
        |: first_fallback probe resolver.fallbacks

:= tool_path = \|
    | ByOption path => path
    | ByEnvironment (_, path) => path
    | ByFallback (_, path) => path
    | NotFound => ""

:= on_path (~option : string) (~environment : string) (executables : tool_sources) : tool_resolver =
    { option = option; environment = environment; fallbacks = executables }

:= named (~executable : string) (rest : tool_sources) : tool_sources = ThenSource (OnPath executable, rest)

:= python_tool () : tool_resolver = on_path "python" "SPIRAL_PYTHON" (named "python" (named "python3" NoMoreSources))
:= cc_tool () : tool_resolver = on_path "cc" "SPIRAL_CC" (named "gcc" (named "clang" (named "cl" NoMoreSources)))
:= rustc_tool () : tool_resolver = on_path "rustc_bin" "SPIRAL_RUSTC" (named "rustc" NoMoreSources)

:= unset (_ : string) : string = ""

:= environment_value (~name : string) : string = $'std::rc::Rc::<str>::from(std::env::var(&*!name).unwrap_or_default()\
    )' : string
:= file_present (~path : string) : string = $'std::rc::Rc::<str>::from(if std::path::Path::new(&*!path).is_file() { \
    &*!path } else { "" })' : string
:= path_executable (~executable : string) : string = $'std::rc::Rc::<str>::from(std::env::var_os("PATH").map(|paths| \
    std::env::split_paths(&paths).map(|dir| dir.join(format\!("{}{}", &*!executable, \
    std::env::consts::EXE_SUFFIX))).find(|candidate| candidate.is_file()).map(|candidate| \
    candidate.to_string_lossy().into_owned()).unwrap_or_default()).unwrap_or_default().as_str())' : string

:= located = \|
    | OnPath executable => path_executable executable
    | FileAt path => file_present path

:= real_probe () : tool_probe = { option = unset; environment = \ name => environment_value name; locate = located }

:= listed (~name : string) (~present : string) : bool = $'(!present).split(char::from(124u8)).any(|entry| entry == \
    &*!name)' : bool

:= listed_at (~present : string) (source : tool_source) : string =
    ?= source ?|
    | OnPath executable => ? listed executable present ?> $'std::rc::Rc::<str>::from(format\!("/bin/{}", \
        &*!executable).as_str())' : string |: ""
    | FileAt path => ? listed path present ?> path |: ""

:= probe_with (options : string -> string) (environment : string -> string) (~present : string) : tool_probe =
    { option = options; environment = environment; locate = \ source => listed_at present source }

:= require (value : bool) : () = $'if !value { () } else { std::panic::panic_any("Spiral test assertion failed") }' : ()

///> rust
:# every_writer_of_one_file_shares_one_pending_copy =
    require (files.pending_path "state/agile.spi" = "state/agile.spi.pending")

///> rust
:# an_explicit_option_wins_over_everything =
    := probe = probe_with (\ key => ? key = "python" ?> "/opt/py" |: "") (\ _ => "/env/py") "python"
    require (tool_path (tool_resolved probe (python_tool ())) = "/opt/py")

///> rust
:# the_environment_wins_over_path =
    := probe = probe_with unset (\ key => ? key = "SPIRAL_PYTHON" ?> "/env/py" |: "") "python"
    require (tool_path (tool_resolved probe (python_tool ())) = "/env/py")

///> rust
:# path_candidates_are_tried_in_order =
    require (tool_path (tool_resolved (probe_with unset unset "python3") (python_tool ())) = "/bin/python3")
    require (tool_path (tool_resolved (probe_with unset unset "cl|clang") (cc_tool ())) = "/bin/clang")
    require (tool_path (tool_resolved (probe_with unset unset "") (rustc_tool ())) = "")

///> rust
:# the_real_probe_finds_rustc_and_misses_unknown_tools =
    require ($'(!(tool_path (tool_resolved (real_probe ()) (rustc_tool ())))).to_lowercase().contains("rustc")' : bool)
    require (
        tool_path (tool_resolved (real_probe ()) (on_path "none" "SPIRAL_NO_SUCH_TOOL" (
            named "spiral-no-such-tool" NoMoreSources)))
        = ""
    )
