:! patch_effect_idle = ()
:! patch_effect_read_authorized = ()
:! patch_effect_read_receipted = ()
:! patch_effect_staged = ()
:! patch_effect_written = ()
:! patch_effect_renamed = ()
:! patch_effect_removed = ()

:| patch_effect_step from to =
    | AuthorizeRead :: patch_effect_step patch_effect_idle patch_effect_read_authorized
    | BindReadReceipt :: patch_effect_step patch_effect_read_authorized patch_effect_read_receipted
    | BindStageIdentity :: patch_effect_step patch_effect_read_receipted patch_effect_staged
    | BindWriteReceipt :: patch_effect_step patch_effect_staged patch_effect_written
    | BindRenameReceipt :: patch_effect_step patch_effect_written patch_effect_renamed
    | BindRemoveReceipt :: patch_effect_step patch_effect_renamed patch_effect_removed

:| ^ patch_effect_plan from to =
    | PatchEffectStep :: \* from to. patch_effect_step from to -> patch_effect_plan from to
    | PatchEffectThen :: \* from to.
        (\? middle. patch_effect_plan from middle * patch_effect_plan middle to) ->
        patch_effect_plan from to

:= native_patch_effect_plan () : patch_effect_plan patch_effect_idle patch_effect_removed =
    PatchEffectThen (\? (
        PatchEffectStep AuthorizeRead,
        PatchEffectThen (\? (
            PatchEffectStep BindReadReceipt,
            PatchEffectThen (\? (
                PatchEffectStep BindStageIdentity,
                PatchEffectThen (\? (
                    PatchEffectStep BindWriteReceipt,
                    PatchEffectThen (\? (
                        PatchEffectStep BindRenameReceipt,
                        PatchEffectStep BindRemoveReceipt
                    ))
                ))
            ))
        ))
    ))

:~ patch_guard_identity (operation : i32) (path_slot : i32) : i32 =
    ? operation < 0i32 ?> -1i32
    |? path_slot < 0i32 ?> -1i32
    |: operation

:~ patch_guard_needle_binding (identity : i32) (needle_bytes : i32) : i32 =
    ? identity < 0i32 ?> -1i32
    |? needle_bytes < 1i32 ?> -1i32
    |: identity

:~ patch_guard_match_binding (identity : i32) (observed_matches : i32) : i32 =
    ? identity < 0i32 ?> -1i32
    |? observed_matches < 1i32 ?> -1i32
    |? 1i32 < observed_matches ?> -1i32
    |: identity

:~ patch_guard_operation_binding (identity : i32) (operation_authorized : i32) : i32 =
    ? identity < 0i32 ?> -1i32
    |? operation_authorized < 1i32 ?> -1i32
    |? 1i32 < operation_authorized ?> -1i32
    |: identity

:~ patch_read_limit_binding (limit : i32) (metadata_bytes : i32) : i32 =
    ? limit < 1i32 ?> -1i32
    |? metadata_bytes < 0i32 ?> -1i32
    |? limit < metadata_bytes ?> -1i32
    |: metadata_bytes

:~ patch_read_receipt_binding (metadata_bytes : i32) (observed_bytes : i32) : i32 =
    ? metadata_bytes < 0i32 ?> -1i32
    |? observed_bytes < 0i32 ?> -1i32
    |? metadata_bytes < observed_bytes ?> -1i32
    |? observed_bytes < metadata_bytes ?> -1i32
    |: observed_bytes

:~ patch_stage_identity (stage_index : i32) (backup_slot : i32) : i32 =
    ? stage_index < 0i32 ?> -1i32
    |? backup_slot < 0i32 ?> -1i32
    |: backup_slot

:~ patch_write_bytes_authorized (expected_bytes : i32) (observed_bytes : i32) : i32 =
    ? expected_bytes < 0i32 ?> 0i32
    |? observed_bytes < 0i32 ?> 0i32
    |? expected_bytes < observed_bytes ?> 0i32
    |? observed_bytes < expected_bytes ?> 0i32
    |: 1i32

:~ patch_write_slot_binding (backup_slot : i32) (write_authorized : i32) : i32 =
    ? backup_slot < 0i32 ?> -1i32
    |? write_authorized < 1i32 ?> -1i32
    |? 1i32 < write_authorized ?> -1i32
    |: backup_slot

:~ patch_rename_stage_authorized (expected_stage : i32) (observed_stage : i32) : i32 =
    ? expected_stage < 0i32 ?> 0i32
    |? observed_stage < 0i32 ?> 0i32
    |? expected_stage < observed_stage ?> 0i32
    |? observed_stage < expected_stage ?> 0i32
    |: 1i32

:~ patch_rename_slot_authorized (expected_slot : i32) (observed_slot : i32) : i32 =
    ? expected_slot < 0i32 ?> 0i32
    |? observed_slot < 0i32 ?> 0i32
    |? expected_slot < observed_slot ?> 0i32
    |? observed_slot < expected_slot ?> 0i32
    |: 1i32

:~ patch_authority_pair (left : i32) (right : i32) : i32 =
    ? left < 1i32 ?> 0i32
    |? 1i32 < left ?> 0i32
    |? right < 1i32 ?> 0i32
    |? 1i32 < right ?> 0i32
    |: 1i32

:~ patch_rename_slot_binding (expected_slot : i32) (authorized : i32) : i32 =
    patch_write_slot_binding expected_slot authorized

:~ patch_remove_receipt_binding (expected_stage : i32) (outcome : i32) : i32 =
    ? expected_stage < 0i32 ?> -1i32
    |? outcome < 1i32 ?> -1i32
    |? 1i32 < outcome ?> -1i32
    |: expected_stage
