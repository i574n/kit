:= main () : i32 =
    := _ = native_patch_effect_plan ()
    := _ = patch_read_limit_binding 1i32 1i32
    := _ = patch_read_receipt_binding 1i32 1i32
    := _ = patch_stage_identity 0i32 0i32
    := _ = patch_write_bytes_authorized 1i32 1i32
    := _ = patch_write_slot_binding 0i32 1i32
    := _ = patch_rename_stage_authorized 0i32 0i32
    := _ = patch_rename_slot_authorized 0i32 0i32
    := _ = patch_authority_pair 1i32 1i32
    := _ = patch_rename_slot_binding 0i32 1i32
    := _ = patch_remove_receipt_binding 0i32 1i32
    !!!!Export(
        "kit_patch_read_limit_binding",
        ((\ (first, second) => patch_read_limit_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_read_receipt_binding",
        ((\ (first, second) => patch_read_receipt_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_stage_identity",
        ((\ (first, second) => patch_stage_identity first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_write_bytes_authorized",
        ((\ (first, second) => patch_write_bytes_authorized first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_write_slot_binding",
        ((\ (first, second) => patch_write_slot_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_rename_stage_authorized",
        ((\ (first, second) => patch_rename_stage_authorized first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_rename_slot_authorized",
        ((\ (first, second) => patch_rename_slot_authorized first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_authority_pair",
        ((\ (first, second) => patch_authority_pair first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_rename_slot_binding",
        ((\ (first, second) => patch_rename_slot_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_patch_remove_receipt_binding",
        ((\ (first, second) => patch_remove_receipt_binding first second) : i32 * i32 -> i32)
    )

    0i32
