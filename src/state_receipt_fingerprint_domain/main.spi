:= main () : i32 =
    := _ = fingerprint_byte_valid_binding 97i32 0i32
    := mixed_low = fingerprint_mix_low_binding -2078137563i32 97i32
    := _ = fingerprint_low_step_binding mixed_low 0i32
    := _ = fingerprint_high_step_binding -873292572i32 mixed_low
    !!!!Export(
        "kit_state_receipt_byte_valid",
        ((\ (first, second) => fingerprint_byte_valid_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_state_receipt_mix_low",
        ((\ (first, second) => fingerprint_mix_low_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_state_receipt_low_step",
        ((\ (first, second) => fingerprint_low_step_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_state_receipt_high_step",
        ((\ (first, second) => fingerprint_high_step_binding first second) : i32 * i32 -> i32)
    )
    0i32
