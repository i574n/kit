///- --package .
test verdict static =
    open sm'_operators

open sm'_operators
open file_system_operators
open eoie_ci_model.tools

union pin_parity =
    | Matches : string
    | Differs : string
    | MissingLocally

let pin_matches (tool : ci_tool) (~ci : string) (~local : string) : bool =
    match tool with
    | ToolRust => ci = local
    | _ => ci = local || sm'.starts_with (ci ++# ".") local

let local_verdict (tool : ci_tool) (~ci : string) (local : option string) : pin_parity =
    match local with
    | None => MissingLocally
    | Some found => if pin_matches tool ci found then Matches found else Differs found

let differs (verdict : pin_parity) : bool =
    match verdict with
    | Matches _ => false
    | _ => true

let verdict_line (tool : ci_tool) (~ci : string) (verdict : pin_parity) : string =
    inl local, state =
        match verdict with
        | Matches found => found, "same"
        | Differs found => found, "differs"
        | MissingLocally => "-", "missing"
    tool_name tool ++# " ci=" ++# ci ++# " local=" ++# local ++# " " ++# state

let matching_version (tool : ci_tool) (~ci : string) (versions : list string) : option string =
    versions |> listm'.try_find_ fun (version : string) => pin_matches tool ci version

let fix_line (tool : ci_tool) (~ci : string) (~path : string) : string =
    match tool with
    | ToolZig => "fix: SPIRAL_ZIG=" ++# path
    | ToolRust => "fix: rustup toolchain install " ++# ci
    | _ => "candidate: " ++# path

let names_in (directory : string) : list string =
    if file_system.directory_exists directory |> not then []
    else
        file_system.read_dir_names directory
        |> resultm.unwrap'
        |> am'.vec_fold' (fun names name => Cons (sm'.from_std_string name, names)) Nil

let scoop_apps () : string =
    optionm'.default_value "" (env.try_get_environment_variable "USERPROFILE") </> "scoop" </> "apps"

let scoop_match (tool : ci_tool) (ci : string) : option string =
    inl apps = scoop_apps ()
    inl exe = tool_name tool ++# ".exe"
    names_in apps
    |> listm'.filter (sm'.starts_with (tool_name tool))
    |> listm.fold fun found (app : string) =>
            match found with
            | Some _ => found
            | None =>
                match matching_version tool ci (names_in (apps </> app)) with
                | Some version =>
                    if file_system.file_exists (apps </> app </> version </> exe)
                    then Some (apps </> app </> version </> exe)
                    else None
                | None => None
        None

let fix_for (rust_installed : string -> bool) (tool : ci_tool) (ci : string) (verdict : pin_parity) : option string =
    match verdict with
    | Matches _ => None
    | _ =>
        match tool with
        | ToolRust => if rust_installed ci then None else Some (fix_line ToolRust ci "")
        | _ => scoop_match tool ci |> optionm.map fun (path : string) => fix_line tool ci path

let row_of
    (probe : string -> string -> bool * string)
    (rust_installed : string -> bool)
    (~name : string)
    (~ci : string)
    (~repo : string)
    : string * bool =
    match tool_of_name name with
    | None => name ++# " ci=" ++# ci ++# " local=- unknown", true
    | Some tool =>
        inl found, version = probe name repo
        inl verdict = local_verdict tool ci (if found then Some version else None)
        inl fix = match fix_for rust_installed tool ci verdict with | Some line => "\n  " ++# line | None => ""
        verdict_line tool ci verdict ++# fix, differs verdict

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

///> rust
test a_pin_matches_its_patch_releases_but_not_a_dev_build =
    expect (pin_matches ToolOtp "29" "29.1.2") "otp 29 takes any 29.x"
    expect (pin_matches ToolElixir "1.20" "1.20.4") "elixir minor pin"
    expect (pin_matches ToolZig "0.17.0" "0.18.0-dev.146+35accc06e" = false) "dev build"
    expect (pin_matches ToolZig "0.18.0" "0.18.0-dev.146+35accc06e" = false) "a dev build is not its release"
    expect (pin_matches ToolOtp "2" "29.1.2" = false) "prefix only at a dot"
    expect (pin_matches ToolRust "nightly-2026-10-18" "nightly-2025-05-09" = false) "rust channels compare whole"

///> rust
test rows_read_the_probe_and_name_a_fix =
    inl laptop (name : string) (_ : string) : bool * string =
        if name = "rust" then true, "nightly-2025-05-09" elif name = "otp" then true, "29.1.2" else false, ""
    inl installed (channel : string) : bool = channel = "stable"
    inl rust_row =
        "rust ci=nightly-2026-10-18 local=nightly-2025-05-09 differs"
        ^^ "\n  fix: rustup toolchain install nightly-2026-10-18"
    expect (row_of laptop installed "rust" "nightly-2026-10-18" "C:/repo" = (rust_row, true)) "rust names its install"
    expect (row_of laptop installed "otp" "29" "C:/repo" = ("otp ci=29 local=29.1.2 same", false)) "otp patch release"
    expect (row_of laptop installed "cobol" "1" "C:/repo" = ("cobol ci=1 local=- unknown", true)) "an unknown tool"

///> rust
test fix_lines_and_matching_versions =
    expect (matching_version ToolPython "3.12.10" [ "3.15.0"; "3.12.10" ] = Some "3.12.10") "an installed match"
    expect (matching_version ToolZig "0.17.0" [ "0.18.0-dev.146+35accc06e" ] = None) "no dev build stands in"
    inl zig = "C:/scoop/apps/zig/0.17.0/zig.exe"
    expect (fix_line ToolZig "0.17.0" zig = "fix: SPIRAL_ZIG=" ++# zig) "zig names the harness variable"
    expect (names_in "C:/eoie-ci-parity-no-such-folder" = []) "a missing folder lists nothing"
