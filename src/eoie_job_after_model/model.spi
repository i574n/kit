///- --package .
test model static =
    open sm'_operators

open sm'_operators

union after_mode =
    | AfterAny
    | AfterOk

union rechain_refusal =
    | UnknownJob
    | UnknownPredecessor
    | SelfAfter
    | NotChained
    | NotWaiting : string
    | WouldCycle

union rechain_outcome =
    | Repointed : string
    | Refused : rechain_refusal

type rechain_facts =
    {
        job_known : bool
        predecessor_known : bool
        same_job : bool
        chained : bool
        waiting : bool
        state : string
        previous : string
        cycle : bool
    }

inl mode_word (mode : after_mode) : string =
    match mode with
    | AfterAny => "any"
    | AfterOk => "ok"

inl mode_of_flag (~flag : string) : option after_mode =
    if flag = "" then Some AfterAny elif flag = "--ok" then Some AfterOk else None

inl after_file_text (~predecessor : string) (mode : after_mode) : string = predecessor ++# "\t" ++# mode_word mode

inl after_file_predecessor (~text : string) : string = sm'.split "\t" text |> array |> am'.index 0i32 |> sm'.trim

inl rechain_of (facts : rechain_facts) : rechain_outcome =
    if facts.job_known |> not then Refused UnknownJob
    elif facts.predecessor_known |> not then Refused UnknownPredecessor
    elif facts.same_job then Refused SelfAfter
    elif facts.chained |> not then Refused NotChained
    elif facts.waiting |> not then Refused (NotWaiting facts.state)
    elif facts.cycle then Refused WouldCycle
    else Repointed facts.previous

inl refusal_text (refusal : rechain_refusal) (~id : string) (~predecessor : string) : string =
    match refusal with
    | UnknownJob => "unknown job id " ++# id
    | UnknownPredecessor => "unknown predecessor id " ++# predecessor
    | SelfAfter => "a job cannot wait for itself"
    | NotChained => id ++# " was not started with --after or --after-ok; stop it and start it again with --after"
    | NotWaiting state => id ++# " is " ++# state ++# ", no longer waiting for its predecessor; nothing changed"
    | WouldCycle => predecessor ++# " already waits, directly or down its chain, for " ++# id ++# "; nothing changed"

inl usage () : string =
    "job after <queued-id> <predecessor-id> [--ok] (re-points a job still waiting on --after/--after-ok; label, "
    ^^ "timeout, gate and command are kept)"

type chain_head =
    {
        mode : after_mode
        first : string
        serial : bool
        runner : bool
    }

type chain_plan =
    {
        head : chain_head
        links : list (list string)
    }

union chain_parse =
    | ChainPlanned : chain_plan
    | ChainRefused : string

inl chain_usage () : string =
    "job chain [--ok] [--serial] [<after-id>] -- <label> <timeout-ms> <program> [args...] -- <label> ... (starts each "
    ^^ "job after the previous one, --after-ok with --ok, and prints every id; --serial runs the links in order inside "
    ^^ "one job, so a waiting link holds no process)"

let rec segments (args : list string) (current : list string) (found : list (list string)) : list (list string) =
    match args with
    | [] => listm.rev (listm.rev current :: found)
    | arg :: rest =>
        if arg = "--" then segments rest [] (listm.rev current :: found) else segments rest (arg :: current) found

let rec head_from (words : list string) (head : chain_head) : option chain_head =
    match words with
    | [] => Some head
    | word :: rest =>
        if word = "--ok" then head_from rest { head with mode = AfterOk }
        elif word = "--serial" then head_from rest { head with serial = true }
        elif word = "--run-serial" then head_from rest { head with runner = true }
        elif head.first = "" && sm'.starts_with "job-" word then head_from rest { head with first = word }
        else None

inl head_of (words : list string) : option chain_head =
    head_from words { mode = AfterAny; first = ""; serial = false; runner = false }

let rec short_link (links : list (list string)) (index : i32) : i32 =
    match links with
    | [] => 0i32
    | link :: rest => if (listm.length link : i32) < 3i32 then index else short_link rest (index + 1i32)

inl chain_of (args : list string) : chain_parse =
    match segments args [] [] with
    | [] => ChainRefused (chain_usage ())
    | head :: links =>
        match head_of head with
        | None => ChainRefused (chain_usage ())
        | Some parsed =>
            inl short = short_link links 1i32
            if (listm.length links : i32) = 0i32 then ChainRefused ("no job to start; " ++# chain_usage ())
            elif short > 0i32
            then ChainRefused ("link " ++# sm'.format short ++# " needs <label> <timeout-ms> <program> [args...]")
            elif parsed.serial && parsed.runner then ChainRefused "--serial and --run-serial exclude each other"
            else ChainPlanned { head = parsed; links = links }

inl after_flag (mode : after_mode) : string =
    match mode with
    | AfterAny => "--after"
    | AfterOk => "--after-ok"

inl start_arguments (mode : after_mode) (~previous : string) (link : list string) : list string =
    "job" :: "start" :: (if previous = "" then link else after_flag mode :: previous :: link)

inl started_id (~output : string) : string =
    inl at = sm'.index_of "id=job-" output
    if at < 0i32 then ""
    else
        inl rest = sm'.substring (at + 3i32) ((sm'.length output : i32) - at - 3i32) output
        sm'.split " " rest |> array |> am'.index 0i32 |> sm'.trim

let rec links_timeout (links : list (list string)) (total : u64) : option u64 =
    match links with
    | [] => Some total
    | (_ :: timeout :: _) :: rest =>
        match sm'.decimal_i32 timeout with
        | Some ms => if ms > 0i32 then links_timeout rest (total + convert.u64 ms) else None
        | None => None
    | _ :: _ => None

let rec list_joined (front : list string) (back : list string) : list string =
    match front with
    | [] => back
    | word :: rest => word :: list_joined rest back

let rec links_flattened (links : list (list string)) : list string =
    match links with
    | [] => []
    | link :: rest => "--" :: list_joined link (links_flattened rest)

inl serial_label (links : list (list string)) : string =
    match links with
    | (label :: _) :: _ => label ++# "-serial"
    | _ => "chain-serial"

inl ok_flags (mode : after_mode) : list string =
    match mode with
    | AfterOk => [ "--ok" ]
    | AfterAny => []

inl serial_start_arguments (head : chain_head) (~program : string) (total : u64) links : list string =
    inl runner = "job" :: "chain" :: "--run-serial" :: ok_flags head.mode
    inl link = serial_label links :: sm'.format total :: program :: list_joined runner (links_flattened links)
    start_arguments head.mode head.first link

inl run_arguments (link : list string) : list string = "job" :: "run" :: link

inl continues_after (mode : after_mode) (succeeded : bool) : bool =
    match mode with
    | AfterAny => true
    | AfterOk => succeeded

let rec arguments_from (index : i32) (count : i32) (found : list string) : list string =
    if count <= index then listm.rev found
    else arguments_from (index + 1i32) count (optionm'.default_value "" (env.try_command_line_argument index) :: found)

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

inl waiting_facts () : rechain_facts =
    {
        job_known = true
        predecessor_known = true
        same_job = false
        chained = true
        waiting = true
        state = "queued"
        previous = "job-1-old"
        cycle = false
    }

///> rust
test a_waiting_chained_job_is_repointed =
    expect (rechain_of (waiting_facts ()) = Repointed "job-1-old") "repointed, previous predecessor reported"
    expect (after_file_text "job-2-new" AfterOk = "job-2-new\tok") "the after file keeps the launch format"
    expect (after_file_predecessor "job-2-new\tany\n" = "job-2-new") "predecessor read back"
    expect (mode_of_flag "" = Some AfterAny && mode_of_flag "--ok" = Some AfterOk && mode_of_flag "-x" = None) "flags"

///> rust
test refusals_come_in_a_fixed_order =
    inl facts = waiting_facts ()
    expect (rechain_of { facts with job_known = false; waiting = false } = Refused UnknownJob) "unknown job first"
    expect (rechain_of { facts with same_job = true } = Refused SelfAfter) "self"
    expect (rechain_of { facts with chained = false } = Refused NotChained) "not chained"
    expect (rechain_of { facts with waiting = false; state = "running" } = Refused (NotWaiting "running")) "running"
    expect (rechain_of { facts with cycle = true } = Refused WouldCycle) "cycle"
    inl text = refusal_text WouldCycle "job-a" "job-b"
    expect (text = "job-b already waits, directly or down its chain, for job-a; nothing changed") "cycle text"

///> rust
test a_chain_reads_its_head_and_links =
    inl planned = chain_of [ "--ok"; "job-1-a"; "--"; "b"; "60000"; "pwsh"; "-c"; "1"; "--"; "c"; "60000"; "cmd" ]
    match planned with
    | ChainPlanned plan =>
        expect (plan.head.mode = AfterOk && plan.head.first = "job-1-a" && plan.head.serial = false) "head"
        expect ((listm.length plan.links : i32) = 2i32) "two links"
        match plan.links with
        | first_link :: _ =>
            expect
                (
                    start_arguments plan.head.mode plan.head.first first_link
                    = [ "job"; "start"; "--after-ok"; "job-1-a"; "b"; "60000"; "pwsh"; "-c"; "1" ]
                )
                "first start"
        | [] => failwith "no link"
    | ChainRefused reason => failwith reason
    expect
        (chain_of [ "--"; "b"; "60000" ] = ChainRefused "link 1 needs <label> <timeout-ms> <program> [args...]")
        "short link"
    expect (chain_of [ "x" ] = ChainRefused (chain_usage ())) "a head that is neither --ok nor a job id"
    expect (chain_of [ "--ok" ] = ChainRefused ("no job to start; " ++# chain_usage ())) "no link"
    expect
        (started_id "eoie job start ok id=job-17-b supervisor_pid=9 timeout_ms=60000\n" = "job-17-b")
        "id from the start receipt"
    expect (started_id "eoie error: job --after names no job" = "") "no id"

inl two_links () : list (list string) = [ [ "gate"; "60000"; "pwsh"; "-c"; "1" ]; [ "land"; "30000"; "cmd" ] ]

///> rust
test a_serial_chain_is_one_job_whose_links_run_in_order =
    inl words = [ "--serial"; "--ok"; "--"; "gate"; "60000"; "pwsh"; "-c"; "1"; "--"; "land"; "30000"; "cmd" ]
    match chain_of words with
    | ChainPlanned plan =>
        expect (plan.head.serial && plan.head.mode = AfterOk && plan.head.first = "") "serial head"
        expect (links_timeout plan.links 0u64 = Some 90000u64) "the one job's limit is the sum of its links"
        inl started = serial_start_arguments plan.head "eoie" 90000u64 plan.links
        inl runner = [ "job"; "start"; "gate-serial"; "90000"; "eoie"; "job"; "chain"; "--run-serial"; "--ok"; "--" ]
        inl flattened = [ "gate"; "60000"; "pwsh"; "-c"; "1"; "--"; "land"; "30000"; "cmd" ]
        expect (started = list_joined runner flattened) "start"
    | ChainRefused reason => failwith reason
    expect (links_timeout [ [ "gate"; "soon"; "cmd" ] ] 0u64 = None) "a link limit must be a number"
    inl land = [ "land"; "30000"; "cmd" ]
    expect (run_arguments land = "job" :: "run" :: land) "each link is a job run"
    expect (continues_after AfterOk false = false && continues_after AfterAny false) "--ok stops at the first failure"
    inl both = chain_of [ "--serial"; "--run-serial"; "--"; "a"; "1"; "b" ]
    expect (both = ChainRefused "--serial and --run-serial exclude each other") "modes"
    expect (serial_label (two_links ()) = "gate-serial") "the job is named after its first link"

///> rust
test an_empty_argument_range_reads_as_no_arguments =
    expect ((listm.length (arguments_from 99i32 0i32 []) : i32) = 0i32) "no arguments past the count"
