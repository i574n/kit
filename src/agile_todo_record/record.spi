:< rust_std_fs.model
:< sm'_operators
:< agile_task_text.model
:< agile_note_model.model
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< workspace_primitives.clock
:< workspace_primitives.console
:< workspace_primitives.files
:< ledger

:= argument_owned index : string = rust_std_env.model.argument_owned index

:= todo_marker () : string = "TO" ++# "DO"

:~ ^ harvested_ledger (~backlog : string) (~sites : string) (~found : string) : string =
    ? sites = ""
    ?> lines_sorted found
    |:
        := line = line_head sites
        := id = $'agile_todo_lines::kit_agile_todo_id(&*!backlog, &*!line)' : string
        := gap = byte_find line "  "
        := entry =
            ? id = "" || gap < 0i32 || byte_find line (todo_marker ()) < 0i32
            ?> ""
            |: id ++# "\t" ++# (byte_slice line 0i32 gap) ++# "\n"
        harvested_ledger backlog (line_rest sites) (found ++# entry)

:== record_tally =
    {
        text : string
        appeared : i32
        moved : i32
        vanished : i32
        notes : i32
    }

:= tally_counted (tally : record_tally) (change : site_change) : record_tally =
    ?= change ?|
    | SitesKept => tally
    | SitesAppeared _ => { tally ?| appeared = (tally.appeared + 1i32) }
    | SitesMoved _ => { tally ?| moved = (tally.moved + 1i32) }
    | SitesVanished _ => { tally ?| vanished = (tally.vanished + 1i32) }

:~ noted (tally : record_tally) (~id : string) (~body : string) (~stamp : string) : record_tally =
    ? body = "" || task_declared tally.text id = !- ?> tally
    |:
        := ready = note_schema_ensured tally.text
        := seq = note_count ready id + 1i32
        := note = { at = stamp; author = "todos"; text = body }
        { tally ?| text = notes_appended ready id (note_row id seq note); notes = (tally.notes + 1i32) }

:~ ^ changes_recorded
    (~ids : string) (~before : string) (~after : string) (~stamp : string) (tally : record_tally)
    : record_tally
    =
    ? ids = "" ?> tally
    |:
        := id = line_head ids
        := change = site_change_of (sites_of before id "") (sites_of after id "")
        := next = noted (tally_counted tally change) id (change_note change) stamp
        changes_recorded (line_rest ids) before after stamp next

:~ record_start (~text : string) : record_tally =
    { text = text; appeared = 0i32; moved = 0i32; vanished = 0i32; notes = 0i32 }

:= record_failure (~reason : string) : i32 = stderr_failure ("agile todos --record rejected: " ++# reason)

:~ record_entry () : i32 =
    := started = unix_ms ()
    := root = argument_owned 1i32
    := state = backlog_state_path root
    ?= probe (unchecked state) ?|
    | FileMissing _ => record_failure "state/agile.spi is missing"
    | FileReadable file =>
        := raw = loaded_string (read_text file)
        := original = records_text raw
        := sites = $'agile_todo_scan::kit_agile_todo_sites(&*!root, "*")' : string
        := after = harvested_ledger original sites ""
        := before = ledger_from_rows original 0i32 ""
        := start = record_start original
        := tally = changes_recorded (first_fields (before ++# "\n" ++# after)) before after (utc_stamp started) start
        := updated = ledger_written tally.text after
        := counts =
            " appeared="
            ++# i32_text tally.appeared
            ++# " moved="
            ++# i32_text tally.moved
            ++# (" vanished=" ++# (i32_text tally.vanished) ++# " notes=" ++# (i32_text tally.notes))
        ? updated = original
        ?>
            stdout_line (
                "kit agile todos record ok sites="
                ++# i32_text ($'(!after).lines().count() as i32' : i32)
                ++# counts
                ++# " unchanged=true elapsed_ms="
                ++# u64_text (ms_since started)
            )
        |:
            ?= state_written state raw updated ?|
            | StateWritten =>
                stdout_line (
                    "kit agile todos record ok sites="
                    ++# i32_text ($'(!after).lines().count() as i32' : i32)
                    ++# counts
                    ++# measured_sizes (text_bytes original) (text_bytes updated) (ms_since started)
                )
            | problem => record_failure (state_write_problem problem)

:= main () : i32 =
    !!!!Export("kit_agile_todos_record_run", ((\ () => record_entry ()) : () -> i32))
    := _ = record_entry ()
    0i32
