///- --package .
:# ledger static =
    :< sm'_operators
    :< workspace_primitives.bytes

:< sm'_operators
:< workspace_primitives.bytes

:| site_change =
    | SitesKept
    | SitesAppeared : string
    | SitesMoved : string * string
    | SitesVanished : string

:= site_row_marker () : string = " () = TodoSite "
:= site_schema () : string = "union todo_site =\n    | TodoSite :: string * string -> todo_site\n\n"
:= site_schema_head () : string = "union todo_site ="

:= lines_sorted (~text : string) : string =
    $'std::rc::Rc::<str>::from({ let mut lines = (!text).lines().filter(|line| \
        \!line.is_empty()).collect::<Vec<_>>(); lines.sort(); lines.dedup(); lines.join("\n") }.as_str())' : string

:= first_fields (~text : string) : string =
    $'std::rc::Rc::<str>::from({ let mut ids = (!text).lines().filter_map(|line| \
        line.split(char::from(9u8)).next()).filter(|id| \!id.is_empty()).collect::<Vec<_>>(); ids.sort(); \
        ids.dedup(); ids.join("\n") }.as_str())' : string

:= line_head (~text : string) : string = $'std::rc::Rc::<str>::from((!text).split(char::from(10u8)).next().unwrap_or("\
    "))' : string
:= line_rest (~text : string) : string = $'std::rc::Rc::<str>::from((!text).split_once(char::from(10u8)).map(|(_, \
    rest)| rest).unwrap_or(""))' : string

:~ ^ sites_of (~ledger : string) (~id : string) (~found : string) : string =
    ? ledger = ""
    ?> found
    |:
        := line = line_head ledger
        := prefix = id ++# "\t"
        := next =
            ? sm'.starts_with prefix line
            ?>
                ? found = ""
                ?> byte_slice line (byte_len prefix) (byte_len line)
                |: found ++# ", " ++# (byte_slice line (byte_len prefix) (byte_len line))
            |: found
        sites_of (line_rest ledger) id next

:= site_change_of (~before : string) (~after : string) : site_change =
    ? before = after ?> SitesKept
    |? before = "" ?> SitesAppeared after
    |? after = "" ?> SitesVanished before
    |: SitesMoved (before, after)

:= change_note = \|
    | SitesKept => ""
    | SitesAppeared after => "todos: block appeared at " ++# after
    | SitesMoved (before, after) => "todos: block moved from " ++# before ++# " to " ++# after
    | SitesVanished before => "todos: block vanished from " ++# before ++# " (cut on purpose, or lost)"

:~ ^ ledger_from_rows (~text : string) (offset : i32) (~found : string) : string =
    := at = byte_find_from text (site_row_marker ()) offset
    ? at < 0i32 ?> lines_sorted found
    |:
        := id_start = at + byte_len (site_row_marker ()) + 2i32
        := id_stop = byte_find_from text "\"" id_start
        := site_start = byte_find_from text "\"" (id_stop + 1i32) + 1i32
        := site_stop = byte_find_from text "\"" site_start
        := entry = (byte_slice text id_start id_stop) ++# "\t" ++# (byte_slice text site_start site_stop) ++# "\n"
        ledger_from_rows text (site_stop + 1i32) (found ++# entry)

:~ ^ rows_removed (~text : string) : string =
    := at = byte_find text (site_row_marker ())
    ? at < 0i32 ?> text
    |:
        := start = line_start_before text at
        := newline = byte_find_from text "\n" at
        := stop = ? newline < 0i32 ?> byte_len text |: newline + 1i32
        rows_removed ((byte_slice text 0i32 start) ++# (byte_slice text stop (byte_len text)))

:~ ^ site_rows (~ledger : string) (index : i32) (~rows : string) : string =
    ? ledger = ""
    ?> rows
    |:
        := line = line_head ledger
        := marker = site_row_marker ()
        := item = $'std::rc::Rc::<str>::from((!line).split(char::from(9u8)).next().unwrap_or(""))' : string
        := site =
            $'std::rc::Rc::<str>::from((!line).split_once(char::from(9u8)).map(|(_, site)| site).unwrap_or(""))'
            : string
        := row =
            $'std::rc::Rc::<str>::from(format\!("inl todo_site_{:04}{}({}{}{}, {}{}{})\n", !index, &*(!marker), \
                char::from(34u8), &*!item, char::from(34u8), char::from(34u8), &*!site, char::from(34u8)).as_str())'
            : string
        site_rows (line_rest ledger) (index + 1i32) (rows ++# row)

:= first_item_offset (~text : string) : i32 =
    ? sm'.starts_with "inl " text ?> 0i32
    |:
        := found = byte_find text "\ninl "
        ? found < 0i32 ?> byte_len text |: found + 1i32

:~ ledger_written (~text : string) (~ledger : string) : string =
    := cleared = rows_removed text
    := ensured =
        ? sm'.contains (site_schema_head ()) cleared
        ?> cleared
        |:
            byte_slice cleared 0i32 (first_item_offset cleared)
            ++# site_schema ()
            ++# byte_slice cleared (first_item_offset cleared) (byte_len cleared)
    := after_schema = byte_find_from ensured "\n\n" (byte_find ensured (site_schema_head ())) + 2i32
    byte_slice ensured 0i32 after_schema
    ++# (site_rows ledger 0i32 "")
    ++# byte_slice ensured after_schema (byte_len ensured)


:= state_sample () : string = "union task_note =\n    | Note :: string -> task_note\n\ninl a () = Task (\"A-1\")\n"

///> rust
:# changes_name_what_appeared_moved_or_vanished =
    := before = lines_sorted "A-1\tx.spi:3\nB-2\ty.spi:9\n"
    := after = lines_sorted "B-2\ty.spi:12\nC-3\tz.spi:1\nC-3\tz.spi:1\n"
    testing.expect (first_fields (before ++# "\n" ++# after) = "A-1\nB-2\nC-3") "ids from both sides"
    testing.expect
        (
            change_note (site_change_of (sites_of before "A-1" "") (sites_of after "A-1" ""))
            = "todos: block vanished from x.spi:3 (cut on purpose, or lost)"
        )
        "vanished"
    testing.expect
        (
            change_note (site_change_of (sites_of before "B-2" "") (sites_of after "B-2" ""))
            = "todos: block moved from y.spi:9 to y.spi:12"
        )
        "moved"
    testing.expect
        (
            change_note (site_change_of (sites_of before "C-3" "") (sites_of after "C-3" ""))
            = "todos: block appeared at z.spi:1"
        )
        "appeared once"
    testing.expect (change_note (site_change_of "q.spi:1" "q.spi:1") = "") "kept"

///> rust
:# the_ledger_round_trips_through_state_rows =
    := ledger = "A-1\tC:/repo/x.spi:3\nB-2\ty.spi:9"
    := written = ledger_written (state_sample ()) ledger
    testing.expect (ledger_from_rows written 0i32 "" = ledger) written
    testing.expect
        (
            sm'.contains
                (
                    "union todo_site =\n    | TodoSite :: string * string -> todo_site\n\n"
                    ^^ "inl todo_site_0000 () = TodoSite (\"A-1\", \"C:/repo/x.spi:3\")\n"
                    ^^ "inl todo_site_0001 () = TodoSite (\"B-2\", \"y.spi:9\")\ninl a () = Task"
                )
                written
        )
        written
    := rewritten = ledger_written written "B-2\ty.spi:10"
    testing.expect (ledger_from_rows rewritten 0i32 "" = "B-2\ty.spi:10") rewritten
    testing.expect
        (byte_find_from rewritten "union todo_site" (byte_find rewritten "union todo_site" + 1i32) < 0i32)
        "one schema"
