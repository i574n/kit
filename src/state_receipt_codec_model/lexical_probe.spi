:= dash_shape_ok input expected : bool =
    (=.) (state_receipt_dash_shape input) expected

:= migration_payload_ok source expected : bool =
    (=.) (state_receipt_constructor_payload source "MigrationDenominator (") expected

:= coverage_kind_ok source expected : bool =
    (=.) (state_receipt_coverage_checkpoint_kind source) expected

:= coverage_sha_ok source expected : bool =
    (=.) (state_receipt_coverage_checkpoint_sha source) expected

:= recovered_topology_count_ok () : bool =
    (=.) (state_receipt_recovered_topology_count_or_max "inl recovered_capability_fixture_count () : u32 = 22u32") 22u64
    && (=.)
           (state_receipt_recovered_topology_count_or_max "inl dogfood_recovered_topology_count () : u32 = 22u32")
           22u64
    && (=.) (state_receipt_recovered_topology_count_or_max "no topology count") 18446744073709551615u64
    && (=.)
           (state_receipt_recovered_topology_count_or_max "inl recovered_capability_fixture_count () : u32 = nope")
           18446744073709551615u64

:= recovered_fixture_ledger_ok () : bool =
    := ledger =
        "  // recovered-fixture|cap-a|evidence/a|evidence/b|evidence/c  \n"
        ^^ "// recovered-fixture|cap-b|evidence/d|evidence/e|evidence/f"
    (=.) (state_receipt_recovered_fixture_record_count_or_max ledger) 2u64
    && (=.) (state_receipt_recovered_fixture_paths ledger) """
        evidence/a
        evidence/b
        evidence/c
        evidence/d
        evidence/e
        evidence/f
        """
    && (=.) (state_receipt_recovered_fixture_record_count_or_max "// recovered-fixture|cap-a|a|b|c\n// recovered-fixture|cap-a|d|e|f") 18446744073709551615u64
    && (=.) (state_receipt_recovered_fixture_record_count_or_max "// recovered-fixture|cap-a|a|b|c|extra") 18446744073709551615u64
    && (=.) (state_receipt_recovered_fixture_record_count_or_max "// recovered-fixture|cap-a|a|b|") 18446744073709551615u64

:= main () : i32 =
    ? dash_shape_ok "" 10u64 ?>
        ? dash_shape_ok "a" 10u64 ?>
            ? dash_shape_ok "a-b" 21u64 ?>
                ? dash_shape_ok "a-b-c" 32u64 ?>
                    ? dash_shape_ok "-a-" 32u64 ?>
                        ? dash_shape_ok "a-" 21u64 ?>
                            if migration_payload_ok """
                                prefix
                                inl x () = MigrationDenominator (69u32, 69u32, 1000u32, 987u32)
                                suffix
                                """ "69u32, 69u32, 1000u32, 987u32" then
                                ? migration_payload_ok "no constructor here" "" ?>
                                    ? state_receipt_series_records_valid "" ?>
                                        ? state_receipt_series_records_valid "SeriesRecord (1u32, 69u32, 987u32, \"a\", \"b\", 1u64, \"c\", \"d\", 2u64, \"p\")" ?>
                                            ? (=.) (state_receipt_last_series_record_payload "SeriesRecord (1u32, 69u32, 987u32, \"a\", \"b\", 1u64, \"c\", \"d\", 2u64, \"p\")\nSeriesRecord (2u32, 69u32, 987u32, \"a\", \"b\", 1u64, \"c\", \"d\", 2u64, \"p\")") "2u32, 69u32, 987u32, \"a\", \"b\", 1u64, \"c\", \"d\", 2u64, \"p\"" ?>
                                                ? state_receipt_series_records_valid "SeriesRecord (2u32, 69u32, 987u32)\nSeriesRecord (2u32, 69u32, 987u32)" ?> 12i32
                                                |? state_receipt_series_records_valid "SeriesRecord (2u32, 69u32, 987u32" ?> 13i32
                                                |? coverage_kind_ok "CoverageCheckpointDurable (804u32, \"abc\")" 2u64 ?>
                                                    ? coverage_kind_ok "CoverageCheckpointMissing (804u32, \"missing\", \"reason\")" 1u64 ?>
                                                        ? coverage_kind_ok "no checkpoint" 0u64 ?>
                                                            ? coverage_sha_ok "CoverageCheckpointDurable (804u32, \"abc\")" "abc" ?>
                                                                ? coverage_sha_ok "CoverageCheckpointDurable (804u32, abc)" "" ?>
                                                                    ? recovered_topology_count_ok () ?>
                                                                        ? recovered_fixture_ledger_ok () ?> 0i32 |: 20i32
                                                                    |: 19i32
                                                                |: 18i32
                                                            |: 17i32
                                                        |: 16i32
                                                    |: 15i32
                                                |: 14i32
                                            |: 11i32
                                        |: 10i32
                                    |: 9i32
                                |: 8i32
                            |: 7i32
                        |: 6i32
                    |: 5i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
