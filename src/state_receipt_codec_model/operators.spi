:= (+.) \* t. (a : t) (b : t) : t =
    $'!a + !b '

:= (-.) \* t. (a : t) (b : t) : t =
    $'!a - !b '

:= (*.) \* t. (a : t) (b : t) : t =
    $'!a * !b '

:= (/.) \* t. (a : t) (b : t) : t =
    $'!a / !b '

:= (%.) \* t. (a : t) (b : t) : t =
    $'!a % !b '

:= (=.) \* t. (a : t) (b : t) : bool =
    $'!a == !b '

:= (<) \* t {number}. (a : t) (b : t) : bool =
    a < b

:= (<=) \* t {number}. (a : t) (b : t) : bool =
    a <= b

:= (>) \* t {number}. (a : t) (b : t) : bool =
    a > b

:= (>=) \* t {number}. (a : t) (b : t) : bool =
    a >= b

:! array t = array_base t

:? create ar el : int -> ar el
:? index ar el : ar el -> int -> el
:? set ar el : ar el -> int -> el -> ()
:? length ar el : ar el -> int

:+ create array = \ size => array !!!!ArrayCreate(`el, size)
:+ index array = \ (array ar) i => !!!!ArrayIndex(ar, i)
:+ set array = \ (array ar) i v => !!!!ArrayIndexSet(ar, i, v)
:+ length array = \ (array ar) => !!!!ArrayLength(`int, ar)
