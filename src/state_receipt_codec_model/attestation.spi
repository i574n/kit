:| receipt_attestation_kind =
    | UnknownReceiptAttestation
    | RuntimeReceiptAttestation
    | BuildReceiptAttestation

:= receipt_attestation_kind_code_value = \|
    | UnknownReceiptAttestation => 0u64
    | RuntimeReceiptAttestation => 1u64
    | BuildReceiptAttestation => 2u64

:~ receipt_attestation_kind_code (attestation : string) : u64 =
    ? (=.) attestation "runtime" ?> receipt_attestation_kind_code_value RuntimeReceiptAttestation
    |? starts_with attestation "build:" ?> receipt_attestation_kind_code_value BuildReceiptAttestation
    |: receipt_attestation_kind_code_value UnknownReceiptAttestation

:~ receipt_attestation_build_payload (attestation : string) : string =
    ? (=.) (receipt_attestation_kind_code attestation) 2u64 ?>
        slice_exclusive attestation (sm.length "build:" : i32) (sm.length attestation : i32)
    |: codec_empty ()

:~ receipt_attestation_text (build_fingerprint : string) : string =
    ? (=.) build_fingerprint "" ?> "runtime"
    |: sm.concat "build:" build_fingerprint
