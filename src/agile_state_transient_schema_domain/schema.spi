:| agile_transient_schema_verdict =
    | ValidTransientSchema
    | InvalidTransientSchema

:= agile_transient_schema_verdict_code = \|
    | ValidTransientSchema => 1u64
    | InvalidTransientSchema => 0u64

:~ agile_transient_schema_code (~projection : string) : u64 =
    ? sm'.starts_with "patch_resume.spi\n" projection ?>
        ? sm'.contains "PatchResumeReceipt (" projection
            && sm'.contains "inl main () : i32 = 0i32" projection ?>
            agile_transient_schema_verdict_code ValidTransientSchema
        |:
            agile_transient_schema_verdict_code InvalidTransientSchema
    |? sm'.starts_with "toolchain_process_receipt.spi\n" projection ?>
        ? sm'.contains "\n// toolchain-process-receipt|" projection
            && sm'.contains "ToolchainProcessReceipt (" projection
            && sm'.contains "inl main () : i32 = 0i32" projection ?>
            agile_transient_schema_verdict_code ValidTransientSchema
        |:
            agile_transient_schema_verdict_code InvalidTransientSchema
    |:
        agile_transient_schema_verdict_code InvalidTransientSchema

:~ agile_state_path_candidate_code (~name : string) : u64 =
    agile_state_path_policy.model.state_path_candidate_code name

:= main () : i32 =
    !!!!Export(
        "kit_agile_state_transient_schema_code",
        ((\ value => agile_transient_schema_code value) : string -> u64)
    )
    !!!!Export(
        "kit_agile_state_path_candidate_code",
        ((\ value => agile_state_path_candidate_code value) : string -> u64)
    )
    inl _ = agile_transient_schema_code """
        patch_resume.spi
        PatchResumeReceipt (x)
        inl main () : i32 = 0i32
        """
    inl _ = agile_transient_schema_code """
        toolchain_process_receipt.spi
        // toolchain-process-receipt|ok
        ToolchainProcessReceipt (x)
        inl main () : i32 = 0i32
        """
    inl _ = agile_transient_schema_code """
        toolchain_process_receipt.spi
        ToolchainProcessReceipt (x)
        inl main () : i32 = 0i32
        """
    := _ = agile_state_path_candidate_code "ratings.spi"
    := _ = agile_state_path_candidate_code "typecheck_receipts.spi"
    := _ = agile_state_path_candidate_code "notes.txt"
    0i32
