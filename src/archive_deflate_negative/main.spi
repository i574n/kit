
:| archive_negative_fixture =
    | MissingArchive
    | ExistingDestination
    | UnsafeEntry
    | UnsupportedCompression
    | BudgetExceeded
    | CountMismatch
    | UnsafeTree

:= main () : i32 =
    global "#![allow(clippy::needless_late_init)]"
    := _ = archive_deflate_domain.deflate_extract_plan ()
    := missing_archive = archive_deflate_domain.archive_preflight_binding 0i32 1i32
    := existing_destination = archive_deflate_domain.archive_preflight_binding 1i32 0i32
    := unsafe_entry = archive_deflate_domain.archive_entry_binding 0i32 1i32
    := escaping_tar_symlink = archive_deflate_domain.archive_tar_symlink_binding 0i32 1i32
    := payload_tar_symlink = archive_deflate_domain.archive_tar_symlink_binding 1i32 0i32
    := missing_tar_hardlink = archive_deflate_domain.archive_tar_hardlink_binding 0i32 1i32
    := payload_tar_hardlink = archive_deflate_domain.archive_tar_hardlink_binding 1i32 0i32
    := oversized_tar_long_link = archive_deflate_domain.archive_tar_long_link_binding 0i32 1i32
    := non_utf8_tar_long_link = archive_deflate_domain.archive_tar_long_link_binding 1i32 0i32
    := unsafe_tar_pax_path = archive_deflate_domain.archive_tar_pax_path_binding 0i32 1i32
    := unsupported_tar_pax_record = archive_deflate_domain.archive_tar_pax_path_binding 1i32 0i32
    := unsupported_compression = archive_deflate_domain.archive_compression_binding 1i32 0i32
    := budget_exceeded = archive_deflate_domain.archive_budget_binding 5i32 10i32
    := count_mismatch = archive_deflate_domain.archive_complete_binding 2i32 1i32
    := unsafe_tree = archive_deflate_domain.archive_tree_binding 1i32 0i32
    := unsupported_format = archive_deflate_domain.archive_format_binding 5i32 1i32
    := missing_tool = archive_deflate_domain.archive_format_binding 3i32 0i32
    ? 0i32 < missing_archive ?> 1i32
    |? 0i32 < existing_destination ?> 1i32
    |? 0i32 < unsafe_entry ?> 1i32
    |? 0i32 < escaping_tar_symlink ?> 1i32
    |? 0i32 < payload_tar_symlink ?> 1i32
    |? 0i32 < missing_tar_hardlink ?> 1i32
    |? 0i32 < payload_tar_hardlink ?> 1i32
    |? 0i32 < oversized_tar_long_link ?> 1i32
    |? 0i32 < non_utf8_tar_long_link ?> 1i32
    |? 0i32 < unsafe_tar_pax_path ?> 1i32
    |? 0i32 < unsupported_tar_pax_record ?> 1i32
    |? 0i32 < unsupported_compression ?> 1i32
    |? 0i32 < budget_exceeded ?> 1i32
    |? 0i32 < count_mismatch ?> 1i32
    |? 0i32 < unsafe_tree ?> 1i32
    |? 0i32 < unsupported_format ?> 1i32
    |? 0i32 < missing_tool ?> 1i32
    |: 0i32
