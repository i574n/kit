open sm'_operators
open eoie_jobs.model
open eoie_jobs.host
open eoie_jobs.jobs
open eoie_job_launch_model.shapes


inl after_receipt (~mode : string) (~other : string) : string = if mode = "" then "" else " after=" ++# other ++# " after_mode=" ++# mode

union launch =
    | Launched : string * string
    | LaunchRefused : string

let job_launched (shape : start_shape) (~after_mode : string) (~after_job : string) (attached : bool) (~cap_mb : u64) (~slot_minutes : u64) (~done_minutes : u64) (~hold_minutes : u64) (~quiet_wait : u64) (~min_free : u64) (~label : string) (~timeout : u64) (~inner : string) (~cwd : string) : launch =
    inl word = shape_word shape
    inl id, supervisor, problem =
        $'eoie_job_create::eoie_job_create(&*!word, &*!after_mode, &*!after_job, !attached, !cap_mb, !slot_minutes, !done_minutes, !hold_minutes, !quiet_wait, !min_free, &*!label, !timeout, &*!inner, &*!cwd)' : string * string * string
    if problem <> "" then LaunchRefused problem else Launched (id, supervisor)
inl supervised_job (~id : string) : i32 = $'eoie_job_supervise::eoie_job_supervise(&*!id)' : i32

union start_settle =
    | SettleHealthy
    | SettleFailed : i32 * string

let rec settled_within (~id : string) (~left_ms : u64) : job_state =
    inl state = shared_state id
    match state with
    | Live _ =>
        if left_ms = 0u64 then state
        else
            sleep_ms 100u64
            settled_within id (if left_ms < 100u64 then 0u64 else left_ms - 100u64)
    | Settled _ => state

inl first_line_of (~text : string) : string =
    inl cut = sm'.index_of "\n" text
    sm'.trim (if cut < 0i32 then text else sm'.substring 0i32 cut text)

let start_settle_of (~id : string) (~settle_ms : u64) : start_settle =
    match settled_within id settle_ms with
    | Settled (JobFinished code) => if code = 0i32 then SettleHealthy else SettleFailed (code, first_line_of (text_or_empty (job_file id "stderr.log")))
    | Settled (JobSpawnFailed problem) => SettleFailed (127i32, problem)
    | Settled (JobLost) => SettleFailed (125i32, "the supervisor ended before the job settled")
    | _ => SettleHealthy

let job_started (attached : bool) : i32 * string =
    inl ok, problem, shape_text, after_mode, after_job, cap_mb, slot_minutes, done_minutes, hold_minutes, quiet_wait, min_free, settle_ms, first, timeout =
        $'eoie_job_start_args::eoie_job_start_args()' : bool * string * string * string * string * u64 * u64 * u64 * u64 * u64 * u64 * u64 * i32 * u64
    if ok |> not then rejected problem, ""
    else
        inl shape = shape_of_word shape_text
        inl label = argument first
        match job_launched shape after_mode after_job attached cap_mb slot_minutes done_minutes hold_minutes quiet_wait min_free label timeout (arguments_from (first + 2i32)) (current_directory ()) with
        | LaunchRefused refused_problem => rejected refused_problem, ""
        | Launched (id, supervisor) =>
            inl settles = attached = false && after_mode = "" && shape = PlainStart && settle_ms > 0u64
            match (if settles then start_settle_of id settle_ms else SettleHealthy) with
            | SettleFailed (code, detail) =>
                stderr_line ("eoie job start failed id=" ++# id ++# " exit=" ++# sm'.format code ++# " stderr=" ++# detail)
                (code, id)
            | SettleHealthy =>
                stdout_line ((if attached then "eoie job run started id=" else "eoie job start ok id=") ++# id ++# " supervisor_pid=" ++# supervisor ++# (" timeout_ms=" ++# (decimal_text timeout) ++# " gate=" ++# (shape_word shape) ++# (" label=" ++# label ++# (after_receipt after_mode after_job) ++# (if cap_mb = 0u64 then "" else " max_private_mb=" ++# (decimal_text cap_mb)) ++# ((if slot_minutes = 0u64 then "" else " slot_within_min=" ++# (decimal_text slot_minutes)) ++# (if done_minutes = 0u64 then "" else " done_within_min=" ++# (decimal_text done_minutes)) ++# (if hold_minutes = 0u64 then "" else " quiet_hold_min=" ++# (decimal_text hold_minutes) ++# " quiet_wait_min=" ++# (decimal_text quiet_wait))))))
                if attached then (supervised_job id, id) else (0i32, id)
let started_text (attached : bool) : string =
    inl code, id = job_started attached
    ($'std::rc::Rc::<str>::from((!code).to_string().as_str())' : string) ++# "\t" ++# id

inl record_mark () : string = $'std::rc::Rc::<str>::from(char::from(30u8).to_string())' : string

let launched_text (~label : string) (~timeout : u64) (~inner : string) (~cwd : string) : string =
    match job_launched PlainStart "" "" false 0u64 0u64 0u64 0u64 0u64 0u64 label timeout inner cwd with
    | Launched (id, supervisor) => id ++# (record_mark ()) ++# supervisor
    | LaunchRefused problem => "error: " ++# problem

inl main () : i32 =
    !!!!Export("eoie_job_start", ((fun attached => started_text attached) : bool -> string))
    !!!!Export("eoie_job_launched_text", ((fun (label, timeout, inner, cwd) => launched_text label timeout inner cwd) : string * u64 * string * string -> string))
    0i32
