:< source_recovery_contract.model

:= main () : i32 =
    ?= source_recovery_provenance_binding 1i32 1i32 ?|
    | 0 =>
        ?= source_recovery_provenance_binding 2i32 0i32 ?|
        | 0 =>
            ?= source_recovery_warning_binding 6i32 5i32 ?|
            | 0 => 0i32
            | _ => 1i32
        | _ => 1i32
    | _ => 1i32
