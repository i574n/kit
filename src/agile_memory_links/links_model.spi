///- --package .
:# links_model static =
    :< sm'_operators

:< sm'_operators

:| memory_kind =
    | UserMemory
    | FeedbackMemory
    | ProjectMemory
    | ReferenceMemory
    | UntypedMemory

:| citation =
    | CitesOpen
    | CitesDone
    | CitesMissing

:| link_finding =
    | NoFinding
    | DanglingId : string * string
    | DoneCited : string * string
    | UnwrittenLink : string * string
    | UnknownMemory : string * string

:= memory_kind_of (~word : string) : memory_kind =
    ? word = "user" ?> UserMemory
    |? word = "feedback" ?> FeedbackMemory
    |? word = "project" ?> ProjectMemory
    |? word = "reference" ?> ReferenceMemory
    |: UntypedMemory

:= citation_of (~status : string) : citation =
    ? status = "" ?> CitesMissing
    |? status = "Done" ?> CitesDone
    |: CitesOpen

:= rule_bearing = \|
    | FeedbackMemory => !+
    | ProjectMemory => !+
    | _ => !-

:= id_finding (kind : memory_kind) (~slug : string) (~id : string) (~status : string) : link_finding =
    ?= citation_of status ?|
    | CitesMissing => DanglingId (slug, id)
    | CitesDone => ? rule_bearing kind ?> DoneCited (slug, id) |: NoFinding
    | CitesOpen => NoFinding

:= link_finding_of (~names : string) (~slug : string) (~target : string) : link_finding =
    ? sm'.listed "|" target names ?> NoFinding |: UnwrittenLink (slug, target)

:= hyphen_count (~slug : string) : i32 = $'(!slug).matches(char::from(45u8)).count() as i32' : i32

:= memory_cite_finding (~names : string) (~id : string) (~slug : string) : link_finding =
    ? sm'.listed "|" slug names ?> NoFinding
    |? hyphen_count slug >= 2i32 ?> UnknownMemory (id, slug)
    |: NoFinding

:= finding_word = \|
    | NoFinding => ""
    | DanglingId _ => "dangling"
    | DoneCited _ => "done"
    | UnwrittenLink _ => "unwritten-link"
    | UnknownMemory _ => "unknown-memory"

:= finding_text = function
    | NoFinding => ""
    | DanglingId (slug, id) => "dangling  " ++# slug ++# "  " ++# id ++# "  no backlog item with this id\n"
    | DoneCited (slug, id) =>
        "done  " ++# slug ++# "  " ++# id ++# "  the item is Done; check that the rule still holds\n"
    | UnwrittenLink (slug, target) =>
        "unwritten-link  " ++# slug ++# "  [[" ++# target ++# "]]  no memory with this name yet\n"
    | UnknownMemory (id, slug) =>
        "unknown-memory  " ++# id ++# "  " ++# slug ++# "  a backlog note cites this memory, which does not exist\n"

:= gating = \|
    | DanglingId _ => !+
    | _ => !-


///> rust
:# citations_report_missing_ids_and_done_items_only_in_rule_memories =
    testing.expect (finding_text (id_finding FeedbackMemory "no-sleep" "KIT-JOBS" "Active") = "") "open item"
    testing.expect
        (
            finding_text (id_finding ProjectMemory "lanes" "KIT-GONE" "")
            = "dangling  lanes  KIT-GONE  no backlog item with this id\n"
        )
        "missing"
    testing.expect
        (
            finding_text (id_finding FeedbackMemory "rule" "OLD-ONE" "Done")
            = "done  rule  OLD-ONE  the item is Done; check that the rule still holds\n"
        )
        "done in a rule"
    testing.expect (finding_text (id_finding ReferenceMemory "pointer" "OLD-ONE" "Done") = "") "references may cite history"
    testing.expect (gating (id_finding UserMemory "me" "NEW-ONE" "")) "a dangling id gates"

///> rust
:# wiki_links_resolve_against_memory_names =
    testing.expect (finding_text (link_finding_of "kit-first|no-sleep-polling" "rule" "kit-first") = "") "known"
    testing.expect
        (
            finding_text (link_finding_of "kit-first" "rule" "kit-last")
            = "unwritten-link  rule  [[kit-last]]  no memory with this name yet\n"
        )
        "unwritten"
    testing.expect (finding_word (link_finding_of "kit-first" "rule" "x") = "unwritten-link") "word"
    testing.expect (memory_kind_of "feedback" = FeedbackMemory) "kind"
    testing.expect
        (finding_text (memory_cite_finding "no-sleep-polling" "KIT-X" "no-sleep-polling") = "")
        "a cited memory that exists"
    testing.expect
        (finding_word (memory_cite_finding "no-sleep-polling" "KIT-X" "gone-old-rule") = "unknown-memory")
        "a cited memory that does not exist"
    testing.expect (finding_text (memory_cite_finding "no-sleep-polling" "KIT-X" "re-measure") = "") "one hyphen reads as prose"
