:= export_restoration_payload_identity () : () =
    !!!!Export(
        "kit_patch_restoration_payload_identity",
        ((\ (first, second) => restoration_payload_identity first second) : i32 * i32 -> i32)
    )

:= export_restoration_payload_slot_binding () : () =
    !!!!Export(
        "kit_patch_restoration_payload_slot_binding",
        ((\ (first, second) => restoration_payload_slot_binding first second) : i32 * i32 -> i32)
    )

:= export_restoration_payload_outcome_binding () : () =
    !!!!Export(
        "kit_patch_restoration_payload_outcome_binding",
        ((\ (first, second) => restoration_payload_outcome_binding first second) : i32 * i32 -> i32)
    )

:= main () : i32 =
    := _ = native_patch_control_plan ()
    := _ = restoration_attempt_witness RestorationSucceeded
    := _ = restoration_attempt_witness RestorationFailed
    := _ = restoration_payload_identity 0i32 0i32
    := _ = restoration_payload_slot_binding 0i32 1i32
    := _ = restoration_payload_outcome_binding 0i32 1i32
    export_restoration_payload_identity ()
    export_restoration_payload_slot_binding ()
    export_restoration_payload_outcome_binding ()
    !!!!Export("kit_patch_plan_failure_message", ((\ code => patch_plan_failure_binding code) : i32 -> string))
    emit_runtime ()

    0i32
