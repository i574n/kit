:! topology_raw = ()
:! topology_partitioned = ()
:! cargo_growth_checked = ()
:! cargo_growth_authorized = ()

:| package_authority =
    | CargoOwned
    | SpiralOnlyOwned
    | OwnershipOnly

:| cargo_growth_exception =
    | NoCargoGrowthException
    | JustifiedCargoGrowth :: string * string -> cargo_growth_exception

:| owner_growth_disposition =
    | OwnerShrinkOrEqual
    | OwnerGrowthCompensated :: string * string -> owner_growth_disposition
    | OwnerGrowthRejected

:| cargo_growth_op from to =
    | PartitionSourcePackages :: cargo_growth_op topology_raw topology_partitioned
    | CheckCargoGrowth :: cargo_growth_op topology_partitioned cargo_growth_checked
    | AuthorizeCargoGrowth :: cargo_growth_op cargo_growth_checked cargo_growth_authorized

:| ^ cargo_growth_plan from to =
    | CargoGrowthStep :: \* from to. cargo_growth_op from to -> cargo_growth_plan from to
    | CargoGrowthThen :: \* from to.
        (\? middle. cargo_growth_plan from middle * cargo_growth_plan middle to) ->
        cargo_growth_plan from to

:= baseline_cargo_crates () : u32 = 74u32

:= current_plan () : cargo_growth_plan topology_raw cargo_growth_authorized =
    CargoGrowthThen (\? (
        CargoGrowthStep PartitionSourcePackages,
        CargoGrowthThen (\? (
            CargoGrowthStep CheckCargoGrowth,
            CargoGrowthStep AuthorizeCargoGrowth
        ))
    ))
