:< rust_std_fs.model
:< sm'_operators
:< agile_task_text.model
:< agile_note_model.model
:< workspace_primitives.bytes
:< workspace_primitives.console
:< workspace_primitives.files

:= argument_owned index : string = rust_std_env.model.argument_owned index
:= concat5 (~a : string) (~b : string) (~c : string) (~d : string) (~e : string) : string = a ++# b ++# c ++# d ++# e

:| view_verb =
    | ViewList
    | ViewNext

:= view_verb_word = \|
    | ViewList => "list"
    | ViewNext => "next"

:| view_verb_parse =
    | VerbRead : view_verb
    | VerbRefused

:= view_verb_of (~word : string) : view_verb_parse =
    union_reflection.cases.union_case_where
        \ (verb : view_verb) => view_verb_word verb = word
        \ verb => VerbRead verb
        VerbRefused

:= view_verb_words () : string = union_reflection.cases.union_cases_joined view_verb_word "|"

:== saved_view =
    {
        name : string
        verb : string
        flags : string
    }

:== views_file =
    {
        existed : bool
        text : string
    }

:= views_path (~root : string) : string = concat5 root "/state/views.spi" "" "" ""
:= package_path (~root : string) : string = concat5 root "/state/package.spiproj" "" "" ""
:= modules_header () : string = "modules:\n"
:= views_module () : string = "    views\n"
:= views_module_listed (~text : string) : bool =
    sm'.contains (concat5 "\n" (views_module ()) "" "" "") text || sm'.ends_with "\n    views" text
:= view_schema () : string = "union agile_view =\n    | View :: string * string * string -> agile_view\n"
:= view_constructor () : string = "View ("
:= view_needle () : string = concat5 (view_constructor ()) "\"" "" "" ""
:= view_anchor (~name : string) : string = concat5 (view_constructor ()) (spi_quoted name) "," "" ""
:= view_binding (~name : string) : string = concat5 "view_" (sm'.replace "-" "_" name) "" "" ""

:= view_row (view : saved_view) : string =
    := head = concat5 "inl " (view_binding view.name) " () = View (" (spi_quoted view.name) ", "
    concat5 head (spi_quoted view.verb) ", " (spi_quoted view.flags) ")"

:= view_field (text : string) (found : i32) (position : i32) : string =
    unquoted (tuple_field text (found + byte_len (view_constructor ())) (byte_len text) position)

:~ view_at (text : string) (found : i32) : saved_view =
    { name = view_field text found 0i32; verb = view_field text found 1i32; flags = view_field text found 2i32 }

:~ views_loaded (~root : string) : views_file =
    ?= probe (unchecked (views_path root)) ?|
    | FileMissing _ => { existed = !-; text = "" }
    | FileReadable file => { existed = !+; text = loaded_string (read_text file) }

:~ views_written (~path : string) (loaded : views_file) (~updated : string) : state_write =
    := unchanged = ? loaded.existed ?> text_equals loaded.text path |? file_exists path ?> !- |: !+
    ? unchanged ?>
        ?= replace_file_checked path updated ?|
        | Replaced => StateWritten
        | problem => StateWriteFailed (file_replacement_problem problem)
    |: StateChangedSinceRead

:~ views_module_registered (~root : string) : state_write =
    := path = package_path root
    ?= probe (unchecked path) ?|
    | FileMissing _ => StateWritten
    | FileReadable file =>
        := text = loaded_string (read_text file)
        ? views_module_listed text
        ?> StateWritten
        |? sm'.contains (modules_header ()) text
        ?>
            ?=
                replace_file_checked path (
                    sm'.replace (modules_header ()) (concat5 (modules_header ()) (views_module ()) "" "" "") text
                )
            ?|
            | Replaced => StateWritten
            | problem => StateWriteFailed (file_replacement_problem problem)
        |: StateWriteFailed "state/package.spiproj has no modules section to list views in"

:= view_name_valid (~name : string) : bool =
    $'\!(!name).is_empty() && (!name).bytes().all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte \
        == 45u8)' : bool

:= flags_from (skip : i32) : string = $'std::rc::Rc::<str>::from(std::env::args().skip(!skip as \
    usize).collect::<Vec<_>>().join(" ").as_str())' : string
:= flags_single_words (skip : i32) : bool = $'std::env::args().skip(!skip as usize).all(|argument| \
    \!argument.is_empty() && \!argument.contains(char::is_whitespace))' : bool

:= view_spawned (~verb : string) (~root : string) (~flags : string) (skip : i32) : i32 =
    $'{ let extra = std::env::args().skip(!skip as usize).collect::<Vec<_>>(); \
        match std::env::current_exe().and_then(|exe| std::process::Command::new(exe).arg("agile").arg(&*!verb).arg(&*!root\
        ).args((!flags).split_whitespace()).args(&extra).status()) { Ok(status) => status.code().unwrap_or(1), \
        Err(error) => { eprintln\!("kit error: agile view could not start: {}", error); 2 } } }'
    : i32

:~ ^ views_listed (text : string) (offset : i32) (count : i32) : i32 =
    := found = declared_from text (view_needle ()) offset
    ? found < 0i32 ?> count
    |:
        := view = view_at text found
        := _ = stdout_line (concat5 view.name "  " view.verb "  " view.flags)
        views_listed text (found + 1i32) (count + 1i32)

:~ views_run () : i32 =
    := root = argument_owned 1i32
    := loaded = views_loaded root
    := count = views_listed loaded.text 0i32 0i32
    stdout_line (
        concat5
            "kit agile views ok views="
            ($'std::rc::Rc::<str>::from((!count).to_string().as_str())' : string)
            " path="
            (views_path root)
            ""
    )

:~ view_run () : i32 =
    := root = argument_owned 1i32
    := name = argument_owned 2i32
    ? name = ""
    ?> stderr_failure "usage: agile view <root> <name> [extra flags...]"
    |:
        := loaded = views_loaded root
        := found = declared_from loaded.text (view_anchor name) 0i32
        ? found < 0i32
        ?>
            stderr_failure (
                concat5 "agile view: no view named " name " in " (views_path root) "; agile views <root> lists them"
            )
        |:
            := view = view_at loaded.text found
            view_spawned view.verb root view.flags 5i32

:= line_replaced (text : string) (found : i32) (~row : string) : string =
    := start = line_start_before text found
    := stop = line_end_after text found
    concat5 (byte_slice text 0i32 start) row (byte_slice text stop (byte_len text)) "" ""

:= view_appended (text : string) (~row : string) : string =
    := base = ? text = "" ?> view_schema () |: text
    concat5 base (? sm'.ends_with "\n" base ?> "" |: "\n") row "\n" ""

:~ view_stored (~root : string) (view : saved_view) : i32 =
    := loaded = views_loaded root
    := found = declared_from loaded.text (view_anchor view.name) 0i32
    := replaced = ? found < 0i32 ?> !- |: !+
    := updated =
        ? replaced ?> line_replaced loaded.text found (view_row view) |: view_appended loaded.text (view_row view)
    := written =
        ?= views_written (views_path root) loaded updated ?|
        | StateWritten => views_module_registered root
        | problem => problem
    ?= written ?|
    | StateWritten =>
        := detail = concat5 " verb=" view.verb " flags='" view.flags "'"
        stdout_line (
            concat5 "kit agile view-add ok name=" view.name detail (? replaced ?> " replaced=yes" |: " replaced=no") ""
        )
    | problem => stderr_failure (concat5 "agile view-add " view.name " rejected: " (state_write_problem problem) "")

:~ view_add_run () : i32 =
    := root = argument_owned 1i32
    := name = argument_owned 2i32
    ? view_name_valid name
    ?>
        ?= view_verb_of (argument_owned 3i32) ?|
        | VerbRefused => stderr_failure (concat5 "agile view-add: view verbs are " (view_verb_words ()) "" "" "")
        | VerbRead verb =>
            ? flags_single_words 6i32
            ?> view_stored root { name = name; verb = view_verb_word verb; flags = flags_from 6i32 }
            |: stderr_failure "agile view-add: each stored flag must be one word without spaces"
    |: stderr_failure "agile view-add: view names are lowercase letters, digits and hyphens"

:| view_command =
    | ViewsCommand
    | ViewCommand
    | ViewAddCommand

:= view_command_word = \|
    | ViewsCommand => "views"
    | ViewCommand => "view"
    | ViewAddCommand => "view-add"

:| view_command_parse =
    | CommandRead : view_command
    | CommandUnknown

:= view_command_of (~word : string) : view_command_parse =
    union_reflection.cases.union_case_where
        \ (command : view_command) => view_command_word command = word
        \ command => CommandRead command
        CommandUnknown

:= view_command_run = \|
    | ViewsCommand => views_run ()
    | ViewCommand => view_run ()
    | ViewAddCommand => view_add_run ()

:~ views_entry () : i32 =
    ?= view_command_of (argument_owned 0i32) ?|
    | CommandRead command => view_command_run command
    | CommandUnknown => stderr_failure "agile views: expected views, view or view-add"

:= main () : i32 =
    !!!!Export("kit_agile_views_run", ((\ () => views_entry ()) : () -> i32))
    0i32
