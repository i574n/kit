:< binary_install_contract.bindings
:< release_closeout_contract.bindings

:! handoff_idle = ()
:! handoff_loaded = ()
:! handoff_rendered = ()

:| handoff_op from to =
    | LoadTypedHandoff :: handoff_op handoff_idle handoff_loaded
    | RenderReadableHandoff :: handoff_op handoff_loaded handoff_rendered

:| ^ handoff_plan from to =
    | HandoffStep :: \* from to. handoff_op from to -> handoff_plan from to
    | HandoffThen :: \* from to. (\? middle. handoff_plan from middle * handoff_plan middle to) -> handoff_plan from to

:= readable_handoff () : handoff_plan handoff_idle handoff_rendered =
    HandoffThen (\? (HandoffStep LoadTypedHandoff, HandoffStep RenderReadableHandoff))

:= main () : i32 =
    binary_install_terminal.emit_runtime ()
    release_closeout_terminal.emit_runtime ()
    := _ = binary_install_shape_binding 1i32 1i32
    := _ = binary_install_source_binding 1i32 3i32
    := _ = binary_install_freshness_binding 1i32 1i32
    := _ = binary_install_running_destination_binding 0i32 1i32
    := _ = binary_install_permission_binding 1i32 1i32
    := _ = binary_install_mode_binding 1i32 7i32
    := _ = binary_install_commit_binding 1i32 7i32
    := _ = release_closeout_shape_binding 63i32 6i32
    := _ = release_closeout_migration_binding 259i32 259i32
    := _ = release_closeout_evidence_binding 7i32 7i32
    := _ = release_closeout_mode_binding 1i32 3i32
    := _ = release_closeout_commit_binding 7i32 7i32
    := _ = release_closeout_refresh_binding 127i32 127i32
    !!!!Export(
        "kit_handoff_binary_install_shape_binding",
        ((\ (first, second) => binary_install_shape_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_binary_install_source_binding",
        ((\ (first, second) => binary_install_source_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_binary_install_freshness_binding",
        ((\ (first, second) => binary_install_freshness_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_binary_install_running_destination_binding",
        ((\ (first, second) => binary_install_running_destination_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_binary_install_permission_binding",
        ((\ (first, second) => binary_install_permission_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_binary_install_mode_binding",
        ((\ (first, second) => binary_install_mode_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_binary_install_commit_binding",
        ((\ (first, second) => binary_install_commit_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_release_closeout_shape_binding",
        ((\ (first, second) => release_closeout_shape_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_release_closeout_migration_binding",
        ((\ (first, second) => release_closeout_migration_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_release_closeout_evidence_binding",
        ((\ (first, second) => release_closeout_evidence_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_release_closeout_mode_binding",
        ((\ (first, second) => release_closeout_mode_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_release_closeout_commit_binding",
        ((\ (first, second) => release_closeout_commit_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_handoff_release_closeout_refresh_binding",
        ((\ (first, second) => release_closeout_refresh_binding first second) : i32 * i32 -> i32)
    )
    := _ = readable_handoff ()
    0i32
