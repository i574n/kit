:< rust_std_string.model

:~ argument (~index : i32) : string = optionm'.default_value "" (env.try_command_line_argument (index - 1i32))
:= option_value (~name : string) : string = $'std::rc::Rc::<str>::from({ let args = \
    std::env::args().collect::<Vec<_>>(); args.iter().position(|argument| argument == &*!name).and_then(|at| \
    args.get(at + 1)).cloned().unwrap_or_default() }.as_str())' : string
:= stdout_line (~text : string) : () = console.write_line text
:= stderr_line (~text : string) : () = console.write_error_line text
:= exact_text (~path : string) : string = $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_defaul\
    t().as_str())' : string
:~ file_present (~path : string) : bool =
    file_system.path_buf_is_file (file_system.new_path_buf (sm'.to_std_string path))
:= text_written (~path : string) (~text : string) : bool = $'{ let path = std::path::Path::new(&*!path); \
    let _ = path.parent().map(std::fs::create_dir_all); std::fs::write(path, (!text).as_bytes()).is_ok() }' : bool
:= markdown_names (~dir : string) : string = $'std::rc::Rc::<str>::from({ let mut names = \
    std::fs::read_dir(&*!dir).map(|entries| entries.filter_map(|entry| entry.ok()).map(|entry| \
    entry.file_name().to_string_lossy().into_owned()).filter(|name| name.ends_with(".md") && name \!= \
    "MEMORY.md").collect::<Vec<_>>()).unwrap_or_default(); names.sort(); names.join("\n") }.as_str())' : string
:= path_joined (~dir : string) (~name : string) : string = $'std::rc::Rc::<str>::from(std::path::Path::new(&*!dir).joi\
    n(&*!name).to_string_lossy().as_ref())' : string
:= count_text (value : i32) : string = (sm'.show value)
:= text_length (~text : string) : i32 = sm'.length text
:= byte_at (~text : string) (index : i32) : i32 = $'(!text).as_bytes().get(!index as usize).map(|byte| *byte as \
    i32).unwrap_or(-1)' : i32
:= text_between (~text : string) (start : i32) (stop : i32) : string = $'std::rc::Rc::<str>::from((!text).get(!start \
    as usize..!stop as usize).unwrap_or(""))' : string
:= index_of (~text : string) (~needle : string) (from : i32) : i32 = $'(!text).get(!from as usize..).and_then(|rest| \
    rest.find(&*!needle)).map(|at| at as i32 + !from).unwrap_or(-1)' : i32
:= line_value (~front : string) (~key : string) : string = $'std::rc::Rc::<str>::from((!front).lines().find_map(|line| \
    line.strip_prefix(&*!key)).unwrap_or(""))' : string
:= first_line (~lines : string) : string = $'std::rc::Rc::<str>::from((!lines).split(char::from(10u8)).next().unwrap_o\
    r(""))' : string
:= rest_lines (~lines : string) : string = $'std::rc::Rc::<str>::from((!lines).split_once(char::from(10u8)).map(|(_, \
    rest)| rest).unwrap_or(""))' : string
:= ascii_lowercase (~text : string) : string =
    $'std::rc::Rc::<str>::from((!text).to_ascii_lowercase().as_str())' : string
:= text_before (~left : string) (~right : string) : bool = $'!left < !right' : bool
:= clipped (~text : string) (width : i32) : string = $'{ let text = !text; if text.chars().count() <= !width as usize \
    { text } else { std::rc::Rc::<str>::from(text.chars().take((!width as \
    usize).saturating_sub(3)).collect::<String>() + "...") } }' : string

:| memory_kind =
    | KindUser
    | KindFeedback
    | KindProject
    | KindReference

:= kind_case (kind : memory_kind) : string = union_reflection.cases.union_case_suffix "Kind" kind
:= kind_word (kind : memory_kind) : string = ascii_lowercase (kind_case kind)

:| kind_parse =
    | KindKnown : memory_kind
    | KindUnknown

:~ kind_of_word (~word : string) : kind_parse =
    union_reflection.cases.union_case_where
        \ (kind : memory_kind) => word = kind_word kind
        \ kind => KindKnown kind
        KindUnknown

:~ kind_of_case (~word : string) : kind_parse =
    union_reflection.cases.union_case_where
        \ (kind : memory_kind) => word = kind_case kind
        \ kind => KindKnown kind
        KindUnknown

:= needs_reasons (kind : memory_kind) : bool =
    ?= kind ?|
    | KindFeedback => !+
    | KindProject => !+
    | _ => !-

:== memory_entry =
    {
        file : string
        slug : string
        description : string
        kind : memory_kind
        node_type : string
        origin : string
        modified : string
        body : string
    }

:| ^ memory_list =
    | NoMemories
    | MemoryThen : memory_entry * memory_list

:~ ^ memories_flipped (list : memory_list) (acc : memory_list) : memory_list =
    ?= list ?|
    | NoMemories => acc
    | MemoryThen (entry, rest) => memories_flipped rest (MemoryThen (entry, acc))

:= meta_line (~key : string) (~value : string) : string = ? value = "" ?> "" |: concat5 "  " key ": " value "\n"

:~ rendered (entry : memory_entry) : string =
    := head = concat5 "---\nname: " entry.slug "\ndescription: " entry.description "\nmetadata:\n"
    := meta =
        concat5
            (meta_line "node_type" entry.node_type)
            (meta_line "type" (kind_word entry.kind))
            (meta_line "originSessionId" entry.origin)
            (meta_line "modified" entry.modified)
            ""
    concat5 head meta "---\n" entry.body ""

:| entry_read =
    | EntryRead : memory_entry
    | EntryRefused : string

:~ entry_of_file (~dir : string) (~name : string) : entry_read =
    := text = exact_text (path_joined dir name)
    := close = index_of text "\n---\n" 3i32
    ? starts_with text "---\n" = !- || close < 0i32
    ?> EntryRefused (concat5 name ": no frontmatter" "" "" "")
    |:
        := front = text_between text 4i32 (close + 1i32)
        ?= kind_of_word (line_value front "  type: ") ?|
        | KindUnknown => EntryRefused (concat5 name ": unknown metadata type " (line_value front "  type: ") "" "")
        | KindKnown kind =>
            := entry =
                {
                    file = name
                    slug = line_value front "name: "
                    description = line_value front "description: "
                    kind = kind
                    node_type = line_value front "  node_type: "
                    origin = line_value front "  originSessionId: "
                    modified = line_value front "  modified: "
                    body = text_between text (close + 5i32) (text_length text)
                }
            ? rendered entry = text
            ?> EntryRead entry
            |: EntryRefused (concat5 name ": does not render back byte-identical" "" "" "")

:== import_tally =
    {
        memories : memory_list
        count : i32
        refused : string
    }

:~ ^ entries_from (~dir : string) (~names : string) (tally : import_tally) : import_tally =
    ? names = ""
    ?> tally
    |:
        := name = first_line names
        ?= entry_of_file dir name ?|
        | EntryRead entry =>
            entries_from dir (rest_lines names) { tally ?|
                memories = MemoryThen (entry, tally.memories)
                count = tally.count + 1i32
            }
        | EntryRefused reason =>
            entries_from dir (rest_lines names) { tally ?|
                refused = ? tally.refused = "" ?> reason |: concat5 tally.refused "\n" reason "" ""
            }

:= escaped (~text : string) : string =
    replace (replace (replace (replace (replace text "\\" "\\\\") "\"" "\\\"") "\n" "\\n") "\r" "\\r") "\t" "\\t"
:= quoted (~text : string) : string = concat5 "\"" (escaped text) "\"" "" ""
:= binding_of (~slug : string) : string = concat5 "memory_" (replace (replace slug "-" "_") "." "_") "" "" ""

:~ memory_line (entry : memory_entry) : string =
    := head = concat5 "inl " (binding_of entry.slug) " () = Memory (" (kind_case entry.kind) ", "
    := fields = concat5 (quoted entry.file) ", " (quoted entry.slug) ", " (quoted entry.description)
    := meta = concat5 ", " (quoted entry.node_type) ", " (quoted entry.origin) ", "
    concat5 head fields meta (concat5 (quoted entry.modified) ", " (quoted entry.body) ")\n" "") ""

:~ ^ memory_lines (list : memory_list) (~acc : string) : string =
    ?= list ?|
    | NoMemories => acc
    | MemoryThen (entry, rest) => memory_lines rest (concat5 acc (memory_line entry) "" "" "")

:= index_marker () : string = "inl index_of_memory () = MemoryIndex ("

:= schema () : string =
    := cases =
        union_reflection.cases.union_cases_joined
            \ (kind : memory_kind) => !!!!StaticStringConcat("    | ", kind_case kind)
            "\n"
    concat5
        "union memory_kind =\n"
        cases
        (
            "\n\nunion memory_item =\n    | Memory :: memory_kind * string * string * string * string * string * "
            ^^ "string * string -> memory_item\n    | MemoryIndex :: string -> memory_item\n\n"
        )
        ""
        ""

:~ data_text (list : memory_list) (~index : string) : string =
    concat5 (schema ()) (memory_lines list "") (index_marker ()) (quoted index) ")\n\ninl main () : i32 = 0i32\n"

:~ ^ unescaped_from (~text : string) (index : i32) (start : i32) (~acc : string) : string * i32 =
    := byte = byte_at text index
    ? byte < 0i32 || byte = 34i32 ?> concat5 acc (text_between text start index) "" "" "", index + 1i32
    |? byte = 92i32 ?>
        := next = byte_at text (index + 1i32)
        := taken = concat5 acc (text_between text start index) "" "" ""
        ? next = 110i32 ?> unescaped_from text (index + 2i32) (index + 2i32) (concat5 taken "\n" "" "" "")
        |? next = 114i32 ?> unescaped_from text (index + 2i32) (index + 2i32) (concat5 taken "\r" "" "" "")
        |? next = 116i32 ?> unescaped_from text (index + 2i32) (index + 2i32) (concat5 taken "\t" "" "" "")
        |: unescaped_from text (index + 2i32) (index + 1i32) taken
    |: unescaped_from text (index + 1i32) start acc

:~ quoted_at (~line : string) (index : i32) : string * i32 =
    := opening = ? index < 0i32 ?> -1i32 |: index_of line "\"" index
    ? opening < 0i32 ?> "", -1i32 |: unescaped_from line (opening + 1i32) (opening + 1i32) ""

:~ entry_of_line (~line : string) : entry_read =
    := start = index_of line "= Memory (" 0i32 + 10i32
    := comma = index_of line "," start
    ?= kind_of_case (text_between line start comma) ?|
    | KindUnknown => EntryRefused (concat5 "unknown memory kind in: " (clipped line 80i32) "" "" "")
    | KindKnown kind =>
        := file, a = quoted_at line comma
        := slug, b = quoted_at line a
        := description, c = quoted_at line b
        := node_type, d = quoted_at line c
        := origin, e = quoted_at line d
        := modified, f = quoted_at line e
        := body, g = quoted_at line f
        ? g < 0i32
        ?> EntryRefused (concat5 "malformed memory line: " (clipped line 80i32) "" "" "")
        |:
            EntryRead {
                file = file
                slug = slug
                description = description
                kind = kind
                node_type = node_type
                origin = origin
                modified = modified
                body = body
            }

:== memory_store =
    {
        memories : memory_list
        count : i32
        index : string
        problems : string
    }

:~ ^ store_from (~text : string) (offset : i32) (store : memory_store) : memory_store =
    ? offset >= text_length text
    ?> { store ?| memories = memories_flipped store.memories NoMemories }
    |:
        := stop = index_of text "\n" offset
        := stop = ? stop < 0i32 ?> text_length text |: stop
        := line = text_between text offset stop
        := next =
            ? starts_with line "inl memory_" && contains line "= Memory ("
            ?>
                ?= entry_of_line line ?|
                | EntryRead entry =>
                    { store ?| memories = MemoryThen (entry, store.memories); count = store.count + 1i32 }
                | EntryRefused reason => { store ?| problems = concat5 store.problems reason "\n" "" "" }
            |? starts_with line (index_marker ())
            ?>
                := index, _ = quoted_at line 0i32
                { store ?| index = index }
            |: store
        store_from text (stop + 1i32) next

:= store_of (~text : string) : memory_store =
    store_from text 0i32 { memories = NoMemories; count = 0i32; index = ""; problems = "" }

:= failed (~reason : string) : i32 =
    stderr_line (concat5 "kit error: memory " reason "" "" "")
    2i32

:= decimal_of (~text : string) (fallback : i32) : i32 = $'(!text).trim().parse::<i32>().ok().filter(|value| *value > \
    0).unwrap_or(!fallback)' : i32
