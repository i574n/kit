:< workspace_primitives.outcome
:< sm'_operators
:< workspace_primitives.numbers
:< workspace_primitives.clock
:< workspace_primitives.console
:< workspace_primitives.rooted

:| read_limit =
    | WholeFile
    | LeadingBytes : u64

:| read_outcome =
    | ReadShown : i32
    | ReadRejected : string

:| read_extent =
    | WholeFileShown
    | LeadingBytesShown

:| content_ending =
    | ContentClosed
    | ContentOpen

:| stream_result =
    | Streamed : u64
    | StreamFailed

:= unlimited_bytes () : u64 = $'u64::MAX' : u64
:= stream_failure_marker () : u64 = $'u64::MAX' : u64
:= u64_text_valid (~text : string) : bool = $'!text.parse::<u64>().is_ok()' : bool
:= u64_parsed (~text : string) : u64 = $'!text.parse::<u64>().unwrap_or(0)' : u64

:= open_problem (~path : string) : string =
    $'std::rc::Rc::<str>::from(kit_rust_std_fs::rooted_open_regular_read(std::path::Path::new(&*!path)).err().unwrap_o\
        r_default().as_str())' : string
:= regular_file_bytes (~path : string) : u64 = $'kit_rust_std_fs::rooted_regular_size(std::path::Path::new(&*!path)).u\
    nwrap_or(0)' : u64
:= streamed_prefix (~path : string) (limit : u64) : u64 =
    $'kit_rust_std_fs::rooted_open_regular_read(std::path::Path::new(&*!path)).ok().and_then(|file| \
        std::io::copy(&mut std::io::Read::take(file, !limit), &mut \
        std::io::stdout().lock()).ok()).unwrap_or(u64::MAX)' : u64
:= stream_result_of (count : u64) : stream_result =
    ? (count = (stream_failure_marker ())) ?> StreamFailed |: Streamed count
:= flushed_stdout () : i32 = $'std::io::Write::flush(&mut std::io::stdout()).map(|_| 0i32).unwrap_or(2i32)' : i32
:= byte_before (~path : string) (shown : u64) : i32 =
    $'kit_rust_std_fs::rooted_open_regular_read(std::path::Path::new(&*!path)).ok().and_then(|mut file| { let offset \
        = (!shown).checked_sub(1)?; std::io::Seek::seek(&mut file, std::io::SeekFrom::Start(offset)).ok()?; \
        let mut byte = [0u8; 1]; std::io::Read::read_exact(&mut file, &mut byte).ok()?; \
        Some(i32::from(byte[0])) }).unwrap_or(-1)' : i32

:= limit_bytes (limit : read_limit) : u64 =
    ?= limit ?|
    | WholeFile => unlimited_bytes ()
    | LeadingBytes count => count

:= parse_read_limit (~text : string) : validation_result read_limit =
    ? u64_text_valid text ?> Valid (LeadingBytes (u64_parsed text)) |: Invalid

:= read_extent_of (shown : u64) (file_bytes : u64) : read_extent =
    ? (shown < file_bytes) ?> LeadingBytesShown |: WholeFileShown

:= ascii_newline () : i32 = 10i32

:= content_ending_of (last_byte : i32) : content_ending =
    ? last_byte < 0i32 ?> ContentClosed
    |? last_byte = ascii_newline () ?> ContentClosed
    |: ContentOpen

:= content_ending_text (ending : content_ending) : string =
    ?= ending ?|
    | ContentClosed => ""
    | ContentOpen => " no_final_newline=true"

:= shown_extent_text (extent : read_extent) (last_byte : i32) : string =
    ?= extent ?|
    | WholeFileShown => content_ending_text (content_ending_of last_byte)
    | LeadingBytesShown => " truncated=true"

:~ read_receipt_text (~path : string) (shown : u64) (last_byte : i32) (started : u64) : string =
    := file_bytes = regular_file_bytes path
    := head =
        "kit proxy fs-read ok bytes="
        ++# u64_text file_bytes
        ++# " shown="
        ++# u64_text shown
        ++# shown_extent_text (read_extent_of shown file_bytes) last_byte
    head ++# " elapsed_ms=" ++# (u64_text (ms_since started))

:= stream_file (~path : string) (limit : read_limit) (started : u64) : read_outcome =
    ?= stream_result_of (streamed_prefix path (limit_bytes limit)) ?|
    | StreamFailed => ReadRejected ("fs-read failed while streaming: " ++# path)
    | Streamed shown =>
        ? flushed_stdout () = 0i32
        ?> ReadShown (stderr_line (read_receipt_text path shown (byte_before path shown) started))
        |: ReadRejected ("fs-read could not flush stdout: " ++# path)

:= read_rooted (~root : string) (~relative : string) (limit : read_limit) (started : u64) : read_outcome =
    := path = rooted_path root relative
    ? (path = "") ?> ReadRejected ("fs-read path rejected: " ++# (rooted_path_problem root relative))
    |:
        := problem = open_problem path
        ? (problem = "") ?> stream_file path limit started
        |: ReadRejected ("fs-read failed: " ++# problem)

:= read_with_limit (~root : string) (~relative : string) (~limit_text : string) (started : u64) : read_outcome =
    ?= parse_read_limit limit_text ?|
    | Valid limit => read_rooted root relative limit started
    | Invalid => ReadRejected "invalid byte limit"

:~ file_reading_outcome () : read_outcome =
    := started = unix_ms ()
    := operands = proxy_argument_count ()
    ? $"!operands == 3" ?> read_rooted (proxy_argument 1i32) (proxy_argument 2i32) WholeFile started
    |? $"!operands == 4" ?> read_with_limit (proxy_argument 1i32) (proxy_argument 2i32) (proxy_argument 3i32) started
    |: ReadRejected "fs-read expects <root> <relative> [max-bytes]"

:~ file_reading_report () : i32 * string =
    ?= file_reading_outcome () ?|
    | ReadShown _ => 0i32, ""
    | ReadRejected text => 2i32, text

:= main () : i32 =
    !!!!Export("kit_file_reading_outcome", ((\ () => file_reading_report ()) : () -> i32 * string))
    := _ = read_receipt_text "file_reading.spi" 5u64 10i32 (unix_ms ())
    := _ = file_reading_outcome ()
    0i32
