///- --package .
:# model static =
    :< rust_std_string.model

:< rust_std_string.model

:| process_owner =
    | ClaudeSession : u64
    | KitJob : string
    | CellsVm : u64
    | Orphan
    | NotATool

:= owner_text = \|
    | ClaudeSession pid => concat5 "claude:" ($'std::rc::Rc::<str>::from((!pid).to_string())' : string) "" "" ""
    | KitJob id => concat5 "kit:" id "" "" ""
    | CellsVm pid => concat5 "cells-vm:" ($'std::rc::Rc::<str>::from((!pid).to_string())' : string) "" "" ""
    | Orphan => "orphan"
    | NotATool => "-"

:== watch_limits =
    {
        silent_minutes : u64
        rogue_minutes : u64
        rogue_cores : f64
        hog_megabytes : u64
    }

:= default_limits () : watch_limits =
    { silent_minutes = 60u64; rogue_minutes = 30u64; rogue_cores = 0.8f64; hog_megabytes = 8192u64 }

:== busy_process =
    {
        pid : u64
        name : string
        cores : f64
        age_minutes : u64
        cpu_minutes : u64
        owner : process_owner
    }

:= orphaned (owner : process_owner) : bool =
    ?= owner ?|
    | Orphan => !+
    | _ => !-

:= tool_owned (owner : process_owner) : bool =
    ?= owner ?|
    | NotATool => !-
    | _ => !+

:~ rogue (limits : watch_limits) (busy : busy_process) : bool =
    := cpu_minutes = busy.cpu_minutes
    := age_minutes = busy.age_minutes
    := long_busy = age_minutes >= 180u64 && $'(!cpu_minutes as f64) >= 0.8 * (!age_minutes as f64)' : bool
    tool_owned busy.owner
    && busy.cores >= limits.rogue_cores
    && ((orphaned busy.owner && busy.age_minutes >= limits.rogue_minutes) || long_busy)

:| quiet_verdict =
    | Talking
    | Buffered : f64
    | QuietInLiveBlock
    | WaitingByDesign : string
    | CellsBusy : f64
    | Silent : u64

:== quiet_job =
    {
        quiet_minutes : u64
        tree_cores : f64
        live_block : bool
        last_line : string
        cells_cores : f64
    }

:= lowercase (~text : string) : string = $'std::rc::Rc::<str>::from((&*!text).to_lowercase())' : string

:~ quiet_verdict_of (limits : watch_limits) (job : quiet_job) : quiet_verdict =
    ? job.quiet_minutes < limits.silent_minutes ?> Talking
    |? job.tree_cores >= 0.1f64 ?> Buffered job.tree_cores
    |? job.live_block ?> QuietInLiveBlock
    |? contains (lowercase job.last_line) "waiting for" ?> WaitingByDesign job.last_line
    |? job.cells_cores >= 0.5f64 ?> CellsBusy job.cells_cores
    |: Silent job.quiet_minutes

:= cores_text (cores : f64) : string = $'std::rc::Rc::<str>::from(format\!("{:.2}", !cores))' : string
:= minutes_text (minutes : u64) : string = $'std::rc::Rc::<str>::from((!minutes).to_string())' : string

:~ verdict_text (verdict : quiet_verdict) : string =
    ?= verdict ?|
    | Talking => ""
    | Buffered cores => concat5 "  (quiet output, tree busy " (cores_text cores) " cores: buffered)" "" ""
    | QuietInLiveBlock => "  (quiet during a live block: waiting for a window is expected)"
    | WaitingByDesign line => concat5 "  (waiting by design, last line: " line ")" "" ""
    | CellsBusy cores =>
        concat5
            "  (quiet, tree idle, detached Cells VMs use "
            (cores_text cores)
            " cores: likely this job's compiler work)"
            ""
            ""
    | Silent minutes =>
        concat5 "  <- SILENT " (minutes_text minutes) " min, tree idle: check the job's own progress files" "" ""

:| window_health =
    | WindowFine
    | WindowStale : string

:~ window_health_of (~held : bool) (~job_state : string) : window_health =
    ? held && job_state <> "" && job_state <> "running" && job_state <> "queued" ?> WindowStale job_state
    |: WindowFine

:= window_text = \|
    | WindowFine => ""
    | WindowStale state => concat5 "  <- STALE: job is " state "" "" ""

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail

:= quiet (minutes : u64) (tree : f64) (live : bool) (~line : string) (cells : f64) : quiet_job =
    { quiet_minutes = minutes; tree_cores = tree; live_block = live; last_line = line; cells_cores = cells }

///> rust
:# quiet_jobs_get_the_first_explanation_that_fits =
    := limits = default_limits ()
    expect (verdict_text (quiet_verdict_of limits (quiet 10u64 0.0f64 !- "" 0.0f64)) = "") "under the silence limit"
    expect
        (
            rust_std_string.model.contains
                (verdict_text (quiet_verdict_of limits (quiet 90u64 1.5f64 !+ "" 0.0f64)))
                "buffered"
        )
        "a busy tree is buffered even in a live block"
    expect
        (
            rust_std_string.model.contains
                (verdict_text (quiet_verdict_of limits (quiet 90u64 0.0f64 !+ "" 0.0f64)))
                "live block"
        )
        "live block"
    expect
        (
            rust_std_string.model.contains
                (verdict_text (quiet_verdict_of limits (quiet 90u64 0.0f64 !- "Waiting for r29 to install" 0.0f64)))
                "waiting by design"
        )
        "waiting by design"
    expect
        (
            rust_std_string.model.contains
                (verdict_text (quiet_verdict_of limits (quiet 90u64 0.0f64 !- "" 2.0f64)))
                "Cells VMs"
        )
        "cells work"
    expect
        (
            rust_std_string.model.contains
                (verdict_text (quiet_verdict_of limits (quiet 90u64 0.0f64 !- "" 0.0f64)))
                "SILENT 90 min"
        )
        "silent"

///> rust
:# rogues_are_orphaned_or_long_busy_tools =
    := limits = default_limits ()
    := orphan =
        { pid = 1u64; name = "dotnet"; cores = 1.0f64; age_minutes = 45u64; cpu_minutes = 20u64; owner = Orphan }
    expect (rogue limits orphan) "an orphan tool over its age"
    expect (rogue limits { orphan ?| owner = ClaudeSession 9u64 } = !-) "an owned young tool"
    expect
        (rogue limits { orphan ?| owner = ClaudeSession 9u64; age_minutes = 200u64; cpu_minutes = 190u64 })
        "busy 95% of 3 h"
    expect (rogue limits { orphan ?| owner = NotATool } = !-) "not a tool"
    expect (rogue limits { orphan ?| cores = 0.5f64 } = !-) "below the core threshold"

///> rust
:# held_windows_of_ended_jobs_are_stale =
    expect (window_text (window_health_of !+ "stopped") = "  <- STALE: job is stopped") "stopped job"
    expect (window_text (window_health_of !+ "running") = "") "running job"
    expect (window_text (window_health_of !- "finished") = "") "waiting window"
    expect (window_text (window_health_of !+ "") = "") "window without a job"
