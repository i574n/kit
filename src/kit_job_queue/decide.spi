:< sm'_operators
:< kit_jobs.host
:< kit_jobs.jobs
:< kit_job_host.queue

:~ queue_decide (~id : string) : i32 =
    := step = step_of (queued_of id)
    ?= step ?|
    | StartSupervisor => 0i32
    | KeepWaiting => 1i32
    | _ =>
        settled_in_queue id step
        2i32

:= main () : i32 =
    !!!!Export("kit_job_queue_decide", ((\ id => queue_decide id) : string -> i32))
    0i32
