:= main () : i32 =
    := _ = toolchain_argument_count_binding 4i32 0i32
    := _ = toolchain_argument_token_low_binding 2i32 3i32
    := _ = toolchain_argument_token_chunk_binding 12i32 1i32
    !!!!Export(
        "kit_toolchain_argument_count",
        ((\ (first, second) => toolchain_argument_count_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_toolchain_argument_token_low",
        ((\ (first, second) => toolchain_argument_token_low_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_toolchain_argument_token_chunk",
        ((\ (first, second) => toolchain_argument_token_chunk_binding first second) : i32 * i32 -> i32)
    )
    0i32
