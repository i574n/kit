:~ toolchain_argument_count_binding (action_code : i32) (witness : i32) : i32 =
    ? action_code < 0i32 ?> -1i32
    |? 7i32 < action_code ?> -1i32
    |? witness < 0i32 ?> -1i32
    |? 0i32 < witness ?> -1i32
    |? action_code = 0i32 ?> 2i32
    |? action_code = 1i32 ?> 3i32
    |? action_code = 2i32 ?> 4i32
    |? action_code = 3i32 ?> 3i32
    |? action_code = 4i32 ?> 6i32
    |? action_code = 5i32 ?> 4i32
    |: 1i32

:~ toolchain_argument_token_low_binding (action_code : i32) (position : i32) : i32 =
    ? action_code < 0i32
    ?> -1i32
    |? 3i32 < action_code
    ?> -1i32
    |? position < 0i32
    ?> -1i32
    |? action_code = 0i32
    ?> ? position = 0i32 ?> 0i32 |? position = 1i32 ?> 1i32 |: -1i32
    |? action_code = 1i32
    ?> ? position = 0i32 ?> 2i32 |? position = 1i32 ?> 3i32 |? position = 2i32 ?> 4i32 |: -1i32
    |? action_code = 2i32
    ?>
        ? position = 0i32
        ?> 5i32
        |? position = 1i32
        ?> 6i32
        |? position = 2i32
        ?> 1i32
        |? position = 3i32
        ?> 7i32
        |: -1i32
    |? position = 0i32
    ?> 8i32
    |? position = 1i32
    ?> 1i32
    |? position = 2i32
    ?> 7i32
    |: -1i32

