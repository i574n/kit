:< sm'_operators
:< kit_jobs.model
:< kit_jobs.host
:< kit_jobs.jobs
:< kit_job_launch_model.shapes


:= after_receipt (~mode : string) (~other : string) : string =
    ? mode = "" ?> "" |: " after=" ++# other ++# " after_mode=" ++# mode

:| launch =
    | Launched : string * string
    | LaunchRefused : string

:~ job_launched
    (shape : start_shape) (~after_mode : string) (~after_job : string) (attached : bool) (~cap_mb : u64)
    (~slot_minutes : u64) (~done_minutes : u64) (~hold_minutes : u64) (~quiet_wait : u64) (~min_free : u64)
    (front : bool) (~label : string) (~timeout : u64) (~inner : string) (~cwd : string)
    : launch
    =
    := word = shape_word shape
    := id, supervisor, problem =
        $'kit_job_create::kit_job_create(&*!word, &*!after_mode, &*!after_job, !attached, !cap_mb, !slot_minutes, \
            !done_minutes, !hold_minutes, !quiet_wait, !min_free, !front, &*!label, !timeout, &*!inner, &*!cwd)'
        : string * string * string
    ? problem <> "" ?> LaunchRefused problem |: Launched (id, supervisor)
:= supervised_job (~id : string) : i32 = $'kit_job_supervise::kit_job_supervise(&*!id)' : i32

:| start_settle =
    | SettleHealthy
    | SettleFailed : i32 * string

:~ ^ settled_within (~id : string) (~left_ms : u64) : job_state =
    := state = shared_state id
    ?= state ?|
    | Live _ =>
        ? left_ms = 0u64 ?> state
        |:
            sleep_ms 100u64
            settled_within id (? left_ms < 100u64 ?> 0u64 |: left_ms - 100u64)
    | Settled _ => state

:= first_line_of (~text : string) : string =
    := cut = sm'.index_of "\n" text
    sm'.trim (? cut < 0i32 ?> text |: sm'.substring 0i32 cut text)

:~ start_settle_of (~id : string) (~settle_ms : u64) : start_settle =
    ?= settled_within id settle_ms ?|
    | Settled (JobFinished code) =>
        ? code = 0i32 ?> SettleHealthy |: SettleFailed (code, first_line_of (text_or_empty (job_file id "stderr.log")))
    | Settled (JobSpawnFailed problem) => SettleFailed (127i32, problem)
    | Settled (JobLost) => SettleFailed (125i32, "the supervisor ended before the job settled")
    | _ => SettleHealthy

:~ job_started (attached : bool) : i32 * string =
    := ok
        , problem, shape_text, after_mode, after_job, cap_mb, slot_minutes, done_minutes, hold_minutes, quiet_wait,
        min_free, settle_ms, first, timeout, front
        =
        $'kit_job_start_args::kit_job_start_args()'
        : bool * string * string * string * string * u64 * u64 * u64 * u64 * u64 * u64 * u64 * i32 * u64 * bool
    ? ok |> not
    ?> rejected problem, ""
    |:
        := shape = shape_of_word shape_text
        := label = argument first
        ?=
            job_launched
                shape
                after_mode
                after_job
                attached
                cap_mb
                slot_minutes
                done_minutes
                hold_minutes
                quiet_wait
                min_free
                front
                label
                timeout
                (arguments_from (first + 2i32))
                (current_directory ())
        ?|
        | LaunchRefused refused_problem => rejected refused_problem, ""
        | Launched (id, supervisor) =>
            := settles = attached = !- && after_mode = "" && shape = PlainStart && settle_ms > 0u64
            ?= (? settles ?> start_settle_of id settle_ms |: SettleHealthy) ?|
            | SettleFailed (code, detail) =>
                stderr_line (
                    "kit job start failed id=" ++# id ++# " exit=" ++# sm'.format code ++# " stderr=" ++# detail
                )
                code, id
            | SettleHealthy =>
                stdout_line (
                    (? attached ?> "kit job run started id=" |: "kit job start ok id=")
                    ++# id
                    ++# " supervisor_pid="
                    ++# supervisor
                    ++# (
                        " timeout_ms="
                        ++# decimal_text timeout
                        ++# " gate="
                        ++# shape_word shape
                        ++# (
                            " label="
                            ++# label
                            ++# after_receipt after_mode after_job
                            ++# (? cap_mb = 0u64 ?> "" |: " max_private_mb=" ++# (decimal_text cap_mb))
                            ++# (
                                (? slot_minutes = 0u64 ?> "" |: " slot_within_min=" ++# (decimal_text slot_minutes))
                                ++# (? done_minutes = 0u64 ?> "" |: " done_within_min=" ++# (decimal_text done_minutes))
                                ++# (
                                    ? hold_minutes = 0u64
                                    ?> ""
                                    |:
                                        " quiet_hold_min="
                                        ++# decimal_text hold_minutes
                                        ++# " quiet_wait_min="
                                        ++# decimal_text quiet_wait
                                )
                            )
                        )
                    )
                )
                ? attached ?> (supervised_job id, id) |: (0i32, id)
:~ started_text (attached : bool) : string =
    := code, id = job_started attached
    ($'std::rc::Rc::<str>::from((!code).to_string().as_str())' : string) ++# "\t" ++# id

:= record_mark () : string = $'std::rc::Rc::<str>::from(char::from(30u8).to_string())' : string

:~ launched_text (~label : string) (~timeout : u64) (~inner : string) (~cwd : string) : string =
    ?= job_launched PlainStart "" "" !- 0u64 0u64 0u64 0u64 0u64 0u64 !- label timeout inner cwd ?|
    | Launched (id, supervisor) => id ++# (record_mark ()) ++# supervisor
    | LaunchRefused problem => "error: " ++# problem

:= main () : i32 =
    !!!!Export("kit_job_start", ((\ attached => started_text attached) : bool -> string))
    !!!!Export(
        "kit_job_launched_text",
        (
            \ (label, timeout, inner, cwd) => launched_text label timeout inner cwd
            : string * u64 * string * string -> string
        )
    )
    0i32
