:< family_contract_bindings.bindings
:< family_contract_contract.model

:= main () : i32 =
    := _ = family_contract_public_plan ()
    := good_catalog = family_contract_catalog_binding 36i32 36i32 36i32 36i32
    := good_set = family_contract_set_binding 36i32 0i32
    := good_shape = family_contract_shape_binding 15i32 4i32
    := bad_catalog = family_contract_catalog_binding 36i32 35i32 36i32 35i32
    := bad_set = family_contract_set_binding 35i32 1i32
    := bad_shape = family_contract_shape_binding 7i32 3i32
    ? good_catalog = 1i32 && good_set = 1i32 && good_shape = 1i32 ?>
        ? bad_catalog = 0i32 && bad_set = 0i32 && bad_shape = 0i32 ?> 0i32 |: 1i32
    |: 1i32
