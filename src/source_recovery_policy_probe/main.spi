:< source_recovery_contract.model

:= main () : i32 =
    := _ = source_recovery_public_plan ()
    ?= source_recovery_provenance_binding 0i32 0i32 ?|
    | 1 =>
        ?= source_recovery_provenance_binding 0i32 1i32 ?|
        | 2 =>
            ?= source_recovery_provenance_binding 1i32 0i32 ?|
            | 3 =>
                ?= source_recovery_warning_binding 2i32 5i32 ?|
                | 1 => 0i32
                | _ => 1i32
            | _ => 1i32
        | _ => 1i32
    | _ => 1i32
