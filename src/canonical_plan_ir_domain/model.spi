///- --package .
:= sample_op = \|
    | CreateKind => CreateFile ("state/example.spi", "typed-payload")
    | ReplaceKind => ReplaceFile ("src/example.spi", "expected", "replacement")
    | PatchExactKind => PatchExact ("src/example.spi", "old", "new")
    | MakeDirKind => MakeDir "src/generated"
    | ToolchainKind => ToolchainAction "cargo-check"
    | CopyKind => CopyFile ("src/source.spi", "expected-sha", "src/copied.spi")
    | ChmodKind => Chmod ("src/tool", "0755", "0644")
    | SymlinkKind => Symlink ("src/current", "src/target")

:= kind_code (kind : plan_kind) : i32 = union_reflection.cases.union_case_index kind - 1i32
:= kind_count () : i32 = union_reflection.cases.union_cases_fold (\ counted (_ : plan_kind) => counted + 1i32) 0i32
:= index_code (~input : string) : i32 = $'(!input).parse::<u8>().ok().filter(|index| index.to_string() == \
    &*!input).map(|index| index as i32).unwrap_or(-1)' : i32
:= wire_code (code : i32) : u64 = (conv code : u64)

:~ plan_schema_tag (~input : string) : string =
    ? (input = "schema") ?> "canonical-plan-ir" |: "invalid"

:= kind_at (code : i32) (kind : plan_kind) : bool = kind_code kind = code
:= kind_descriptor (kind : plan_kind) : string * string * string * string * string = op_descriptor (sample_op kind)

:~ plan_descriptor_by_index (~input : string) : string * string * string * string * string =
    union_reflection.cases.union_case_where
        (kind_at (index_code input))
        kind_descriptor
        ("invalid", "", "", "", "invalid")

:~ plan_manifest_header_projection (~input : string) : string =
    ? (input = "KIT-PLAN-IR\t1") ?> "1" |: codec_empty ()

:~ plan_manifest_row_hex_tuple (~input : string) : string * string * string * string * string =
    := text_len = sm.length input : i32
    := tab = char_tab ()
    := first = find_char input 0i32 tab
    ? (=.) first text_len
    ?> codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
    |:
        := second = find_char input ((+.) first 1i32) tab
        ? (=.) second text_len
        ?> codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
        |:
            := third = find_char input ((+.) second 1i32) tab
            ? (=.) third text_len
            ?> codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
            |:
                := fourth = find_char input ((+.) third 1i32) tab
                ? (=.) fourth text_len
                ?> codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
                |:
                    := fifth = find_char input ((+.) fourth 1i32) tab
                    ? (=.) fifth text_len
                    ?> codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
                    |:
                        := extra = find_char input ((+.) fifth 1i32) tab
                        := marker = slice_exclusive input 0i32 first
                        ? (<) extra text_len ?>
                            codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()
                        |? (marker = "op") ?>
                            slice_exclusive input ((+.) first 1i32) second,
                            slice_exclusive input ((+.) second 1i32) third,
                            slice_exclusive input ((+.) third 1i32) fourth,
                            slice_exclusive input ((+.) fourth 1i32) fifth,
                            slice_exclusive input ((+.) fifth 1i32) text_len
                        |:
                            codec_empty (), codec_empty (), codec_empty (), codec_empty (), codec_empty ()

:~ plan_manifest_projection_witness () : i32 =
    := header = plan_manifest_header_projection "KIT-PLAN-IR\t1"
    ? (header = "1")
    ?>
        := invalid_header = plan_manifest_header_projection "KIT-PLAN-IR\t2"
        ? (invalid_header = "")
        ?>
            := op_hex, target_hex, expected_hex, payload_hex, effect_hex =
                plan_manifest_row_hex_tuple "op\t01\t02\t03\t04\t05"
            ? (op_hex = "01")
            ?>
                ? (target_hex = "02")
                ?>
                    ? (expected_hex = "03")
                    ?>
                        ? (payload_hex = "04")
                        ?>
                            ? (effect_hex = "05")
                            ?>
                                := invalid_op, invalid_target, invalid_expected, invalid_payload, invalid_effect =
                                    plan_manifest_row_hex_tuple "op\t01\t02\t03\t04\t05\t06"
                                ? (invalid_op = "") ?>
                                    ? (invalid_target = "") ?>
                                        ? (invalid_expected = "") ?>
                                            ? (invalid_payload = "") ?>
                                                ? (invalid_effect = "") ?> 1i32 |: 0i32
                                            |: 0i32
                                        |: 0i32
                                    |: 0i32
                                |: 0i32
                            |: 0i32
                        |: 0i32
                    |: 0i32
                |: 0i32
            |: 0i32
        |: 0i32
    |: 0i32

:~ plan_provider_count () : i32 = kind_count ()

:~ plan_stage_witness () : i32 =
    := _ : plan_stage plan_raw plan_canonical = Canonicalize
    := _ : plan_stage plan_canonical plan_consumed = Consume
    1i32

:~ plan_index_valid (~input : string) : u64 =
    := code = index_code input
    ? 0i32 <= code && code < kind_count () ?> 1u64 |: 0u64

:= field_absent (~field : string) : bool = field = "" || field = "-"

:= field_fits (rule : field_rule) (~field : string) : bool =
    ?= rule ?|
    | AnyField => !+
    | PresentField => ? field_absent field ?> !- |: !+
    | DashField => field = "-"

:= kind_named (~op : string) (~effect : string) (kind : plan_kind) : bool =
    := spec = kind_spec_of kind
    spec.name = op && effect_name spec.effect = effect

:= decoded (~target : string) (~expected : string) (~payload : string) (invalid : u64) (kind : plan_kind) : u64 =
    := spec = kind_spec_of kind
    ? field_fits PresentField target && field_fits spec.expected expected && field_fits spec.payload payload
    ?> wire_code (kind_code kind)
    |: invalid

:~ plan_decode_code
    (~op : string) (~target : string) (~expected : string) (~payload : string) (~effect : string)
    : u64
    =
    := invalid = wire_code (kind_count ())
    union_reflection.cases.union_case_where (kind_named op effect) (decoded target expected payload invalid) invalid

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail
:= index_text (index : i32) : string = (sm'.show index)

:~ ^ descriptors_round_trip (index : i32) : bool =
    ? kind_count () <= index
    ?> !+
    |:
        := op, target, expected, payload, effect = plan_descriptor_by_index (index_text index)
        ? plan_decode_code op target expected payload effect = wire_code index
        ?> descriptors_round_trip (index + 1i32)
        |: !-

///> rust
:# plan_codes_keep_their_wire_values =
    expect (descriptors_round_trip 0i32) "every sample descriptor decodes to its own index"
    expect (plan_provider_count () = 8i32) "eight plan kinds"
    expect (plan_decode_code "create" "state/a.spi" "-" "" "write" = 0u64) "create takes any payload"
    expect (plan_decode_code "create" "state/a.spi" "sha" "p" "write" = 8u64) "create needs a dash expected"
    expect (plan_decode_code "replace" "a" "-" "p" "write" = 8u64) "replace needs an expected hash"
    expect (plan_decode_code "patch-exact" "a" "" "" "write" = 2u64) "patch-exact checks only its target"
    expect (plan_decode_code "toolchain" "cargo-check" "-" "-" "toolchain" = 4u64) "toolchain is code 4"
    expect (plan_decode_code "toolchain" "cargo-check" "-" "-" "write" = 8u64) "toolchain runs under its own effect"
    expect (plan_decode_code "copy" "-" "e" "s" "write" = 8u64) "a dash target is absent"
    expect (plan_decode_code "symlink" "a" "-" "" "write" = 8u64) "symlink needs a link target"
    expect (plan_decode_code "symlink" "a" "-" "b" "write" = 7u64) "symlink is code 7"
    expect (plan_decode_code "rename" "a" "-" "b" "write" = 8u64) "an unknown op is invalid"
    expect (plan_index_valid "7" = 1u64) "7 is a plan index"
    expect (plan_index_valid "8" = 0u64) "8 is past the kinds"
    expect (plan_index_valid "+1" = 0u64) "only canonical index text"
