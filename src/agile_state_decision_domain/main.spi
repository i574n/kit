:< state_series_contract.model

:| agile_state_entry_kind =
    | StaticPackageModule
    | TransientTypedReceipt
    | InvalidStateEntry

:= classify_state_entry package_owned transient_known =
    ?= package_owned, transient_known ?|
    | !+, !- => StaticPackageModule
    | !-, !+ => TransientTypedReceipt
    | _ => InvalidStateEntry

:~ agile_state_entry_kind_binding (package_owned : i32) (transient_known : i32) : i32 =
    ? package_owned = 1i32 ?>
        ? transient_known = 1i32 ?> 0i32 |: 1i32
    |:
        ? transient_known = 1i32 ?> 2i32 |: 0i32

:| agile_state_module_name_class =
    | StableStateModuleName
    | TransientStateReceiptName

:= agile_state_module_name_class_code = \|
    | StableStateModuleName => 0u64
    | TransientStateReceiptName => 1u64

:| transient_receipt =
    | PatchResumeReceipt
    | ToolchainProcessReceipt

:= transient_receipt_file (receipt : transient_receipt) : string =
    ?= receipt ?|
    | PatchResumeReceipt => "patch_resume.spi"
    | ToolchainProcessReceipt => "toolchain_process_receipt.spi"

:~ agile_transient_state_name_code (~name : string) : u64 =
    ?
        union_reflection.cases.union_case_where
            \ (receipt : transient_receipt) => name = transient_receipt_file receipt
            \ _ => !+
            !-
    ?> agile_state_module_name_class_code TransientStateReceiptName
    |: agile_state_module_name_class_code StableStateModuleName

:| agile_record_requirement =
    | HistoryStateRecord
    | RatingsStateRecord
    | BenchStateRecord
    | MigrationStateRecord

:= agile_record_file (record : agile_record_requirement) : string =
    ?= record ?|
    | HistoryStateRecord => "history.spi"
    | RatingsStateRecord => "ratings.spi"
    | BenchStateRecord => "bench.spi"
    | MigrationStateRecord => "migration.spi"

:= agile_record_requirement_bit = \|
    | HistoryStateRecord => 1u64
    | RatingsStateRecord => 2u64
    | BenchStateRecord => 4u64
    | MigrationStateRecord => 8u64

:~ agile_record_required_name_bit (~name : string) : u64 =
    union_reflection.cases.union_case_where
        \ (record : agile_record_requirement) => name = agile_record_file record
        \ record => agile_record_requirement_bit record
        0u64

:~ agile_record_required_catalog (~version : string) : string =
    ? version = "v1"
    ?> union_reflection.cases.union_cases_joined (\ (record : agile_record_requirement) => agile_record_file record) "|"
    |: ""

:~ agile_record_preflight_binding (observed_mask : i32) (reserved : i32) : i32 =
    ? observed_mask < 0i32 || 15i32 < observed_mask || reserved < 0i32 || 0i32 < reserved ?> -1i32
    |? observed_mask = 15i32 ?> 1i32
    |: 0i32

:| agile_attestation_decision =
    | RejectUnknownStateEntry
    | SkipCurrentAttestation
    | RuntimeAttestTransient
    | BuildAttestStatic
    | RequireBuildCompiler

:= agile_attestation_decision_code = \|
    | RejectUnknownStateEntry => 0i32
    | SkipCurrentAttestation => 1i32
    | RuntimeAttestTransient => 2i32
    | BuildAttestStatic => 3i32
    | RequireBuildCompiler => 4i32

:~ agile_attestation_decision_binding (kind_code : i32) (observation_mask : i32) : i32 =
    ? observation_mask < 0i32 || 7i32 < observation_mask || observation_mask = 4i32 || observation_mask = 5i32 ?>
        agile_attestation_decision_code RejectUnknownStateEntry
    |? kind_code = 2i32 ?>
        ? observation_mask = 1i32 || observation_mask = 3i32 || observation_mask = 7i32 ?>
            agile_attestation_decision_code SkipCurrentAttestation
        |:
            agile_attestation_decision_code RuntimeAttestTransient
    |? kind_code = 1i32 ?>
        ? observation_mask = 7i32 || observation_mask = 1i32 ?>
            agile_attestation_decision_code SkipCurrentAttestation
        |? observation_mask = 2i32 || observation_mask = 3i32 || observation_mask = 6i32 ?>
            agile_attestation_decision_code BuildAttestStatic
        |? observation_mask = 0i32 ?>
            agile_attestation_decision_code RequireBuildCompiler
        |:
            agile_attestation_decision_code RejectUnknownStateEntry
    |:
        agile_attestation_decision_code RejectUnknownStateEntry

:~ agile_series_sequence_binding (previous : i32) (next : i32) : i32 =
    series_sequence_binding previous next

:~ agile_series_source_binding (path_length : i32) (packed_shape : i32) : i32 =
    series_source_binding path_length packed_shape

:~ agile_series_pair_binding (ratings_present : i32) (bench_present : i32) : i32 =
    series_pair_binding ratings_present bench_present

:~ agile_series_monotonic_binding (previous : i32) (next : i32) : i32 =
    series_monotonic_binding previous next

:~ agile_series_fingerprint_binding (ratings_nonzero : i32) (bench_nonzero : i32) : i32 =
    series_fingerprint_binding ratings_nonzero bench_nonzero

:= main () : i32 =
    !!!!Export(
        "kit_agile_state_series_sequence_binding",
        ((\ (first, second) => agile_series_sequence_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_agile_state_series_source_binding",
        ((\ (first, second) => agile_series_source_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_agile_state_series_pair_binding",
        ((\ (first, second) => agile_series_pair_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_agile_state_series_monotonic_binding",
        ((\ (first, second) => agile_series_monotonic_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_agile_state_series_fingerprint_binding",
        ((\ (first, second) => agile_series_fingerprint_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_agile_state_entry_kind_binding",
        ((\ (first, second) => agile_state_entry_kind_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_agile_state_transient_name_code",
        ((\ value => agile_transient_state_name_code value) : string -> u64)
    )
    !!!!Export(
        "kit_agile_state_record_required_name_bit",
        ((\ value => agile_record_required_name_bit value) : string -> u64)
    )
    !!!!Export(
        "kit_agile_state_record_required_catalog",
        ((\ value => agile_record_required_catalog value) : string -> string)
    )
    !!!!Export(
        "kit_agile_state_record_preflight_binding",
        ((\ (first, second) => agile_record_preflight_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_agile_state_attestation_decision_binding",
        ((\ (first, second) => agile_attestation_decision_binding first second) : i32 * i32 -> i32)
    )
    := _ = append_only_series_plan ()
    := _ = agile_series_sequence_binding 0i32 1i32
    := _ = agile_series_source_binding 17i32 32i32
    := _ = agile_series_pair_binding 1i32 1i32
    := _ = agile_series_monotonic_binding 0i32 1i32
    := _ = agile_series_fingerprint_binding 1i32 1i32
    := _ = agile_state_entry_kind_binding 1i32 0i32
    := _ = agile_transient_state_name_code "patch_resume.spi"
    := _ = agile_transient_state_name_code "toolchain_process_receipt.spi"
    := _ = agile_transient_state_name_code "ratings.spi"
    := _ = agile_record_required_name_bit "history.spi"
    := _ = agile_record_required_name_bit "ratings.spi"
    := _ = agile_record_required_name_bit "bench.spi"
    := _ = agile_record_required_name_bit "migration.spi"
    := _ = agile_record_required_name_bit "other.spi"
    := _ = agile_record_required_catalog "v1"
    := _ = agile_record_preflight_binding 15i32 0i32
    := _ = agile_record_preflight_binding 7i32 0i32
    := _ = agile_attestation_decision_binding 0i32 0i32
    := _ = agile_attestation_decision_binding 2i32 1i32
    := _ = agile_attestation_decision_binding 2i32 0i32
    := _ = agile_attestation_decision_binding 1i32 1i32
    := _ = agile_attestation_decision_binding 1i32 7i32
    := _ = agile_attestation_decision_binding 1i32 2i32
    := _ = agile_attestation_decision_binding 1i32 0i32
    := _ = classify_state_entry !+ !-
    0i32
