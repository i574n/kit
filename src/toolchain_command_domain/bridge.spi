:~ toolchain_program_profile_binding (action_code : i32) (witness : i32) : i32 =
    ? action_code < 0i32 ?> -1i32
    |? 7i32 < action_code ?> -1i32
    |? witness < 0i32 ?> -1i32
    |? 0i32 < witness ?> -1i32
    |? action_code < 1i32 ?> 0i32
    |? 1i32 < action_code ?>
        ? action_code < 4i32 ?> 0i32
        |? 4i32 < action_code ?> 0i32
        |: 2i32
    |: 1i32

:~ toolchain_argument_profile_binding (action_code : i32) (witness : i32) : i32 =
    ? action_code < 0i32 ?> -1i32
    |? 7i32 < action_code ?> -1i32
    |? witness < 0i32 ?> -1i32
    |? 0i32 < witness ?> -1i32
    |? action_code < 7i32 ?> action_code
    |: 6i32

:~ toolchain_environment_profile_binding (action_code : i32) (witness : i32) : i32 =
    ? action_code < 0i32 ?> -1i32
    |? 7i32 < action_code ?> -1i32
    |? witness < 0i32 ?> -1i32
    |? 0i32 < witness ?> -1i32
    |? action_code < 3i32 ?> 0i32
    |? 3i32 < action_code ?>
        ? action_code < 7i32 ?> 0i32 |: 1i32
    |: 2i32

:~ toolchain_timeout_profile_binding (action_code : i32) (witness : i32) : i32 =
    ? action_code < 0i32 ?> -1i32
    |? 7i32 < action_code ?> -1i32
    |? witness < 0i32 ?> -1i32
    |? 0i32 < witness ?> -1i32
    |: 0i32

:~ toolchain_success_profile_binding (action_code : i32) (witness : i32) : i32 =
    ? action_code < 0i32 ?> -1i32
    |? 7i32 < action_code ?> -1i32
    |? witness < 0i32 ?> -1i32
    |? 0i32 < witness ?> -1i32
    |: 0i32

:~ toolchain_resume_profile_binding (action_code : i32) (witness : i32) : i32 =
    ? action_code < 0i32 ?> -1i32
    |? 7i32 < action_code ?> -1i32
    |? witness < 0i32 ?> -1i32
    |? 0i32 < witness ?> -1i32
    |? action_code = 2i32 ?> model.toolchain_resume_profile_code model.CargoCheckResume
    |? action_code = 3i32 ?> model.toolchain_resume_profile_code model.CargoTestResume
    |? action_code = 4i32 ?> model.toolchain_resume_profile_code model.CargoClippyResume
    |? action_code = 5i32 ?> model.toolchain_resume_profile_code model.CargoReleaseResume
    |? action_code = 7i32 ?> model.toolchain_resume_profile_code model.SpiralUtilityResume
    |: model.toolchain_resume_profile_code model.CargoUtilityResume

:~ toolchain_resume_retry_binding (checkpoint : i32) (outcome : i32) : i32 =
    ? checkpoint = 4i32 && outcome = 3i32
    ?> model.toolchain_resume_decision_code model.RetryTimedOutReceipt
    |: model.toolchain_resume_decision_code model.ContinueReceipt

:~ toolchain_execution_plan_binding (action_code : i32) (witness : i32) : i32 =
    := program = toolchain_program_profile_binding action_code witness
    := environment = toolchain_environment_profile_binding action_code witness
    := timeout = toolchain_timeout_profile_binding action_code witness
    := success = toolchain_success_profile_binding action_code witness
    ? program < 0i32 ?> -1i32
    |? environment < 0i32 ?> -1i32
    |? timeout < 0i32 ?> -1i32
    |? success < 0i32 ?> -1i32
    |: program + (environment * 4i32 + (timeout * 16i32 + success * 32i32))

:~ toolchain_environment_entry_count_binding (action_code : i32) (witness : i32) : i32 =
    := environment = toolchain_environment_profile_binding action_code witness
    ? environment < 0i32 ?> -1i32
    |? environment = 1i32 ?> 0i32
    |? environment = 2i32 ?> 8i32
    |: 5i32

:~ toolchain_environment_entry_binding (action_code : i32) (index : i32) : i32 =
    := environment = toolchain_environment_profile_binding action_code 0i32
    := count = toolchain_environment_entry_count_binding action_code 0i32
    ? environment < 0i32 ?> -1i32
    |? index < 0i32 ?> -1i32
    |? index < count ?>
        ? index = 0i32 ?> 0i32
        |? index = 1i32 ?> 17i32
        |? index = 2i32 ?> 34i32
        |? index = 3i32 ?> 51i32
        |? index = 4i32 ?> 68i32
        |? index = 5i32 ?> 85i32
        |? index = 6i32 ?> 86i32
        |: 103i32
    |: -1i32
