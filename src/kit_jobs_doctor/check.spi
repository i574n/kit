///- --package .
:# check static =
    :< sm'_operators

:< sm'_operators
:< file_system_operators
:< kit_jobs_doctor_model.model

:~ ^ facts_from
    (rows : kit_machine_watch.host.process_rows) (at : i32) (count : i32) (found : list process_fact)
    : list process_fact
    =
    ? count <= at
    ?> listm.rev found
    |:
        := name = kit_machine_watch.host.row_name rows at
        ? sm'.starts_with "kit" name |> not
        ?> facts_from rows (at + 1i32) count found
        |:
            := fact =
                {
                    pid = kit_machine_watch.host.row_pid rows at
                    parent_alive =
                        kit_machine_watch.host.row_of_pid rows (kit_machine_watch.host.row_parent rows at) >= 0i32
                    role = role_of (kit_machine_watch.host.row_command rows at)
                }
            facts_from rows (at + 1i32) count (fact :: found)

:~ process_facts () : list process_fact =
    := rows = kit_machine_watch.host.process_rows_sampled 50u64
    facts_from rows 0i32 (kit_machine_watch.host.row_count rows) []

:~ standing_of (job : string) : job_standing =
    ? kit_jobs.jobs.known_job job |> not ?> JobMissing
    |? file_system.file_exists (kit_jobs.jobs.job_file job "exit") ?> JobSettled
    |: JobLive

:~ job_names () : list string =
    := root = kit_jobs.host.jobs_root ()
    ? file_system.directory_exists root |> not ?> []
    |:
        file_system.read_dir_names root
        |> resultm.unwrap'
        |> am'.vec_fold' (\ names name => (sm'.from_std_string name :: names)) Nil
        |> listm'.filter (sm'.starts_with "job-")

:~ chain_facts () : list chain_fact =
    job_names ()
    |> listm.fold
        \ found (job : string) =>
            := after = kit_jobs.jobs.job_file job "after"
            := waiting =
                file_system.file_exists after
                && not (file_system.file_exists (kit_jobs.jobs.job_file job "after-done"))
                && not (file_system.file_exists (kit_jobs.jobs.job_file job "exit"))
            ? waiting ?>
                := predecessor = sm'.split "\t" (file_system.read_all_text after) |> array |> am'.index 0i32 |> sm'.trim
                { job = job; predecessor = predecessor; standing = standing_of predecessor } :: found
            |: found
        []

:~ environment_finding (env_drift : () -> bool * string) : option finding =
    := ran, changes = env_drift ()
    ? ran |> not ?> Some (HostEnvironmentDiffers "(an environment listing did not run)")
    |? changes = "" ?> None
    |: Some (HostEnvironmentDiffers changes)

:~ doctor_run (env_drift : () -> bool * string) : i32 =
    := with_environment = optionm'.default_value "" (env.try_command_line_argument 2i32) = "--env"
    := processes = process_facts ()
    := findings = process_findings processes standing_of
    := findings =
        listm.rev (listm.fold (\ (all : list finding) (item : finding) => item :: all) (listm.rev findings) (
            chain_findings (chain_facts ())))
    := findings =
        ? with_environment |> not ?> findings
        |:
            ?= environment_finding env_drift ?|
            | Some item => listm.rev (item :: listm.rev findings)
            | None => findings
    findings |> listm.iter \ (item : finding) => console.write_line (finding_line item)
    := summary =
        " processes="
        ++# sm'.format (listm.length processes : i32)
        ++# " findings="
        ++# sm'.format (listm.length findings : i32)
    ?= findings ?|
    | [] =>
        console.write_line ("kit job doctor ok" ++# summary)
        0i32
    | _ =>
        console.write_line ("kit job doctor refused:" ++# summary)
        1i32

///> rust
:# an_environment_listing_reads_as_one_finding =
    expect
        (environment_finding (\ () => !-, "") = Some (HostEnvironmentDiffers "(an environment listing did not run)"))
        "listing failed"
    expect (environment_finding (\ () => !+, "") = None) "no drift"
    expect
        (environment_finding (\ () => !+, "+CARGO_BUILD_JOBS") = Some (HostEnvironmentDiffers "+CARGO_BUILD_JOBS"))
        "drift"
