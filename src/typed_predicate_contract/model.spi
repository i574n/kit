:< typed_predicate.model

:~ require (value : bool) : () = $'if !value { () } else { std::panic::panic_any("typed predicate differential \
    mismatch") }' : ()
:~ ascii_text (byte : u64) (length : u64) : string =
    $'std::rc::Rc::<str>::from(std::string::String::from_utf8(std::iter::repeat_n(!byte as u8,!length as \
        usize).collect::<Vec<_>>()).unwrap())' : string
:~ check (text : string) : () =
    := hash_expected = $'!text.len() == 64 && !text.bytes().all(|byte| byte.is_ascii_hexdigit())' : bool
    := safe_expected = $'(!text.len() > 0) && !text.bytes().all(|byte| byte.is_ascii_alphanumeric() || \
        [45u8,46,47,95].contains(&byte))' : bool
    := hash_actual = evaluate (sha256_text ()) text
    := safe_actual = evaluate (safe_receipt_text ()) text
    require (hash_actual = hash_expected)
    require (safe_actual = safe_expected)
    require ($'kit_handoff::binary_install_hash_text(&*!text) == !hash_expected ' : bool)
    require ($'kit_handoff::binary_install_safe_text(&*!text) == !safe_expected ' : bool)

:~ differential () : i32 =
    :~ ^ loop (byte : u64) : u64 =
        ? byte < 128u64 ?>
            check (ascii_text byte 1u64)
            check (ascii_text byte 63u64)
            check (ascii_text byte 64u64)
            check (ascii_text byte 65u64)
            loop (byte + 1u64)
        |: byte
    := count = loop 0u64
    require (count = 128u64)
    check ""
    check "aB09-._/"
    check "é"
    check "路/receipt"
    check "ABCDEFabcdef0123456789ABCDEFabcdef0123456789ABCDEFabcdef0123456789ABCD"
    0i32

:= main () : i32 =
    !!!!Export("kit_test_typed_predicates", ((\ () => differential ()) : () -> i32))
    !!!!Global("""
        #[cfg(test)] mod typed_predicate_tests { #[test] fn ascii_and_unicode_match_original_rust_predicates() { assert_eq!(super::kit_test_typed_predicates(),0); } }

        """)
    0i32
