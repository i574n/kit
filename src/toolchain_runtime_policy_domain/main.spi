:= main () : i32 =
    := _ = toolchain_execution_gate_binding 1i32 0i32
    := _ = toolchain_execution_gate_binding 2i32 0i32
    := _ = toolchain_observed_outcome_binding 1i32 0i32
    := _ = toolchain_observed_outcome_binding 0i32 1i32
    := _ = toolchain_observed_outcome_binding 0i32 0i32
    := _ = toolchain_receipt_catalog "v1"
    !!!!Export(
        "kit_toolchain_execution_gate",
        ((\ (first, second) => toolchain_execution_gate_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_toolchain_observed_outcome",
        ((\ (first, second) => toolchain_observed_outcome_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export("kit_toolchain_receipt_catalog", ((\ value => toolchain_receipt_catalog value) : string -> string))
    0i32
