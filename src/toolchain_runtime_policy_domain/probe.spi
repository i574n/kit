:= main () : i32 =
    := run_gate = toolchain_execution_gate_binding 1i32 0i32
    := hold_gate = toolchain_execution_gate_binding 2i32 0i32
    := invalid_gate = toolchain_execution_gate_binding 6i32 0i32
    := timeout = toolchain_observed_outcome_binding 1i32 0i32
    := passed = toolchain_observed_outcome_binding 0i32 1i32
    := failed = toolchain_observed_outcome_binding 0i32 0i32
    := invalid = toolchain_observed_outcome_binding 2i32 0i32
    ?
        run_gate = 1i32
        && hold_gate = 0i32
        && invalid_gate < 0i32
        && timeout = 3i32
        && passed = 1i32
        && failed = 2i32
        && invalid < 0i32
    ?> 0i32
    |: 70i32
