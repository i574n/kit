:< rust_std_string.model
:< kit_receipt.receipt
:< kit_do_git_host.host

:~ joined (~left : string) (~right : string) : string =
    ? right = "" ?> left |? left = "" ?> right |: concat5 left "\n" right "" ""

:~ row (~cells : string) (~next : string) : string = concat5 cells (column ()) next "" ""

:~ succeeded (~outcome : string) : bool = part_at outcome 0i32 = "0"

:~ failure_row (~head : string) (~outcome : string) : string = concat5 head "  failed: " (part_at outcome 2i32) "" ""

:~ ^ history_rows
    (~root : string) (~repo : string) (~needle : string) (~path : string) (~log : string) (~index : u64)
    (~rows : string)
    : string
    =
    ? index < line_count log ?>
        := entry = line_at log index
        := hash = tab_part entry 0i32
        := after = occurrences (part_at (git_run root repo (concat5 "show\n" hash ":" path "") "") 1i32) needle
        := before = occurrences (part_at (git_run root repo (concat5 "show\n" hash "^:" path "") "") 1i32) needle
        := change = ? after < before ?> "removed" |: "added"
        := next = row hash (row (tab_part entry 1i32) (row change (tab_part entry 2i32)))
        history_rows root repo needle path log (index + 1u64) (joined rows next)
    |: rows

:~ history_report (~root : string) (~repo : string) (~needle : string) (~path : string) : string * bool * u64 * u64 =
    := outcome =
        git_run root repo
            (concat5 "log\n--abbrev=8\n--format=%h%x09%ad%x09%s\n--date=short\n-S" needle "\n--\n" path "")
            ""
    ? succeeded outcome ?>
        := log = part_at outcome 1i32
        := table = history_rows root repo needle path log 0u64 (row "commit" (row "date" (row "change" "subject")))
        := found = matching_lines root (concat5 repo "/" path "" "") needle
        joined (aligned table) found, !-, line_count log, line_count found
    |: failure_row (concat5 "git history " repo "" "" "") outcome, !+, 0u64, 0u64

:~ days_report (~root : string) (~repo : string) (~since : string) : string * bool * u64 * u64 =
    := bare_date = $'(!since).len() == 10' : bool
    := window = ? since = "" ?> "" |: concat5 "\n--since=" since (? bare_date ?> " 00:00:00" |: "") "" ""
    := outcome = git_run root repo (concat5 "log\n--format=%ad\n--date=short" window "" "" "") ""
    ? succeeded outcome ?>
        := dates = part_at outcome 1i32
        := counted = days_counted dates
        aligned (joined (row "day" "commits") counted), !-, line_count dates, line_count counted
    |: failure_row (concat5 "git log " repo "" "" "") outcome, !+, 0u64, 0u64

:~ state_row (~repo : string) (~label : string) (~paths : string) : string =
    ? paths = "" ?> "" |: row repo (row label (row (decimal_text (line_count paths)) (replace paths "\n" ", ")))

:~ ^ staged_from (~rows : array string) (index : i32) (~found : string) : string =
    ? index >= am'.length rows ?> found
    |:
        := row = am'.index index rows
        := size : i32 = sm'.length row
        := mark = ? size > 3i32 ?> sm'.substring 0i32 1i32 row |: " "
        := path = ? size > 3i32 ?> sm'.replace "\"" "" (sm'.substring 3i32 (size - 3i32) row) |: ""
        staged_from rows (index + 1i32) (? mark = " " || mark = "?" ?> found |: joined found path)

:~ staged_paths (~lines : string) : string = staged_from (sm'.split "\n" lines |> array) 0i32 ""

:~ ^ status_rows
    (~root : string) (~repos : string) (~index : u64) (~rows : string) (failed : bool) (seen : u64) (changed : u64)
    (fresh : u64)
    : string * bool * u64 * u64 * u64
    =
    ? index < line_count repos
    ?>
        := repo = line_at repos index
        := outcome = git_run root repo "status\n--porcelain\n--untracked-files=all" ""
        ? succeeded outcome
        ?>
            := lines = part_at outcome 1i32
            := modified = porcelain_paths lines !-
            := untracked = porcelain_paths lines !+
            := shown =
                ? lines = ""
                ?> row repo (row "clean" "0")
                |:
                    := staged = state_row repo "staged" (staged_paths lines)
                    := tracked = joined (state_row repo "modified" modified) staged
                    joined tracked (state_row repo "untracked" untracked)
            := more = changed + line_count modified
            := newer = fresh + line_count untracked
            status_rows root repos (index + 1u64) (joined rows shown) failed (seen + 1u64) more newer
        |:
            := failure = row repo (row "failed" (row "-" (part_at outcome 2i32)))
            status_rows root repos (index + 1u64) (joined rows failure) !+ seen changed fresh
    |: aligned rows, failed, seen, changed, fresh

:~ status_report (~root : string) (~repos : string) : string * bool * u64 * u64 * u64 =
    status_rows root repos 0u64 (row "repo" (row "state" (row "count" "paths"))) !- 0u64 0u64 0u64

:= main () : i32 =
    export
        "kit_do_git_history"
        (
            \ (root, repo, needle, path) => history_report root repo needle path
            : string * string * string * string -> string * bool * u64 * u64
        )
    export
        "kit_do_git_days"
        ((\ (root, repo, since) => days_report root repo since) : string * string * string -> string * bool * u64 * u64)
    export
        "kit_do_git_status"
        ((\ (root, repos) => status_report root repos) : string * string -> string * bool * u64 * u64 * u64)
    0i32
