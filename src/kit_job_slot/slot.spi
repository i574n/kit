///- --package .
:# slot static =
    :< sm'_operators

:< sm'_operators
:< kit_jobs.host
:< kit_jobs.model
:< kit_jobs.jobs
:< kit_machine_windows.window_model
:< kit_machine_windows.windows

:~ heavy_queue () : string =
    $'std::rc::Rc::<str>::from(std::env::var_os("KIT_HEAVY_QUEUE").map(|queue| \
        std::path::PathBuf::from(queue).to_string_lossy().into_owned()).or_else(|| \
        std::env::var_os("LOCALAPPDATA").or_else(|| std::env::var_os("HOME")).map(|base| \
        std::path::PathBuf::from(base).join("spiral-bin").join("heavy-queue").to_string_lossy().into_owned())).unwrap_\
        or_default().as_str())' : string

:~ ticket_created (~queue : string) : string =
    $'std::rc::Rc::<str>::from({ let ticks = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|e\
        lapsed| elapsed.as_nanos() as u64 / 100).unwrap_or(0) + 621355968000000000u64; let name = \
        format\!("{:020}-{}.t", ticks, std::process::id()); let _ = std::fs::create_dir_all(&*!queue); match \
        std::fs::write(std::path::Path::new(&*!queue).join(&name), b"") { Ok(()) => name, Err(_) => String::new() } \
        }.as_str())' : string

:~ tickets_sorted (~queue : string) : string =
    $'std::rc::Rc::<str>::from({ let mut names = std::fs::read_dir(&*!queue).into_iter().flatten().flatten().map(|entr\
        y| entry.file_name().to_string_lossy().into_owned()).filter(|name| name.ends_with(".t")).collect::<Vec<_>>(); \
        names.sort(); names.join("\n") }.as_str())' : string

let ticket_pid (~name : string) : u64 = $'(!name).trim_end_matches(".t").split(char::from(45u8)).nth(1).and_then(|pid| \
    pid.parse::<u64>().ok()).unwrap_or(0)' : u64

:~ ^ first_live_ticket (~names : string) : string =
    ? names = "" ?> ""
    |:
        := name = first_row names
        ? process_alive (ticket_pid name) ?> name |: first_live_ticket (other_rows names)

:~ ticket_ticks (~name : string) : u64 =
    $'(!name).split(char::from(45u8)).next().and_then(|ticks| ticks.parse::<u64>().ok()).unwrap_or(0)' : u64

:~ own_pid () : u64 = $'std::process::id() as u64' : u64

:~ ticket_written (~queue : string) (~name : string) : bool =
    $'std::fs::create_dir_all(&*!queue).and_then(|_| std::fs::write(std::path::Path::new(&*!queue).join(&*!name), \
        b"")).is_ok()'
    : bool

:= ticket_name (ticks : u64) (pid : u64) : string =
    sm'.pad_left 20i32 '0' (sm'.show ticks) ++# "-" ++# sm'.show pid ++# ".t"

:= front_name (head_ticks : u64) (pid : u64) : string = ticket_name (head_ticks - 1u64) pid

:~ front_ticket (~queue : string) : string =
    := head = first_live_ticket (tickets_sorted queue)
    ? head = "" || ticket_ticks head = 0u64
    ?> ticket_created queue
    |:
        := name = front_name (ticket_ticks head) (own_pid ())
        ? ticket_written queue name ?> name |: ""
:~ slot_free (free : u64) : bool =
    $'{ \#[cfg(windows)] fn probe(name: &str) -> bool { unsafe extern "system" { fn OpenMutexW(access: u32, inherit: \
        i32, name: *const u16) -> *mut std::ffi::c_void; fn WaitForSingleObject(handle: *mut std::ffi::c_void, ms: \
        u32) -> u32; fn ReleaseMutex(handle: *mut std::ffi::c_void) -> i32; fn CloseHandle(handle: *mut \
        std::ffi::c_void) -> i32; } let name = name.encode_utf16().chain(std::iter::once(0u16)).collect::<Vec<u16>>(); \
        unsafe { let handle = OpenMutexW(0x0010_0001, 0, name.as_ptr()); if handle.is_null() { return true; } let \
        state = WaitForSingleObject(handle, 0); let taken = state == 0 || state == 0x80; if taken { \
        ReleaseMutex(handle); } CloseHandle(handle); taken } } \#[cfg(not(windows))] fn probe(_name: &str) -> bool { \
        true } let base = std::env::var("KIT_HEAVY_MUTEX").unwrap_or_else(|_| format\!("Global{}spiral-heavy-job", \
        char::from(92u8))); probe(&base) || (!free > 3072 && probe(&format\!("{base}-2"))) }' : bool

:~ ticket_adopted (~name : string) : () = $'unsafe { std::env::set_var("SPIRAL_HEAVY_TICKET", &*!name); }' : ()

:~ slot_deadline_passed (~id : string) (now : u64) : bool =
    := by = decimal_u64 (text_or_empty (job_file id "slot_by_ms"))
    by <> 0u64 && now > by

:~ ^ slot_loop (~id : string) (~queue : string) (~ticket : string) (since : u64) : i32 =
    := now = now_ms ()
    := _ = text_written (job_file id "heartbeat_ms") (decimal_text now)
    ? file_exists (job_file id "stop") ?>
        := _ = file_removed (joined queue ticket)
        := _ = text_written (job_file id "exit") (halt_line HaltOnRequest now (tree_stop_of 0u64))
        := _ = text_written (job_file id "slot") ("settled ticket=" ++# ticket ++# " state=stopped")
        143i32
    |? slot_deadline_passed id now ?>
        := _ = file_removed (joined queue ticket)
        := _ =
            text_written
                (job_file id "exit")
                (exit_line 75i32 now JobExpiredInQueue "no heavy slot within --slot-within; the job never started")
        := _ = text_written (job_file id "slot") ("settled ticket=" ++# ticket ++# " state=expired-in-queue")
        75i32
    |? first_live_ticket (tickets_sorted queue) = ticket && slot_free (free_mb ()) ?>
        ticket_adopted ticket
        := _ =
            text_written (job_file id "slot") ("ready ticket=" ++# ticket ++# " waited_ms=" ++# (decimal_text (
                now - since)))
        0i32
    |:
        := _ =
            text_written (job_file id "slot") ("waiting ticket=" ++# ticket ++# " first=" ++# (first_live_ticket (
                tickets_sorted queue)))
        sleep_ms 500u64
        slot_loop id queue ticket since

:~ ticket_renamed (~queue : string) (~name : string) (~owned : string) : bool =
    $'std::fs::rename(std::path::Path::new(&*!queue).join(&*!name), \
        std::path::Path::new(&*!queue).join(&*!owned)).is_ok()' : bool

:~ handed_ticket (~id : string) (~queue : string) : string =
    := handed = text_or_empty (job_file id "slot_ticket")
    := owned = ticket_name (ticket_ticks handed) (own_pid ())
    ? handed <> "" && ticket_renamed queue handed owned ?> owned |: ""

:~ slot_gate (~id : string) : i32 =
    := queue = heavy_queue ()
    := handed = ? queue = "" ?> "" |: handed_ticket id queue
    := ticket =
        ? queue = "" || handed <> "" ?> handed
        |? file_exists (job_file id "front") ?> front_ticket queue
        |: ticket_created queue
    ? ticket = "" ?> 0i32 |: slot_loop id queue ticket (now_ms ())

:~ held_ticket (~id : string) (~queue : string) : string =
    := recorded = text_or_empty (job_file id "slot_ticket")
    ? recorded <> "" && file_exists (joined queue recorded) ?> recorded
    |:
        := name = ? file_exists (job_file id "front") ?> front_ticket queue |: ticket_created queue
        := _ = text_written (job_file id "slot_ticket") name
        := _ = text_written (joined queue name) id
        name

:~ abandoned_swept (~queue : string) (~first : string) (now : u64) : () =
    := text = text_or_empty (joined queue first)
    := owner = first_row text
    := handed = decimal_u64 (other_rows text)
    := held = file_exists (joined (joined (jobs_root ()) "held") owner)
    ? first = "" || ticket_pid first <> own_pid () || held || (handed <> 0u64 && now - handed < 60000u64) ?> ()
    |:
        := _ = file_removed (joined queue first)
        ()

:~ slot_held_step (~id : string) : i32 =
    := queue = heavy_queue ()
    ? queue = "" || file_exists (job_file id "heavy-wrapper.ps1") = !- ?> 0i32
    |:
        := now = now_ms ()
        := ticket = held_ticket id queue
        abandoned_swept queue (first_live_ticket (tickets_sorted queue)) now
        := first = first_live_ticket (tickets_sorted queue)
        ? ticket = "" ?> 0i32
        |? slot_deadline_passed id now ?>
            := _ = file_removed (joined queue ticket)
            := _ =
                text_written
                    (job_file id "exit")
                    (exit_line 75i32 now JobExpiredInQueue "no heavy slot within --slot-within; the job never started")
            := _ = text_written (job_file id "slot") ("settled ticket=" ++# ticket ++# " state=expired-in-queue")
            2i32
        |? first = ticket && slot_free (free_mb ()) ?>
            := _ = text_written (joined queue ticket) (id ++# "\n" ++# decimal_text now)
            := _ = text_written (job_file id "slot") ("handed ticket=" ++# ticket)
            0i32
        |:
            := _ = text_written (job_file id "slot") ("held ticket=" ++# ticket ++# " first=" ++# first)
            1i32

:~ slot_ticket_dropped (~id : string) : () =
    := name = text_or_empty (job_file id "slot_ticket")
    ? name = "" ?> ()
    |:
        := _ = file_removed (joined (heavy_queue ()) name)
        ()

///> rust
:# a_front_ticket_sorts_one_tick_before_the_head =
    ? front_name 639286833110079226u64 42u64 = "00639286833110079225-42.t" ?> () |: failwith "front ticket sorts first"

///> rust
:# a_handed_ticket_keeps_its_place_under_the_new_owner =
    := handed = "00639286833110079225-7.t"
    ? ticket_name (ticket_ticks handed) 42u64 = "00639286833110079225-42.t" ?> () |: failwith "same ticks, new pid"

///> _
:= main () : i32 =
    !!!!Export("kit_job_slot_gate", ((\ id => slot_gate id) : string -> i32))
    !!!!Export("kit_job_slot_held_step", ((\ id => slot_held_step id) : string -> i32))
    !!!!Export("kit_job_slot_ticket_dropped", ((\ id => slot_ticket_dropped id) : string -> ()))
    0i32
