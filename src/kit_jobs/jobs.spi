:< rust_std_string.model
:< sm'_operators
:< model
:< host

:~ job_directory (~id : string) : string = joined (jobs_root ()) id
:~ job_file (~id : string) (~name : string) : string = joined (job_directory id) name

:~ job_environment_adopted (~id : string) : () =
    := path = job_file id "env"
    ? file_exists path ?>
        env.environment_restored (text_or_empty path) "KIT_JOB_"
        file_system.file_delete path
    |: ()

:~ job_record_of (~id : string) : job_record =
    record_at
        (text_or_empty (job_file id "exit"))
        (decimal_u64 (text_or_empty (job_file id "heartbeat_ms")))
        (decimal_u64 (text_or_empty (job_file id "started_ms")))
        (now_ms ())

:~ job_state_now (~id : string) : job_state =
    := record = job_record_of id
    := state = job_state_of record
    ?= state ?|
    | Settled (JobLost) =>
        := supervisor = decimal_u64 (text_or_empty (job_file id "supervisor"))
        ? file_exists (joined (joined (jobs_root ()) "held") id)
        ?> Live JobPending
        |? supervisor <> 0u64 && process_alive supervisor
        ?> Live JobRunning
        |:
            := child = decimal_u64 (text_or_empty (job_file id "pid"))
            := gone = child = 0u64 || process_alive child = !-
            := _ =
                ? record.exit_text = "" && gone
                ?>
                    text_written
                        (job_file id "exit")
                        (
                            exit_line 125i32
                                (? record.heartbeat_ms > 0u64 ?> record.heartbeat_ms |: record.started_ms)
                                JobLost
                                (
                                    "the supervisor stopped beating: it was killed (with its caller, by the memory "
                                    ^^ "reaper) or crashed, and its job tree ended with it"
                                )
                        )
                |: ""
            state
    | _ => state

:~ elapsed_of (~id : string) : u64 =
    := record = job_record_of id
    := exit_text = record.exit_text
    := ended = ? exit_text = "" ?> record.now_ms |: decimal_u64 ($'std::rc::Rc::<str>::from(!exit_text.split(char::fro\
        m(9u8)).nth(1).unwrap_or("0"))' : string)
    ? ended > record.started_ms ?> ended - record.started_ms |: 0u64

:| gate_wait =
    | NotWaiting
    | WaitingAfter : string
    | WaitingWindow : string
    | WaitingSlot

:~ gate_wait_of (~id : string) : gate_wait =
    ? file_exists (job_file id "after") && not (file_exists (job_file id "after-done"))
    ?> WaitingAfter (sm'.split "\t" (text_or_empty (job_file id "after")) |> array |> am'.index 0i32 |> sm'.trim)
    |? file_exists (job_file id "window-class")
    ?>
        ? sm'.starts_with "granted" (text_or_empty (job_file id "window")) ?> NotWaiting
        |: WaitingWindow (sm'.trim (text_or_empty (job_file id "window-class")))
    |?
        file_exists (job_file id "heavy-wrapper.ps1") && not (sm'.contains "Invoke-Heavy: acquired slot" (
            text_or_empty (job_file id "stdout.log")))
    ?> WaitingSlot
    |: NotWaiting

:= waiting_for (wait : gate_wait) : string =
    ?= wait ?|
    | NotWaiting => ""
    | WaitingAfter predecessor => " waiting_for=after:" ++# predecessor
    | WaitingWindow window_class => " waiting_for=window:" ++# window_class
    | WaitingSlot => " waiting_for=heavy-slot"

:~ gate_queued (~id : string) : bool = gate_wait_of id <> NotWaiting

:~ job_summary (~verb : string) (~id : string) : string =
    := state = job_state_now id
    := head = concat5 "kit job " verb " ok id=" id " state="
    := wait = ? state_settled state ?> NotWaiting |: gate_wait_of id
    := codes =
        state_shown state (wait <> NotWaiting)
        ++# waiting_for wait
        ++# " exit="
        ++# exit_shown state
        ++# " elapsed_ms="
        ++# decimal_text (elapsed_of id)
    := sizes =
        concat5
            " stdout_bytes="
            (decimal_text (file_bytes (job_file id "stdout.log")))
            " stderr_bytes="
            (decimal_text (file_bytes (job_file id "stderr.log")))
            ""
    := detail = exit_detail (text_or_empty (job_file id "exit"))
    := detail_text = ? detail = "" ?> "" |: concat5 " detail=\"" detail "\"" "" ""
    := label = concat5 " label=" (text_or_empty (job_file id "label")) "" "" ""
    := cap = text_or_empty (job_file id "memory_cap_mb")
    := memory =
        ? cap = ""
        ?> ""
        |:
            concat5
                " max_private_mb="
                cap
                " peak_private_mb="
                (? file_exists (job_file id "peak_private_mb") ?> text_or_empty (job_file id "peak_private_mb") |: "0")
                ""
    concat5 head codes sizes detail_text (concat5 memory label "" "" "")

:~ shared_state (~id : string) : job_state =
    := word, code, detail = $'kit_job_state::kit_job_state_parts(&*!id)' : string * i32 * string
    state_of_parts word code detail

:~ shared_summary (~verb : string) (~id : string) : string = $'kit_job_state::kit_job_summary(&*!verb, &*!id)' : string
:~ rejected (~message : string) : i32 =
    stderr_line (concat5 "kit error: job " message "" "" "")
    2i32

:= known_job (~id : string) : bool = starts_with id "job-" && directory_exists (job_directory id)

:~ job_status () : i32 =
    := id = argument 3i32
    ? known_job id ?>
        := _ = held_revival ()
        stdout_line (shared_summary "status" id)
        0i32
    |: rejected (concat5 "status: unknown job id " id "" "" "")

:~ ^ waited (~id : string) (deadline : u64) (~watch : u64) : job_state =
    := state = shared_state id
    ? state_settled state || now_ms () > deadline || process_alive watch = !- ?> state
    |:
        sleep_ms 250u64
        waited id deadline watch

:~ watched_caller () : u64 =
    := inherited = $'std::env::var("KIT_JOB_WATCH").ok().and_then(|value| value.parse::<u64>().ok()).unwrap_or(0)' : u64
    ? inherited = 0u64 ?> parent_pid () |: inherited

:~ job_waited () : i32 =
    := id = argument 3i32
    ? known_job id ?>
        := _ = held_revival ()
        := deadline = now_ms () + (? argument_count () > 4i32 ?> decimal_u64 (argument 4i32) |: 864000000u64)
        := state = waited id deadline (watched_caller ())
        stdout_line (shared_summary "wait" id)
        state_exit state
    |: rejected (concat5 "wait: unknown job id " id "" "" "")

:~ started_code (attached : bool) : i32 =
    := result =
        ? attached
        ?> $'kit_job_launch::kit_job_start(true)' : string
        |: $'kit_job_launch::kit_job_start(false)' : string
    := code =
        $'(!result).split(char::from(9u8)).next().and_then(|code| code.trim().parse::<i32>().ok()).unwrap_or(2)' : i32
    := id = $'std::rc::Rc::<str>::from((!result).split(char::from(9u8)).nth(1).unwrap_or("").trim())' : string
    := _ = ? attached && id <> "" ?> stdout_line (shared_summary "run" id) |: ()
    code

:~ job_run () : i32 =
    ?= job_command_of (argument 2i32) ?|
    | JobStart => started_code !-
    | JobRun => started_code !+
    | JobSupervise =>
        := id = argument 3i32
        $'kit_job_supervise::kit_job_supervise(&*!id)' : i32
    | JobHost => $'kit_job_host::kit_job_host_run()' : i32
    | JobStatus => job_status ()
    | JobWait => job_waited ()
    | JobList => $'kit_job_control::kit_job_list_run()' : i32
    | JobTail => $'kit_job_control::kit_job_tail_run()' : i32
    | JobStop => $'kit_job_control::kit_job_stop_run()' : i32
    | JobAfter => $'kit_job_rechain::kit_job_rechain_run()' : i32
    | JobChain =>
        ? optionm'.default_value "" (env.try_command_line_argument 2i32) = "--run-serial"
        ?> $'kit_job_serial::kit_job_serial_run()' : i32
        |: $'kit_job_chain::kit_job_chain_run()' : i32
    | JobAmend => $'kit_job_control::kit_job_amend_run()' : i32
    | JobDoctor => $'kit_jobs_doctor::kit_job_doctor_run()' : i32
    | JobUnknown => rejected (job_usage ())

:= main () : i32 =
    !!!!Export("kit_job_run", ((\ () => job_run ()) : () -> i32))
    0i32
