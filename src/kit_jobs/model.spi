///- --package .
:# model static =
    :< rust_std_string.model

:< rust_std_string.model

:| job_command =
    | JobStart
    | JobRun
    | JobSupervise
    | JobHost
    | JobStatus
    | JobWait
    | JobList
    | JobTail
    | JobStop
    | JobAfter
    | JobChain
    | JobAmend
    | JobDoctor
    | JobUnknown

:= job_command_of (~word : string) : job_command =
    ? word = "start" ?> JobStart
    |? word = "run" ?> JobRun
    |? word = "supervise" ?> JobSupervise
    |? word = "host" ?> JobHost
    |? word = "status" ?> JobStatus
    |? word = "wait" ?> JobWait
    |? word = "list" ?> JobList
    |? word = "tail" ?> JobTail
    |? word = "stop" ?> JobStop
    |? word = "after" ?> JobAfter
    |? word = "chain" ?> JobChain
    |? word = "amend" ?> JobAmend
    |? word = "doctor" ?> JobDoctor
    |: JobUnknown

:= job_usage () : string =
    "job doctor [--env] (audits kit processes, job files and after-chains; --env also compares a detached job's "
    ^^ "environment with this shell's; exit 1 on a finding) | job after <queued-id> <predecessor-id> [--ok] "
    ^^ "(re-points a job still waiting on --after/--after-ok; label, timeout, gate and command are kept) | job chain "
    ^^ "[--ok] [--serial] [<after-id>] -- <label> <timeout-ms> <program> [args...] -- <label> ... (starts each job "
    ^^ "after the previous one and prints every id; --serial runs the links in order inside one job, so waiting links "
    ^^ "hold no process) | job start [--after <id>|--after-ok <id>] [--heavy|--compile] [--max-private-mb <n>] "
    ^^ "[--slot-within <minutes>] [--done-within <minutes>] [--min-free-mb <n>] [--quiet [--quiet-hold <min>] "
    ^^ "[--quiet-wait <min>]] [--settle-ms <n>] <label> <timeout-ms> <program> [args...] (the cap covers the whole "
    ^^ "job tree; reaching it stops the job as memory-capped, exit 137; a plain start without --after watches the job "
    ^^ "for --settle-ms, default 2000, 0 skips, and a job that already failed prints 'job start failed' with its exit "
    ^^ "and first stderr line and exits with its code) | job run [--after <id>|--after-ok <id>] [--heavy|--compile] "
    ^^ "[--max-private-mb <n>] [--slot-within <minutes>] [--done-within <minutes>] [--min-free-mb <n>] [--quiet "
    ^^ "[--quiet-hold <min>] [--quiet-wait <min>]] <label> <timeout-ms> <program> [args...] (supervises in this "
    ^^ "process, so the job's processes stay in the caller's tree and end with it; exits with the job's code; for "
    ^^ "long runs from an agent shell that can be reaped, use job start plus a background job wait) | job status <id> "
    ^^ "| job wait <id> [max-ms, default until it settles] | job list [count] | job tail <id> [lines] | job stop <id> "
    ^^ "| job amend <id> --timeout <ms> (a queued job only; the limit is read when its child starts)"

:| job_live =
    | JobPending
    | JobRunning

:| job_settled =
    | JobFinished : i32
    | JobTimedOut
    | JobStopped
    | JobSpawnFailed : string
    | JobSkipped : string
    | JobLost
    | JobMemoryCapped
    | JobExpiredInQueue

:| job_state =
    | Live : job_live
    | Settled : job_settled

:~ live_word (live : job_live) : string =
    ?= live ?|
    | JobPending => "pending"
    | JobRunning => "running"

:~ settled_word (settled : job_settled) : string =
    ?= settled ?|
    | JobFinished _ => "finished"
    | JobTimedOut => "timed-out"
    | JobStopped => "stopped"
    | JobSpawnFailed _ => "spawn-failed"
    | JobSkipped _ => "skipped"
    | JobLost => "lost"
    | JobMemoryCapped => "memory-capped"
    | JobExpiredInQueue => "expired-in-queue"

:~ settled_exit (settled : job_settled) : i32 =
    ?= settled ?|
    | JobFinished code => code
    | JobTimedOut => 124i32
    | JobStopped => 143i32
    | JobSpawnFailed _ => 125i32
    | JobSkipped _ => 125i32
    | JobLost => 125i32
    | JobMemoryCapped => 137i32
    | JobExpiredInQueue => 75i32

:= still_running_exit () : i32 = 3i32

:~ state_word (state : job_state) : string =
    ?= state ?|
    | Live live => live_word live
    | Settled settled => settled_word settled

:~ state_exit (state : job_state) : i32 =
    ?= state ?|
    | Live _ => still_running_exit ()
    | Settled settled => settled_exit settled

:~ state_settled (state : job_state) : bool =
    ?= state ?|
    | Live _ => !-
    | Settled _ => !+

:~ state_detail (state : job_state) : string =
    ?= state ?|
    | Live _ => ""
    | Settled settled =>
        ?= settled ?|
        | JobSpawnFailed detail => detail
        | JobSkipped detail => detail
        | _ => ""

:~ state_of_parts (~word : string) (code : i32) (~detail : string) : job_state =
    ? word = "pending" ?> Live JobPending
    |? word = "running" ?> Live JobRunning
    |? word = "finished" ?> Settled (JobFinished code)
    |? word = "timed-out" ?> Settled JobTimedOut
    |? word = "stopped" ?> Settled JobStopped
    |? word = "lost" ?> Settled JobLost
    |? word = "memory-capped" ?> Settled JobMemoryCapped
    |? word = "expired-in-queue" ?> Settled JobExpiredInQueue
    |? word = "skipped" ?> Settled (JobSkipped detail)
    |: Settled (JobSpawnFailed detail)
:= state_shown (state : job_state) (gate_wait : bool) : string =
    ? gate_wait && state_settled state = !- ?> "queued" |: state_word state

:= exit_shown (state : job_state) : string =
    ?= state ?|
    | Live _ => "-"
    | Settled settled => $'std::rc::Rc::<str>::from((!(settled_exit settled)).to_string())' : string

:= silence_limit_ms () : u64 = 15000u64

:== job_record =
    {
        exit_text : string
        heartbeat_ms : u64
        started_ms : u64
        now_ms : u64
    }

:= exit_word (~exit_text : string) : string = $'std::rc::Rc::<str>::from(!exit_text.split(char::from(9u8)).nth(2).unwr\
    ap_or("").trim())' : string
:= exit_code (~exit_text : string) : i32 = $'!exit_text.split(char::from(9u8)).next().and_then(|code| \
    code.trim().parse::<i32>().ok()).unwrap_or(1)' : i32
:= exit_detail (~exit_text : string) : string = $'std::rc::Rc::<str>::from(!exit_text.split(char::from(9u8)).nth(3).un\
    wrap_or("").trim())' : string

:= silent_since (record : job_record) (since : u64) : bool = since + silence_limit_ms () < record.now_ms

:~ job_state_of (record : job_record) : job_state =
    ? record.exit_text <> "" ?>
        := word = exit_word record.exit_text
        ? word = "finished" ?> Settled (JobFinished (exit_code record.exit_text))
        |? word = "timed-out" ?> Settled JobTimedOut
        |? word = "stopped" ?> Settled JobStopped
        |? word = "lost" ?> Settled JobLost
        |? word = "memory-capped" ?> Settled JobMemoryCapped
        |? word = "expired-in-queue" ?> Settled JobExpiredInQueue
        |? word = "skipped" ?> Settled (JobSkipped (exit_detail record.exit_text))
        |: Settled (JobSpawnFailed (exit_detail record.exit_text))
    |? record.heartbeat_ms > 0u64 ?>
        ? silent_since record record.heartbeat_ms ?> Settled JobLost |: Live JobRunning
    |? silent_since record record.started_ms ?> Settled JobLost
    |: Live JobPending

:= exit_record (code : i32) (ended : u64) (~word : string) (~detail : string) : string =
    := code_text = $'std::rc::Rc::<str>::from((!code).to_string())' : string
    := ended_text = $'std::rc::Rc::<str>::from((!ended).to_string())' : string
    concat5 code_text "\t" ended_text "\t" (concat5 word "\t" detail "\n" "")

:= exit_line (code : i32) (ended : u64) (settled : job_settled) (~detail : string) : string =
    exit_record code ended (settled_word settled) detail

:| tree_stop =
    | TreeStopped
    | SurvivorsLeft : u64

:= tree_stop_of (~survivors : u64) : tree_stop = ? survivors = 0u64 ?> TreeStopped |: SurvivorsLeft survivors

:= tree_text = function
    | TreeStopped => "process tree stopped"
    | SurvivorsLeft count =>
        concat5 ($'std::rc::Rc::<str>::from((!count).to_string())' : string) " processes left alive" "" "" ""

:| job_halt =
    | KeepRunning
    | HaltOnTimeout
    | HaltOnRequest
    | HaltOnMemory

:= halt_of (expired : bool) (requested : bool) (capped : bool) : job_halt =
    ? requested ?> HaltOnRequest |? capped ?> HaltOnMemory |? expired ?> HaltOnTimeout |: KeepRunning

:= halt_code = \|
    | HaltOnRequest => 143i32
    | HaltOnMemory => 137i32
    | _ => 124i32

:= halt_word = \|
    | HaltOnRequest => "stopped"
    | HaltOnMemory => "memory-capped"
    | _ => "timed-out"

:= halt_reason = \|
    | HaltOnRequest => "stopped on request"
    | HaltOnMemory => "private memory cap reached"
    | _ => "wall-clock timeout"

:= halt_detail (halt : job_halt) (stop : tree_stop) : string = concat5 (halt_reason halt) "; " (tree_text stop) "" ""

:= halt_terms = \|
    | HaltOnRequest => 143i32, "stopped", "stopped on request"
    | HaltOnMemory => 137i32, "memory-capped", "private memory cap reached"
    | _ => 124i32, "timed-out", "wall-clock timeout"

:= halt_line (halt : job_halt) (ended : u64) (stop : tree_stop) : string =
    := code, word, reason = halt_terms halt
    exit_record code ended word (concat5 reason "; " (tree_text stop) "" "")

:| stop_verdict =
    | StopRequested
    | StopRefused : string

:= stop_verdict_of (state : job_state) : stop_verdict =
    ?= state ?|
    | Live _ => StopRequested
    | Settled settled => StopRefused (concat5 "is already " (settled_word settled) "; nothing to stop" "" "")

:= stop_reason = \|
    | StopRequested => ""
    | StopRefused reason => reason

:= label_safe (~label : string) : string =
    $'std::rc::Rc::<str>::from(!label.chars().map(|c| if c.is_ascii_alphanumeric() || c == char::from(45u8) { c } \
        else { char::from(95u8) }).take(40).collect::<String>())' : string

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail

:= record_at (exit_text : string) (heartbeat : u64) (started : u64) (now : u64) : job_record =
    { exit_text = exit_text; heartbeat_ms = heartbeat; started_ms = started; now_ms = now }

///> rust
:# job_states_follow_the_registry_records =
    expect (state_word (job_state_of (record_at "" 0u64 1000u64 2000u64)) = "pending") "fresh start"
    expect (state_word (job_state_of (record_at "" 0u64 1000u64 40000u64)) = "lost") "never started"
    expect (state_word (job_state_of (record_at "" 30000u64 1000u64 40000u64)) = "running") "recent heartbeat"
    expect (state_word (job_state_of (record_at "" 10000u64 1000u64 40000u64)) = "lost") "stale heartbeat"
    expect (state_exit (job_state_of (record_at "7\t5000\tfinished\t" 4000u64 1000u64 40000u64)) = 7i32) "finished code"
    expect
        (state_exit (job_state_of (record_at "1\t5000\ttimed-out\t" 4000u64 1000u64 40000u64)) = 124i32)
        "timeout code"
    expect
        (
            state_word (job_state_of (record_at "125\t5000\tspawn-failed\tno such program" 0u64 1000u64 40000u64))
            = "spawn-failed"
        )
        "spawn failure"
    expect
        (
            state_word (
                job_state_of (
                    record_at "75\t5000\texpired-in-queue\tno heavy slot within --slot-within" 0u64 1000u64 40000u64
                )
            )
            = "expired-in-queue"
        )
        "a queue deadline settles before any start"
    expect
        (
            state_exit (
                job_state_of (
                    record_at "75\t5000\texpired-in-queue\tno heavy slot within --slot-within" 0u64 1000u64 40000u64
                )
            )
            = 75i32
        )
        "expired jobs exit 75"

///> rust
:# labels_become_safe_directory_names =
    expect (label_safe "kit regen: batch 1/7" = "kit_regen__batch_1_7") "unsafe characters"
    expect (job_command_of "wait" <> JobUnknown) "known verb"
    expect (job_command_of "stop" = JobStop) "stop verb"
    expect (job_command_of "amend" = JobAmend) "amend verb"
    expect (job_command_of "run" = JobRun) "run verb"

///> rust
:# a_running_job_shows_no_exit_code_and_a_gated_one_shows_queued =
    expect (exit_shown (Live JobRunning) = "-") "running has no exit yet"
    expect (exit_shown (Settled JobStopped) = "143") "stopped exit"
    expect (state_shown (Live JobRunning) !+ = "queued") "waiting on the heavy gate"
    expect (state_shown (Live JobRunning) !- = "running") "admitted"
    expect (state_shown (Settled (JobFinished 0i32)) !+ = "finished") "a settled job is never queued"
    expect
        (state_exit (Live JobPending) = 3i32 && state_exit (Settled (JobSkipped "x")) = 125i32)
        "a live job waits with 3, a skipped one exits 125"

///> rust
:# a_timeout_names_what_survived_the_tree_stop =
    expect (halt_detail HaltOnTimeout (tree_stop_of 0u64) = "wall-clock timeout; process tree stopped") "clean stop"
    expect
        (halt_detail HaltOnTimeout (tree_stop_of 2u64) = "wall-clock timeout; 2 processes left alive")
        "survivors counted"
    expect
        (
            exit_detail (exit_line 124i32 9u64 JobTimedOut (halt_detail HaltOnTimeout (tree_stop_of 2u64)))
            = "wall-clock timeout; 2 processes left alive"
        )
        "detail round trip"

///> rust
:# a_stop_request_wins_over_the_deadline_and_settles_as_stopped =
    expect (halt_of !- !- !- = KeepRunning) "no reason to halt"
    expect (halt_of !+ !- !- = HaltOnTimeout) "deadline passed"
    expect (halt_of !+ !+ !+ = HaltOnRequest) "request wins"
    expect (halt_of !+ !- !+ = HaltOnMemory) "the cap wins over the deadline"
    expect (halt_detail HaltOnRequest (tree_stop_of 0u64) = "stopped on request; process tree stopped") "request detail"
    := line = halt_line HaltOnRequest 9u64 (tree_stop_of 0u64)
    := settled = job_state_of (record_at line 4000u64 1000u64 40000u64)
    expect (state_word settled = "stopped") "stopped round trip"
    expect (state_exit settled = 143i32) "stopped exit"

///> rust
:# only_unsettled_jobs_accept_a_stop =
    expect (stop_reason (stop_verdict_of (Live JobRunning)) = "") "running"
    expect (stop_reason (stop_verdict_of (Live JobPending)) = "") "pending"
    expect
        (stop_reason (stop_verdict_of (Settled (JobFinished 0i32))) = "is already finished; nothing to stop")
        "finished"
    expect (stop_reason (stop_verdict_of (Settled JobLost)) = "is already lost; nothing to stop") "lost"

///> rust
:# a_state_survives_its_parts =
    := round (state : job_state) : bool =
        state_of_parts (state_word state) (state_exit state) (state_detail state) = state
    expect (round (Live JobRunning) && round (Live JobPending)) "live states"
    expect
        (round (Settled (JobFinished 3i32)) && round (Settled JobTimedOut) && round (Settled JobLost))
        "settled states"
    expect
        (round (Settled (JobSkipped "after failed")) && round (Settled (JobSpawnFailed "no such program")))
        "states with a detail"
