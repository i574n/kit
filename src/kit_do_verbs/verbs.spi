///- --package .
:# verbs static =
    :< kit_do_model.model
    :< kit_do_records.records

:< kit_do_model.model
:< kit_do_records.records

:| fact_verb =
    | HashVerb
    | EnvVerb
    | ExistsVerb
    | NearestVerb
    | JsonVerb
    | LinesVerb
    | TableVerb
    | DirsVerb
    | TagVerb
    | CountVerb
    | DiffVerb

:| run_verb =
    | RunVerb
    | ErrorsVerb
    | ProcessesVerb
    | StopVerb

:| write_verb =
    | AppendVerb
    | CopyVerb
    | MoveVerb
    | WriteFileVerb

:| program_verb =
    | ReadVerb : query_verb
    | FactVerb : fact_verb
    | RunStepVerb : run_verb
    | WriteVerb : write_verb
    | GitVerb
    | JobVerb
    | LabVerb

:= fact_word (verb : fact_verb) : string =
    ?= verb ?|
    | HashVerb => "hash"
    | EnvVerb => "env"
    | ExistsVerb => "exists"
    | NearestVerb => "nearest"
    | JsonVerb => "json"
    | LinesVerb => "lines"
    | TableVerb => "table"
    | DirsVerb => "dirs"
    | TagVerb => "tag"
    | CountVerb => "count"
    | DiffVerb => "diff"

:= run_word (verb : run_verb) : string =
    ?= verb ?|
    | RunVerb => "run"
    | ErrorsVerb => "errors"
    | ProcessesVerb => "processes"
    | StopVerb => "stop"

:= write_word (verb : write_verb) : string =
    ?= verb ?|
    | AppendVerb => "append"
    | CopyVerb => "copy"
    | MoveVerb => "move"
    | WriteFileVerb => "write"

:= program_verb_family (verb : program_verb) : program_family =
    ?= verb ?|
    | ReadVerb _ => Reads
    | FactVerb _ => Facts
    | RunStepVerb _ => Runs
    | WriteVerb _ => Writes
    | GitVerb => Git
    | JobVerb => Jobs
    | LabVerb => Labs

:~ fact_named (~word : string) : option fact_verb =
    union_reflection.cases.union_case_where (\ (verb : fact_verb) => word = fact_word verb) (\ verb => Some verb) None

:~ run_named (~word : string) : option run_verb =
    union_reflection.cases.union_case_where (\ (verb : run_verb) => word = run_word verb) (\ verb => Some verb) None

:~ write_named (~word : string) : option write_verb =
    union_reflection.cases.union_case_where (\ (verb : write_verb) => word = write_word verb) (\ verb => Some verb) None

:~ program_verb_tail (~word : string) : option program_verb =
    ?= run_named word ?|
    | Some verb => Some (RunStepVerb verb)
    | None =>
        ?= write_named word ?|
        | Some verb => Some (WriteVerb verb)
        | None =>
            ? word = "git" ?> Some GitVerb
            |? word = "job" ?> Some JobVerb
            |? word = "lab" ?> Some LabVerb
            |: None

:~ program_verb_named (~word : string) : option program_verb =
    ?= query_verb_named word ?|
    | Some verb => Some (ReadVerb verb)
    | None =>
        ?= fact_named word ?|
        | Some verb => Some (FactVerb verb)
        | None => program_verb_tail word

:~ do_verb_family (~word : string) : string =
    ?= program_verb_named word ?|
    | Some verb => program_family_word (program_verb_family verb)
    | None => ""

:== families_seen =
    {
        runs : bool
        jobs : bool
        labs : bool
        git : bool
        writes : bool
        facts : bool
        reads : bool
    }

:= nothing_seen () : families_seen = { runs = !-; jobs = !-; labs = !-; git = !-; writes = !-; facts = !-; reads = !- }

:= seen_with (seen : families_seen) (family : program_family) : families_seen =
    ?= family ?|
    | Runs => { seen ?| runs = !+ }
    | Jobs => { seen ?| jobs = !+ }
    | Labs => { seen ?| labs = !+ }
    | Git => { seen ?| git = !+ }
    | Writes => { seen ?| writes = !+ }
    | Facts => { seen ?| facts = !+ }
    | Reads => { seen ?| reads = !+ }
    | Edits => seen

:= family_seen (seen : families_seen) (family : program_family) : bool =
    ?= family ?|
    | Runs => seen.runs
    | Jobs => seen.jobs
    | Labs => seen.labs
    | Git => seen.git
    | Writes => seen.writes
    | Facts => seen.facts
    | Reads => seen.reads
    | Edits => !-

:= family_priority () : list program_family =
    (Runs :: (Jobs :: (Labs :: (Git :: (Writes :: (Facts :: (Reads :: Nil)))))))

:~ query_family (~records : record_list) (index : i32) : option program_family =
    := verb = field_at records index 1i32
    ? verb = "files" && field_index records index "count" >= 0i32 ?> Some Facts
    |:
        ?= program_verb_named verb ?|
        | Some named => Some (program_verb_family named)
        | None => None

:~ ^ families_of (~records : record_list) (index : i32) (seen : families_seen) : families_seen =
    ? index >= record_count records ?> seen
    |? field_at records index 0i32 <> "query" ?> families_of records (index + 1i32) seen
    |:
        ?= query_family records index ?|
        | Some family => families_of records (index + 1i32) (seen_with seen family)
        | None => families_of records (index + 1i32) seen

:~ ^ first_seen (order : list program_family) (seen : families_seen) : program_family =
    ?= order ?|
    | Nil => Edits
    | (family :: rest) => ? family_seen seen family ?> family |: first_seen rest seen

:~ records_family (~records : record_list) : program_family =
    first_seen (family_priority ()) (families_of records 1i32 (nothing_seen ()))

:= main () : i32 =
    !!!!Export(
        "kit_do_program_family",
        ((\ encoded => program_family_word (records_family (records_of encoded))) : string -> string)
    )
    !!!!Export("kit_do_verb_family", ((\ word => do_verb_family word) : string -> string))
    0i32


///> rust
:# every_verb_names_its_family_once =
    testing.expect (do_verb_family "search" = "reads") "search reads"
    testing.expect (do_verb_family "tail" = "reads") "tail reads"
    testing.expect (do_verb_family "hash" = "facts") "hash is a fact"
    testing.expect (do_verb_family "diff" = "facts") "diff is a fact"
    testing.expect (do_verb_family "processes" = "runs") "processes runs"
    testing.expect (do_verb_family "move" = "writes") "move writes"
    testing.expect (do_verb_family "git" = "git") "git"
    testing.expect (do_verb_family "lab" = "labs") "lab"
    testing.expect (do_verb_family "replace" = "") "replace is no query verb"
    testing.expect (do_verb_family "edit" = "") "edit is a statement, not a query verb"

:= family_of_bars (~text : string) : string = program_family_word (records_family (records_from_bars text))

///> rust
:# a_program_is_delegated_to_its_highest_priority_family =
    testing.expect (family_of_bars "ok\nquery|search|qneedle\nquery|run|qcargo" = "runs") "a run step outranks reads"
    testing.expect (family_of_bars "ok\nquery|hash|qa.txt\nquery|move|qa|qb" = "writes") "writes outrank facts"
    testing.expect (family_of_bars "ok\nquery|files|q.|wcount" = "facts") "counting files is a fact"
    testing.expect (family_of_bars "ok\nquery|files|q." = "reads") "listing files reads"
    testing.expect (family_of_bars "ok\nquery|lab|qlist\nquery|git|qstatus" = "labs") "labs outrank git"
    testing.expect (family_of_bars "ok\nedit|qa.txt" = "edits") "no query is an edit program"
    testing.expect (program_family_named "jobs" = Some Jobs) "family words read back"
