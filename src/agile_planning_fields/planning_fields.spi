:< workspace_primitives.outcome
:< sm'_operators
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< agile_planning_model.model

:= padded (~text : string) (width : i32) : string =
    $'{ let text = !text; let filler = (!width as usize).saturating_sub(text.chars().count()); \
        std::rc::Rc::<str>::from(text.to_string() + &" ".repeat(filler)) }' : string

:= estimate_width () : i32 = 7i32
:= load_width () : i32 = 7i32
:= assignee_width () : i32 = 6i32

:~ planning_header () : string =
    (padded "EST" (estimate_width ())) ++# (padded "LOAD" (load_width ())) ++# (padded "WHO" (assignee_width ()))

:~ planning_columns_of (plan : task_planning) : string =
    padded (estimate_text plan.estimate) (estimate_width ())
    ++# padded (load_text plan.load) (load_width ())
    ++# padded (assignee_text plan.assignee) (assignee_width ())

:~ planning_columns (~text : string) (~id : string) : string = planning_columns_of (planning_of text id)

:~ planning_columns_near (~text : string) (~id : string) (start : i32) : string =
    planning_columns_of (planning_near text id start)

:~ planning_json (~text : string) (~id : string) : string = planning_json_fields (planning_of text id)

:~ planning_json_near (~text : string) (~id : string) (start : i32) : string =
    planning_json_fields (planning_near text id start)

:~ planning_minutes_near (~text : string) (~id : string) (start : i32) : i32 =
    planned_minutes (planning_near text id start).estimate
:~ planning_summary_of (~text : string) (~id : string) : string = planning_summary (planning_of text id)

:~ planning_minutes_of (~text : string) (~id : string) : i32 =
    := plan = planning_of text id
    planned_minutes plan.estimate

:= main () : i32 =
    !!!!Export("kit_agile_planning_header", ((\ () => planning_header ()) : () -> string))
    !!!!Export("kit_agile_planning_columns", ((\ (text, id) => planning_columns text id) : string * string -> string))
    !!!!Export("kit_agile_planning_json", ((\ (text, id) => planning_json text id) : string * string -> string))
    !!!!Export(
        "kit_agile_planning_summary",
        ((\ (text, id) => planning_summary_of text id) : string * string -> string)
    )
    !!!!Export("kit_agile_planning_minutes", ((\ (text, id) => planning_minutes_of text id) : string * string -> i32))
    !!!!Export(
        "kit_agile_planning_columns_near",
        ((\ (text, id, start) => planning_columns_near text id start) : string * string * i32 -> string)
    )
    !!!!Export(
        "kit_agile_planning_json_near",
        ((\ (text, id, start) => planning_json_near text id start) : string * string * i32 -> string)
    )
    !!!!Export(
        "kit_agile_planning_minutes_near",
        ((\ (text, id, start) => planning_minutes_near text id start) : string * string * i32 -> i32)
    )
    := _ = planning_header ()
    := _ = planning_columns "" "ID"
    := _ = planning_json "" "ID"
    := _ = planning_summary_of "" "ID"
    := _ = planning_minutes_of "" "ID"
    := _ = planning_columns_near "" "ID" 0i32
    := _ = planning_json_near "" "ID" 0i32
    := _ = planning_minutes_near "" "ID" 0i32
    0i32
