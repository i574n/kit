:< filesystem_action_batch_contract.model
:< filesystem_action_batch_contract.bindings

:= main () : i32 =
    := _ = public_plan ()
    := _ : fs_action_operation = BatchMkdir "dir"
    := _ : fs_action_operation = BatchCopy ("source", "sha", "target")
    := _ : fs_action_operation = BatchChmod ("target", "0644", "0755")
    := _ : fs_action_operation = BatchSymlink ("link", "target")
    ?= fs_action_shape_binding 4i32 0i32 ?|
    | 1 =>
        ?= fs_action_freshness_binding 3i32 1i32 ?|
        | 1 =>
            ?= fs_action_apply_binding 4i32 4i32 ?|
            | 1 =>
                ?= fs_action_verify_binding 4i32 4i32 ?|
                | 1 =>
                    ?= fs_action_rollback_binding 4i32 4i32 ?|
                    | 1 => 0i32
                    | _ => 1i32
                | _ => 1i32
            | _ => 1i32
        | _ => 1i32
    | _ => 1i32
