:! filesystem_evidence = bool
:! process_evidence = bool
:! toolchain_evidence = bool
:! bootstrap_contract = filesystem_evidence * process_evidence * toolchain_evidence

:= build_plan
    (filesystem_ok : bool)
    (process_ok : bool)
    (toolchain_ok : bool)
    : bootstrap_contract =
    bootstrap_contract (
        filesystem_evidence filesystem_ok,
        process_evidence process_ok,
        toolchain_evidence toolchain_ok)

:= terminal
    (bootstrap_contract (
        filesystem_evidence filesystem_ok,
        process_evidence process_ok,
        toolchain_evidence toolchain_ok))
    : bool =
    filesystem_ok && process_ok && toolchain_ok

:= policy_plan filesystem_ok process_ok toolchain_ok =
    build_plan filesystem_ok process_ok toolchain_ok

:= agile_plan filesystem_ok process_ok toolchain_ok =
    build_plan filesystem_ok process_ok toolchain_ok

:! bootstrap_seed_bundle_only = ()
:! bootstrap_seed_flat_extracted = ()
:! bootstrap_seed_candidate_verified = ()
:! bootstrap_seed_installed = ()
:! bootstrap_seed_canonical_verified = ()

:| bootstrap_seed_op from to =
    | BootstrapExtractFlat :: bootstrap_seed_op bootstrap_seed_bundle_only bootstrap_seed_flat_extracted
    | BootstrapVerifyCandidate :: bootstrap_seed_op bootstrap_seed_flat_extracted bootstrap_seed_candidate_verified
    | BootstrapInstallCandidate :: bootstrap_seed_op bootstrap_seed_candidate_verified bootstrap_seed_installed
    | BootstrapVerifyCanonical :: bootstrap_seed_op bootstrap_seed_installed bootstrap_seed_canonical_verified

:| ^ bootstrap_seed_plan from to =
    | BootstrapSeedStep :: \* from to. bootstrap_seed_op from to -> bootstrap_seed_plan from to
    | BootstrapSeedThen :: \* from to.
        (\? middle. bootstrap_seed_plan from middle * bootstrap_seed_plan middle to) ->
        bootstrap_seed_plan from to

:= bootstrap_seed_complete_plan () : bootstrap_seed_plan bootstrap_seed_bundle_only bootstrap_seed_canonical_verified =
    BootstrapSeedThen (\? (
        BootstrapSeedStep BootstrapExtractFlat,
        BootstrapSeedThen (\? (
            BootstrapSeedStep BootstrapVerifyCandidate,
            BootstrapSeedThen (\? (
                BootstrapSeedStep BootstrapInstallCandidate,
                BootstrapSeedStep BootstrapVerifyCanonical
            ))
        ))
    ))

:| bootstrap_seed_route =
    | BootstrapUnzipSeed
    | BootstrapFallbackBinarySeed
    | BootstrapPreexistingCandidateSeed

:= bootstrap_seed_route_code = \|
    | BootstrapUnzipSeed => 0i32
    | BootstrapFallbackBinarySeed => 1i32
    | BootstrapPreexistingCandidateSeed => 2i32

:~ bootstrap_seed_preflight_binding
    (bundle_only : i32) (fallback_present : i32) (candidate_present : i32) (route : i32)
    : i32
    =
    ? bundle_only < 1i32 ?> 0i32
    |? 1i32 < bundle_only ?> 0i32
    |? fallback_present < 0i32 ?> 0i32
    |? 0i32 < fallback_present ?> 0i32
    |? candidate_present < 0i32 ?> 0i32
    |? 0i32 < candidate_present ?> 0i32
    |? route < 0i32 ?> 0i32
    |? 0i32 < route ?> 0i32
    |: 1i32

:~ bootstrap_seed_extract_binding (flat_root : i32) (public_binary : i32) (bundle_check : i32) : i32 =
    ? flat_root < 1i32 ?> 0i32
    |? 1i32 < flat_root ?> 0i32
    |? public_binary < 1i32 ?> 0i32
    |? 1i32 < public_binary ?> 0i32
    |? bundle_check < 1i32 ?> 0i32
    |? 1i32 < bundle_check ?> 0i32
    |: 1i32

:~ bootstrap_seed_install_binding (candidate_status : i32) (install_self : i32) (canonical_status : i32) : i32 =
    ? candidate_status < 1i32 ?> 0i32
    |? 1i32 < candidate_status ?> 0i32
    |? install_self < 1i32 ?> 0i32
    |? 1i32 < install_self ?> 0i32
    |? canonical_status < 1i32 ?> 0i32
    |? 1i32 < canonical_status ?> 0i32
    |: 1i32

:~ bootstrap_seed_rollback_binding (fault_observed : i32) (hash_restored : i32) (canonical_status : i32) : i32 =
    ? fault_observed < 1i32 ?> 0i32
    |? 1i32 < fault_observed ?> 0i32
    |? hash_restored < 1i32 ?> 0i32
    |? 1i32 < hash_restored ?> 0i32
    |? canonical_status < 1i32 ?> 0i32
    |? 1i32 < canonical_status ?> 0i32
    |: 1i32
