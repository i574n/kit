:= main () : i32 =
    := root = $'std::env::temp_dir().display().to_string().into()' : string
    := root_present = $'std::path::Path::new(&*!root).is_dir()' : bool
    ? root_present ?>
        := rejected = $'kit_proxy_search::inspection_tree_sha256(std::path::Path::new(&*!root), \
            "../escape").is_err_and(|error| error.contains("unsafe relative path"))' : bool
        ? rejected ?> 0i32 |: 1i32
    |: 10i32
