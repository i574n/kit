///- --package .
:# mirror static =
    :< sm'_operators

:< sm'_operators

:| file_side =
    | Missing
    | Present : string * u64

:== mirrored_file =
    {
        path : string
        left : file_side
        right : file_side
    }

:| file_drift =
    | SameOnBoth
    | LeftOnly
    | RightOnly
    | LeftNewer
    | RightNewer

:| mirror_state =
    | InStep
    | LeftAhead : string
    | RightAhead : string
    | Diverged : string

:~ drift_of (file : mirrored_file) : file_drift =
    ?= file.left, file.right ?|
    | Missing, Missing => SameOnBoth
    | Present _, Missing => LeftOnly
    | Missing, Present _ => RightOnly
    | Present (left, left_ms), Present (right, right_ms) =>
        ? left = right ?> SameOnBoth |? left_ms > right_ms ?> LeftNewer |: RightNewer

:= drift_word (drift : file_drift) : string =
    ?= drift ?|
    | SameOnBoth => "same"
    | LeftOnly => "left-only"
    | RightOnly => "right-only"
    | LeftNewer => "left-newer"
    | RightNewer => "right-newer"

:= left_moved (drift : file_drift) : bool =
    ?= drift ?|
    | LeftOnly => !+
    | LeftNewer => !+
    | _ => !-

:= joined_path (~list : string) (~path : string) : string = ? list = "" ?> path |: list ++# ", " ++# path

:~ ^ mirror_state_of (files : list mirrored_file) (~left : string) (~right : string) : mirror_state =
    ?= files ?|
    | Nil =>
        ? left = "" && right = "" ?> InStep
        |? right = "" ?> LeftAhead left
        |? left = "" ?> RightAhead right
        |: Diverged (left ++# " | " ++# right)
    | (file :: rest) =>
        ?= drift_of file ?|
        | SameOnBoth => mirror_state_of rest left right
        | drift =>
            ? left_moved drift
            ?> mirror_state_of rest (joined_path left file.path) right
            |: mirror_state_of rest left (joined_path right file.path)

:= state_word (state : mirror_state) : string =
    ?= state ?|
    | InStep => "in-step"
    | LeftAhead _ => "left-ahead"
    | RightAhead _ => "right-ahead"
    | Diverged _ => "diverged"

:= refuses_commit (state : mirror_state) : bool =
    ?= state ?|
    | InStep => !-
    | _ => !+


:= file_at (~path : string) (left : file_side) (right : file_side) : mirrored_file =
    { path = path; left = left; right = right }

///> rust
:# a_change_on_one_side_alone_is_reported_and_refused =
    := same = file_at "ci.yml" (Present ("x", 5u64)) (Present ("x", 9u64))
    testing.expect (mirror_state_of (same :: Nil) "" "" = InStep) "identical content in step whatever the times"
    := left_change = file_at "scripts/build.ps1" (Present ("new", 20u64)) (Present ("old", 10u64))
    testing.expect
        (mirror_state_of (left_change :: (same :: Nil)) "" "" = LeftAhead "scripts/build.ps1")
        "changed only on the left"
    testing.expect
        (
            mirror_state_of (file_at "a" (Present ("old", 10u64)) (Present ("new", 20u64)) :: Nil) "" ""
            = RightAhead "a"
        )
        "changed only on the right"
    testing.expect
        (
            mirror_state_of (left_change :: (file_at "b" (Missing) (Present ("", 3u64)) :: Nil)) "" ""
            = Diverged "scripts/build.ps1 | b"
        )
        "both sides moved"
    testing.expect (refuses_commit (LeftAhead "x") && refuses_commit InStep = !-) "only an in-step mirror commits"

///> rust
:# an_empty_file_is_present_not_missing =
    testing.expect (drift_of (file_at "e" (Present ("", 1u64)) Missing) = LeftOnly) "an empty file on the left only"
    testing.expect (drift_of (file_at "e" (Present ("", 1u64)) (Present ("", 2u64))) = SameOnBoth) "two empty files agree"
    testing.expect (drift_word (drift_of (file_at "e" Missing Missing)) = "same") "absent on both sides"
