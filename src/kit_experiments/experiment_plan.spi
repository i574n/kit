///- --package .
:# experiment_plan static =
    :< rust_std_string.model
    :< experiment_model

:< rust_std_string.model
:< experiment_model

:! mean_test = ()
:! rate_test = ()
:! median_test = ()

:| test_plan result =
    | WelchPlan :: string -> test_plan mean_test
    | OneSamplePlan :: f64 -> test_plan mean_test
    | BinomialPlan :: f64 -> test_plan rate_test
    | WilsonPlan :: f64 -> test_plan rate_test
    | BinomialBandPlan :: f64 -> test_plan rate_test
    | MedianPlan :: f64 * f64 -> test_plan median_test

:| tested =
    | TestedMean : test_plan mean_test
    | TestedRate : test_plan rate_test
    | TestedMedian : test_plan median_test

:== plan =
    {
        id : string
        metric : string
        arm : string
        kind : test_kind
        group : string
        runs : i32
        confidence : f64
        decision : string
        time : string
        since : string
        test : tested
    }

:| plan_read =
    | PlanRead : plan
    | PlanBroken : string

:~ number_of (~text : string) : f64 = $'(!text).trim().parse::<f64>().unwrap_or(f64::NAN)' : f64
:~ whole_of (~text : string) : i32 = $'(!text).trim().parse::<i32>().unwrap_or(-1)' : i32
:~ first_item (~list : string) : string = $'std::rc::Rc::<str>::from((!list).split(char::from(44u8)).next().unwrap_or(\
    "").trim())' : string
:~ second_item (~list : string) : string = $'std::rc::Rc::<str>::from((!list).split(char::from(44u8)).nth(1).unwrap_or\
    ("").trim())' : string

:~ test_plan_of (kind : test_kind) (~arms : string) (~prediction : string) : tested =
    ?= kind ?|
    | WelchTwoSided => TestedMean (WelchPlan (second_item arms))
    | OneSampleT => TestedMean (OneSamplePlan (number_of prediction))
    | BinomialAtMost => TestedRate (BinomialPlan (number_of prediction))
    | WilsonBand => TestedRate (WilsonPlan (number_of prediction))
    | BinomialBand => TestedRate (BinomialBandPlan (number_of prediction))
    | MedianBand => TestedMedian (MedianPlan (number_of (first_item prediction), number_of (second_item prediction)))

:= plan_record (kind : test_kind) (~text : string) : plan =
    := runs = whole_of (field_of text "runs")
    := confidence = number_of (field_of text "confidence")
    {
        kind = kind
        id = field_of text "id"
        metric = field_of text "metric"
        arm = (? field_of text "arms" = "" ?> "all" |: first_item (field_of text "arms"))
        group = field_of text "group"
        runs = runs
        confidence = (? confidence = confidence ?> confidence |: 0.95f64)
        decision = field_of text "decision"
        time = field_of text "time"
        since = field_of text "registered_local"
        test = test_plan_of kind (field_of text "arms") (field_of text "prediction")
    }

:~ plan_of (~text : string) : plan_read =
    ?= test_of (field_of text "test") ?|
    | TestUnknown => PlanBroken "the registration names an unknown test"
    | TestKnown kind =>
        := runs = whole_of (field_of text "runs")
        ?=
            plan_checked kind
                (field_of text "arms")
                (field_of text "group")
                runs
                (field_of text "prediction")
                (field_of text "metric")
                (field_of text "decision")
        ?|
        | PlanRejected reason => PlanBroken reason
        | PlanAccepted =>
            PlanRead (plan_record kind text)

:~ plan_trusted (~text : string) : plan_read =
    ?= test_of (field_of text "test") ?|
    | TestUnknown => PlanBroken "the registration names an unknown test"
    | TestKnown kind => PlanRead (plan_record kind text)

:= predicted_rate (which : test_plan rate_test) : f64 =
    ?= which ?|
    | BinomialPlan rate => rate
    | WilsonPlan rate => rate
    | BinomialBandPlan rate => rate

:~ kind_of_plan (test : tested) : test_kind =
    ?= test ?|
    | TestedMean (WelchPlan _) => WelchTwoSided
    | TestedMean (OneSamplePlan _) => OneSampleT
    | TestedRate (BinomialPlan _) => BinomialAtMost
    | TestedRate (WilsonPlan _) => WilsonBand
    | TestedRate (BinomialBandPlan _) => BinomialBand
    | TestedMedian (MedianPlan _) => MedianBand

:| second_arm =
    | OneArm
    | AgainstArm : string

:~ second_arm_of (test : tested) : second_arm =
    ?= test ?|
    | TestedMean (WelchPlan arm) => AgainstArm arm
    | _ => OneArm

:~ prediction_of (test : tested) : f64 =
    ?= test ?|
    | TestedMean (OneSamplePlan value) => value
    | TestedRate which => predicted_rate which
    | _ => 0.0f64

:| band =
    | NoBand
    | Band : f64 * f64

:~ band_of (test : tested) : band =
    ?= test ?|
    | TestedMedian (MedianPlan (low, high)) => Band (low, high)
    | _ => NoBand

:= against_text (arm : second_arm) : string =
    ?= arm ?|
    | AgainstArm name => name
    | OneArm => "-"

:= band_text (range : band) : string =
    ?= range ?|
    | Band (low, high) =>
        concat5
            ($'std::rc::Rc::<str>::from((!low).to_string().as_str())' : string)
            ".."
            ($'std::rc::Rc::<str>::from((!high).to_string().as_str())' : string)
            ""
            ""
    | NoBand => "-"

:= broken_reason (read : plan_read) : string =
    ?= read ?|
    | PlanBroken reason => reason
    | PlanRead _ => ""

:= registration (~test : string) (~arms : string) (~prediction : string) : string =
    concat5
        (field_line "id" "PR-1")
        (field_line "test" test)
        (field_line "metric" "retries")
        (field_line "arms" arms)
        (concat5 (field_line "runs" "5") (field_line "prediction" prediction) (field_line "decision" "d") "" "")

:= read_plan (~text : string) : plan =
    ?= plan_of text ?|
    | PlanRead found => found
    | PlanBroken reason => failwith reason

///> rust
:# a_registration_reads_into_a_typed_plan_with_its_parameters =
    := welch = read_plan (registration "welch" "fast,base" "")
    testing.expect (welch.arm = "fast") "first arm"
    testing.expect (against_text (second_arm_of welch.test) = "base") "second arm"
    testing.expect (welch.confidence = 0.95f64) "default confidence"
    := median = read_plan (registration "median" "fast" "28,32")
    testing.expect (band_text (band_of median.test) = "28..32") "band"
    := binomial = read_plan (registration "binomial" "fast" "0.35")
    testing.expect (prediction_of binomial.test = 0.35f64) "rate"
    testing.expect (test_word (kind_of_plan binomial.test) = "binomial") "kind round trip"
    := band = read_plan (registration "binomial-band" "fast" "0.74")
    testing.expect (prediction_of band.test = 0.74f64) "band rate"
    testing.expect (test_word (kind_of_plan band.test) = "binomial-band") "band kind round trip"

///> rust
:# a_broken_registration_names_the_problem =
    testing.expect
        (broken_reason (plan_of (registration "anova" "a" "")) = "the registration names an unknown test")
        "unknown test"
    testing.expect
        (
            broken_reason (plan_of (registration "one-sample" "a" ""))
            = "one-sample needs --prediction (the model value or rate it is tested against)"
        )
        "missing prediction"
