open sm'_operators

inl query_flag_width (~argument : string) (~value : string) : i32 = $'agile_task_query::eoie_query_flag_width(&*!argument, &*!value)' : i32
inl query_flag_refusal (~argument : string) (~value : string) : string = $'agile_task_query::eoie_query_flag_refusal(&*!argument, &*!value)' : string
inl query_usage () : string = $'agile_task_query::eoie_query_usage()' : string
inl fitting_loads () : string = $'eoie_window_query::eoie_fitting_loads()' : string
inl planned_load_valid (~load : string) : bool = $'agile_planning_filters::eoie_agile_planning_filters_valid(&*!load, "all")' : bool
inl argument_owned index : string = rust_std_env.model.argument_owned index
inl argument_count () : i32 = $'std::env::args().skip(2).count() as i32' : i32

let load_words (~loads : string) : array string = sm'.split "," loads |> array

let rec loads_valid (words : array string) (at : i32) : bool =
    if am'.length words <= at then true
    elif planned_load_valid (am'.index at words) then loads_valid words (at + 1i32)
    else false

inl query_appended (~query : string) (~argument : string) (~value : string) : string = rust_std_string.model.concat5 query (if query = "" then "" else " ") argument (if value = "" then "" else " ") value

type next_args =
    {
        role : string
        limit : i32
        filters : string
        load : string
        json : bool
    }

union args_parse =
    | ArgsParsed : next_args
    | ArgsRejected : string

inl next_usage () : string = rust_std_string.model.concat5 "expected --as main|subagent, " (query_usage ()) ", --load <light|medium|heavy|none,...>, --fits, --json or a positive count" "" ""

let rec next_request_from (index : i32) (count : i32) (request : next_args) : args_parse =
    if count <= index then ArgsParsed request
    else
        inl argument = argument_owned index
        inl value = argument_owned (index + 1i32)
        if argument = "--as" then
            if value = "main" || value = "subagent" then next_request_from (index + 2i32) count { request with role = value }
            else ArgsRejected (rust_std_string.model.concat5 "--as expects main or subagent, got " value "" "" "")
        elif argument = "--json" then next_request_from (index + 1i32) count { request with json = true }
        elif argument = "--fits" then next_request_from (index + 1i32) count { request with load = fitting_loads () }
        elif argument = "--load" then
            if value <> "" && loads_valid (load_words value) 0i32 then next_request_from (index + 2i32) count { request with load = value }
            else ArgsRejected ("--load expects light, medium, heavy or none, or a comma list of them, got " ++# value)
        else
            inl width = query_flag_width argument value
            if width > 0i32 then next_request_from (index + width) count { request with filters = query_appended request.filters argument (if width = 2i32 then value else "") }
            elif width < 0i32 then ArgsRejected (query_flag_refusal argument value)
            else
                inl parsed = $'(!argument).parse::<i32>().ok().filter(|value| *value > 0).unwrap_or(0)' : i32
                if 0i32 < parsed then next_request_from (index + 1i32) count { request with limit = parsed }
                else ArgsRejected (rust_std_string.model.concat5 "unexpected argument " argument " (" (next_usage ()) ")")

let next_request () : bool * string * string * i32 * string * string * bool =
    match next_request_from 2i32 (argument_count ()) { role = "main"; limit = 10i32; filters = ""; load = "all"; json = false } with
    | ArgsParsed request => true, "", request.role, request.limit, request.filters, request.load, request.json
    | ArgsRejected reason => false, reason, "", 0i32, "", "", false

inl main () : i32 =
    !!!!Export("eoie_agile_next_request", ((fun () => next_request ()) : () -> bool * string * string * i32 * string * string * bool))
    0i32
