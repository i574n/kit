:= main () : i32 =
    := toolchain_ok =
        (=.)
            (handoff_toolchain_projection (fixture_toolchain ()))
            "spiral_compiler=spiral-compile sha256=abcdef bytes=67952"
    := cold_ok =
        (=.) (handoff_cold_projection (fixture_cold ())) "cold_proof=closed replay_flags=15 binary_sha256=deadbeef"
    := cold_windows_ok =
        (=.)
            (handoff_cold_projection (fixture_cold_windows ()))
            "cold_proof=closed replay_flags=15 binary_sha256=deadbeef"
    !!!!Export("kit_handoff_toolchain_projection", ((\ value => handoff_toolchain_projection value) : string -> string))
    !!!!Export("kit_handoff_cold_projection", ((\ value => handoff_cold_projection value) : string -> string))
    ? toolchain_ok ?> ? cold_ok ?> ? cold_windows_ok ?> 0i32 |: 3i32 |: 2i32 |: 1i32
