///- --package .
:# model static =
    :< kit_crate_walk.walk
    :< sm'_operators

:< kit_crate_walk.walk
:< sm'_operators

:= expect (condition : bool) (~detail : string) : () = ? condition ?> () |: failwith detail

:| crate_verdict =
    | CrateWithin
    | CrateOver
    | CrateUnbuilt

:~ verdict_of (limit : i32) (measure : crate_measure) : crate_verdict =
    ? measure.lines < 0i32 ?> CrateUnbuilt |? measure.lines > limit ?> CrateOver |: CrateWithin

:~ verdict_text (limit : i32) (measure : crate_measure) : string =
    ?= verdict_of limit measure ?|
    | CrateWithin => "ok"
    | CrateOver => "OVER " ++# sm'.format limit
    | CrateUnbuilt => "no generated output yet"

:~ measure_line (limit : i32) (measure : crate_measure) : string =
    "gate / "
    ++# measure.crate
    ++# " "
    ++# measure.output
    ++# " "
    ++# sm'.format measure.lines
    ++# " lines "
    ++# verdict_text limit measure
    ++# measure.largest

:~ over_count (limit : i32) (measures : list crate_measure) : i32 =
    measures |> listm.fold (\ count (m : crate_measure) => ?= verdict_of limit m ?| | CrateOver => count + 1i32 | _ => count) 0i32

:| gate_outcome =
    | GatePassed
    | GateFailedOver : i32
    | GateFailedMissing : i32
    | GateFailedVacuous

:~ missing_count (limit : i32) (measures : list crate_measure) : i32 =
    measures |> listm.fold (\ count (m : crate_measure) => ?= verdict_of limit m ?| | CrateUnbuilt => count + 1i32 | _ => count) 0i32

:~ gate_outcome_of (enforce : bool) (limit : i32) (measures : list crate_measure) : gate_outcome =
    := over = over_count limit measures
    := missing = missing_count limit measures
    ? enforce && listm.length measures = 0i32 ?> GateFailedVacuous
    |? enforce && over > 0i32 ?> GateFailedOver over
    |? enforce && missing > 0i32 ?> GateFailedMissing missing
    |: GatePassed

///> rust
:# lines_verdicts_and_the_vacuity_rule =
    := small = { crate = "small"; output = "s.rs"; lines = 900i32; largest = "" }
    := big = { crate = "big"; output = "b.rs"; lines = 1200i32; largest = "" }
    := unbuilt = { crate = "new"; output = "n.rs"; lines = -1i32; largest = "" }
    := named = { crate = "big"; output = "b.rs"; lines = 1200i32; largest = " largest run 300" }
    expect (measure_line 1000i32 named = "gate / big b.rs 1200 lines OVER 1000 largest run 300") "largest fn named"
    expect (measure_line 1000i32 big = "gate / big b.rs 1200 lines OVER 1000") "over line"
    expect (measure_line 1000i32 small = "gate / small s.rs 900 lines ok") "ok line"
    expect (verdict_of 1000i32 unbuilt = CrateUnbuilt) "missing output is not counted as over"
    expect
        ?= gate_outcome_of !+ 1000i32 [ small; big; unbuilt ] ?|
        | GateFailedOver n => n = 1i32
        | _ => !-
        "enforce fails on one crate over"
    expect
        ?= gate_outcome_of !+ 1000i32 [] ?|
        | GateFailedVacuous => !+
        | _ => !-
        "enforce fails when nothing was measured"
    expect (?= gate_outcome_of !- 1000i32 [ big ] ?| | GatePassed => !+ | _ => !-) "report-only passes"
    expect
        ?= gate_outcome_of !+ 1000i32 [ small; unbuilt ] ?|
        | GateFailedMissing n => n = 1i32
        | _ => !-
        "enforce fails on a missing output"
    expect
        ?= gate_outcome_of !- 1000i32 [ unbuilt ] ?|
        | GatePassed => !+
        | _ => !-
        "report-only keeps a missing output as a report"
