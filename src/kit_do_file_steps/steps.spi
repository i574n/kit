:< sm'_operators
:< kit_receipt.receipt
:< kit_do_write_host.host

:== copy_tally =
    {
        report : string
        failed : bool
        copied : u64
        skipped : u64
        bytes : u64
    }

:~ joined (~left : string) (~right : string) : string =
    ? right = "" ?> left |? left = "" ?> right |: left ++# "\n" ++# right

:~ counted (~count : u64) (~one : string) (~many : string) : string =
    (decimal_text count) ++# " " ++# (? count = 1u64 ?> one |: many)

:~ append_step (~root : string) (~path : string) (~line : string) : string * bool * u64 * u64 =
    := before = file_text root path
    := newline = ? uses_crlf before ?> crlf () |: "\n"
    := filled = clock_filled line (local_offset_minutes ())
    := added = (? ended_with_newline before ?> "" |: newline) ++# filled ++# newline
    := problem = appended_to root path added
    ? problem = ""
    ?>
        := after = file_text root path
        := bytes = text_bytes added
        := lines = line_count filled
        := totals =
            "  now "
            ++# (counted (line_count after) "line" "lines")
            ++# ", "
            ++# (counted (text_bytes after) "byte" "bytes")
        := row =
            "append "
            ++# path
            ++# "  "
            ++# (counted lines "line" "lines")
            ++# ("  " ++# (counted bytes "byte" "bytes") ++# totals)
        row, !-, lines, bytes
    |: problem, !+, 0u64, 0u64

:~ ^ copies_run
    (~root : string) (~base : string) (~destination : string) (~excluded : string) (~paths : string) (~index : u64)
    (~state : copy_tally)
    : copy_tally
    =
    ? index < line_count paths ?>
        := path = line_at paths index
        := next =
            ? excluded_by excluded path ?> { state ?| skipped = state.skipped + 1u64 }
            |:
                := bytes = copied_bytes root path (destination ++# "/" ++# (relative_under base path))
                ? bytes < 0i64
                ?> { state ?| failed = !+; report = joined state.report ("copy " ++# path ++# "  failed") }
                |: { state ?| copied = state.copied + 1u64; bytes = state.bytes + unsigned bytes }
        copies_run root base destination excluded paths (index + 1u64) next
    |: state

:~ copy_step
    (~root : string) (~source : string) (~destination : string) (~excluded : string)
    : string * bool * u64 * u64 * u64
    =
    := base = glob_base source
    := paths = matching root source
    := after =
        copies_run root base destination excluded paths 0u64 {
            report = ""
            failed = !-
            copied = 0u64
            skipped = 0u64
            bytes = 0u64
        }
    := exclusions =
        ? excluded = "" ?> ""
        |: "  " ++# decimal_text after.skipped ++# " skipped (" ++# (sm'.replace "\n" ", " excluded) ++# ")"
    := row =
        "copy "
        ++# (? base = "" ?> "." |: base)
        ++# " -> "
        ++# destination
        ++# (
            "  "
            ++# (counted after.copied "file" "files")
            ++# "  "
            ++# (counted after.bytes "byte" "bytes")
            ++# exclusions
        )
    := failed = after.failed || paths = ""
    := report = ? paths = "" ?> "copy: no file matched " ++# source |: row
    joined after.report report, failed, after.copied, after.skipped, after.bytes

:= main () : i32 =
    !!!!Export(
        "kit_do_append_step",
        ((\ (root, path, line) => append_step root path line) : string * string * string -> string * bool * u64 * u64)
    )
    !!!!Export(
        "kit_do_copy_step",
        (
            \ (root, source, destination, excluded) => copy_step root source destination excluded
            : string * string * string * string -> string * bool * u64 * u64 * u64
        )
    )
    0i32
