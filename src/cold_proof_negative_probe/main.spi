:< cold_proof_contract.model
:< cold_proof_bindings.bindings

:= main () : i32 =
    ?= cold_proof_header_binding 3i32 1i32 ?|
    | 0 =>
        ?= cold_proof_header_binding 4i32 0i32 ?|
        | 0 =>
            ?= cold_proof_shape_binding 15i32 5i32 ?|
            | 0 =>
                ?= cold_proof_shape_binding 31i32 4i32 ?|
                | 0 =>
                    ?= cold_proof_evidence_binding 5i32 7i32 ?|
                    | 0 =>
                        ?= cold_proof_count_binding 10i32 11i32 ?|
                        | 0 =>
                            ?= cold_proof_replay_binding 7i32 15i32 ?|
                            | 0 => 0i32
                            | _ => 7i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
