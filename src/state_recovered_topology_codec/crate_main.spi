:~ bundle_rehydrate_structure_binding (profile : i32) (observed_mask : i32) : i32 =
    ? profile = 2i32 ?>
        ? observed_mask = 3i32 || observed_mask = 7i32 ?> 1i32 |: 0i32
    |:
        ? observed_mask = 4i32 || observed_mask = 5i32 || observed_mask = 6i32 || observed_mask = 7i32 ?> 1i32 |: 0i32

:~ bundle_profile_signature_binding (bootstrap_mask : i32) (model_mask : i32) : i32 =
    ? bootstrap_mask = 3i32 && model_mask = 3i32 ?> 1i32 |: 0i32

:= main () : i32 =
    := _ = bundle_rehydrate_structure_binding 2i32 7i32
    := _ = bundle_rehydrate_structure_binding 2i32 5i32
    := _ = bundle_rehydrate_structure_binding 1i32 4i32
    := _ = bundle_rehydrate_structure_binding 1i32 0i32
    := _ = bundle_profile_signature_binding 3i32 3i32
    := _ = bundle_profile_signature_binding 3i32 1i32
    := _ = state_receipt_recovered_topology_count_or_max "inl recovered_capability_fixture_count () : u32 = 22u32"
    := _ = state_receipt_recovered_fixture_record_count_or_max "// recovered-fixture|cap|a|b|c"
    := _ = state_receipt_recovered_fixture_paths "// recovered-fixture|cap|a|b|c"
    !!!!Export(
        "kit_state_receipt_recovered_topology_count_or_max",
        ((\ value => state_receipt_recovered_topology_count_or_max value) : string -> u64)
    )
    !!!!Export(
        "kit_state_receipt_recovered_fixture_record_count_or_max",
        ((\ value => state_receipt_recovered_fixture_record_count_or_max value) : string -> u64)
    )
    !!!!Export(
        "kit_state_receipt_recovered_fixture_paths",
        ((\ value => state_receipt_recovered_fixture_paths value) : string -> string)
    )
    !!!!Export(
        "kit_bundle_rehydrate_structure_binding",
        ((\ (first, second) => bundle_rehydrate_structure_binding first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_bundle_profile_signature_binding",
        ((\ (first, second) => bundle_profile_signature_binding first second) : i32 * i32 -> i32)
    )
    0i32
