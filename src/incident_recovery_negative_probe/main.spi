:< incident_recovery_contract.model

:= main () : i32 =
    ?= incident_recovery_scope_binding 1i32 1i32 0i32 1i32 ?|
    | 0 =>
        ?= incident_recovery_leaf_binding 0i32 1i32 ?|
        | 0 =>
            ?= incident_recovery_snapshot_binding 1i32 0i32 1i32 1i32 ?|
            | 0 =>
                ?= incident_recovery_restore_binding 1i32 2i32 1i32 1i32 ?|
                | 0 =>
                    ?= incident_recovery_restore_binding 1i32 1i32 1i32 0i32 ?|
                    | 0 =>
                        ?= incident_recovery_fault_binding 3i32 3i32 ?|
                        | 0 =>
                            ?= incident_recovery_rollback_binding 1i32 0i32 1i32 ?|
                            | 0 =>
                                ?= incident_recovery_completion_binding 1i32 1i32 0i32 ?|
                                | 0 => 0i32
                                | _ => 8i32
                            | _ => 7i32
                        | _ => 6i32
                    | _ => 5i32
                | _ => 4i32
            | _ => 3i32
        | _ => 2i32
    | _ => 1i32
