:< sm'_operators

:~ argument (~index : i32) : string = optionm'.default_value "" (env.try_command_line_argument (index - 1i32))
:= option_value (~name : string) : string = $'std::rc::Rc::<str>::from({ let args = \
    std::env::args().collect::<Vec<_>>(); args.iter().position(|argument| argument == &*!name).and_then(|at| \
    args.get(at + 1)).cloned().unwrap_or_default() }.as_str())' : string
:= stdout_text (~text : string) : () = $'{ use std::io::Write; let _ = std::io::stdout().lock().write_all((!text).as_b\
    ytes()); }' : ()
:= stdout_line (~text : string) : () = console.write_line text
:= stderr_line (~text : string) : () = console.write_error_line text
:= text_of (~path : string) : string = $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_default()\
    .replace(char::from(13u8), "").as_str())' : string
:| write_outcome =
    | Written
    | WriteFailed : string

:= write_problem (~path : string) (~text : string) : string = $'std::rc::Rc::<str>::from({ let target = \
    std::path::Path::new(&*!path); target.parent().filter(|parent| \
    \!parent.as_os_str().is_empty()).map(std::fs::create_dir_all).transpose().and_then(|_| std::fs::write(target, \
    (!text).as_bytes())).err().map(|error| error.to_string()).unwrap_or_default() }.as_str())' : string
:= text_written (~path : string) (~text : string) : write_outcome =
    := problem = write_problem path text
    ? problem = "" ?> Written |: WriteFailed problem
:= line_end_from (~text : string) (offset : i32) : i32 = $'(!text).get(!offset as usize..).and_then(|rest| \
    rest.find(char::from(10u8))).map(|at| at as i32 + !offset).unwrap_or((!text).len() as i32)' : i32
:= text_between (~text : string) (start : i32) (stop : i32) : string = $'std::rc::Rc::<str>::from((!text).get(!start \
    as usize..!stop as usize).unwrap_or(""))' : string
:= text_length (~text : string) : i32 = sm'.length text
:= count_text (value : i32) : string = (sm'.show value)

:| guide_place =
    | BetweenBlocks
    | InHabit
    | InCommand

:== guide_tally =
    {
        intents : i32
        text : string
    }

:= line_guided (place : guide_place) (~line : string) (tally : guide_tally) : guide_place * guide_tally =
    ?= place ?|
    | InHabit =>
        ? line = "" ?> BetweenBlocks, { tally ?| text = tally.text ++# "\n" }
        |: InHabit, { tally ?| text = tally.text ++# " " ++# line }
    | InCommand =>
        ? line = "```" ?> BetweenBlocks, { tally ?| text = tally.text ++# "```\n" }
        |: InCommand, { tally ?| text = tally.text ++# line ++# "\n" }
    | BetweenBlocks =>
        ? sm'.starts_with "## " line
        ?> BetweenBlocks, { intents = tally.intents + 1i32; text = tally.text ++# "\n" ++# line ++# "\n" }
        |? sm'.starts_with "Habit" line
        ?> InHabit, { tally ?| text = tally.text ++# "\nInstead of: " ++# line }
        |? line = "```command"
        ?> InCommand, { tally ?| text = tally.text ++# "\nOne call:\n\n```sh\n" }
        |: BetweenBlocks, tally

:~ ^ guided (~spec : string) (offset : i32) (place : guide_place) (tally : guide_tally) : guide_tally =
    ? offset >= text_length spec ?> tally
    |:
        := stop = line_end_from spec offset
        := next_place, next_tally = line_guided place (text_between spec offset stop) tally
        guided spec (stop + 1i32) next_place next_tally

:= guide_heading () : string =
    "# kit one-call guide\n\nGenerated by kit guide from spec/one-call.md: per intent, the habit it replaces and "
    ^^ "the one kit call. Do not edit by hand; regenerate.\n"

:~ guide_run () : i32 =
    := spec_path = argument 2i32
    := spec = text_of spec_path
    ? spec = "" ?>
        stderr_line "kit error: guide needs a readable spec file; usage: guide <spec/one-call.md> [--out <file.md>]"
        2i32
    |:
        := tally = guided spec 0i32 BetweenBlocks { intents = 0i32; text = guide_heading () }
        := out = option_value "--out"
        ? out = "" ?>
            stdout_text tally.text
            0i32
        |:
            ?= text_written out tally.text ?|
            | Written =>
                stdout_line ("kit guide ok intents=" ++# (count_text tally.intents) ++# " out=" ++# out)
                0i32
            | WriteFailed problem =>
                stderr_line ("kit error: guide could not write " ++# out ++# ": " ++# problem)
                2i32

:= main () : i32 =
    !!!!Export("kit_guide_run", ((\ () => guide_run ()) : () -> i32))
    0i32
