:! differential_raw = ()
:! differential_normalized = ()
:! differential_compared = ()
:! differential_receipted = ()

:! differential_equal = ()
:! differential_mismatch = ()

:| differential_relation relation =
    | DifferentialEqual :: differential_relation differential_equal
    | DifferentialMismatch :: differential_relation differential_mismatch

:| normalization_kind =
    | TextLineNormalization :: normalization_kind

:| differential_op from to =
    | NormalizeText :: normalization_kind -> differential_op differential_raw differential_normalized
    | CompareNormalized ::
        differential_relation differential_equal ->
        differential_op differential_normalized differential_compared
    | CommitDifferentialReceipt :: differential_op differential_compared differential_receipted

:| ^ differential_plan from to =
    | DifferentialStep :: \* from to. differential_op from to -> differential_plan from to
    | DifferentialThen :: \* from to.
        (\? middle. differential_plan from middle * differential_plan middle to) ->
        differential_plan from to

:= public_differential_plan () : differential_plan differential_raw differential_receipted =
    DifferentialThen (\? (
        DifferentialStep (NormalizeText TextLineNormalization),
        DifferentialThen (\? (
            DifferentialStep (CompareNormalized DifferentialEqual),
            DifferentialStep CommitDifferentialReceipt
        ))
    ))

:~ normalization_binding (canonical_lines : i32) (nonexpanding : i32) : i32 =
    ? canonical_lines = 1i32 ?>
        ? nonexpanding = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:~ comparison_binding (equal : i32) (mismatch_valid : i32) : i32 =
    ? mismatch_valid = 1i32 ?>
        ? equal = 1i32 ?> 1i32 |: 2i32
    |: 0i32

:~ receipt_binding (comparison_code : i32) (receipt_shape_valid : i32) : i32 =
    ? comparison_code = 1i32 ?>
        ? receipt_shape_valid = 1i32 ?> 1i32 |: 0i32
    |: 0i32

:~ settlement_binding (normalization_ok : i32) (comparison_ok : i32) (receipt_ok : i32) : i32 =
    := gate = normalization_ok * comparison_ok
    (gate * receipt_ok)
