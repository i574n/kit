:< rust_std_fs.model
:< sm'_operators
:< agile_task_text.model
:< workspace_primitives.outcome
:< workspace_primitives.numbers
:< workspace_primitives.bytes
:< workspace_primitives.clock
:< workspace_primitives.console
:< workspace_primitives.files

:= argument_owned index : string = rust_std_env.model.argument_owned index

:| scaffold_file =
    | StatePackage
    | BacklogSchema
    | LeasePrompt

:= scaffold_relative = \|
    | StatePackage => "/state/package.spiproj"
    | BacklogSchema => "/state/agile.spi"
    | LeasePrompt => "/state/prompt.spi"

:= expired_lease_text (now : u64) : string =
    := started = now - 5100000u64
    := head =
        "union lease_status = | LeaseActive :: lease_status | LeaseClosed :: lease_status\n"
        ^^ "union prompt_lease = | PromptLease :: string * string * u64 * u64 * u64 * u64 * lease_status -> "
        ^^ "prompt_lease\n"
    := row =
        (
            "inl current () : prompt_lease = PromptLease (\"init\", \"scaffolded by agile init; agile begin opens "
            ^^ "a lease\", 4500000u64, 600000u64, "
        )
        ++# u64_text started
        ++# "u64, "
        ++# u64_text now
        ++# "u64, LeaseActive)\ninl main () : i32 = 0i32\n"
    head ++# row

:= scaffold_text (now : u64) = \|
    | StatePackage => """
        modules:
            agile
            prompt

        """
    | BacklogSchema =>
        inl kinds = """
            union task_kind =
                | Epic :: task_kind
                | Feature :: task_kind
                | Story :: task_kind
                | TaskKind :: task_kind


            """
        inl priorities = """
            union priority =
                | P0 :: priority | P1 :: priority | P2 :: priority | P3 :: priority | P4 :: priority | P5 :: priority


            """
        inl difficulties = """
            union difficulty =
                | D0 :: difficulty | D1 :: difficulty | D2 :: difficulty | D3 :: difficulty | D4 :: difficulty
                | D5 :: difficulty | D6 :: difficulty | D7 :: difficulty | D8 :: difficulty


            """
        inl statuses = """
            union task_status =
                | Planned :: task_status | Active :: task_status | Blocked :: task_status | Paused :: task_status | Done :: task_status


            """
        inl item = """
            union agile_item =
                | Task :: string * string * task_kind * priority * difficulty * u32 * task_status * string * string * string * string -> agile_item

            inl main () : i32 = 0i32

            """
        kinds ++# priorities ++# difficulties ++# statuses ++# item
    | LeasePrompt => expired_lease_text now

:= scaffold_path (~root : string) (file : scaffold_file) : string = root ++# (scaffold_relative file)
:= state_directory (~root : string) : string = root ++# "/state"
:= directory_ready (~path : string) : bool = $'std::fs::create_dir_all(&*!path).is_ok()' : bool
:= file_present (~path : string) : bool = $'std::path::Path::new(&*!path).exists()' : bool

:= agile_init_failure (~reason : string) (~root : string) : i32 =
    stderr_failure ("agile init " ++# root ++# " rejected: " ++# reason)

:= agile_init_success (~root : string) (written : u64) (elapsed : u64) : i32 =
    := head = "kit agile init ok root=" ++# root ++# " files=3 bytes=" ++# (u64_text written) ++# " elapsed_ms="
    stdout_line (head ++# (u64_text elapsed) ++# " next=kit agile begin <root> <title>")

:= agile_init (~root : string) : i32 =
    := started = unix_ms ()
    ? file_present (scaffold_path root BacklogSchema) ?> agile_init_failure "state/agile.spi already exists" root
    |? file_present (scaffold_path root StatePackage) ?> agile_init_failure "state/package.spiproj already exists" root
    |? file_present (scaffold_path root LeasePrompt) ?> agile_init_failure "state/prompt.spi already exists" root
    |? directory_ready (state_directory root) ?>
        ? write_text (scaffold_path root StatePackage) (scaffold_text started StatePackage) ?>
            ? write_text (scaffold_path root BacklogSchema) (scaffold_text started BacklogSchema) ?>
                ? write_text (scaffold_path root LeasePrompt) (scaffold_text started LeasePrompt) ?>
                    agile_init_success root ($"!(text_bytes (scaffold_text started StatePackage)) + \
                        !(text_bytes (scaffold_text started BacklogSchema)) + \
                        !(text_bytes (scaffold_text started LeasePrompt))" : u64) (ms_since started)
                |: agile_init_failure "could not write state/prompt.spi" root
            |: agile_init_failure "could not write state/agile.spi" root
        |: agile_init_failure "could not write state/package.spiproj" root
    |: agile_init_failure "could not create the state directory" root

:~ agile_init_entry () : i32 = agile_init (argument_owned 1i32)

:= main () : i32 =
    !!!!Export("kit_agile_init_run", ((\ () => agile_init_entry ()) : () -> i32))
    := _ = agile_init_entry ()
    0i32
