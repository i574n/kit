open sm'_operators
open file_system_operators
open model

inl run_notebook_batch (command : string) : bool =
    sm'.contains "run_notebook.ps1" command && sm'.contains " --output-dir " command

inl now_ms () : u64 = convert.u64 (reactors.physical_micros () / 1000i64)

let notebook_batch_line (command : string) (age_minutes : u64) (now : u64) : string =
    if run_notebook_batch command |> not then ""
    else
        inl dir = batch_output_dir command
        inl started_ms = now - (age_minutes + 1u64) * 60000u64
        inl progress = batch_progress_of command (fun name => file_system.last_write_ms (dir </> name)) started_ms
        batch_progress_text progress started_ms now

inl main () : i32 =
    !!!!Export(
        "eoie_notebook_batch_line",
        ((fun (command, age_minutes) => notebook_batch_line command age_minutes (now_ms ())) : string * u64 -> string)
    )
    0i32
