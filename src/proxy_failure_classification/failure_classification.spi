:| proxy_failure =
    | ArgumentFailure
    | ChildProcessFailure : i32

:| proxy_repair =
    | AddCreateOrReplace
    | ExpectObservedMatches : u64
    | NoRepair

:= child_exit_digits (~message : string) : i32 =
    $'!message.find("failed: exit code: ").and_then(|at| !message[at + 19..].split(|c: char| c.is_ascii_digit() == \
        false).next().and_then(|digits| digits.parse::<i32>().ok())).unwrap_or(0)' : i32

:= observed_match_digits (~message : string) : u64 =
    $'!message.find("observed matches=").and_then(|at| !message[at + 17..].split(|c: char| c.is_ascii_digit() == \
        false).next().and_then(|digits| digits.parse::<u64>().ok())).unwrap_or(0)' : u64

:= message_starts (~message : string) (~prefix : string) : bool = $'!message.starts_with(&*!prefix)' : bool

:= proxy_failure_of (~message : string) : proxy_failure =
    := code = child_exit_digits message
    ? $"!code > 0" ?> ChildProcessFailure code |: ArgumentFailure

:= proxy_repair_of (~message : string) : proxy_repair =
    := matches = observed_match_digits message
    ? message_starts message "fs-write refuses to overwrite existing file" ?> AddCreateOrReplace
    |? message_starts message "text-replace expected " && $"!matches > 0" ?> ExpectObservedMatches matches
    |: NoRepair

:= process_exit_code (code : i32) : i32 = ? (code > 255i32) ?> 255i32 |: code

:= proxy_flags_follow (index : i32) : bool = $'std::env::args().nth(2 + !index as usize).is_some_and(|word| \
    word.starts_with("--"))' : bool

:~ proxy_argument_count () : i32 =
    := user = env.command_line_argument_count ()
    ? user > 0i32 ?> user - 1i32 |: 0i32

:= proxy_words (first : i32) (last : i32) : string =
    $'std::rc::Rc::<str>::from(std::env::args().skip(2 + !first as usize).take((!last - !first).max(0) as \
        usize).map(|word| Some(word.clone()).filter(|plain| plain.is_empty() == false && \
        plain.chars().enumerate().all(|(at, c)| c.is_ascii_alphanumeric() || "_-./:=+,".contains(c) || c == \
        char::from(92u8) || (c == char::from(126u8) && at > 0))).unwrap_or_else(|| [String::from(char::from(39u8)), \
        word.replace(char::from(39u8), &String::from_iter([char::from(39u8); \
        2])), String::from(char::from(39u8))].concat())).collect::<Vec<_>>().join(" ").as_str())' : string

:= joined (~a : string) (~b : string) (~c : string) : string = $'std::rc::Rc::<str>::from([&*!a, &*!b, \
    &*!c].concat().as_str())' : string

:= u64_text (value : u64) : string = $'std::rc::Rc::<str>::from(!value.to_string().as_str())' : string

:~ proxy_child_exit_code (~message : string) : i32 =
    ?= proxy_failure_of message ?|
    | ChildProcessFailure code => process_exit_code code
    | ArgumentFailure => 0i32

:~ proxy_corrected_command (~message : string) : string =
    ?= proxy_repair_of message ?|
    | AddCreateOrReplace =>
        := flag = ? proxy_flags_follow 3i32 ?> " --create-or-replace " |: " --create-or-replace -- "
        joined (joined "kit proxy " (proxy_words 0i32 3i32) flag) (proxy_words 3i32 (proxy_argument_count ())) ""
    | ExpectObservedMatches matches =>
        ? $"!matches == 1" ?> joined "kit proxy " (proxy_words 0i32 6i32) ""
        |: joined (joined "kit proxy " (proxy_words 0i32 6i32) " --expect ") (u64_text matches) ""
    | NoRepair => ""

:= main () : i32 =
    !!!!Export("kit_proxy_child_exit_code", ((\ message => proxy_child_exit_code message) : string -> i32))
    !!!!Export("kit_proxy_corrected_command", ((\ message => proxy_corrected_command message) : string -> string))
    := _ = proxy_child_exit_code "proxy-run failed: exit code: 3"
    := _ = proxy_corrected_command "text-replace expected 1 match(es), observed matches=3"
    0i32
