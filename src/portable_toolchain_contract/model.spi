:! portable_toolchain_raw = ()
:! portable_toolchain_payload_verified = ()
:! portable_toolchain_tools_verified = ()
:! portable_toolchain_ready = ()

:| portable_toolchain_resolution =
    | PortableToolchainMissing
    | PortableToolchainMismatch
    | PortableToolchainReady

:| portable_toolchain_op from to =
    | InspectPortablePayloads :: portable_toolchain_op portable_toolchain_raw portable_toolchain_payload_verified
    | VerifyPortableTools :: portable_toolchain_op portable_toolchain_payload_verified portable_toolchain_tools_verified
    | ClosePortableToolchain :: portable_toolchain_op portable_toolchain_tools_verified portable_toolchain_ready

:| ^ portable_toolchain_plan from to =
    | PortableToolchainStep :: \* from to. portable_toolchain_op from to -> portable_toolchain_plan from to
    | PortableToolchainThen :: \* from to.
        (\? middle. portable_toolchain_plan from middle * portable_toolchain_plan middle to) ->
        portable_toolchain_plan from to

:= portable_toolchain_public_plan () : portable_toolchain_plan portable_toolchain_raw portable_toolchain_ready =
    PortableToolchainThen (\? (
        PortableToolchainStep InspectPortablePayloads,
        PortableToolchainThen (\? (
            PortableToolchainStep VerifyPortableTools,
            PortableToolchainStep ClosePortableToolchain
        ))
    ))

:~ portable_toolchain_resolution_binding (payload_present : i32) (payload_match : i32) (tools_match : i32) : i32 =
    ? payload_present = 0i32 ?> 0i32
    |:
        ? payload_match = 1i32 ?>
            ? tools_match = 1i32 ?> 2i32 |: 1i32
        |: 1i32

:~ portable_toolchain_shape_binding (payload_count : i32) (tool_count : i32) (root_count : i32) : i32 =
    ? payload_count = 3i32 ?>
        ? tool_count = 7i32 ?>
            ? root_count = 2i32 ?> 1i32 |: 0i32
        |: 0i32
    |: 0i32
