:= main () : i32 =
    := _ = typed_predicate.model.lift_sha256 "evidence_sha256_text" ""
    !!!!Export(
        "kit_evidence_row_stage",
        ((\ (first, second) => model.evidence_row_stage first second) : i32 * i32 -> i32)
    )
    !!!!Export(
        "kit_rust_tool_environment",
        ((\ relative => model.rust_tool_environment_binding relative) : string -> string)
    )
    !!!!Export(
        "kit_evidence_public_binary",
        ((\ (first, second) => model.evidence_public_binary_binding first second) : i32 * i32 -> string)
    )
    terminal.emit_runtime ()
    0i32
