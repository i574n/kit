open sm'_operators
open eoie_jobs.host
open eoie_jobs.jobs
open host_model
open queue

nominal supervisor_children = $'std::rc::Rc<std::cell::RefCell<Vec<std::process::Child>>>'

let no_children () : supervisor_children =
    $'std::rc::Rc::new(std::cell::RefCell::new(Vec::new()))' : supervisor_children

let own_pid () : u64 = $'std::process::id() as u64' : u64

let host_home_directory () : string = joined (jobs_root ()) "shell-host"

let requests_directory () : string = joined (host_home_directory ()) "requests"

let host_pid_file () : string = joined (host_home_directory ()) "pid"

let request_removed (~path : string) : bool = $'std::fs::remove_file(&*!path).is_ok()' : bool

let next_request (~dir : string) : string =
    $'std::rc::Rc::<str>::from(std::fs::read_dir(&*!dir).into_iter().flatten().flatten().map(|entry| \
        entry.file_name().to_string_lossy().into_owned()).filter(|name| \
        name.ends_with(".start")).min().unwrap_or_default())' : string

let supervisor_child_started (~children : supervisor_children) (~executable : string) (~id : string) : bool =
    $'{ let mut command = std::process::Command::new(&*!executable); \
        command.arg("job").arg("supervise").arg(&*!id).stdin(std::process::Stdio::null()).stdout(std::process::Stdio::\
        null()).stderr(std::process::Stdio::null()); \#[cfg(windows)] { use std::os::windows::process::CommandExt; \
        const DETACHED_PROCESS: u32 = 0x0000_0008; command.creation_flags(DETACHED_PROCESS); } match command.spawn() \
        { Ok(child) => { (!children).borrow_mut().push(child); true } Err(_) => false } }' : bool

let live_children (~children : supervisor_children) : u64 =
    $'{ let mut kids = (!children).borrow_mut(); kids.retain_mut(|child| matches\!(child.try_wait(), Ok(None))); \
        kids.len() as u64 }' : u64

let detached_started (~executable : string) (~args : string) : u64 =
    $'eoie_os_launch::eoie_shell_parented_start(&*!executable, &(!args).split(char::from(31u8)).filter(|arg| \
        \!arg.is_empty()).collect::<Vec<_>>()).0' : u64

let queue_decide (~id : string) : i32 = $'eoie_job_queue::eoie_job_queue_decide(&*!id)' : i32

let request_served (~children : supervisor_children) (~executable : string) (~id : string) : () =
    inl decided = queue_decide id
    if decided = 0i32 then
        inl _ = supervisor_child_started children executable id
        ()
    elif decided = 1i32 then held_recorded id executable
    else ()

let rec held_from (~children : supervisor_children) (names : array string) (index : i32) (held : u64) : u64 =
    if index >= am'.length names then held
    else
        inl id = am'.index index names
        inl decided = queue_decide id
        if decided = 1i32 then
            held_beat id
            held_from children names (index + 1i32) (held + 1u64)
        elif decided = 0i32 then
            inl executable = text_or_empty (held_file id)
            held_released id
            inl _ = supervisor_child_started children executable id
            held_from children names (index + 1i32) held
        else
            held_released id
            held_from children names (index + 1i32) held
let held_served (~children : supervisor_children) : u64 = held_from children (held_names ()) 0i32 0u64

let home_of () : host_home = if directory_exists (requests_directory ()) then HomePresent else HomeGone

let args_mark () : string = $'std::rc::Rc::<str>::from(char::from(31u8).to_string())' : string

let rec host_served (~children : supervisor_children) (~idle_since : u64) : i32 =
    inl dir = requests_directory ()
    inl name = next_request dir
    if name <> "" then
        inl path = joined dir name
        inl executable = text_or_empty path
        inl _ = request_removed path
        inl _ = request_served children executable (request_id name)
        host_served children (now_ms ())
    else
        inl live = live_children children + held_served children
        inl now = now_ms ()
        match host_step_of live idle_since now (home_of ()) with
        | HostIdleExit =>
            inl _ =
                if decimal_u64 (text_or_empty (host_pid_file ())) = own_pid () then request_removed (host_pid_file ())
                else false
            0i32
        | KeepServing =>
            sleep_ms 500u64
            host_served children (if live > 0u64 then now else idle_since)

let host_run () : i32 =
    inl recorded = decimal_u64 (text_or_empty (host_pid_file ()))
    match host_claim_of recorded (own_pid ()) (process_alive recorded) with
    | OtherHostServes _ => 0i32
    | HostOwns =>
        inl _ = directory_created (requests_directory ())
        inl _ = text_written (host_pid_file ()) (decimal_text (own_pid ()))
        host_served (no_children ()) (now_ms ())

let rec supervisor_awaited (~id : string) (~deadline : u64) : supervisor_wait =
    match supervisor_wait_of (decimal_u64 (text_or_empty (job_file id "supervisor"))) (now_ms ()) deadline with
    | Some wait => wait
    | None =>
        if file_exists (held_file id) then SupervisorHeld "held"
        elif file_exists (job_file id "exit") then SupervisorHeld "settled"
        else
            sleep_ms 50u64
            supervisor_awaited id deadline

let supervisor_requested (~id : string) : string =
    inl executable = supervisor_executable (jobs_root ())
    inl dir = requests_directory ()
    inl _ = directory_created dir
    inl request = joined dir (request_name id)
    inl _ = text_written request executable
    inl host = decimal_u64 (text_or_empty (host_pid_file ()))
    inl _ =
        match host_state_of host (process_alive host) with
        | HostRunning _ => 0u64
        | HostMissing => detached_started executable ("job" ++# args_mark () ++# "host")
    match supervisor_awaited id (now_ms () + 5000u64) with
    | SupervisorUp pid => decimal_text pid
    | SupervisorHeld word => word
    | SupervisorLate =>
        if request_removed request then
            inl pid = detached_started executable ("job" ++# args_mark () ++# "supervise" ++# args_mark () ++# id)
            if pid = 0u64 then "error: neither the job host nor a detached start launched the supervisor"
            else decimal_text pid
        else
            match supervisor_awaited id (now_ms () + 60000u64) with
            | SupervisorUp pid => decimal_text pid
            | SupervisorHeld word => word
            | SupervisorLate => "error: the job host took the request but the supervisor never recorded its pid"

let held_revived () : string =
    if am'.length (held_names ()) = 0i32 then "idle"
    else
        inl recorded = decimal_u64 (text_or_empty (host_pid_file ()))
        match host_state_of recorded (process_alive recorded) with
        | HostRunning _ => "running"
        | HostMissing =>
            inl pid = detached_started (supervisor_executable (jobs_root ())) ("job" ++# args_mark () ++# "host")
            if pid = 0u64 then "error: held jobs wait and no job host could be started" else "revived"

inl main () : i32 =
    !!!!Export("eoie_job_host_run", ((fun () => host_run ()) : () -> i32))
    !!!!Export("eoie_job_host_revive", ((fun () => held_revived ()) : () -> string))
    !!!!Export("eoie_job_host_request", ((fun id => supervisor_requested id) : string -> string))
    0i32
