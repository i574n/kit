///- --package .
test note_filter static =
    open sm'_operators
    open agile_note_model.model
    open workspace_primitives.numbers

open sm'_operators
open agile_note_model.model
open workspace_primitives.numbers

union note_filter =
    | AllNotes
    | NewestNotes : i32
    | NotesMatching : string

let note_filter_of (~mode : string) (~value : string) : note_filter =
    if mode = "last" then
        match (convert.try_convert value : option i32) with
        | Some newest => NewestNotes newest
        | None => AllNotes
    elif mode = "grep" then NotesMatching (sm'.to_lower value)
    else AllNotes

inl note_kept (filter : note_filter) (index : i32) (count : i32) (note : task_note) : bool =
    match filter with
    | AllNotes => true
    | NewestNotes newest => index > count - newest
    | NotesMatching needle => sm'.contains needle (sm'.to_lower note.text) || sm'.contains needle (sm'.to_lower note.author)

let rec kept_lines (text : string) (~needle : string) (offset : i32) (filter : note_filter) (index : i32) (count : i32) (~lines : string) (kept : i32) : string * i32 =
    inl found = declared_from text needle offset
    if found < 0i32 then lines, kept
    else
        inl note = note_at text found
        inl next = index + 1i32
        if note_kept filter next count note then
            inl seq = sm'.replace "u32" "" (item_field text NoteItem found 1i32)
            kept_lines text needle (found + 1i32) filter next count (lines ++# "\n#" ++# seq ++# " " ++# note_line note) (kept + 1i32)
        else kept_lines text needle (found + 1i32) filter next count lines kept

let notes_filtered_text (text : string) (~id : string) (filter : note_filter) : string =
    inl count = note_count text id
    if count = 0i32 then ""
    else
        inl lines, kept = kept_lines text (item_anchor NoteItem id) 0i32 filter 0i32 count "" 0i32
        "notes (" ++# i32_text kept ++# "/" ++# i32_text count ++# ")" ++# lines

inl expect (condition : bool) (~detail : string) : () = if condition then () else failwith detail

inl sample_notes () : string =
    inl first = note_row "T-1" 1i32 { at = "2026-10-22T01:00Z"; author = "eoie"; text = "lease probe" }
    inl second = note_row "T-1" 2i32 { at = "2026-10-22T02:00Z"; author = "tibia-lane"; text = "rows written" }
    inl third = note_row "T-1" 3i32 { at = "2026-10-22T03:00Z"; author = "eoie"; text = "window Lease held" }
    "inl task_t_1 () = Task (\"T-1\", \"t\", TaskKind, P1, D1, 0u32, Active, \"\", \"\")\n" ++# first ++# "\n" ++# second ++# "\n" ++# third ++# "\n"

///> rust
test notes_filter_by_newest_and_by_text_and_keep_their_numbers =
    inl newest = notes_filtered_text (sample_notes ()) "T-1" (note_filter_of "last" "1")
    expect (sm'.starts_with "notes (1/3)\n#3 2026-10-22T03:00Z" newest) newest
    inl matching = notes_filtered_text (sample_notes ()) "T-1" (note_filter_of "grep" "LEASE")
    expect (sm'.starts_with "notes (2/3)\n#1 2026-10-22T01:00Z" matching && sm'.contains "\n#3 " matching) matching
    expect (sm'.starts_with "notes (1/3)\n#2 " (notes_filtered_text (sample_notes ()) "T-1" (note_filter_of "grep" "tibia"))) "the author matches too"
    expect (sm'.starts_with "notes (3/3)\n#1 " (notes_filtered_text (sample_notes ()) "T-1" (note_filter_of "last" "x"))) "an unreadable count keeps every note"