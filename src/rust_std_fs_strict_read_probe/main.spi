:= main () : i32 =
    := root = "/tmp/kit-strict-read-spiral-probe"
    := path = "/tmp/kit-strict-read-spiral-probe/value.txt"
    := minus_one = (-(1i32))
    := clean_before = rust_std_fs.rooted_effects.cleanup_tree root
    := created = rust_std_fs.rooted_effects.create_dir root
    := written = rust_std_fs.model.write_text path "abcdef"
    := over_limit = rust_std_fs.rooted_effects.read_regular_len path 5
    := exact_len = rust_std_fs.rooted_effects.read_regular_len path 6
    := exact_text = rust_std_fs.rooted_effects.read_regular_text_equals path 6 "abcdef"
    := directory_rejected = rust_std_fs.rooted_effects.read_regular_len root 16
    := clean_after = rust_std_fs.rooted_effects.cleanup_tree root
    ?
        clean_before
        && created
        && written
        && over_limit = minus_one
        && exact_len = 6i32
        && exact_text
        && directory_rejected = minus_one
        && clean_after
    ?> 0i32
    |: 1i32
