:< predicate_rules.model

:| outcome =
    | Rejected : string
    | Candidate : string

:= opening (token : string) : bool = (=.) token "(" || (=.) token "[" || (=.) token "{"
:= closing (token : string) : bool = (=.) token ")" || (=.) token "]" || (=.) token "}"
:= fail (reason : string) : outcome = Rejected reason

:~ ^ function_end (source : string) (cursor : i32) (depth : i32) (started : bool) : i32 =
    := _, after, token, ok = predicate_lex.model.token source cursor
    ? (=.) ok !- || (=.) token "" ?> -1i32
    |? (=.) token "{" ?> function_end source after ((+.) depth 1i32) !+
    |? (=.) token "}" ?>
        ? (=.) depth 1i32 ?> after
        |? (<=) depth 0i32 ?> -1i32
        |: function_end source after ((-.) depth 1i32) started
    |? (=.) token ";" && (=.) started !- ?> -1i32
    |: function_end source after depth started

:~ ^ closure_name (source : string) (cursor : i32) : string =
    := _, after, token, ok = predicate_lex.model.token source cursor
    ? (=.) ok !- || (=.) token "" ?> ""
    |? (=.) token "|" ?>
        := _, _, name, _ = predicate_lex.model.token source after
        name
    |: closure_name source after

:= supported (function_text : string) (name : string) (kind : string) : bool =
    := _, a, _, _ = predicate_lex.model.token function_text 0i32
    := _, b, _, _ = predicate_lex.model.token function_text a
    := _, c, paren, _ = predicate_lex.model.token function_text b
    := _, d, parameter, _ = predicate_lex.model.token function_text c
    := byte = closure_name function_text d
    := expected = predicate_rules.model.expected kind name parameter byte
    := expected_tokens, expected_ok = predicate_lex.model.canonical expected
    := observed_tokens, observed_ok = predicate_lex.model.canonical function_text
    (=.) paren "("
    && expected_ok
    && observed_ok
    && (=.) expected_tokens observed_tokens
    && (<) 0i32 (predicate_lex_core.model.length expected)

:~ ^ rust_loop
    (source : string) (name : string) (kind : string) (cursor : i32) (depth : i32) (ready : bool) (last : i32)
    (out : string) (found : i32)
    : string * i32 * bool
    =
    := first, after, token, ok = predicate_lex.model.token source cursor
    ? (=.) ok !-
    ?> "", found, !-
    |? (=.) token ""
    ?>
        predicate_lex_core.model.append out (
            predicate_lex_core.model.cut source last (predicate_lex_core.model.length source)
        ),
        found,
        (=.) depth 0i32
    |? (=.) depth 0i32 && (=.) token "fn"
    ?>
        := _, _, next, _ = predicate_lex.model.token source after
        ? (=.) next name
        ?>
            := end_function = function_end source after 0i32 !-
            ? (<) end_function 0i32 || (=.) ready !-
            ?> "", found, !-
            |? supported (predicate_lex_core.model.cut source first end_function) name kind
            ?>
                rust_loop source name kind end_function 0i32 !+ end_function
                    (predicate_lex_core.model.append out (predicate_lex_core.model.cut source last first))
                    ((+.) found 1i32)
            |: "", found, !-
        |: rust_loop source name kind after depth !- last out found
    |:
        := next_depth = ? opening token ?> (+.) depth 1i32 |? closing token ?> (-.) depth 1i32 |: depth
        := next_ready = (=.) next_depth 0i32 && ((=.) token ";" || (=.) token "}")
        ? (<) next_depth 0i32 ?> "", found, !-
        |: rust_loop source name kind after next_depth next_ready last out found

:~ ^ argument (source : string) (cursor : i32) (depth : i32) : i32 * i32 * i32 * string * bool =
    := first = predicate_lex.model.skip source cursor
    ? (<) first 0i32 || (>=) first (predicate_lex_core.model.length source) || (>) depth 16i32
    ?> cursor, cursor, cursor, "", !-
    |? (=.) (predicate_lex_core.model.at source first) (char_quote ())
    ?>
        := code, after, ok = predicate_lex.model.literal source first
        after, first, after, code, ok
    |? predicate_lex_core.model.starts source first "("
    ?>
        := begin = predicate_lex.model.skip source ((+.) first 1i32)
        := hash = "typed_predicate.model.lift_sha256"
        := receipt = "typed_predicate.model.lift_receipt_text"
        := width =
            ? (<) begin 0i32
            ?> 0i32
            |? predicate_lex_core.model.starts source begin hash
            ?> predicate_lex_core.model.length hash
            |? predicate_lex_core.model.starts source begin receipt
            ?> predicate_lex_core.model.length receipt
            |: 0i32
        ? (=.) width 0i32
        ?> first, first, first, "", !-
        |:
            := name_at = predicate_lex.model.skip source ((+.) begin width)
            := _, after_name, name_ok = predicate_lex.model.literal source name_at
            ? (=.) name_ok !-
            ?> first, first, first, "", !-
            |:
                := after, literal_from, literal_to, code, ok = argument source after_name ((+.) depth 1i32)
                := close = predicate_lex.model.skip source after
                ? (<) close 0i32 || (=.) ok !-
                ?> first, first, first, "", !-
                |? predicate_lex_core.model.starts source close ")"
                ?> (+.) close 1i32, literal_from, literal_to, code, !+
                |: first, first, first, "", !-
    |: first, first, first, "", !-

:~ ^ source_loop
    (source : string) (name : string) (kind : string) (cursor : i32) (last : i32) (out : string) (found : i32)
    : outcome
    =
    := _, after, token, ok = predicate_lex.model.token source cursor
    ? (=.) ok !-
    ?> fail "Unsupported or malformed source syntax; input unchanged"
    |? (>) found 1i32
    ?> fail "Ambiguous function: multiple definitions; input unchanged"
    |? (=.) token ""
    ?>
        ? (=.) found 1i32
        ?>
            Candidate (predicate_lex_core.model.append out (predicate_lex_core.model.cut source last (
                predicate_lex_core.model.length source)))
        |: fail "No supported top-level predicate definition; input unchanged"
    |? (=.) token "rust_global"
    ?>
        := next = predicate_lex.model.skip source after
        ? (<) next 0i32
        ?> fail "Malformed comment after RustGlobal; input unchanged"
        |? predicate_lex_core.model.starts source next "(x : string)"
        ?> source_loop source name kind after last out found
        |:
            := next_cursor, literal_from, literal_to, code, ok = argument source next 0i32
            ? (=.) ok !-
            ?> fail "Unsupported RustGlobal argument; input unchanged"
            |:
                := reduced, count, valid = rust_loop code name kind 0i32 0i32 !+ 0i32 "" 0i32
                ? (=.) valid !-
                ?> fail "Predicate or syntax differs from the supported token grammar; input unchanged"
                |? (=.) count 0i32
                ?> source_loop source name kind next_cursor last out found
                |:
                    := wrapper = predicate_rules.model.wrapper kind name (predicate_lex.model.encode reduced)
                    := updated =
                        predicate_lex_core.model.append
                            (
                                predicate_lex_core.model.append out (
                                    predicate_lex_core.model.cut source last literal_from
                                )
                            )
                            wrapper
                    source_loop source name kind next_cursor literal_to updated ((+.) found count)
    |: source_loop source name kind after last out found

:= rewrite (source : string) (name : string) (kind : string) : outcome =
    ? (=.) (predicate_lex_core.model.length name) 0i32
    ?> fail "Empty function name"
    |?
        (=.) (predicate_lex.model.word_end name 0i32) (predicate_lex_core.model.length name)
        && predicate_lex_core.model.letter (predicate_lex_core.model.at name 0i32)
    ?>
        ?= predicate_rules.model.family_of kind ?|
        | Unsupported => fail "Unsupported predicate family"
        | _ => source_loop source name kind 0i32 0i32 "" 0i32
    |: fail "Function name must be an ASCII identifier"
