:< exact_replace_contract.model

:= zero_is (value : i32) : bool =
    ? value < 0i32 ?> !-
    |? 0i32 < value ?> !-
    |: !+

:= main () : i32 =
    := _ = negative_plan ()
    ? zero_is (preflight_binding 0i32 1i32 1i32) ?>
        ? zero_is (preflight_binding 1i32 0i32 1i32) ?>
            ? zero_is (preflight_binding 1i32 1i32 0i32) ?>
                ? zero_is (unique_match_binding 0i32) ?>
                    ? zero_is (unique_match_binding 2i32) ?>
                        ? zero_is (mode_binding 0i32 1i32) ?>
                            ? zero_is (verification_binding 0i32 0i32 1i32) ?>
                                ? zero_is (verification_binding 1i32 1i32 1i32) ?>
                                    ? zero_is (verification_binding 1i32 0i32 0i32) ?> 0i32 |: 9i32
                                |: 8i32
                            |: 7i32
                        |: 6i32
                    |: 5i32
                |: 4i32
            |: 3i32
        |: 2i32
    |: 1i32
