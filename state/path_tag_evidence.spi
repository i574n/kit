:= bench_tagged_source_map () : patch_exact =
    PatchExact (
        "state/bench.spi",
        "inl proxy_source_map_authority () = BenchCase (\"public-spi-map-classifies-ninety-three-package-roots-sixt"
        ^^ "y-seven-Cargo-crates-twenty-six-map-only-packages-one-hundred-eleven-mains-eighty-four-residuals-and-seven"
        ^^ "ty-eight-imports-while-spi-diff-finds-exactly-four-changed-owners\", BundleRoundtripBench, BenchPassed, "
        ^^ "100u32)",
        "inl proxy_source_map_authority () = BenchCase (\"public-spi-map-classifies-ninety-six-package-roots-sixty-"
        ^^ "seven-Cargo-crates-twenty-nine-map-only-packages-one-hundred-thirteen-mains-eighty-four-residuals-and-eigh"
        ^^ "ty-one-imports-while-emitting-stable-tags-and-spi-diff-finds-three-added-plus-two-changed-owners\", "
        ^^ "BundleRoundtripBench, BenchPassed, 100u32)\n"
        ^^ "inl mnemonic_path_tags () = BenchCase (\"shared-Spiral-path-tag-contract-positive-and-negative-mains-valid"
        ^^ "ate-relative-paths-decode-eighteen-SHA256-bits-select-three-sixty-four-word-banks-normalize-separators-and"
        ^^ "-public-spi-map-rejects-collisions\", RustEmitBench, BenchPassed, 100u32)"
    )

