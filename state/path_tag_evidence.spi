:| patch_exact = | PatchExact :: string * string * string -> patch_exact

:= agile_lease_regression () : patch_exact =
    PatchExact (
        "state/agile.spi",
        "inl manual_session_lease () = Task (\"BOOT-MANUAL-SESSION-LEASE\", \"Use agile begin with a fifty-minute "
        ^^ "work budget and ten-minute publication guard and fall back to manual timing only when the typed lease "
        ^^ "cannot open\", Feature, P0, D4, 100u32, Done, \"BOOT-TRUTH-REBASELINE\", \"lease,time,bundle\", "
        ^^ "\"current\", \"settled\")",
        "inl manual_session_lease () = Task (\"BOOT-MANUAL-SESSION-LEASE\", \"Use agile begin with a fifty-minute "
        ^^ "work budget and ten-minute publication guard and fall back to manual timing only when the typed lease "
        ^^ "cannot open\", Feature, P0, D4, 100u32, Done, \"BOOT-TRUTH-REBASELINE\", \"lease,time,bundle\", "
        ^^ "\"current\", \"settled\")\n"
        ^^ "inl agile_lease_tail_regression () = Task (\"AGILE-LEASE-TAIL-REGRESSION\", \"Repair the lease owner "
        ^^ "argument-tail index so agile begin accepts its title without manual timing fallback\", TaskKind, P0, D3, "
        ^^ "20u32, Blocked, \"BOOT-MANUAL-SESSION-LEASE\", \"agile,lease,args,regression\", \"next\", \"blocked\")"
    )

:= bench_lease_regression () : patch_exact =
    PatchExact (
        "state/bench.spi",
        "inl session_lease () = BenchCase (\"typed-lease-reserves-wrap-and-hard-stop-before-seventy-minutes\", "
        ^^ "BootstrapBench, BenchPassed, 100u32)",
        "inl session_lease () = BenchCase (\"typed-lease-reserves-wrap-and-hard-stop-before-seventy-minutes\", "
        ^^ "BootstrapBench, BenchPassed, 100u32)\n"
        ^^ "inl session_lease_tail_regression () = BenchCase (\"current-agile-begin-rejects-a-valid-title-because-the-"
        ^^ "lease-owner-reads-the-wrong-tail-index-and-this-round-uses-manual-timing\", BootstrapBench, BenchFailed, "
        ^^ "20u32)"
    )

:= bench_cold_bundle () : patch_exact =
    PatchExact (
        "state/bench.spi",
        "inl cold_bundle () = BenchCase (\"flat-bundle-rehydrates-cold-status-reports-one-hundred-thirty-and-nine-S"
        ^^ "piral-only-units-recompile-run-prove-topology-map-diff-limits-and-preserve-package-classification\", "
        ^^ "BundleRoundtripBench, BenchPassed, 100u32)",
        "inl cold_bundle () = BenchCase (\"flat-bundle-rehydrates-cold-status-reports-one-hundred-forty-four-and-te"
        ^^ "n-Spiral-only-units-recompile-run-prove-topology-tag-map-diff-limits-and-preserve-package-classification\""
        ^^ ", BundleRoundtripBench, BenchPassed, 100u32)"
    )

:= bench_settlement () : patch_exact =
    PatchExact (
        "state/bench.spi",
        "inl settled_migration () = BenchCase (\"nine-consecutive-post-rebaseline-alphas-settle-roundtrip-copy-move"
        ^^ "-directory-bundle-output-verification-manifest-stability-source-topology-and-source-map-diff-as-nine-of-si"
        ^^ "xty-nine-units\", TypecheckBench, BenchPassed, 130u32)",
        "inl settled_migration () = BenchCase (\"ten-consecutive-post-rebaseline-alphas-settle-roundtrip-copy-move-"
        ^^ "directory-bundle-output-verification-manifest-stability-source-topology-source-map-diff-and-mnemonic-path-"
