:= legacy_tag_family () : patch_exact =
    PatchExact (
        "state/legacy_catalog.spi",
        "inl prompt_rating_sync () = CapabilityFamily (\"prompt-and-rating-policy-synchronization\", "
        ^^ "LegacyRustMonolith, Absorbed, MediumRisk, \"prompt lease policy sync rating deltas and rebaseline caps\", "
        ^^ "\"typed prompt state rating anchor and agile check enforce synchronized recoverable claims\")",
        "inl prompt_rating_sync () = CapabilityFamily (\"prompt-and-rating-policy-synchronization\", "
        ^^ "LegacyRustMonolith, Absorbed, MediumRisk, \"prompt lease policy sync rating deltas and rebaseline caps\", "
        ^^ "\"typed prompt state rating anchor and agile check enforce synchronized recoverable claims\")\n"
        ^^ "inl mnemonic_path_tags () = CapabilityFamily (\"mnemonic-three-word-path-tags\", LegacyCpp, Absorbed, "
        ^^ "MediumRisk, \"stable relative-path identities from three sixty-four-word banks\", \"a shared Spiral "
        ^^ "contract validates paths and SHA256 bit selection while public spi-map emits deterministic "
        ^^ "collision-checked tags\")"
    )

:= legacy_tag_decision () : patch_exact =
    PatchExact (
        "state/legacy_catalog.spi",
        "inl decision_prompt_rating_sync () = LegacyDecision (\"prompt-and-rating-policy-synchronization\", "
        ^^ "PortNow, \"absorbed-into-prompt-rating-and-agile-check\", \"lease rollback subjective caps and "
        ^^ "delta-bearing typed state fail closed before packaging\")",
        "inl decision_prompt_rating_sync () = LegacyDecision (\"prompt-and-rating-policy-synchronization\", "
        ^^ "PortNow, \"absorbed-into-prompt-rating-and-agile-check\", \"lease rollback subjective caps and "
        ^^ "delta-bearing typed state fail closed before packaging\")\n"
        ^^ "inl decision_mnemonic_path_tags () = LegacyDecision (\"mnemonic-three-word-path-tags\", PortNow, "
        ^^ "\"absorbed-into-tagged-spi-map\", \"positive negative deterministic normalization and full-map collision "
        ^^ "proofs pass without a new Cargo crate\")"
    )

:= legacy_counts () : patch_exact =
    PatchExact (
        "state/legacy_catalog.spi",
        "inl cataloged_families () : u32 = 34u32\ninl estimated_total_families () : u32 = 34u32\n"
        ^^ "inl catalog_coverage_0_100 () : u32 = 100u32\ninl decided_families () : u32 = 30u32",
        "inl cataloged_families () : u32 = 35u32\ninl estimated_total_families () : u32 = 35u32\n"
        ^^ "inl catalog_coverage_0_100 () : u32 = 100u32\ninl decided_families () : u32 = 31u32"
    )

:= migration_legacy_decisions () : patch_exact =
    PatchExact (
        "state/migration.spi",
        "inl legacy_port_prune_decisions () : migration_item = SpiralExperiment "
        ^^ "(\"typed-legacy-port-or-prune-decisions\", 74u32, \"twenty-five of thirty-four capability families now "
        ^^ "have explicit port prune defer or fallback decisions and twenty-five families are cataloged\")",
        "inl legacy_port_prune_decisions () : migration_item = SpiralExperiment "
        ^^ "(\"typed-legacy-port-or-prune-decisions\", 89u32, \"thirty-one of thirty-five capability families have "
        ^^ "explicit port prune defer or fallback decisions and all thirty-five families are cataloged\")"
    )

:= migration_legacy_quarry () : patch_exact =
    PatchExact (
        "state/migration.spi",
        "inl legacy_surface_quarry_mapping () : migration_item = MigrationEvidence "
        ^^ "(\"fallback-capability-family-quarry\", 60u32, \"all thirty-four known fallback capability families have "
        ^^ "typed port prune defer or keep-fallback decisions; executable absorption remains partial and is not "
        ^^ "confused with catalog completion\")",
        "inl legacy_surface_quarry_mapping () : migration_item = MigrationEvidence "
        ^^ "(\"fallback-capability-family-quarry\", 62u32, \"all thirty-five known fallback capability families are "
        ^^ "cataloged and thirty-one have typed port prune defer or keep-fallback decisions; executable absorption "
        ^^ "remains partial and is not confused with catalog completion\")"
    )

:= main () : i32 = 0i32
