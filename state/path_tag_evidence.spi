:= bench_authority () : patch_exact =
    PatchExact (
        "state/bench.spi",
        "inl authority_gate () = BenchCase (\"global-candidate-primary-authority-is-paused-fallbacks-remain-canonic"
        ^^ "al-and-only-four-bundle-routes-plus-proxy-source-topology-source-stats-spi-map-and-spi-diff-hold-narrow-ca"
        ^^ "ndidate-partial-authority\", CoverageBench, BenchPassed, 100u32)",
        "inl authority_gate () = BenchCase (\"global-candidate-primary-authority-is-paused-fallbacks-remain-canonic"
