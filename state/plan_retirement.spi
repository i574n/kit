:! plan_active = ()
:! plan_applied = ()
:! plan_retired = ()

:| spent_plan_id =
    | FinalizePatchPlan
    | CompilerPatchPlan
    | MutationMigrationPlan
    | MutationLiteralPlan
    | OwnedStringPatch
    | OwnedCallPatch
    | CompilerOwnedStringPatch
    | CompilerScopedInteropPatch
    | OwnedStringFinalizePatch
    | ColdReceiptPatch
    | ExplicitOwnedApiPatch
    | PatchContextRuntimePatch
    | PublicRestorationErrorPatch
    | TransactionTestSplitPatch
    | TransactionTestSupportFix
    | TransactionSplitStatePatch
    | BestEffortRestorationPatch
    | BestEffortFinalizePatch
    | MappingClippyFinalizePatch
    | FailureAccumulatorPatch

:| plan_transition from to =
    | ApplyPlan :: spent_plan_id -> plan_transition plan_active plan_applied
    | RetireAppliedPlan :: spent_plan_id -> plan_transition plan_applied plan_retired

:| ^ retirement_witness from to =
    | RetirementStep :: \* from to. plan_transition from to -> retirement_witness from to
    | RetirementThen :: \* from to.
        (\? middle. retirement_witness from middle * retirement_witness middle to) ->
        retirement_witness from to

:= retire plan : retirement_witness plan_active plan_retired =
    RetirementThen (\? (
        RetirementStep (ApplyPlan plan),
        RetirementStep (RetireAppliedPlan plan)
    ))

:= retired_plan_count () : u32 = 20u32
:= state_file_budget () : u32 = 24u32

:= main () : i32 =
    := _ = retire FinalizePatchPlan
    := _ = retire CompilerPatchPlan
    := _ = retire MutationMigrationPlan
    := _ = retire MutationLiteralPlan
    := _ = retire OwnedStringPatch
    := _ = retire OwnedCallPatch
    := _ = retire CompilerOwnedStringPatch
    := _ = retire CompilerScopedInteropPatch
    := _ = retire OwnedStringFinalizePatch
    := _ = retire ColdReceiptPatch
    := _ = retire ExplicitOwnedApiPatch
    := _ = retire PatchContextRuntimePatch
    := _ = retire PublicRestorationErrorPatch
    := _ = retire TransactionTestSplitPatch
    := _ = retire TransactionTestSupportFix
    := _ = retire TransactionSplitStatePatch
    := _ = retire BestEffortRestorationPatch
    := _ = retire BestEffortFinalizePatch
    := _ = retire MappingClippyFinalizePatch
    := _ = retire FailureAccumulatorPatch
    0i32
