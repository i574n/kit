:! baseline_ready = ()
:! patched_ready = ()
:! cold_ready = ()

:| baseline_route =
    | UpstreamV50Route :: baseline_route
    | PatchedV51Route :: baseline_route
    | ColdV51Route :: baseline_route

:| baseline_status =
    | DiffRecorded :: baseline_status
    | ByteMatched :: baseline_status
    | NativePassed :: baseline_status
    | CleanOfBusinessLogic :: baseline_status

:| baseline_receipt =
    | BaselineReceipt :: string * baseline_route * baseline_status * i32 * string -> baseline_receipt

:= source_diff () : baseline_receipt =
    BaselineReceipt (
        "portable-backends-v50-v51",
        PatchedV51Route,
        DiffRecorded,
        118i32,
        "reports/v50-to-v51-portable-backends.patch"
    )
:= target_globals () : baseline_receipt =
    BaselineReceipt ("rust-target-globals", PatchedV51Route, ByteMatched, 259i32, "golden-identical")
:= library_mode () : baseline_receipt =
    BaselineReceipt ("rust-library-mode", PatchedV51Route, NativePassed, 1i32, "rustc-test-deny-warnings")
:= clean_source () : baseline_receipt =
    BaselineReceipt (
        "compiler-business-logic-scan",
        ColdV51Route,
        CleanOfBusinessLogic,
        0i32,
        "zero-Eoie-symbols-in-compiler-source"
    )

:= main () : i32 = 0i32
