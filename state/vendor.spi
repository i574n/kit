:| vendor_source =
    | UserSuppliedArchive :: vendor_source
    | BundleLocalDirectory :: vendor_source

:| vendor_crate =
    | Rayon :: vendor_crate
    | RayonCore :: vendor_crate
    | CrossbeamDeque :: vendor_crate
    | CrossbeamEpoch :: vendor_crate
    | CrossbeamUtils :: vendor_crate
    | Either :: vendor_crate

:| vendor_evidence =
    | Vendored :: vendor_crate * string * vendor_source * bool -> vendor_evidence

:= rayon_evidence () : vendor_evidence = Vendored (Rayon, "1.12.0", BundleLocalDirectory, !+)
:= rayon_core_evidence () : vendor_evidence = Vendored (RayonCore, "1.13.0", BundleLocalDirectory, !+)
:= crossbeam_deque_evidence () : vendor_evidence = Vendored (CrossbeamDeque, "0.8.7", BundleLocalDirectory, !+)
:= either_evidence () : vendor_evidence = Vendored (Either, "1.16.0", BundleLocalDirectory, !+)

:= main () : i32 = 0i32
