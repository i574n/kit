:! route_ready = ()
:! normalized = ()
:! compared = ()
:! receipted = ()

:| differential_route =
    | RecoveredBaseline :: differential_route
    | WorkingTree :: differential_route
    | ColdBundle :: differential_route

:| normalization =
    | TextLinesTrimmed :: normalization
    | NativeExitCode :: normalization
    | CompilerSourceSymbols :: normalization

:| differential_op from to result =
    | Normalize :: differential_route * normalization -> differential_op route_ready normalized string
    | Compare :: differential_route * differential_route -> differential_op normalized compared bool
    | WriteReceipt :: string -> differential_op compared receipted string

:| ^ differential_plan from to =
    | DifferentialStep :: \* from to. (\? result. differential_op from to result * result) -> differential_plan from to
    | DifferentialThen :: \* from to.
        (\? middle. differential_plan from middle * differential_plan middle to) ->
        differential_plan from to

:= backend_comparison () : differential_plan route_ready receipted =
    DifferentialThen (\? (
        DifferentialStep (\? (Normalize (RecoveredBaseline, TextLinesTrimmed), "baseline-normalized")),
        DifferentialThen (\? (
            DifferentialStep (\? (Compare (RecoveredBaseline, WorkingTree), !+)),
            DifferentialStep (\? (WriteReceipt "generic-rust-backend-diff-recorded", "receipted"))
        ))
    ))

:= cold_comparison () : differential_plan route_ready receipted =
    DifferentialThen (
        \? (
            DifferentialStep (\? (Normalize (WorkingTree, NativeExitCode), "working")),
            DifferentialThen (
                \? (
                    DifferentialStep (\? (Compare (WorkingTree, ColdBundle), !+)),
                    DifferentialStep (
                        \? (
                            WriteReceipt (
                                "cold-compiler-typed-layout-889df4ed33bc0878-multi-payload-6aba908d64895760-owned-s"
                                ^^ "tring-b958d99c3932ab34-environment-a973f1613640cebf-lease-0104b6a922a77143-agile-s"
                                ^^ "tate-9d8930ce88edf925-transaction-4339fb682d9e28b2-facade-c2ad3a3a45bc543d-mutatio"
                                ^^ "n-3f8ca8a1788d7e58-cli-4e2ab25d555b632c"
                            ),
                            "receipted"
                        )
                    )
                )
            )
        )
    )

:! fallback_routes_ready = ()
:! candidate_route_restored = ()
:! primary_route_restored = ()
:! secondary_route_restored = ()
:! fallback_hash_agreed = ()

:| fallback_agreement_step from to =
    | RestoreCandidateRoute :: string -> fallback_agreement_step fallback_routes_ready candidate_route_restored
    | RestorePrimaryRoute :: string -> fallback_agreement_step candidate_route_restored primary_route_restored
    | RestoreSecondaryRoute :: string -> fallback_agreement_step primary_route_restored secondary_route_restored
    | AgreeFallbackHash :: string -> fallback_agreement_step secondary_route_restored fallback_hash_agreed

:| ^ fallback_agreement_plan from to =
    | FallbackAgreementStep :: \* from to. fallback_agreement_step from to -> fallback_agreement_plan from to
    | FallbackAgreementThen :: \* from to.
        (\? middle. fallback_agreement_plan from middle * fallback_agreement_plan middle to) ->
        fallback_agreement_plan from to

:= fallback_patch_agreement () : fallback_agreement_plan fallback_routes_ready fallback_hash_agreed =
    FallbackAgreementThen (
        \? (
            FallbackAgreementStep (RestoreCandidateRoute "candidate-forward-reverse"),
            FallbackAgreementThen (
                \? (
                    FallbackAgreementStep (RestorePrimaryRoute "primary-text-replace-forward-reverse"),
                    FallbackAgreementThen (
                        \? (
                            FallbackAgreementStep (RestoreSecondaryRoute "secondary-replace-forward-reverse"),
                            FallbackAgreementStep (
                                AgreeFallbackHash "ce453f7d8a44bdccfa43f29e6bbcc3301c4cadac0cf39dc47d4391d19341321e"
                            )
                        )
                    )
                )
            )
        )
    )

:= safe_archive_symlink_receipt () : differential_plan route_ready receipted =
    DifferentialThen (\? (
        DifferentialStep (\? (Normalize (WorkingTree, TextLinesTrimmed), "safe-symlink-runtime")),
        DifferentialThen (\? (
            DifferentialStep (\? (Compare (WorkingTree, ColdBundle), !+)),
            DifferentialStep (\? (WriteReceipt "safe-archive-symlink-bytes-seven", "receipted"))
        ))
    ))

:= partial_rollback_receipt () : differential_plan route_ready receipted =
    DifferentialThen (\? (
        DifferentialStep (\? (Normalize (WorkingTree, TextLinesTrimmed), "partial-rollback-restored-oracle")),
        DifferentialThen (\? (
            DifferentialStep (\? (Compare (WorkingTree, RecoveredBaseline), !+)),
            DifferentialStep (\? (WriteReceipt "partial-rollback-byte-exact-restored-one-failed-one", "receipted"))
        ))
    ))

:= canonical_lcov_union_receipt () : differential_plan route_ready receipted =
    DifferentialThen (
        \? (
            DifferentialStep (\? (Normalize (WorkingTree, TextLinesTrimmed), "canonical-lcov-union")),
            DifferentialThen (
                \? (
                    DifferentialStep (\? (Compare (WorkingTree, RecoveredBaseline), !+)),
                    DifferentialStep (
                        \? (
                            WriteReceipt (
                                "coverage-union-public-289-smoke-262-combined-319-lines-19190-sha-a6f0acd395c9bf123"
                                ^^ "13cca1fa1be80a19619badf26b79d5e7b3bfa088fc0ede0"
                            ),
                            "receipted"
                        )
                    )
                )
            )
        )
    )

:= three_promotion_rollback_receipt () : differential_plan route_ready receipted =
    DifferentialThen (
        \? (
            DifferentialStep (
                \? (Normalize (WorkingTree, TextLinesTrimmed), "three-promotion-two-restored-one-failed")
            ),
            DifferentialThen (
                \? (
                    DifferentialStep (\? (Compare (WorkingTree, RecoveredBaseline), !+)),
                    DifferentialStep (
                        \? (
                            WriteReceipt "three-promotion-partial-rollback-byte-exact-restored-two-failed-one",
                            "receipted"
                        )
                    )
                )
            )
        )
    )

:| differential_settlement_evidence =
    | NormalizedParityObserved
    | DeterministicReceiptObserved
    | NormalizedMismatchObserved
    | MissingInputRejected
    | EscapingReceiptRejected

:| differential_settlement =
    | DifferentialSettlement ::
        u32 *
        u32 *
        string *
        string *
        differential_settlement_evidence *
        differential_settlement_evidence *
        differential_settlement_evidence *
        differential_settlement_evidence *
        differential_settlement_evidence ->
        differential_settlement

:= current_differential_settlement () : differential_settlement =
    DifferentialSettlement (
        10u32,
        9u32,
        "a15677518e2469e9",
        "3c8d3a94a3bfb1173a21c26b28256fffc586c2df941b70285a6e3c78fcc2e3df",
        NormalizedParityObserved,
        DeterministicReceiptObserved,
        NormalizedMismatchObserved,
        MissingInputRejected,
        EscapingReceiptRejected
    )

:= main () : i32 = 0i32
